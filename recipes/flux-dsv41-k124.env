# ==============================================================================
# Flux Engine Model Recipe: flux-dsv41-k124.env
# Target:     deepseek-v4.1 (DeepSeek-V4.1-Flash-Next, CB3 K154 pack served at K124)
# Source:     crates/spark-server/src/recipe/builtin/deepseek-v4.1-flash-next.yaml `atlas.env`.
#             A cold `serve` never applies that builtin, and ATLAS_DSV41_CHUNK defaults to 512
#             without it (crates/spark-model/src/factory/build.rs).
# Launch:     flux-autodetect also exports ATLAS_DSV41_MODEL_DIR=<model path> (the Rust loader
#             does not take it from --model-from-path), pins C1, no speculation,
#             --tool-call-parser dsml_v41, --max-seq-len 65536, BF16 KV.
# DSpark:     ATLAS_DSV41_DSPARK=1 is the opt-in internal MTP drafter (+8 GB, greedy only).
# ==============================================================================
ATLAS_DSV41_PACKED_KEEP=124
ATLAS_DSV41_CHUNK=2048
ATLAS_DSV41_DSPARK=0
