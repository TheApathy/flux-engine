ATLAS_QWEN4_QSA_ATTN_V2=1
ATLAS_QWEN4_QSA_GRAPH_SAFE=1
ATLAS_QWEN4_QSA_SCORE_V2=1
ATLAS_QWEN4_QSA_SELECT_PAR=1
ATLAS_QWEN4_RELEASE_BF16_QKVZ=1
