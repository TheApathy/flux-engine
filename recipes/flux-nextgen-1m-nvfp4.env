# ==============================================================================
# Flux Engine Operating Recipe: flux-nextgen-1m-nvfp4.env
# Target:      1x NVIDIA DGX Spark (GB10 / sm_121a, 128 GB LPDDR5X UMA)
# Context:     1,048,576 tokens (1M frequency-only 4.0x YaRN + 4-bit NVFP4 KV + QSA v3)
# Recommended CLI:
#   spark serve /models/Qwen3.8-Flash-Next-NVFP4-QAD5500-Hybrid \
#     --max-seq-len 1048576 --rope-yarn-factor 4.0 --kv-cache-dtype nvfp4 \
#     --qwen4-qsa --speculative --num-drafts 4 --max-prefill-tokens 16384 \
#     --enable-prefix-caching --ssm-cache-slots 32 --ssm-checkpoint-interval 64
# ==============================================================================
# Architecture Notes:
#   - Unlocks full 1,048,576-token single-Spark context (~29 GiB 4-bit E2M1 + UE4M3
#     NVFP4 KV pool vs ~103 GiB BF16) with unit attention_factor = 1.0 Qwen4 YaRN
#     synced across target attention, QSA indexer, and speculative draft heads.
#   - Engages slabbed 32-iteration radix QSA v3 selector (ATLAS_QWEN4_QSA_SELECT_V3=1)
#     supporting >131,072 up to 1,048,576 tokens with 0 shared-memory overflow.
# ==============================================================================

FLUX_MODE=1m-nvfp4
FLUX_MAX_SEQ_LEN=1048576
FLUX_KV_CACHE_DTYPE=nvfp4
FLUX_ROPE_YARN_FACTOR=4.0
FLUX_QWEN4_PREFILL_WIDE=16384

ATLAS_QWEN4_FP8_PAD128=1
ATLAS_CUBLASLT_CACHE=1
ATLAS_QWEN4_GDN_VERIFY_FUSED=1
ATLAS_QWEN4_QSA_FUSED_GATE=1
