def load_yaml_or_fallback(path: Path) -> Dict[str, Any]:
    """Parse YAML config using PyYAML if installed, or a pure-stdlib indentation parser."""
    text = path.read_text(encoding="utf-8")
    try:
        import yaml  # type: ignore
        loaded = yaml.safe_load(text)
        if isinstance(loaded, dict):
            return loaded
    except Exception:
        pass

    def _parse_scalar(val: str) -> Any:
        val = val.strip()
        if not val:
            return ""
        if (val.startswith('"') and val.endswith('"')) or (val.startswith("'") and val.endswith("'")):
            return val[1:-1]
        if val.startswith("[") and val.endswith("]"):
            inner = val[1:-1].strip()
            if not inner:
                return []
            return [_parse_scalar(x) for x in inner.split(",")]
        low = val.lower()
        if low == "true":
            return True
        if low == "false":
            return False
        if low in ("null", "none", "~"):
            return None
        try:
            if "." in val:
                return float(val)
            return int(val)
        except ValueError:
            return val

    root: Dict[str, Any] = {}
    stack: List[Tuple[int, Dict[str, Any]]] = [(-1, root)]
    for raw_line in text.splitlines():
        line = raw_line.split("#", 1)[0].rstrip()
        if not line.strip():
            continue
        indent = len(line) - len(line.lstrip(" "))
        stripped = line.strip()
        if ":" not in stripped:
            continue
        key_part, val_part = stripped.split(":", 1)
        key = key_part.strip()
        val_str = val_part.strip()
        while len(stack) > 1 and stack[-1][0] >= indent:
            stack.pop()
        parent = stack[-1][1]
        if not val_str:
            new_dict: Dict[str, Any] = {}
            parent[key] = new_dict
            stack.append((indent, new_dict))
        else:
            parent[key] = _parse_scalar(val_str)
    return root


def parse_env_file(path: Path) -> Dict[str, str]:
    """Parse KEY=VALUE lines from a sanitized .env recipe file."""
    env_map: Dict[str, str] = {}
    if not path.is_file():
        return env_map
    for raw in path.read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("export "):
            line = line[len("export "):].strip()
        if "=" in line:
            k, v = line.split("=", 1)
            v = v.strip()
            if (v.startswith('"') and v.endswith('"')) or (v.startswith("'") and v.endswith("'")):
                v = v[1:-1]
            env_map[k.strip()] = v
    return env_map


def parse_argv_file(path: Path, models_root: str) -> List[str]:
    """Parse newline-delimited CLI arguments and substitute <MODELS_ROOT>."""
    if not path.is_file():
        return []
    args: List[str] = []
    for raw in path.read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        args.append(line.replace("<MODELS_ROOT>", models_root))
    return args


def read_meminfo() -> Dict[str, int]:
    """Read /proc/meminfo values in MiB."""
    info: Dict[str, int] = {}
    try:
        for line in Path("/proc/meminfo").read_text(encoding="utf-8").splitlines():
            parts = line.split(":")
            if len(parts) == 2:
                key = parts[0].strip()
                val_kb = int(parts[1].strip().split()[0])
                info[key] = val_kb // 1024
    except Exception:
        pass
    return info


def detect_hardware(topology_override: str = "auto") -> Dict[str, Any]:
    """Inspect GPU, CPU core topology, UMA memory state, and cluster nodes without running GPU workloads."""
    mem = read_meminfo()
    total_mib = mem.get("MemTotal", 0)
    avail_mib = mem.get("MemAvailable", 0)
    cached_mib = mem.get("Cached", 0)
    free_mib = mem.get("MemFree", 0)

    # Read GPU info from /proc/driver/nvidia/gpus or sysfs without launching any CUDA context
    gpu_name = "NVIDIA GB10 (DGX Spark)"
    driver_ver = "580.126.09"
    gpu_count = 1
    proc_gpus = sorted(Path("/proc/driver/nvidia/gpus").glob("*/information"))
    if proc_gpus:
        gpu_count = len(proc_gpus)
        try:
            info_txt = proc_gpus[0].read_text(encoding="utf-8", errors="replace")
            for ln in info_txt.splitlines():
                if ln.startswith("Model:"):
                    parsed_model = ln.split(":", 1)[1].strip()
                    if parsed_model and parsed_model.lower() != "unknown":
                        gpu_name = parsed_model
                    elif platform.machine() == "aarch64":
                        gpu_name = "NVIDIA GB10 (DGX Spark)"
        except Exception:
            pass
    proc_ver = Path("/proc/driver/nvidia/version")
    if proc_ver.is_file():
        try:
            vtxt = proc_ver.read_text(encoding="utf-8", errors="replace")
            m = re.search(r"Kernel Module\s+([0-9.]+)", vtxt)
            if m:
                driver_ver = m.group(1)
        except Exception:
            pass

    # Detect cluster nodes via FLUX_CLUSTER_NODES
    cluster_nodes_raw = os.environ.get("FLUX_CLUSTER_NODES", "").strip()
    cluster_nodes = [n.strip() for n in cluster_nodes_raw.split(",") if n.strip()] if cluster_nodes_raw else []

    if topology_override and topology_override != "auto":
        topology = topology_override
    elif len(cluster_nodes) >= 4:
        topology = "4x-spark"
    elif len(cluster_nodes) == 2:
        topology = "2x-spark"
    elif "GB10" in gpu_name.upper():
        topology = "1x-spark"
    else:
        topology = "generic-gpu"

    # Compute capability & arch classification
    upper_gpu = gpu_name.upper()
    if "GB10" in upper_gpu:
        cc, arch_flag, target_id = "12.1", "sm_121a", "nvidia_gb10_sm121a"
    elif "6000" in upper_gpu or "5090" in upper_gpu or "SM120" in upper_gpu:
        cc, arch_flag, target_id = "12.0", "sm_120a", "nvidia_blackwell_sm120"
    elif "B200" in upper_gpu or "GB200" in upper_gpu:
        cc, arch_flag, target_id = "10.0", "sm_100a", "nvidia_b200_sm100a"
    elif "H100" in upper_gpu or "H200" in upper_gpu or "GH200" in upper_gpu:
        cc, arch_flag, target_id = "9.0", "sm_90a", "nvidia_hopper_sm90"
    else:
        cc, arch_flag, target_id = "12.1", "sm_121a", "nvidia_gb10_sm121a"

    # Detect CPU cores & Cortex-X925 affinity
    cpu_count = os.cpu_count() or 20
    arch = platform.machine()
    affinity = os.environ.get("FLUX_CPU_AFFINITY", "5-9,15-19" if arch == "aarch64" and cpu_count == 20 else f"0-{max(0, cpu_count - 1)}")

    # Select optimal recipe automatically
    if topology == "4x-spark":
        recommended_recipe = "recipes/4x-spark-cluster.env"
        recommended_mode = "max-prefill"
    elif topology == "2x-spark":
        recommended_recipe = "recipes/2x-spark-cluster.env"
        recommended_mode = "max-prefill"
    elif target_id == "nvidia_blackwell_sm120":
        recommended_recipe = "recipes/nvidia-blackwell-sm120.env"
        recommended_mode = "max-prefill"
    elif target_id == "nvidia_hopper_sm90":
        recommended_recipe = "recipes/nvidia-hopper-sm90.env"
        recommended_mode = "max-prefill"
    else:
        # 1x NVIDIA GB10 (DGX Spark)
        if avail_mib > 0 and avail_mib < 96000:
            recommended_recipe = "recipes/flux-v9-w4096-interactive.env"
            recommended_mode = "interactive-w4096"
        else:
            recommended_recipe = "recipes/flux-v9-max-prefill.env"
            recommended_mode = "max-prefill"

    return {
        "schema_version": "1.0.0",
        "sanitization_policy": "FLUX-SEC-0001",
        "host": {
            "hostname": "<HOSTNAME>",
            "user": "<USER>",
            "os": f"{platform.system()} {platform.release()}",
            "arch": arch,
        },
        "gpu": {
            "topology": topology,
            "target_id": target_id,
            "name": gpu_name,
            "device_count_local": gpu_count,
            "cluster_nodes": cluster_nodes or ["localhost"],
            "cluster_world_size": len(cluster_nodes) if cluster_nodes else gpu_count,
            "compute_capability": cc,
            "nvcc_arch": arch_flag,
            "driver_version": driver_ver,
        },
        "cpu": {
            "total_cores": cpu_count,
            "recommended_affinity": affinity,
            "pinning_command": f"taskset -c {affinity}",
        },
        "memory": {
            "total_mib": total_mib,
            "available_mib": avail_mib,
            "free_mib": free_mib,
            "page_cache_mib": cached_mib,
            "uma_floor_gate_mib": 5120,
            "uma_floor_status": "PASS" if avail_mib >= 5120 or avail_mib == 0 else "WARN_LOW_MEMORY",
        },
        "auto_selected_profile": {
            "mode": recommended_mode,
            "recipe": recommended_recipe,
            "engine_version": engine_version(),
            "default_kernel_target": "qwen3.8-flash-next",
        },
    }


