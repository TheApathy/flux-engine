# ==============================================================================
# Flux Engine Operating Recipe: flux-v9-max-prefill.env
# Mode Alias:  --mode max-prefill (w16384 / 16,384-token prefill chunks)
# Pair With:   recipes/flux-serve.argv
# Bridge:      source scripts/flux_env_bridge.sh --mode max-prefill
# ==============================================================================
# Certified Performance (NVIDIA Grace Blackwell GB10 / sm_121a, Qwen3.8-Flash-Next NVFP4):
#   - 8K   (8,192 tok):   5,830.2 tok/s peak | 5,819.3 tok/s median (TTFT  1.405s)
#   - 16K  (16,384 tok):  6,082.2 tok/s peak | 6,076.7 tok/s median (TTFT  2.694s)
#   - 32K  (32,768 tok):  5,969.6 tok/s peak | 5,952.6 tok/s median (TTFT  5.489s)
#   - 64K  (65,536 tok):  5,828.3 tok/s peak | 5,792.4 tok/s median (TTFT 11.244s)
#   - 128K (131,072 tok): 5,694.4 tok/s peak | 5,664.8 tok/s median (TTFT 23.018s)
#   - Decode (K=5 MTP):   57.4 tok/s peak    | 56.3 tok/s median (LOSSLESS 10/10 = 2,560/2,560 exact)
#   - Memory Safety:      7,757 - 8,450 MiB MemAvailable floor (>= 6,656 MiB watchdog bar)
#
# Architecture Notes:
#   Default production profile combining 16,384-token prefill chunking, v28q=2 +
#   v17q compact MoE, mHC t128 roof + gatepre, QSA qkpv_amax_pipe + ldmatrix.x4
#   score_v2, GDN conv_v3 + norm_fp8_v2, and 4-ring sector-aligned NVMe PLE DMA.
# ==============================================================================

# --- Flux Public Branded Selectors (translated by scripts/flux_env_bridge.sh) ---
FLUX_MODE=max-prefill
FLUX_QWEN4_PREFILL_WIDE=16384
FLUX_QWEN4_PREFILL_MOE_V28Q=2
FLUX_QWEN4_PREFILL_MHC_ROOF=t128
FLUX_QWEN4_PREFILL_QSA_FP8=qkpv
FLUX_QWEN4_PREFILL_QSA_PIPE=1
FLUX_QWEN4_PREFILL_GDN_CONV_V3=1
FLUX_QWEN4_PREFILL_GDN_NORM_FP8_V2=1
FLUX_PLE_READ_RINGS=4
FLUX_PLE_SECTOR_READ=1
FLUX_QWEN4_FAST_PROJ_FP8_WEIGHT_CACHE_RESERVE_GB=7

# --- Core Unified Prefill + K=5 Speculative Decode Engine Selectors ---
ATLAS_BOUNDED_HOST_COPY=1
