def _resolve_lil_root() -> Path:
    env_dir = os.environ.get("LIL_BENCH_DIR", "")
    if env_dir and Path(env_dir).is_dir():
        return Path(env_dir)
    for cand in (
        Path("/opt/flux/llm-inference-bench"),
        Path(__file__).resolve().parent / "llm-inference-bench",
        Path("/opt/flux/repro-kit/llm-inference-bench"),
    ):
        if (cand / "llm_decode_bench.py").is_file():
            return cand
    return Path(env_dir or "/opt/flux/llm-inference-bench")


def _resolve_out_path(path_s: str) -> Path:
    p = Path(path_s)
    try:
        p.parent.mkdir(parents=True, exist_ok=True)
        if os.access(p.parent, os.W_OK):
            return p
    except OSError:
        pass
    fallback = Path("/tmp/flux-results") / p.name
    fallback.parent.mkdir(parents=True, exist_ok=True)
    return fallback


