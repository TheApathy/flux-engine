def engine_version() -> str:
    """Return the version stamped into this image, or the stable fallback."""
    return os.environ.get("FLUX_ENGINE_VERSION", "").strip() or STABLE_ENGINE_VERSION


def get_opt_outs(argv: List[str]) -> Tuple[Dict[str, bool], List[str]]:
    # Privacy-First by Default: telemetry, host identifiers, and prompt logs are all opted-out/redacted by default
    env_raw = os.environ.get("FLUX_OPT_OUT", "all").lower()
    tokens = {t.strip() for t in env_raw.replace(";", ",").split(",") if t.strip()}
    none_out = ("none" in tokens) or ("0" in tokens) or ("false" in tokens)
    all_out = (not none_out) and (("all" in tokens) or ("1" in tokens) or ("true" in tokens) or not tokens)
    opts = {
        "telemetry": True,  # Always 100% air-gapped local execution
        "host": all_out or ("host" in tokens) or ("host-info" in tokens),
        "logs": all_out or ("logs" in tokens) or ("prompts" in tokens) or ("prompt-logs" in tokens),
    }
    if os.environ.get("FLUX_INCLUDE_HOST_INFO", "") == "1":
        opts["host"] = False
    if os.environ.get("FLUX_INCLUDE_PROMPT_LOGS", "") == "1":
        opts["logs"] = False
    cleaned: List[str] = []
    for arg in argv:
        if arg in ("--opt-out-telemetry", "--no-upload", "--offline"):
            opts["telemetry"] = True
        elif arg == "--opt-out-host-info":
            opts["host"] = True
        elif arg == "--opt-out-prompt-logs":
            opts["logs"] = True
        elif arg in ("--opt-out-all", "--privacy-first"):
            opts["telemetry"] = True
            opts["host"] = True
            opts["logs"] = True
        elif arg == "--include-host-info":
            opts["host"] = False
        elif arg == "--include-prompt-logs":
            opts["logs"] = False
        else:
            cleaned.append(arg)
    return opts, cleaned


def auto_detect_live_model(host: str, port: str) -> str:
    env_model = os.environ.get("FLUX_MODEL_ID", "")
    if env_model:
        return env_model
    try:
        url = f"http://{host}:{port}/v1/models"
        with urllib.request.urlopen(url, timeout=3.0) as resp:
            data = json.loads(resp.read().decode("utf-8", errors="replace"))
            models = data.get("data", [])
            if models and isinstance(models[0], dict) and models[0].get("id"):
                return str(models[0]["id"])
    except Exception:
        pass
    # No reachable /v1/models and no FLUX_MODEL_ID: let the server pick its single served
    # model instead of sending (and labelling cards with) an unrelated hardcoded id.
    return "default"


ACCURACY_MAX_TOKENS_CAP = 131072
ACCURACY_PROMPT_HEADROOM = 4096


def _server_context_len(host: str, port: str) -> Optional[int]:
    """Best-effort max context of the served model from /v1/models (max_model_len /
    context_length / max_seq_len), else FLUX_MAX_SEQ_LEN."""
    try:
        with urllib.request.urlopen(f"http://{host}:{port}/v1/models", timeout=3.0) as resp:
            data = json.loads(resp.read().decode("utf-8", errors="replace"))
        for m in data.get("data", []) or []:
            for key in ("max_model_len", "context_length", "max_seq_len", "max_context_length"):
                if isinstance(m, dict) and isinstance(m.get(key), int) and m[key] > 0:
                    return int(m[key])
    except Exception:
        pass
    env = os.environ.get("FLUX_MAX_SEQ_LEN", "")
    return int(env) if env.isdigit() and int(env) > 0 else None


def _accuracy_max_tokens(host: str, port: str) -> int:
    """Generation budget for accuracy suites: the server context minus prompt headroom,
    capped at ACCURACY_MAX_TOKENS_CAP, so requests are not rejected as too long."""
    ctx = _server_context_len(host, port)
    if ctx is None:
        return ACCURACY_MAX_TOKENS_CAP
    return max(1024, min(ACCURACY_MAX_TOKENS_CAP, ctx - ACCURACY_PROMPT_HEADROOM))


_LOG_TEXT_KEYS = (
    "output_excerpt",
    "content_preview",
    "content",
    "reasoning",
    "reasoning_content",
    "final_answer",
    "prompt",
    "question",
