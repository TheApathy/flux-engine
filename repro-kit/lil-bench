)
_SAFE_DIAG_ARG_KEYS = (
    "max_tokens",
    "kv_budget",
    "duration",
    "concurrency",
    "contexts",
    "token_targeting",
    "test_profile",
)


def _scrub_text_fields(obj: Any) -> Any:
    if isinstance(obj, dict):
        for k in _LOG_TEXT_KEYS:
            if k in obj and obj[k] is not None:
                obj[k] = "[REDACTED_BY_OPT_OUT_PROMPT_LOGS]"
    return obj


def sanitize_json_file(path: Path, opts: Dict[str, bool]) -> None:
    if not path.is_file():
        return
    if not (opts.get("host") or opts.get("logs")):
        return
    try:
        data = json.loads(path.read_text(encoding="utf-8", errors="replace"))
        if opts.get("host") and isinstance(data, dict):
            if "hardware" in data and isinstance(data["hardware"], dict):
                data["hardware"]["hostname"] = "REDACTED"
                data["hardware"]["driver_version"] = "REDACTED"
            if "system_info" in data and isinstance(data["system_info"], dict):
                data["system_info"] = {"redacted": True}
            if "startup_diagnostics" in data and isinstance(data["startup_diagnostics"], dict):
                raw_args = data["startup_diagnostics"].get("args")
                safe_args = (
                    {k: raw_args[k] for k in _SAFE_DIAG_ARG_KEYS if k in raw_args}
                    if isinstance(raw_args, dict)
                    else {}
                )
                data["startup_diagnostics"] = {"redacted": True, "args": safe_args}
            for host_key in ("hardware_run_summary", "p2pmark", "amd_fabric", "nvidia_p2p_override"):
                if host_key in data:
                    data[host_key] = {"redacted": True}
            if isinstance(data.get("metadata"), dict):
                if "server" in data["metadata"]:
                    data["metadata"]["server"] = "REDACTED"
                if data["metadata"].get("dataset_path"):
                    data["metadata"]["dataset_path"] = Path(str(data["metadata"]["dataset_path"])).name
            if isinstance(data.get("prefill"), dict):
                for cell in data["prefill"].values():
                    if isinstance(cell, dict) and "hardware_summary" in cell:
                        cell["hardware_summary"] = {"redacted": True}
        if opts.get("logs") and isinstance(data, dict):
            for key in ("raw_responses", "samples", "prompts", "completions"):
                if key in data:
                    data[key] = "[REDACTED_BY_OPT_OUT_PROMPT_LOGS]"
            if "estonia_profile" in data and isinstance(data["estonia_profile"], dict):
                if "response_text" in data["estonia_profile"]:
                    data["estonia_profile"]["response_text"] = "[REDACTED_BY_OPT_OUT_PROMPT_LOGS]"
            if isinstance(data.get("coding_peak"), dict):
                cp = data["coding_peak"]
                if "prompt" in cp:
                    cp["prompt"] = "[REDACTED_BY_OPT_OUT_PROMPT_LOGS]"
                if isinstance(cp.get("samples"), list):
                    for sample in cp["samples"]:
                        _scrub_text_fields(sample)
            if isinstance(data.get("runs"), list):
                for run_entry in data["runs"]:
                    _scrub_text_fields(run_entry)
            if isinstance(data.get("wrong_runs"), list):
                scrubbed_wrong = []
                for item in data["wrong_runs"]:
                    if isinstance(item, dict):
                        scrubbed_wrong.append(_scrub_text_fields(item))
                    else:
                        scrubbed_wrong.append("[REDACTED_BY_OPT_OUT_PROMPT_LOGS]")
                data["wrong_runs"] = scrubbed_wrong
            if isinstance(data.get("prefill_scout"), dict):
                _scrub_text_fields(data["prefill_scout"])
        path.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
    except Exception:
        pass


