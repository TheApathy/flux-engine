def _normalize_run(d: Dict[str, Any]) -> Dict[str, Any]:
    """Map llm-inference-bench v0.7.x JSON (metadata / prefill{ctx} / results[].aggregate_tps)
    onto the legacy keys the card renderer reads. Keys already present are left untouched."""
    meta = d.get("metadata") if isinstance(d.get("metadata"), dict) else {}
    diag = d.get("startup_diagnostics") if isinstance(d.get("startup_diagnostics"), dict) else {}
    args = diag.get("args") if isinstance(diag.get("args"), dict) else {}
    for key, src in (("model", meta.get("model")), ("benchmark_version", meta.get("version")),
                     ("timestamp", meta.get("timestamp")), ("duration_s", meta.get("duration_per_test") or args.get("duration")),
                     ("max_tokens", args.get("max_tokens")), ("kv_budget", args.get("kv_budget"))):
        if d.get(key) is None and src is not None:
            d[key] = src
    if "prefill_Load_Sweep" not in d and isinstance(d.get("prefill"), dict):
        rows = []
        for ctx, v in d["prefill"].items():
            if not isinstance(v, dict):
                continue
            try:
                c = int(ctx)
            except (TypeError, ValueError):
                continue
            rows.append({"target_context": c, "actual_prompt_tokens": v.get("prompt_tokens", c),
                         "prefill_tok_s": v.get("tok_per_sec"), "ttft_s": v.get("ttft_seconds"),
                         "cold_ttft_s": v.get("cold_ttft_seconds")})
        d["prefill_Load_Sweep"] = rows
    if d.get("decode_prompt_mode") is None:
        # Benches without the distinct-prompt patch sent one prompt to every stream.
        multi = any(isinstance(r, dict) and int(r.get("concurrency", 1) or 1) > 1 for r in d.get("results", []) or [])
        d["decode_prompt_mode"] = meta.get("decode_prompt_mode") or ("shared" if multi else None)
    for row in d.get("results", []) or []:
        if not isinstance(row, dict) or "context" in row or "context_tokens" not in row:
            continue
        row["context"] = row["context_tokens"]
        tps = row.get("aggregate_tps")
        failed = bool(row.get("failure_reason")) or (isinstance(tps, (int, float)) and tps < 0)
        row["throughput_tok_s"] = None if failed or tps is None else tps
        row.setdefault("avg_latency_s", row.get("ttft_avg"))
        row.setdefault("prompt_tokens", row.get("input_seq_len_avg"))
        row["cell_status"] = (row.get("failure_reason") or "failed") if failed else "ok"
    if "hardware" not in d:
        smi = (diag.get("nvidia_smi_query") or {}).get("stdout", "") if isinstance(diag.get("nvidia_smi_query"), dict) else ""
        parts = [x.strip() for x in str(smi).splitlines()[0].split(",")] if smi else []
        if len(parts) >= 3:
            d["hardware"] = {"gpus": [{"name": parts[1]}], "driver_version": parts[2]}
    return d


def _load_runs(paths: List[Path]) -> List[Dict[str, Any]]:
    runs = []
    for p in paths:
        if p.is_file():
            try:
                runs.append(_normalize_run(json.loads(p.read_text(encoding="utf-8", errors="replace"))))
            except Exception:
                pass
    return runs


def _aggregate_prefill(runs: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    by_ctx: Dict[int, List[Dict[str, Any]]] = {}
    for r in runs:
        for row in r.get("prefill_Load_Sweep", []) or []:
            c = int(row.get("target_context", 0))
            by_ctx.setdefault(c, []).append(row)
    out = []
    for c in sorted(by_ctx):
        rows = by_ctx[c]
        vals = [x["prefill_tok_s"] for x in rows if x.get("prefill_tok_s") is not None]
        ttfts = [x["ttft_s"] for x in rows if x.get("ttft_s") is not None]
        colds = [x["cold_ttft_s"] for x in rows if x.get("cold_ttft_s") is not None]
        if not vals:
            continue
        mean = sum(vals) / len(vals)
        sd = (sum((v - mean) ** 2 for v in vals) / max(1, len(vals) - 1)) ** 0.5 if len(vals) > 1 else 0.0
        out.append({
            "context": c,
            "actual_prompt_tokens": rows[0].get("actual_prompt_tokens", c),
            "mean_tok_s": mean,
            "sd_tok_s": sd,
            "min_tok_s": min(vals),
            "max_tok_s": max(vals),
            "mean_ttft_s": sum(ttfts) / len(ttfts) if ttfts else None,
            "mean_cold_ttft_s": sum(colds) / len(colds) if colds else None,
            "n": len(vals),
        })
    return out


def _aggregate_decode(runs: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    by_cell: Dict[Tuple[int, int], List[Dict[str, Any]]] = {}
    for r in runs:
        for row in r.get("results", []) or []:
            key = (int(row.get("concurrency", 1)), int(row.get("context", 0)))
            by_cell.setdefault(key, []).append(row)
    out = []
    for (conc, ctx) in sorted(by_cell):
        rows = by_cell[(conc, ctx)]
        vals = [x["throughput_tok_s"] for x in rows if x.get("throughput_tok_s") is not None]
        lat = [x["avg_latency_s"] for x in rows if x.get("avg_latency_s") is not None]
        prompts = [x["prompt_tokens"] for x in rows if x.get("prompt_tokens") is not None]
        status = rows[0].get("cell_status", "ok")
        if not vals:
            out.append({
                "concurrency": conc,
                "context": ctx,
                "mean_tok_s": None,
                "sd_tok_s": None,
                "mean_lat_s": None,
                "prompt_tokens": prompts[0] if prompts else ctx,
                "status": status,
                "n": len(rows),
            })
            continue
        mean = sum(vals) / len(vals)
        sd = (sum((v - mean) ** 2 for v in vals) / max(1, len(vals) - 1)) ** 0.5 if len(vals) > 1 else 0.0
        out.append({
            "concurrency": conc,
            "context": ctx,
            "mean_tok_s": mean,
            "sd_tok_s": sd,
            "min_tok_s": min(vals),
            "max_tok_s": max(vals),
            "mean_lat_s": sum(lat) / len(lat) if lat else None,
            "prompt_tokens": prompts[0] if prompts else ctx,
            "status": status,
            "n": len(vals),
        })
    return out


def _fmt_ctx(c: int) -> str:
    if c == 0:
        return "0"
    if c >= 1024 and c % 1024 == 0:
        return f"{c // 1024}k"
    if c >= 1000 and c % 1000 == 0:
        return f"{c // 1000}k"
    return str(c)


def _heat_color(val: Optional[float], vmin: float, vmax: float) -> str:
    if val is None or math.isnan(val):
        return "#1f2430"
    if vmax <= vmin:
        t = 0.5
    else:
        t = max(0.0, min(1.0, (val - vmin) / (vmax - vmin)))
    stops = [
        (0.0, (0x1E, 0x3A, 0x5F)),
        (0.5, (0x0E, 0x74, 0x90)),
        (1.0, (0x10, 0xB9, 0x81)),
    ]
    for i in range(len(stops) - 1):
        t0, c0 = stops[i]
        t1, c1 = stops[i + 1]
        if t0 <= t <= t1:
            u = (t - t0) / (t1 - t0) if t1 > t0 else 0.0
            r = int(c0[0] + u * (c1[0] - c0[0]))
            g = int(c0[1] + u * (c1[1] - c0[1]))
            b = int(c0[2] + u * (c1[2] - c0[2]))
            return f"#{r:02x}{g:02x}{b:02x}"
    return "#10b981"


def generate_cards(out_prefix: Path, json_paths: List[Path], opts: Dict[str, bool], title_override: str = "") -> Dict[str, str]:
    runs = _load_runs(json_paths)
    if not runs:
        print("[lil-bench] No valid JSON files found to generate card.", file=sys.stderr)
        return {}

    built_version = engine_version()
    prefill = _aggregate_prefill(runs)
    decode = _aggregate_decode(runs)
    r0 = runs[0]
    model = title_override or r0.get("model") or os.environ.get("FLUX_MODEL_ID") or "unknown model"
    bench_ver = r0.get("benchmark_version", "0.7.9")
    hw = r0.get("hardware", {}) or {}
    gpus = hw.get("gpus") or [{}]
    gpu_name = "REDACTED-GPU" if opts.get("host") else gpus[0].get("name", "NVIDIA GB10")
    gpu_mem_mb = gpus[0].get("memory_total_mb", 122880)
    driver = "REDACTED" if opts.get("host") else hw.get("driver_version", "580.126.09")
    kv_budget = r0.get("kv_budget")
    token_Scroll = r0.get("token_targeting", "exact")
    duration = r0.get("duration_s", 30)
    max_tokens = r0.get("max_tokens", 2048)
    prompt_modes = sorted({str(r.get("decode_prompt_mode")) for r in runs if r.get("decode_prompt_mode")})
    prompt_mode = ",".join(prompt_modes) or "n/a"
    ts = r0.get("timestamp", dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"))

    coding_peaks: List[float] = []
    for r in runs:
        cp = r.get("coding_peak")
        if not isinstance(cp, dict):
            continue
        summary = cp.get("summary") if isinstance(cp.get("summary"), dict) else {}
        peak = summary.get("max_generation_tok_s")
        if not isinstance(peak, (int, float)) or peak <= 0:
            peak = cp.get("peak_tok_s")
        if isinstance(peak, (int, float)) and peak > 0:
            coding_peaks.append(float(peak))
    estonia_runs = []
    for r in runs:
        meta = r.get("metadata") if isinstance(r.get("metadata"), dict) else {}
        if (
            r.get("estonia_profile")
            or r.get("estonia")
            or r.get("test_profile") == "estonia"
            or meta.get("test_profile") == "estonia"
        ):
            estonia_runs.append(r.get("estonia_profile") or r.get("estonia") or r)

    concs = sorted({d["concurrency"] for d in decode}) if decode else [1]
    ctxs = sorted({d["context"] for d in decode}) if decode else [0]
    cell_map = {(d["concurrency"], d["context"]): d for d in decode}

    W = 1280
    prefill_rows_h = max(1, len(prefill)) * 34 + 60
    matrix_rows_h = max(1, len(concs)) * 48 + 80
    H = 260 + prefill_rows_h + matrix_rows_h + 150

    pf_vals = [p["mean_tok_s"] for p in prefill] or [0, 1]
    pf_min, pf_max = min(pf_vals), max(pf_vals)
    dc_vals = [d["mean_tok_s"] for d in decode if d["mean_tok_s"] is not None] or [0, 1]
    dc_min, dc_max = min(dc_vals), max(dc_vals)

    peak_pf = max(pf_vals) if prefill else 0.0
    peak_pf_ctx = next((p["context"] for p in prefill if p["mean_tok_s"] == peak_pf), 0)
    peak_dc = max(dc_vals) if dc_vals else 0.0
    peak_dc_cell = next(
        ((d["concurrency"], d["context"]) for d in decode if d["mean_tok_s"] == peak_dc),
        (1, 0),
    )

    lines: List[str] = []
    lines.append(f'<svg xmlns="http://www.w3.org/2000/svg" width="{W}" height="{H}" viewBox="0 0 {W} {H}">')
    lines.append("""<defs>
      <style>
        .bg { fill: #0b0f17; }
        .panel { fill: #121826; stroke: #1f2937; stroke-width: 1; }
        .title { font: 700 22px 'DejaVu Sans', 'Inter', sans-serif; fill: #f9fafb; }
        .sub { font: 400 13px 'DejaVu Sans', 'Inter', sans-serif; fill: #9ca3af; }
        .kpi-label { font: 600 11px 'DejaVu Sans', sans-serif; fill: #9ca3af; letter-spacing: 0.8px; }
        .kpi-val { font: 700 24px 'DejaVu Sans Mono', monospace; fill: #10b981; }
        .kpi-sub { font: 400 11px 'DejaVu Sans', sans-serif; fill: #6b7280; }
        .sec { font: 700 14px 'DejaVu Sans', sans-serif; fill: #e5e7eb; letter-spacing: 0.6px; }
        .th { font: 600 12px 'DejaVu Sans', sans-serif; fill: #9ca3af; }
        .td { font: 600 13px 'DejaVu Sans Mono', monospace; fill: #f3f4f6; }
        .td-sub { font: 400 10px 'DejaVu Sans Mono', monospace; fill: #cbd5e1; }
        .foot { font: 400 11px 'DejaVu Sans Mono', monospace; fill: #6b7280; }
      </style>
    </defs>""")
    lines.append(f'<rect class="bg" x="0" y="0" width="{W}" height="{H}" rx="14"/>')
    lines.append(f'<rect class="panel" x="24" y="20" width="{W-48}" height="104" rx="10"/>')
    lines.append(f'<text class="title" x="44" y="54">{html.escape(str(model))}</text>')
    lines.append(
        f'<text class="sub" x="44" y="78">Flux Engine v{html.escape(built_version)}  ·  llm-inference-bench v{html.escape(str(bench_ver))}  ·  '
        f'{html.escape(str(gpu_name))} ({gpu_mem_mb // 1024} GB, driver {html.escape(str(driver))})  ·  n={len(runs)} rep(s)</text>'
    )
    mode_label = os.environ.get("FLUX_MODE", "auto")
    lines.append(
        f'<text class="sub" x="44" y="100">FLUX_MODE={html.escape(mode_label)}  ·  token-targeting={html.escape(str(token_Scroll))}  ·  '
        f'kv-budget={kv_budget}  ·  duration={duration}s/cell  ·  max-tokens={max_tokens}  ·  '
        f'prompts={html.escape(prompt_mode)}</text>'
    )

    kpi_w = 270
    kpi_x0 = W - 44 - kpi_w * 2 - 14
    lines.append(f'<rect x="{kpi_x0}" y="32" width="{kpi_w}" height="80" rx="8" fill="#0f172a" stroke="#1e293b"/>')
    lines.append(f'<text class="kpi-label" x="{kpi_x0+16}" y="52">PEAK PREFILL</text>')
    if prefill:
        lines.append(f'<text class="kpi-val" x="{kpi_x0+16}" y="82">{peak_pf:,.1f} tok/s</text>')
        lines.append(f'<text class="kpi-sub" x="{kpi_x0+16}" y="100">@ {_fmt_ctx(peak_pf_ctx)} context</text>')
    else:
        lines.append(f'<text class="kpi-val" x="{kpi_x0+16}" y="82">n/a</text>')
        lines.append(f'<text class="kpi-sub" x="{kpi_x0+16}" y="100">no prefill cells in this run</text>')

    kpi_x1 = kpi_x0 + kpi_w + 14
    lines.append(f'<rect x="{kpi_x1}" y="32" width="{kpi_w}" height="80" rx="8" fill="#0f172a" stroke="#1e293b"/>')
    lines.append(f'<text class="kpi-label" x="{kpi_x1+16}" y="52">PEAK DECODE</text>')
    lines.append(f'<text class="kpi-val" x="{kpi_x1+16}" y="82">{peak_dc:,.1f} tok/s</text>')
    lines.append(f'<text class="kpi-sub" x="{kpi_x1+16}" y="100">@ C={peak_dc_cell[0]}, ctx={_fmt_ctx(peak_dc_cell[1])}</text>')

    # Prefill Section
    pf_y = 140
    lines.append(f'<rect class="panel" x="24" y="{pf_y}" width="{W-48}" height="{prefill_rows_h}" rx="10"/>')
    lines.append(f'<text class="sec" x="44" y="{pf_y+28}">PREFILL THROUGHPUT SWEEP (PROMPT PROCESSING)</text>')
    lines.append(f'<text class="th" x="44" y="{pf_y+50}">CONTEXT</text>')
    lines.append(f'<text class="th" x="150" y="{pf_y+50}">PROMPT TOK</text>')
    lines.append(f'<text class="th" x="290" y="{pf_y+50}">PREFILL TOK/S (MEAN ± SD)</text>')
    lines.append(f'<text class="th" x="540" y="{pf_y+50}">TTFT (s)</text>')

    bar_x0 = 650
    bar_max_w = W - 48 - bar_x0 - 30
    for idx, p in enumerate(prefill):
        ry = pf_y + 74 + idx * 32
        col = _heat_color(p["mean_tok_s"], pf_min, pf_max)
        bw = int(bar_max_w * (p["mean_tok_s"] / peak_pf)) if peak_pf > 0 else 0
        lines.append(f'<text class="td" x="44" y="{ry}">{_fmt_ctx(p["context"])}</text>')
        lines.append(f'<text class="td-sub" x="150" y="{ry}">{p["actual_prompt_tokens"]:,}</text>')
        sd_str = f' ± {p["sd_tok_s"]:.1f}' if p["n"] > 1 else ""
        lines.append(f'<text class="td" x="290" y="{ry}">{p["mean_tok_s"]:,.1f}{sd_str}</text>')
        ttft_str = f'{p["mean_ttft_s"]:.2f}s' if p["mean_ttft_s"] is not None else "—"
        lines.append(f'<text class="td-sub" x="540" y="{ry}">{ttft_str}</text>')
        lines.append(f'<rect x="{bar_x0}" y="{ry-14}" width="{max(4, bw)}" height="18" rx="4" fill="{col}"/>')

    # Decode Section
    mx_y = pf_y + prefill_rows_h + 16
    lines.append(f'<rect class="panel" x="24" y="{mx_y}" width="{W-48}" height="{matrix_rows_h}" rx="10"/>')
    lines.append(f'<text class="sec" x="44" y="{mx_y+28}">DECODE THROUGHPUT MATRIX — AGGREGATE TOK/S (CONCURRENCY × CONTEXT DEPTH)</text>')

    grid_x0 = 140
    avail_w = W - 48 - grid_x0 - 30
    cell_w = max(90, avail_w // max(1, len(ctxs)))
    cell_h = 42

    for j, c in enumerate(ctxs):
        cx = grid_x0 + j * cell_w + cell_w // 2
        lines.append(f'<text class="th" x="{cx}" y="{mx_y+56}" text-anchor="middle">ctx {_fmt_ctx(c)}</text>')

    for i, conc in enumerate(concs):
        ry = mx_y + 68 + i * (cell_h + 6)
        lines.append(f'<text class="th" x="44" y="{ry + 26}">C = {conc}</text>')
        for j, c in enumerate(ctxs):
            cx = grid_x0 + j * cell_w
            cell = cell_map.get((conc, c))
            val = cell["mean_tok_s"] if cell else None
            col = _heat_color(val, dc_min, dc_max)
            lines.append(f'<rect x="{cx}" y="{ry}" width="{cell_w-8}" height="{cell_h}" rx="6" fill="{col}" stroke="#1f2937"/>')
            if val is not None:
                sd_s = f"±{cell['sd_tok_s']:.1f}" if cell and cell["n"] > 1 else ""
                lines.append(f'<text class="td" x="{cx + (cell_w-8)//2}" y="{ry+20}" text-anchor="middle">{val:,.1f}</text>')
                sub_txt = sd_s if sd_s else (f"{cell['mean_lat_s']:.1f}s" if cell.get("mean_lat_s") else "tok/s")
                lines.append(f'<text class="td-sub" x="{cx + (cell_w-8)//2}" y="{ry+34}" text-anchor="middle">{sub_txt}</text>')
            else:
                st = (cell.get("status") if cell else "n/a") or "skip"
                lines.append(f'<text class="td-sub" x="{cx + (cell_w-8)//2}" y="{ry+25}" text-anchor="middle">{html.escape(str(st)[:14])}</text>')

    foot_y = mx_y + matrix_rows_h + 28
    lines.append(
        f'<text class="foot" x="44" y="{foot_y}">Generated by Flux Engine lil-bench ({ts})  ·  '
        f'100% Local Execution (Zero External Telemetry)</text>'
    )
    lines.append("</svg>")

    out_prefix.parent.mkdir(parents=True, exist_ok=True)
    svg_path = out_prefix.with_suffix(".svg")
    png_path = out_prefix.with_suffix(".png")
    md_path = out_prefix.parent / "MODEL_CARD.md"
    summary_path = out_prefix.parent / "summary.md"

    svg_path.write_text("\n".join(lines), encoding="utf-8")
    rendered_png = False
    if shutil.which("rsvg-convert"):
        try:
            subprocess.run(["rsvg-convert", "-o", str(png_path), str(svg_path)], check=True)
            rendered_png = True
        except Exception:
            pass

    # Write comprehensive Markdown Model Card
    md: List[str] = [
        f"# Flux Engine Model Card — `{model}`",
        "",
        "## 1. Runtime & Hardware Configuration",
        "",
        "| Field | Value |",
        "| :--- | :--- |",
        f"| **Engine Version** | `flux-engine v{built_version}` |",
        f"| **Model** | `{model}` |",
        f"| **Execution Mode (`FLUX_MODE`)** | `{mode_label}` |",
        f"| **Benchmark Suite** | `local-inference-lab/llm-inference-bench v{bench_ver}` (`n={len(runs)}` run(s)) |",
        f"| **Hardware** | `{gpu_name}` (`{gpu_mem_mb // 1024} GB`, driver `{driver}`) |",
        f"| **KV Budget / Token Targeting** | `kv_budget={kv_budget}`, `token_targeting={token_Scroll}` |",
        f"| **Decode Prompts (C>1)** | `{prompt_mode}` |",
        f"| **Timestamp (UTC)** | `{ts}` |",
        "",
    ]

    if prefill:
        md.extend([
            "## 2. Prefill Throughput Sweep",
            "",
            "| Target Context | Actual Prompt Tokens | Mean Prefill (tok/s) | SD (tok/s) | Min / Max (tok/s) | Mean TTFT (s) | Cold TTFT (s) |",
            "| ---: | ---: | ---: | ---: | ---: | ---: | ---: |",
        ])
        for p in prefill:
            ttft_s = f"{p['mean_ttft_s']:.2f}" if p["mean_ttft_s"] is not None else "—"
            cold_s = f"{p['mean_cold_ttft_s']:.2f}" if p.get("mean_cold_ttft_s") is not None else "—"
            md.append(
                f"| {_fmt_ctx(p['context'])} | {p['actual_prompt_tokens']:,} | **{p['mean_tok_s']:,.2f}** | "
                f"{p['sd_tok_s']:.2f} | {p['min_tok_s']:,.1f} / {p['max_tok_s']:,.1f} | {ttft_s} | {cold_s} |"
            )
        md.append("")

    if decode:
        md.extend([
            "## 3. Decode Throughput Matrix (Aggregate tok/s)",
            "",
            "| Concurrency | " + " | ".join(_fmt_ctx(c) for c in ctxs) + " |",
            "| ---: | " + " | ".join("---:" for _ in ctxs) + " |",
        ])
        for conc in concs:
            row_cells = []
            for c in ctxs:
                cell = cell_map.get((conc, c))
                if cell and cell["mean_tok_s"] is not None:
                    if conc > 1:
                        per_stream = cell["mean_tok_s"] / conc
                        row_cells.append(f"**{cell['mean_tok_s']:,.2f}** ({per_stream:,.1f}/s)")
                    else:
                        row_cells.append(f"**{cell['mean_tok_s']:,.2f}** ± {cell['sd_tok_s']:.2f}")
                else:
                    row_cells.append(f"_{cell.get('status', 'n/a') if cell else 'n/a'}_")
            md.append(f"| **C={conc}** | " + " | ".join(row_cells) + " |")
        md.append("")

    if coding_peaks:
        md.extend([
            "## 4. Coding Peak Throughput",
            "",
            f"- **Peak Single-Stream Coding Decode**: **{max(coding_peaks):,.2f} tok/s** (mean across runs: `{sum(coding_peaks)/len(coding_peaks):,.2f} tok/s`)",
            "",
        ])

    if estonia_runs:
        md.extend([
            "## 5. Estonia 136.6K Long-Context Needle & Coherent Synthesis",
            "",
            "- **Profile**: `--test-profile estonia` (~105,650 words / ~136,645 prompt tokens)",
            f"- **Recorded Runs**: `{len(estonia_runs)}`",
            "",
        ])

    md.extend([
        "## 6. Visual Benchmark Cards",
        "",
        f"- **SVG Card**: `{svg_path.name}`",
        f"- **PNG Card**: `{png_path.name if rendered_png else '(install librsvg2-bin for PNG)'}`",
        "",
    ])

    md_text = "\n".join(md) + "\n"
    md_path.write_text(md_text, encoding="utf-8")
    summary_path.write_text(md_text, encoding="utf-8")

    result = {"svg": str(svg_path), "markdown": str(md_path), "summary": str(summary_path)}
    if rendered_png:
        result["png"] = str(png_path)
    return result


