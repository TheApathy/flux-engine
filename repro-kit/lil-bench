def extract_flag(args: List[str], flag: str, default: Optional[str] = None) -> Tuple[Optional[str], List[str]]:
    out: List[str] = []
    val = default
    i = 0
    while i < len(args):
        if args[i] == flag and i + 1 < len(args):
            val = args[i + 1]
            i += 2
        elif args[i].startswith(flag + "="):
            val = args[i].split("=", 1)[1]
            i += 1
        else:
            out.append(args[i])
            i += 1
    return val, out


def extract_bool_flag(args: List[str], flag: str) -> Tuple[bool, List[str]]:
    found = False
    out: List[str] = []
    for a in args:
        if a == flag:
            found = True
        else:
            out.append(a)
    return found, out


def run_lil_cmd(cmd: List[str], out_json: Optional[Path], opts: Dict[str, bool]) -> int:
    print(f"[lil-bench] Executing: {' '.join(cmd)}", flush=True)
    environment = os.environ.copy()
    environment["LLM_BENCH_NO_UPDATE_CHECK"] = "1"
    proc = subprocess.run(cmd, env=environment)
    if out_json and out_json.is_file():
        sanitize_json_file(out_json, opts)
    return proc.returncode


def main() -> int:
    opts, args = get_opt_outs(sys.argv[1:])
    if not args or args[0] in ("-h", "--help", "help"):
        print_help()
        if args and args[0] in ("-h", "--help"):
            print("\n--- Underlying llm_decode_bench.py options ---")
            subprocess.run([sys.executable, str(LIL_SCRIPT), "--help"])
        return 0

    host = os.environ.get("FLUX_BENCH_HOST", "127.0.0.1")
    port = os.environ.get("FLUX_PORT", "8899")
    host, args = extract_flag(args, "--host", host)
    port, args = extract_flag(args, "--port", port)
    model_arg, args = extract_flag(args, "--model", None)
    model = model_arg or auto_detect_live_model(host, port)
    kv_budget_default = os.environ.get("FLUX_MAX_SEQ_LEN", "131072")

    sub = args[0]
    rest = args[1:]

    if sub == "card":
        if not rest:
            json_files = sorted(Path("/results").glob("*.json"))
            out_prefix = Path("/results/card")
        else:
            first = Path(rest[0])
            if first.suffix == ".json":
                out_prefix = first.parent / "card"
                json_files = [Path(p) for p in rest]
            else:
                out_prefix = first
                json_files = [Path(p) for p in rest[1:]] if len(rest) > 1 else sorted(first.parent.glob("*.json"))
        json_files = [p for p in json_files if p.is_file() and p.name not in ("environment.json", "flux-diagnostics.json")]
        cards = generate_cards(out_prefix, json_files, opts)
        print(json.dumps({"status": "ok", "cards": cards}, indent=2))
        return 0

    if sub == "matrix":
        conc, rest = extract_flag(rest, "--concurrency", "1")
        ctxs, rest = extract_flag(rest, "--contexts", "0,8k,16k,32k,64k,128k")
        reps_s, rest = extract_flag(rest, "--reps", "1")
        dur, rest = extract_flag(rest, "--duration", "30")
        max_tok, rest = extract_flag(rest, "--max-tokens", "2048")
        kv_b, rest = extract_flag(rest, "--kv-budget", kv_budget_default)
        out_path_s, rest = extract_flag(rest, "--output", "/results/repetition-1.json")
        no_card, rest = extract_bool_flag(rest, "--no-card")
        reps = max(1, int(reps_s or "1"))
        produced: List[Path] = []
        rc = 0
        for r in range(1, reps + 1):
            raw_out = str(Path(out_path_s) if reps == 1 else Path(out_path_s).parent / f"repetition-{r}.json")
            out_p = _resolve_out_path(raw_out)
            cmd = [
                sys.executable, str(LIL_SCRIPT),
                "--host", str(host), "--port", str(port),
                "--model", str(model),
                "--dcp-size", "1",
                "--temperature", "0",
                "--request-seed", "20261011",
                "--token-targeting", "exact",
                "--display-mode", "plain",
                "--no-hw-monitor",
                "--concurrency", str(conc),
                "--contexts", str(ctxs),
                "--max-tokens", str(max_tok),
                "--duration", str(dur),
                "--decode-warmup-seconds", "5",
                "--cell-warmup-timeout-seconds", "900",
                "--no-resume",
                "--output", str(out_p),
            ]
            max_c = max(int(x) for x in str(conc).split(",") if x.strip().isdigit()) if conc else 1
            if max_c == 1 and kv_b:
                cmd.extend(["--kv-budget", str(kv_b)])
            else:
                cmd.append("--show-capacity-limited-values")
            cmd.extend(rest)
            step_rc = run_lil_cmd(cmd, out_p, opts)
            rc = rc or step_rc
            if out_p.is_file():
                produced.append(out_p)
        if produced and not no_card:
            cards = generate_cards(produced[0].parent / "card", produced, opts, title_override=model)
            print(f"[lil-bench] Generated Model Card & Visual Cards: {json.dumps(cards)}")
        return rc

    if sub in ("concurrency", "sweep"):
        # Support `lil-bench concurrency 1,2,4,8` or `lil-bench concurrency --concurrency 1,2,4,8`
        conc_default = "1,2,4,8"
        if rest and not rest[0].startswith("-"):
            conc_default = rest[0]
            rest = rest[1:]
        conc, rest = extract_flag(rest, "--concurrency", conc_default)
        ctxs, rest = extract_flag(rest, "--contexts", "0,8k,32k")
        dur, rest = extract_flag(rest, "--duration", "30")
        max_tok, rest = extract_flag(rest, "--max-tokens", "2048")
        decode_only, rest = extract_bool_flag(rest, "--decode-only")
        no_card, rest = extract_bool_flag(rest, "--no-card")
        out_path_s, rest = extract_flag(rest, "--output", "/results/concurrency-sweep.json")
        out_p = _resolve_out_path(out_path_s)
        cmd = [
            sys.executable, str(LIL_SCRIPT),
            "--host", str(host), "--port", str(port),
            "--model", str(model),
            "--dcp-size", "1",
            "--temperature", "0",
            "--request-seed", "20261011",
            "--token-targeting", "exact",
            "--display-mode", "plain",
            "--no-hw-monitor",
            "--concurrency", str(conc),
            "--contexts", str(ctxs),
            "--max-tokens", str(max_tok),
            "--duration", str(dur),
            "--decode-warmup-seconds", "5",
            # Distinct per-stream prompts prefill C prompts in the cell warmup.
            "--cell-warmup-timeout-seconds", "120",
            "--show-capacity-limited-values",
            "--no-resume",
            "--output", str(out_p),
        ]
        if decode_only:
            cmd.append("--skip-prefill")
        cmd.extend(rest)
        rc = run_lil_cmd(cmd, out_p, opts)
        if out_p.is_file() and not no_card:
            cards = generate_cards(out_p.parent / "concurrency-card", [out_p], opts, title_override=f"{model} (Concurrency {conc})")
            print(f"[lil-bench] Generated Concurrency Card: {json.dumps(cards)}")
        return rc

    if sub == "estonia":
        conc, rest = extract_flag(rest, "--concurrency", "1")
        stall, rest = extract_flag(rest, "--stall-timeout", "600")
        out_path_s, rest = extract_flag(rest, "--output", "/results/estonia-results.json")
        out_p = _resolve_out_path(out_path_s)
        cmd = [
            sys.executable, str(LIL_SCRIPT),
            "--host", str(host), "--port", str(port),
            "--model", str(model),
            "--test-profile", "estonia",
            "--concurrency", str(conc),
            "--completion-stats-stall-timeout", str(stall),
            "--display-mode", "plain",
            "--no-hw-monitor",
            "--no-resume",
            "--output", str(out_p),
        ]
        cmd.extend(rest)
        return run_lil_cmd(cmd, out_p, opts)

    if sub == "coding":
        runs_n, rest = extract_flag(rest, "--runs", "5")
        out_path_s, rest = extract_flag(rest, "--output", "/results/coding-peak.json")
        out_p = _resolve_out_path(out_path_s)
        cmd = [
            sys.executable, str(LIL_SCRIPT),
            "--host", str(host), "--port", str(port),
            "--model", str(model),
            "--no-hw-monitor",
            "--display-mode", "plain",
            "--no-resume",
            "--skip-prefill",
            "--contexts", "0",
            "--concurrency", "1",
            "--duration", "15",
            "--max-tokens", "2048",
            "--coding-peak",
            "--coding-peak-runs", str(runs_n),
            "--coding-peak-max-tokens", "2000",
            "--temperature", "0",
            "--coding-peak-temperature", "0",
            "--request-seed", "20261011",
            "--output", str(out_p),
        ]
        cmd.extend(rest)
        return run_lil_cmd(cmd, out_p, opts)

    if sub == "prefill":
        pf_ctxs, rest = extract_flag(rest, "--prefill-contexts", "8k,16k,32k,64k,128k")
        out_path_s, rest = extract_flag(rest, "--output", "/results/prefill-sweep.json")
        out_p = _resolve_out_path(out_path_s)
        cmd = [
            sys.executable, str(LIL_SCRIPT),
            "--host", str(host), "--port", str(port),
            "--model", str(model),
            "--prefill-only",
            "--prefill-contexts", str(pf_ctxs),
            "--token-targeting", "exact",
            "--request-seed", "20261011",
            "--display-mode", "plain",
            "--no-hw-monitor",
            "--no-resume",
            "--output", str(out_p),
        ]
        cmd.extend(rest)
        return run_lil_cmd(cmd, out_p, opts)

    if sub == "accuracy":
        suite = "all"
        if rest and not rest[0].startswith("-"):
            suite = rest[0]
            rest = rest[1:]
        conc, rest = extract_flag(rest, "--concurrency", "1")
        aliases = {
            "gsm-8k": "gsm8k",
            "gsm8k": "gsm8k",
            "mmlupro": "mmlu-pro",
            "mmlu-pro": "mmlu-pro",
            "mmlu-pro-1000": "mmlu-pro",
            "gpqa": "gpqa-diamond",
            "gpqa-diamond": "gpqa-diamond",
        }
        if suite == "all":
            profiles = ["gsm8k", "mmlu-pro", "gpqa-diamond"]
            offline = (
                os.environ.get("HF_HUB_OFFLINE", "").strip().lower() in ("1", "true", "yes")
                or os.environ.get("TRANSFORMERS_OFFLINE", "").strip().lower() in ("1", "true", "yes")
            )
            gpqa_local = LIL_ROOT / "data" / "gpqa_diamond.jsonl"
            gpqa_cache = Path.home() / ".cache" / "llm_decode_bench" / "datasets" / "gpqa_diamond.jsonl"
            if offline and not gpqa_local.is_file() and not gpqa_cache.is_file():
                profiles = ["gsm8k", "mmlu-pro"]
                print(
                    "[lil-bench] NOTE: Skipping gpqa-diamond in offline mode (HF_HUB_OFFLINE=1) "
                    "because gpqa_diamond.jsonl is not locally cached. Place gpqa_diamond.jsonl under "
                    f"{gpqa_local.parent} or {gpqa_cache.parent}, or run 'lil-bench accuracy gpqa-diamond' online.",
                    file=sys.stderr,
                )
        elif suite in aliases:
            profiles = [aliases[suite]]
        else:
            print(f"[lil-bench] ERROR: unknown accuracy profile {suite!r}", file=sys.stderr)
            return 2
        out_path_s, rest = extract_flag(rest, "--output", f"/results/accuracy-{suite}.json")
        requested_output = Path(str(out_path_s))
        profile_runs = {"gsm8k": "1319", "mmlu-pro": "1000", "gpqa-diamond": "198"}
        acc_max_tokens, rest = extract_flag(rest, "--max-tokens", None)
        if acc_max_tokens is None:
            acc_max_tokens = str(_accuracy_max_tokens(host, port))
        rc = 0
        for profile in profiles:
            if len(profiles) == 1:
                raw_output = requested_output
            else:
                stem = requested_output.stem.removesuffix("-all")
                raw_output = requested_output.with_name(f"{stem}-{profile}.json")
            out_p = _resolve_out_path(str(raw_output))
            cmd = [
                sys.executable, str(LIL_SCRIPT),
                "--host", str(host), "--port", str(port),
                "--model", str(model),
                "--test-profile", profile,
                "--profile-concurrency", str(conc),
                "--profile-runs", profile_runs[profile],
                "--completion-stats-temperature", "0",
                "--completion-stats-top-p", "1",
                "--completion-stats-seed", "20261018",
                "--completion-stats-stall-timeout", "600",
                "--completion-stats-request-timeout", "3600",
                "--max-tokens", str(acc_max_tokens),
                "--display-mode", "plain",
                "--no-hw-monitor",
                "--no-resume",
                "--output", str(out_p),
            ]
            cmd.extend(rest)
            rc = run_lil_cmd(cmd, out_p, opts) or rc
        return rc

    if sub == "suite":
        out_dir_s, rest = extract_flag(rest, "--output-dir", "/results")
        out_dir = _resolve_out_path(str(Path(out_dir_s) / "repetition-1.json")).parent
        privacy_flags = [
            "--opt-out-host-info" if opts.get("host") else "--include-host-info",
            "--opt-out-prompt-logs" if opts.get("logs") else "--include-prompt-logs",
        ]
        common_flags = ["--host", host, "--port", port, "--model", model] + privacy_flags + rest
        print(f"[lil-bench] Running unified suite in {out_dir}...")
        rep_json = out_dir / "repetition-1.json"
        coding_json = out_dir / "coding-peak.json"
        conc_json = out_dir / "concurrency-sweep.json"
        estonia_json = out_dir / "estonia-results.json"
        rc1 = subprocess.call([sys.executable, __file__, "matrix", "--no-card", "--output", str(rep_json)] + common_flags)
        rc2 = subprocess.call([sys.executable, __file__, "coding", "--output", str(coding_json)] + common_flags)
        rc3 = subprocess.call([sys.executable, __file__, "concurrency", "1,2,4,8", "--no-card", "--output", str(conc_json)] + common_flags)
        rc4 = subprocess.call([sys.executable, __file__, "estonia", "--output", str(estonia_json)] + common_flags)
        suite_jsons = [rep_json, coding_json, conc_json, estonia_json]
        cards = generate_cards(out_dir / "card", suite_jsons, opts, title_override=model)
        print(f"[lil-bench] Suite complete. Cards written: {json.dumps(cards)}")
        return rc1 or rc2 or rc3 or rc4

    # Direct pass-through to llm_decode_bench.py
    out_flag, _ = extract_flag(args, "--output", None)
    pass_cmd = [
        sys.executable,
        str(LIL_SCRIPT),
        "--host",
        str(host),
        "--port",
        str(port),
        "--model",
        str(model),
    ] + args
    rc = run_lil_cmd(pass_cmd, Path(out_flag) if out_flag else None, opts)
    return rc


if __name__ == "__main__":
    sys.exit(main())
