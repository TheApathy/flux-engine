    return receipt, reuse


def run_same_prompt_wave(args, probe, context, live, plan, base, cursor):
    """Token-level parity for W identical prompts; sessions alias so no log parse."""
    source = plan.wave_cases[0]
    cases = [
        probe.Case(f"same-{ordinal:02d}", ordinal, source.content)
        for ordinal in range(live.width)
    ]
    offset = cursor.mark()
    results = probe.run_wave(args.base_url, live.model, cases, args.max_tokens, args.timeout)
    text = cursor.read_from(offset)
    baseline = base.results[source.label]
    for result in results:
        probe.validate_request_identity(f"same-prompt/{result.label}", result, baseline)
    census = frame_census(text)
    require_executed_width(census, plan.expected_route, live.width, "same-prompt")
    context.timing.drain()
    return {
        "source_label": source.label,
        "rows": live.width,
        "requests": [probe.serialize_result(result) for result in results],
        "census": census,
        "log_sha256": digest(text.encode()),
    }


def run_mid_cancel_churn(args, probe, context, live, plan, base, cursor):
    """P8: cancel a middle row at --cancel-token; survivors and replacement match C1."""
    cases = plan.wave_cases
    target = cases[len(cases) // 2 - 1]
    replacement = plan.churn_replacement
    barrier = threading.Barrier(len(cases))
    cancelled = threading.Event()
    order = {case.label: position for position, case in enumerate(cases)}
    offset = cursor.mark()

    def original(case):
        barrier.wait(timeout=args.timeout)
        time.sleep(order[case.label] * probe.WAVE_ADMISSION_STAGGER_S)
        if case == target:
            return probe.stream_then_cancel(
                args.base_url,
                live.model,
                case,
                args.max_tokens,
                args.timeout,
                cancel_after_chunks=args.cancel_token,
                cancelled=cancelled,
            )
        return probe.stream_request(
            args.base_url, live.model, case, args.max_tokens, args.timeout
        )

    def replacement_request():
        require(cancelled.wait(timeout=args.timeout), "replacement timed out")
        return probe.stream_request(
            args.base_url, live.model, replacement, args.max_tokens, args.timeout
        )

    with concurrent.futures.ThreadPoolExecutor(max_workers=len(cases) + 1) as pool:
        originals = {case.label: pool.submit(original, case) for case in cases}
        future = pool.submit(replacement_request)
        outcomes = {label: item.result(timeout=args.timeout) for label, item in originals.items()}
        replacement_result = future.result(timeout=args.timeout)
    cancel_result = outcomes[target.label]
    require(isinstance(cancel_result, probe.CancelResult), "mid churn target was not cancelled")
    require(
        cancel_result.content_chunks == args.cancel_token
        and replacement_result.started_unix >= cancel_result.closed_unix,
        "mid churn cancellation boundary or replacement order differs",
    )
    survivors = [outcomes[case.label] for case in cases if case != target]
    for survivor in survivors:
        require(isinstance(survivor, probe.RequestResult), "mid churn survivor did not finish")
        probe.validate_request_identity(
            f"mid-churn/{survivor.label}", survivor, base.results[survivor.label]
        )
    probe.validate_request_identity(
        "mid-churn/replacement", replacement_result, base.results[replacement.label]
    )
    text = cursor.read_from(offset)
    parsed = probe.parse_log(text)
    terminal_geometry = validate_mid_churn_log(
        probe, plan, base, parsed, target, replacement, survivors,
        replacement_result, cancel_result.content_chunks,
    )
    census = frame_census(text)
    require_executed_width(census, plan.expected_route, live.width, "mid-churn")
    context.timing.drain()
    return {
        "cancelled_label": target.label,
        "cancel_token": args.cancel_token,
        "content_chunks_before_close": cancel_result.content_chunks,
        "cancelled_terminal_geometry": terminal_geometry,
        "survivors": [probe.serialize_result(item) for item in survivors],
        "replacement": probe.serialize_result(replacement_result),
        "census": census,
        "log_sha256": parsed.text_sha256,
    }


def validate_mid_churn_log(probe, plan, base, parsed, target, replacement, survivors, replacement_result, cancelled_content_chunks):
    """Full logits/state parity for survivors and replacement after a mid-row cancel."""
    expected_sessions = {base.sessions[case.label] for case in [*plan.wave_cases, replacement]}
    require(
        set(parsed.rows_by_session) == expected_sessions
        and set(parsed.state_by_session) == expected_sessions,
        "mid-churn: logits/state sessions differ from originals plus replacement",
    )
    for result in [*survivors, replacement_result]:
        session = base.sessions[result.label]
        require(
            probe.row_digest_map(parsed.rows_by_session.get(session, {}))
            == base.logits[result.label],
            f"mid-churn/{result.label}: full logits differ from C1",
        )
        state = parsed.state_by_session.get(session)
        require(state is not None, f"mid-churn/{result.label}: target-state receipt missing")
        probe.validate_state_receipt(
            f"mid-churn/{result.label}", state, len(result.token_ids), result.usage["prompt_tokens"]
        )
        require(
            probe.state_signature(state) == probe.state_signature(base.states[result.label]),
            f"mid-churn/{result.label}: terminal state differs from C1",
        )
    target_session = base.sessions[target.label]
    cancelled_state = parsed.state_by_session.get(target_session)
    require(cancelled_state is not None, "mid-churn: cancelled request has no state receipt")
    require(
        0 < cancelled_content_chunks <= cancelled_state.output_tokens
        < base.results[target.label].usage["completion_tokens"],
        "mid-churn: cancelled request target-state token count is invalid",
    )
    raw_cancelled_rows = parsed.rows_by_session.get(target_session, {})
    terminal_geometry = probe.validate_cancelled_state_receipt(
        "mid-churn/cancelled", cancelled_state,
        base.results[target.label].usage["prompt_tokens"], raw_cancelled_rows,
    )
    cancelled_rows = probe.row_digest_map(raw_cancelled_rows)
    require(
        all(base.logits[target.label].get(i) == d for i, d in cancelled_rows.items()),
        "mid-churn: cancelled logits are not an exact C1 prefix",
    )
    wrong = [f for f in parsed.frames if 2 <= f.rows <= 8 and f.route != plan.expected_route]
    require(not wrong, "mid-churn: a C2-C8 frame used the wrong route")
    labels_by_session = {
        base.sessions[case.label]: case.label for case in [*plan.wave_cases, replacement]
    }
    for frame in parsed.frames:
        require(2 <= frame.rows <= plan.width, "mid-churn: unexpected frame width")
        require(
            (frame.selector_on is None and frame.qsa_required is None)
            if plan.expected_route == "native"
            else (frame.selector_on is False and frame.qsa_required is False),
            "mid-churn: route selector metadata differs",
        )
        for session, seq_len, row in zip(frame.sessions, frame.pre_step_seq_lens, frame.logits):
            label = labels_by_session.get(session)
            require(label is not None, "mid-churn: frame contains an unknown session")
            require(
                seq_len == base.results[label].usage["prompt_tokens"] + row.index - 1,
                f"mid-churn/{label}: frame sequence length differs from output index",
            )
    probe.validate_frame_ownership(
        "mid-churn", parsed.frames, parsed.state_by_session, allow_retired_slot_reuse=True
    )
    probe.validate_cancelled_frame_extent(
        "mid-churn/cancelled", parsed.frames, cancelled_state, raw_cancelled_rows
    )
    replacement_session = base.sessions[replacement.label]
    target_frames = [f for f in parsed.frames if target_session in f.sessions]
    replacement_frames = [f for f in parsed.frames if replacement_session in f.sessions]
    require(target_frames and replacement_frames, "mid-churn: target or replacement never entered a frame")
    last_target, first_replacement = target_frames[-1], replacement_frames[0]
    require(
        last_target.line_number < cancelled_state.line_number < first_replacement.line_number,
        "mid-churn: replacement entered before the cancelled state retired",
    )
    retired = last_target.slots[last_target.sessions.index(target_session)]
    reused = first_replacement.slots[first_replacement.sessions.index(replacement_session)]
    require(retired == reused, "mid-churn: replacement did not reuse the retired slot")
    return terminal_geometry


def finish_arm(args, probe, context, live, plan, cursor, memory):
    end = cursor.mark()
    complete_bytes = cursor.read_bytes_from(0, settle_seconds=0.0, end_offset=end)
    complete = complete_bytes.decode("utf-8", "strict")
    probe.validate_evidence_line_syntax(complete)
    lowered = complete.lower()
    safety = {m: lowered.count(m.lower()) for m in probe.FORBIDDEN_LOG_MARKERS}
    for marker, count in safety.items():
        if count:
            raise GateFailure("VOID", f"server log contains forbidden marker: {marker}")
    engaged = [int(v) for v in probe.ENGAGED_RE.findall(complete)]
    if plan.expected_route == "native":
        require(engaged == [live.width], f"expected one C{live.width} engagement marker")
    else:
        require(not engaged, "serial control unexpectedly engaged the native route")
    selector_counts = {
        s: complete.count(m) for s, m in probe.OPTIMIZATION_ENGAGEMENT_MARKERS.items()
    }
    expected = 1 if live.profile == "native-optimized" else 0
    for selector, count in selector_counts.items():
        require(count == expected, f"{selector}: engagement marker count differs")
    summary = memory.summary()
    require(
        summary["mem_available_floor_kib"] >= args.memory_floor_mib * 1024,
        "MemAvailable floor is below the memory contract",
    )
    metrics = request(args, "GET", "/metrics").decode("utf-8", "strict")
    k5_events = sum(float(v) for v in K5_METRIC_RE.findall(metrics))
    require(
        math.isfinite(k5_events) and 0 <= k5_events <= 1e12 and k5_events.is_integer(),
        "native K5 verification counter is malformed",
    )
    require(
        k5_events > 0 if live.mode == "native-mtp-k5" else k5_events == 0,
        "native K5 verifier engagement differs from the arm mode",
    )
    return {
        "end_offset": end,
        "log_sha256": digest(complete_bytes),
        "safety": safety,
        "engaged": engaged,
        "selector_counts": selector_counts,
        "memory": summary,
        "memory_samples": memory.samples,
        "k5_events": int(k5_events),
        "metrics_sha256": digest(metrics.encode()),
    }


def arm_limitations(probe, mode):
    limitations = [
        "direct-binary endpoint evidence, not container evidence",
        "correctness receipt, not a throughput receipt",
        "terminal state covers all live GDN/PLE state and logical BF16 KV prefixes",
        "per-step evidence covers complete logits plus logical-session/physical-slot/sequence-length routing",
        "cancellation/replacement/drain/reuse is exercised only by C8",
        "release requires a separate nine-arm selector matrix seal",
    ]
    if mode != "none":
        limitations.append(
            "native-K5 arm validated by the container driver under the engaged-native-mtp state contract, not by the nine-arm matrix sealer"
        )
    return limitations


def qualify_arm(args, context, live, reference):
    """Run every probe phase plus the driver's extra phases on one live arm."""
    probe = context.probe
    plan = arm_plan(args, probe, context, live)
    probe.healthcheck(args.base_url, min(args.timeout, 30.0))
    cursor = probe.LogCursor(live.host_log)
    check_fresh_log(probe, cursor)
    memory = probe.MemorySampler(live.pid)
    memory.start()
    started = time.time()
    try:
        base = run_baseline(args, probe, context, live, plan, cursor)
        reference_receipt = validate_reference(args, probe, context, live, plan, base, reference)
        forward, forward_results = run_validated_wave(
            args, probe, context, live, plan, base, cursor, "forward", plan.wave_cases
        )
        reverse, reverse_results = run_validated_wave(
            args, probe, context, live, plan, base, cursor, "reverse",
            list(reversed(plan.wave_cases)),
        )
        churn = reuse = mid_churn = None
        if plan.churn_replacement is not None:
            churn, reuse = run_c8_churn(args, probe, context, live, plan, base, cursor)
        same_prompt = run_same_prompt_wave(args, probe, context, live, plan, base, cursor)
        if plan.churn_replacement is not None:
            mid_churn = run_mid_cancel_churn(args, probe, context, live, plan, base, cursor)
        probe.healthcheck(args.base_url, min(args.timeout, 30.0))
    finally:
        memory.stop()
    final = finish_arm(args, probe, context, live, plan, cursor, memory)
    recheck_provenance(probe, context.provenance)
    _payload, identity = read_pinned_bytes(args.probe_program, args.probe_sha256)
    require(identity == context.probe_identity, "qualifier source changed during qualification")
    receipt = {
        **plan.plan,
        "provenance": {
            **context.provenance.public,
            "manifest_schema": probe.LAUNCH_SCHEMA,
            "manifest_name": live.manifest_name,
            "manifest_sha256": live.manifest_sha256,
            "selector_profile": live.profile,
            "configured_max_batch_size": live.width,
            "configured_max_num_seqs": live.width,
            "server_process": live.process,
        },
        "result": "PASS",
        "arm_qualified": True,
        "release_qualified": False,
        "started_unix": started,
        "finished_unix": time.time(),
        "server_pid": live.pid,
        "server_log_name": Path(live.log_locator).name,
        "server_log_qualified_start_offset": 0,
        "server_log_qualified_end_offset": final["end_offset"],
        "server_log_sha256": final["log_sha256"],
        "safety_log_marker_counts": final["safety"],
        "memory": final["memory"],
        "baseline_c1": base.receipts,
        "waves": [forward, reverse],
        "reference_receipt": reference_receipt,
        "api_churn": churn,
        "post_drain_reuse": reuse,
        "native_engagement_widths": final["engaged"],
        "optimization_selector_engagement_counts": final["selector_counts"],
        "limitations": arm_limitations(probe, live.mode),
    }
    observation = {
        "mode": live.mode,
        "profile": live.profile,
        "width": live.width,
        "execution_scope": "immutable-container",
        "process_binding": live.proof,
        "full_frames": min(forward["full_width_frames"], reverse["full_width_frames"]),
        "forward_reverse_token_identity": all(
            left.token_ids == right.token_ids
            for left, right in zip(forward_results, reversed(reverse_results))
        ),
        "same_prompt_wave": same_prompt,
        "mid_cancel_churn": mid_churn,
        "k5_events": final["k5_events"],
        "metrics_sha256": final["metrics_sha256"],
        "memory_samples_mib": [
            int(row["mem_available_kib"]) // 1024 for row in final["memory_samples"]
        ],
    }
    return receipt, observation


# --- ladder (C9-C32, optional) ----------------------------------------------


def validate_ladder_wave(probe, args, name, width, cases, results, parsed, base):
    """Width-agnostic replay of the probe's wave checks for C9-C32 rungs."""
    require(
        [r.label for r in results] == [c.label for c in cases],
        f"{name}: request result order differs from admission plan",
    )
    by_label = {r.label: r for r in results}
    by_session = {base.sessions[case.label]: case.label for case in cases}
    require(
        set(parsed.rows_by_session) == set(by_session)
        and set(parsed.state_by_session) == set(by_session),
        f"{name}: logits/state sessions differ from the ladder wave",
    )
    for case in cases:
        probe.validate_request_identity(f"{name}/{case.label}", by_label[case.label], base.results[case.label])
        session = base.sessions[case.label]
        observed = parsed.rows_by_session.get(session)
        require(
            observed is not None and probe.row_digest_map(observed) == base.logits[case.label],
            f"{name}/{case.label}: full-logits SHA-256 differs from C1",
        )
        state = parsed.state_by_session.get(session)
        require(state is not None, f"{name}/{case.label}: target-state receipt is missing")
        probe.validate_state_receipt(
            f"{name}/{case.label}", state, len(by_label[case.label].token_ids),
            by_label[case.label].usage["prompt_tokens"],
        )
        require(
            probe.state_signature(state) == probe.state_signature(base.states[case.label]),
            f"{name}/{case.label}: terminal state differs from C1",
        )
    full = [f for f in parsed.frames if f.rows == width and f.route == "native"]
    require(len(full) >= args.minimum_full_frames, f"{name}: too few complete native C{width} frames")
    require(
        all(
            f.route == "native" and 2 <= f.rows <= width
            and f.selector_on is None and f.qsa_required is None
            for f in parsed.frames
        ),
        f"{name}: a frame used the wrong route, width, or selector metadata",
    )
    probe.validate_frame_ownership(name, parsed.frames, parsed.state_by_session, allow_retired_slot_reuse=False)
    for frame in parsed.frames:
        for session, seq_len, row in zip(frame.sessions, frame.pre_step_seq_lens, frame.logits):
            label = by_session.get(session)
            require(label is not None, f"{name}: frame contains an unknown session")
            require(
                seq_len == base.results[label].usage["prompt_tokens"] + row.index - 1,
                f"{name}/{label}: frame sequence length differs from output index",
            )
            require(
                base.logits[label].get(row.index) == row.sha256,
                f"{name}/{label}: frame logits differ from C1",
            )
    expected_order = [c.label for c in cases]
    require(
        all([by_session[s] for s in f.sessions] == expected_order and f.slots == full[0].slots for f in full),
        f"{name}: full frames do not preserve exact order and stable slots",
    )
    return {"name": name, "width": width, "full_width_frames": len(full), "log_sha256": parsed.text_sha256}


def qualify_ladder_arm(args, context, live):
    probe = context.probe
    plan = arm_plan(args, probe, context, live)
    cursor = probe.LogCursor(live.host_log)
    check_fresh_log(probe, cursor)
    memory = probe.MemorySampler(live.pid)
    memory.start()
    try:
        base = run_baseline(args, probe, context, live, plan, cursor)
        waves = []
        for name, cases in (("forward", plan.wave_cases), ("reverse", list(reversed(plan.wave_cases)))):
            offset = cursor.mark()
            results = probe.run_wave(args.base_url, live.model, cases, args.max_tokens, args.timeout)
            text = cursor.read_from(offset)
            key = f"ladder/{live.profile}-c{live.width}/{name}"
            context.diagnostics[key] = {
                "divergence": divergence_rows(results, base.results),
                "census": frame_census(text),
            }
            waves.append(validate_ladder_wave(probe, args, name, live.width, cases, results, probe.parse_log(text), base))
            require_executed_width(context.diagnostics[key]["census"], "native", live.width, key)
        probe.healthcheck(args.base_url, min(args.timeout, 30.0))
    finally:
        memory.stop()
    final = finish_arm(args, probe, context, live, plan, cursor, memory)
    recheck_provenance(probe, context.provenance)
    return {
        "profile": live.profile,
        "width": live.width,
        "process_binding": live.proof,
        "server_process": live.process,
        "waves": waves,
        "server_log_sha256": final["log_sha256"],
        "memory": final["memory"],
        "memory_samples_mib": [int(r["mem_available_kib"]) // 1024 for r in final["memory_samples"]],
        "native_engagement_widths": final["engaged"],
    }


# --- matrix seal -----------------------------------------------------------


def seal_matrix(args, context, arm_paths):
    """Seal the nine plain arms with the pinned, Git-captured matrix sealer."""
    suite = args.suite
    matrix = load_module(
        args.matrix_program,
        args.matrix_sha256,
        "_r16_native_concurrency_matrix",
    )
    seals = matrix.reviewed_source_closure()
    expected = {
        matrix.MATRIX_RELATIVE_PATH: args.matrix_sha256,
        matrix.PROBE_RELATIVE_PATH: args.probe_sha256,
        matrix.R9_HELPER_RELATIVE_PATH: args.r9_sha256,
    }
    for relative, sha in expected.items():
        require(seals[relative].sha256 == sha, "reviewed source closure differs from the pins")
    specs = [[str(path), sha] for path, sha in arm_paths]
    arms, public, identities = matrix.load_arms(specs)
    result = matrix.validate_matrix(arms, public)
    for path, (identity, sha) in identities.items():
        require(matrix.probe.stable_identity(path, "arm") == identity, "arm receipt changed")
        _, observed, _ = matrix.probe.read_stable_file_bytes(path, "arm")
        require(observed == sha, "arm receipt bytes changed during sealing")
    matrix.revalidate_reviewed_source_closure(seals)
    require(result["probe_sha256"] == args.probe_sha256, "sealed probe SHA-256 differs")
    sealer = seals[matrix.MATRIX_RELATIVE_PATH]
    r9 = seals[matrix.R9_HELPER_RELATIVE_PATH]
    result["sealer_name"] = sealer.path.name
    result["sealer_sha256"] = sealer.sha256
    result["sealer_git_blob"] = sealer.blob
    result["r9_helper_name"] = r9.path.name
    result["r9_helper_sha256"] = r9.sha256
    result["r9_helper_git_blob"] = r9.blob
    result["matrix_sha256"] = matrix.canonical_hash(result)
    require(
        result["result"] == "PASS" and result["release_qualified"] is True,
        "matrix seal is not a release PASS",
    )
    raw = suite.canonical_bytes(result)
    make_directory(suite, context.runtime, [*context.base.split("/"), "matrix"])
    locator = context.base + "/matrix/none.json"
    sha = write_artifact(suite, context.runtime, locator, raw)
    return {"artifact": locator, "sha256": sha, "matrix_sha256": result["matrix_sha256"]}


# --- orchestration ---------------------------------------------------------


@dataclasses.dataclass
class Context:
    probe: object
    probe_identity: tuple
    plan: dict
    recipe: dict
    container_env: dict
    mounts: dict
    provenance: Provenance
    runtime: Path
    base: str
    model: str
    timing: TimingRegistry
    timing_rows: dict = dataclasses.field(default_factory=dict)
    diagnostics: dict = dataclasses.field(default_factory=dict)
    proofs: list = dataclasses.field(default_factory=list)
    identities: list = dataclasses.field(default_factory=list)


def make_directory(suite, runtime, parts):
    parent = suite.open_directory_chain(runtime, "concurrency runtime")
    try:
        for name in parts:
            try:
                os.mkdir(name, 0o700, dir_fd=parent)
            except FileExistsError:
                pass
            child = os.open(
                name,
                os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC,
                dir_fd=parent,
            )
            os.close(parent)
            parent = child
    finally:
        os.close(parent)


def record_fresh_identity(context, process):
    identity = (process["boot_id"], process["pid"], process["start_ticks"])
    log = (process["log_device"], process["log_inode"])
    require(
        identity not in [row[0] for row in context.identities]
        and log not in [row[1] for row in context.identities],
        "server process or log identity is not fresh",
    )
    context.identities.append((identity, log))


def publish_arm_log(args, suite, locator, descriptor):
    """Publish even a failed arm from its owned descriptor, after cleanup."""
    os.fsync(descriptor)
    raw = suite.read_fd(
        descriptor, "complete concurrency server log", suite.MAX_RAW_LOG_BYTES, nlink=1
    )
    suite.append_log_frame(args.raw_log_fd, GATE, Path(locator).name, raw)
    return digest(raw)


def run_mode_matrix(args, context, mode):
    suite = args.suite
    receipts, observations, arm_paths = [], [], []
    make_directory(suite, context.runtime, [*context.base.split("/"), "arms", mode])
    for width in LEVELS:
        reference = None
        for profile in PROFILES:
            stem = f"{context.base}/arms/{mode}/{profile}-c{width}"
            with state_contract(context.probe, mode), server(
                args, context, mode, profile, width, stem
            ) as live:
                record_fresh_identity(context, live.process)
                context.proofs.append(live.proof)
                receipt, observation = qualify_arm(args, context, live, reference)
            raw = suite.canonical_bytes(receipt)
            locator = stem + ".json"
            sha = write_artifact(suite, context.runtime, locator, raw)
            observation["arm_receipt"] = {"artifact": locator, "sha256": sha}
            observation["server_log"] = {
                "artifact": live.log_locator,
                "sha256": live.complete_log_sha256,
            }
            if profile == "native-reference":
                reference = {"path": context.runtime / locator, "sha256": sha}
            receipts.append(receipt)
            observations.append(observation)
            arm_paths.append((context.runtime / locator, sha))
    return receipts, observations, arm_paths


def run_ladder(args, context):
    suite = args.suite
    rows = []
    make_directory(suite, context.runtime, [*context.base.split("/"), "ladder"])
    for profile in args.ladder_profiles:
        for width in args.ladder_widths:
            stem = f"{context.base}/ladder/{profile}-c{width}"
            with server(args, context, "none", profile, width, stem) as live:
                record_fresh_identity(context, live.process)
                context.proofs.append(live.proof)
                row = qualify_ladder_arm(args, context, live)
            row["server_log"] = {"artifact": live.log_locator, "sha256": live.complete_log_sha256}
            rows.append(row)
    return rows


def wrapper_arm_rows(observations):
    return [
        {
            "level": item["width"],
            "mode": item["mode"],
            "fresh_process": True,
            "full_frames": item["full_frames"],
            "forward_reverse_order_all_frames": True,
            "per_frame_logit_identity": True,
            "per_frame_state_identity": True,
        }
        for item in observations
    ]


def memory_samples(observations, ladder):
    samples = []
    for item in [*observations, *ladder]:
        rows = item["memory_samples_mib"]
        require(bool(rows), "arm memory samples are missing")
        samples += [rows[0], min(rows), rows[-1]]
    return samples


def scope_contract(scope, modes):
    """Return (gate, required modes) for a scope; plain demands exactly mode none."""
    require(scope in SCOPES, "--scope must be full or plain")
    gate, required = SCOPES[scope]
    require(
        scope == "full" or tuple(modes) == required,
        "--scope plain requires exactly --modes none",
    )
    return gate, required


def scope_coverage(scope):
    """Extra receipt keys. The full scope adds none, so its receipt is unchanged."""
    if scope == "full":
        return {}
    return {
        "scope": "plain",
        "covered_modes": list(SCOPES[scope][1]),
        "not_covered_modes": list(PLAIN_NOT_COVERED),
        "native_k5": "NOT_COVERED",
        "release_scope": "plain native C2/C4/C8 only; not native-concurrency-c2-c8",
    }


def require_complete(scope, modes, observations):
    _gate, required = SCOPES[scope]
    message = (
        "qualification is incomplete: both modes and all 18 arms are required"
        if scope == "full"
        else "qualification is incomplete: the plain scope requires mode none and all 9 arms"
    )
    require(
        set(modes) == set(required)
        and len(observations) == 3 * len(LEVELS) * len(required),
        message,
    )


def build_validator(args, context, observations, matrix, ladder):
    raw = {
        "arms": wrapper_arm_rows(observations),
        "available_mib_samples": memory_samples(observations, ladder),
        "cancellation_replacement_pass": True,
        "final_highest_slot_reused": True,
        "post_drain_clean": True,
        "execution_scope": "immutable-container",
        "plain_matrix_seal": matrix,
        "arm_observations": observations,
        "process_bindings": context.proofs,
        "timing_rows": context.timing_rows,
        "diagnostics": context.diagnostics,
        "ladder": ladder,
        "provenance": context.provenance.public,
        "model": context.model,
        "max_tokens": args.max_tokens,
        "cancel_token": args.cancel_token,
    }
    validator = {
        "schema": "flux-r15-gate-validator/1",
        "gate": args.gate,
        "status": "PASS",
        "release_qualified": True,
        "container_id": args.container_id,
        "run_id": args.run_id,
        "raw": raw,
        **scope_coverage(args.scope),
    }
    validator_raw = args.suite.canonical_bytes(validator)
    locator = context.base + "/validator.json"
    sha = write_artifact(args.suite, context.runtime, locator, validator_raw)
    evidence = {
        "levels": list(LEVELS),
        "modes": list(SCOPES[args.scope][1]),
        "fresh_processes": len(observations),
        "minimum_full_frames": min(item["full_frames"] for item in observations),
        "forward_reverse_order_all_frames": True,
        "per_frame_logit_identity": True,
        "per_frame_state_identity": True,
        "cancellation_replacement_pass": True,
        "final_highest_slot_reused": True,
        "post_drain_clean": True,
        "minimum_available_mib": min(raw["available_mib_samples"]),
        "validator_artifact": locator,
        "validator_receipt_sha256": sha,
    }
    return evidence


def write_failure(args, context, error):
    """Preserve a private diagnosis file; never a PASS receipt."""
    failure_class = getattr(error, "failure_class", None)
    if failure_class is None:
        text = str(error)
        failure_class = "VOID" if any(m.lower() in text.lower() for m in VOID_MARKERS) else "FAIL"
    payload = args.suite.canonical_bytes(
        {
            "schema": "flux-r16-native-concurrency-failure/1",
            "gate": getattr(args, "gate", GATE),
            "status": failure_class,
            "error_type": type(error).__name__,
            "error": str(error),
            "timing_rows": context.timing_rows,
            "diagnostics": context.diagnostics,
            "process_bindings": context.proofs,
        }
    )
    try:
        write_artifact(
            args.suite,
            context.runtime,
            context.base + "/failure-" + secrets.token_hex(4) + ".json",
            payload,
        )
    except (OSError, ValueError):
        pass


def run(args):
    suite, probe = args.suite, args.probe
    plan, recipe, container_env, mounts = inspect_container(args, suite)
    runtime = suite.normalized_absolute(args.runtime_dir, "concurrency runtime")
    runtime_identity = suite.directory_identity_sha256(runtime, "concurrency runtime")
    verify_runtime_bind(suite, runtime, mounts)
    provenance = preflight_provenance(args, suite, probe, plan, mounts)
    parts = ["concurrency", GATE]
    make_directory(suite, runtime, parts)
    context = Context(
        probe,
        args.probe_identity,
        plan,
        recipe,
        container_env,
        mounts,
        provenance,
        runtime,
        "/".join(parts),
        "flux-concurrency-" + secrets.token_hex(8),
        TimingRegistry(),
    )
    install_timing_hook(probe, context.timing)
    try:
        observations, matrix, ladder = [], None, []
        if "none" in args.modes:
            _receipts, plain, arm_paths = run_mode_matrix(args, context, "none")
            observations += plain
            matrix = seal_matrix(args, context, arm_paths)
        if args.ladder:
            ladder = run_ladder(args, context)
        if "native-mtp-k5" in args.modes:
            _receipts, k5, _paths = run_mode_matrix(args, context, "native-mtp-k5")
            observations += k5
        require(
            suite.directory_identity_sha256(runtime, "concurrency runtime")
            == runtime_identity,
            "concurrency runtime identity changed",
        )
        require_complete(args.scope, args.modes, observations)
        evidence = build_validator(args, context, observations, matrix, ladder)
    except Exception as error:
        write_failure(args, context, error)
        raise
    receipt = {
        "schema": "flux-r15-container-gate-receipt/1",
        "gate": args.gate,
        "status": "PASS",
        "release_qualified": True,
        "execution_scope": "immutable-container",
        "image_id": args.image_id,
        "image_digest": args.image_digest,
        "container_id": args.container_id,
        "run_id": args.run_id,
        "evidence": evidence,
        **scope_coverage(args.scope),
    }
    suite.write_all(args.receipt_fd, suite.canonical_bytes(receipt))
    os.fsync(args.receipt_fd)
    return receipt


def parse_widths(value):
    match = re.fullmatch(r"([0-9]+)-([0-9]+)", value)
    require(match is not None, "ladder widths must be a low-high range")
    low, high = int(match[1]), int(match[2])
    require(
        LADDER_WIDTHS[0] <= low <= high <= LADDER_WIDTHS[-1],
        "ladder widths must stay within C9-C32",
    )
    return tuple(range(low, high + 1))


def parse_args(argv=None):
    parser = argparse.ArgumentParser(description=__doc__, allow_abbrev=False)
    for name in (
        "container-id",
        "image-id",
        "image-digest",
        "base-url",
        "run-id",
        "receipt-fd",
        "raw-log-fd",
        "runtime-dir",
        "suite-program",
        "suite-sha256",
        "probe-program",
        "probe-sha256",
        "r9-program",
        "r9-sha256",
        "matrix-program",
        "matrix-sha256",
        "launch-manifest",
        "launch-manifest-sha256",
    ):
        parser.add_argument(
            "--" + name, required=True, type=int if name.endswith("-fd") else str
        )
    parser.add_argument("--container-port", type=int, default=8888)
    parser.add_argument("--container-results-path", default="/results")
    parser.add_argument("--container-cwd", default="/")
    parser.add_argument("--max-tokens", type=int, default=64)
    parser.add_argument("--minimum-full-frames", type=int, default=8)
    parser.add_argument("--memory-floor-mib", type=int, default=6656)
    parser.add_argument("--timeout", type=float, default=900.0)
    parser.add_argument("--cancel-token", type=int, default=20)
    parser.add_argument("--modes", default=",".join(MODES))
    parser.add_argument("--scope", default="full")
    parser.add_argument("--ladder", action="store_true")
    parser.add_argument("--ladder-widths", default="9-32")
    parser.add_argument("--ladder-profiles", default="native-reference")
    args = parser.parse_args(argv)
    parsed = urllib.parse.urlsplit(args.base_url)
    require(
        parsed.scheme == "http"
        and parsed.hostname == "127.0.0.1"
        and parsed.port is not None
        and parsed.path in ("", "/")
        and not parsed.query
        and not parsed.fragment
        and parsed.username is None,
        "base URL must be explicit HTTP IPv4 loopback",
    )
    args.base_url = args.base_url.rstrip("/")
    require(1 <= args.container_port <= 65535, "container port is invalid")
    require(
        re.fullmatch(r"[0-9a-f]{64}", args.container_id) is not None,
        "container ID differs",
    )
    for value in (args.image_id, args.image_digest):
        require(
            re.fullmatch(r"sha256:[0-9a-f]{64}", value) is not None,
            "immutable image identity differs",
        )
    require(
        re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,127}", args.run_id) is not None,
        "run ID is invalid",
    )
    for name in ("suite_sha256", "probe_sha256", "r9_sha256", "matrix_sha256", "launch_manifest_sha256"):
        value = getattr(args, name)
        require(
            re.fullmatch(r"[0-9a-f]{64}", value) is not None and set(value) != {"0"},
            f"{name} is invalid",
        )
    require(
        Path(args.probe_program).name == "qwen4_native_concurrency_probe.py",
        "probe program basename differs",
    )
    require(
        Path(args.container_results_path).is_absolute()
        and Path(args.container_cwd).is_absolute(),
        "container paths must be absolute",
    )
    require(16 <= args.max_tokens <= 256, "--max-tokens must be in 16..256")
    require(args.minimum_full_frames >= 8, "--minimum-full-frames must be at least 8")
    require(args.memory_floor_mib >= 1, "--memory-floor-mib must be positive")
    require(math.isfinite(args.timeout) and args.timeout > 0, "--timeout must be positive")
    require(1 <= args.cancel_token < args.max_tokens, "--cancel-token must precede the budget")
    args.modes = tuple(dict.fromkeys(item.strip() for item in args.modes.split(",")))
    require(
        args.modes and set(args.modes) <= set(MODES), "--modes must name none/native-mtp-k5"
    )
    args.gate, _required = scope_contract(args.scope, args.modes)
    args.ladder_widths = parse_widths(args.ladder_widths)
    args.ladder_profiles = tuple(
        dict.fromkeys(item.strip() for item in args.ladder_profiles.split(","))
    )
    require(
        set(args.ladder_profiles) <= {"native-reference", "native-optimized"},
        "--ladder-profiles must be native selector profiles",
    )
    verify_parent_suite(args.suite_sha256)
    args.suite = load_module(
        args.suite_program, args.suite_sha256, "_r16_suite_native_concurrency"
    )
    require(
        callable(getattr(args.suite, "_live_listener_identity", None))
        and callable(getattr(args.suite, "_verify_live_mode", None)),
        "source-pinned live broker upgrade is required",
    )
    r9 = load_module(args.r9_program, args.r9_sha256, "_r16_r9_native_concurrency")
    _payload, args.probe_identity = read_pinned_bytes(args.probe_program, args.probe_sha256)
    args.probe = load_module(
        args.probe_program,
        args.probe_sha256,
        "_r16_probe_native_concurrency",
        injected={"r9_provenance": r9},
    )
    args.identities = {
        name: getattr(args, name)
        for name in ("container_id", "image_id", "image_digest", "run_id", "base_url")
    }
    require(
        hasattr(signal, "pidfd_send_signal") and hasattr(os, "pidfd_open"),
        "local Linux pidfd support is required",
    )
    return args


def main():
    try:
        run(parse_args())
    except Exception as error:
        # Paths, host identifiers, and response text stay in private artifacts.
        print(
            GATE + ": qualification failed (" + type(error).__name__ + ")",
            file=sys.stderr,
        )
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
