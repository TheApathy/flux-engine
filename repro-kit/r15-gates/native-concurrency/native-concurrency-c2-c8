class GateFailure(ValueError):
    """A fail-closed verdict with a failure class for the private diagnosis file."""

    def __init__(self, failure_class, message):
        super().__init__(message)
        self.failure_class = failure_class


def require(condition, message):
    if not condition:
        raise ValueError(message)


def digest(raw):
    return hashlib.sha256(raw).hexdigest()


def verify_parent_suite(expected):
    """Bind the helper pin to the actual sealed suite that launched this gate."""
    parent = os.getppid()
    argv = Path(f"/proc/{parent}/cmdline").read_bytes().split(b"\0")
    candidates = [item for item in argv if re.fullmatch(rb"/proc/self/fd/[0-9]+", item)]
    require(len(candidates) == 1, "gate must be launched by the sealed release suite")
    number = int(candidates[0].rsplit(b"/", 1)[1])
    descriptor = os.open(f"/proc/{parent}/fd/{number}", os.O_RDONLY | os.O_CLOEXEC)
    try:
        seals = (
            fcntl.F_SEAL_SEAL
            | fcntl.F_SEAL_SHRINK
            | fcntl.F_SEAL_GROW
            | fcntl.F_SEAL_WRITE
        )
        require(
            fcntl.fcntl(descriptor, fcntl.F_GET_SEALS) & seals == seals,
            "launching suite bytes are not sealed",
        )
        size = os.fstat(descriptor).st_size
        require(0 < size <= 16 * 1024 * 1024, "launching suite size differs")
        require(
            digest(os.pread(descriptor, size + 1, 0)) == expected
            and os.getppid() == parent,
            "helper differs from the launching suite",
        )
    finally:
        os.close(descriptor)


def read_pinned_bytes(path, expected):
    """Read checked bytes once; never reopen the pathname after hashing."""
    descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        before = os.fstat(descriptor)
        require(
            stat.S_ISREG(before.st_mode) and 0 < before.st_size <= 16 * 1024 * 1024,
            "module size is invalid",
        )
        payload = os.pread(descriptor, before.st_size + 1, 0)
        after = os.fstat(descriptor)
        identity = (
            before.st_dev,
            before.st_ino,
            before.st_size,
            before.st_mtime_ns,
            before.st_ctime_ns,
        )
        require(
            identity
            == (
                after.st_dev,
                after.st_ino,
                after.st_size,
                after.st_mtime_ns,
                after.st_ctime_ns,
            ),
            "module changed while reading",
        )
        require(digest(payload) == expected, "source dependency hash differs")
    finally:
        os.close(descriptor)
    return payload, identity


def load_module(path, expected, name, injected=None):
    """Execute checked bytes under a private module identity."""
    payload, _identity = read_pinned_bytes(path, expected)
    module = types.ModuleType(name)
    module.__file__ = str(path)
    module.__package__ = ""
    if injected:
        module.__dict__.update(injected)
    sys.modules[name] = module
    try:
        exec(compile(payload, str(path), "exec"), module.__dict__)
    except BaseException:
        sys.modules.pop(name, None)
        raise
    return module


def docker(arguments):
    result = subprocess.run(
        ["docker", *arguments],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=90,
        check=False,
    )
    require(result.returncode == 0, "Docker identity or process query failed")
    require(len(result.stdout) <= 16 * 1024 * 1024, "Docker response is oversized")
    return result.stdout


def live_environment_subset(environment):
    return {
        key: value
        for key, value in environment.items()
        if key.startswith(LIVE_ENVIRONMENT_PREFIXES) or key == "RUST_LOG"
    }


def _container_mounts(document):
    mounts = document.get("Mounts")
    require(type(mounts) is list, "container mount inventory is missing")
    table = {}
    for item in mounts:
        require(
            type(item) is dict and type(item.get("Destination")) is str,
            "container mount entry is malformed",
        )
        require(item["Destination"] not in table, "container mount is duplicated")
        table[item["Destination"]] = item
    for destination, writable in ((CONTAINER_MODELS, False), ("/results", True)):
        item = table.get(destination)
        require(
            type(item) is dict
            and item.get("Type") == "bind"
            and item.get("RW") is writable
            and type(item.get("Source")) is str,
            f"container {destination} bind differs from the release contract",
        )
    return table


def inspect_container(args, suite):
    document = suite.strict_json_loads(
        docker(["container", "inspect", "--format", "{{json .}}", args.container_id]),
        "concurrency container",
    )
    require(
        type(document) is dict
        and document.get("Id") == args.container_id
        and document.get("Image") == args.image_id,
        "container identity differs",
    )
    require(
        document.get("State", {}).get("Running") is True
        and document.get("HostConfig", {}).get("ReadonlyRootfs") is True,
        "container is not running with read-only root",
    )
    labels = document.get("Config", {}).get("Labels", {})
    plan = {
        "in_container_binary_path": labels.get(LABEL_PREFIX + "binary-path"),
        "in_container_recipe_path": labels.get(LABEL_PREFIX + "recipe-path"),
        "in_container_binary_sha256": labels.get(LABEL_PREFIX + "binary-sha256"),
        "recipe_sha256": labels.get(LABEL_PREFIX + "recipe-sha256"),
    }
    for key, prefix in (
        ("in_container_binary_path", "/opt/flux/bin/"),
        ("in_container_recipe_path", "/opt/flux/repro-kit/recipes/"),
    ):
        value = plan[key]
        require(
            type(value) is str and value.startswith(prefix),
            "image artifact path differs",
        )
        suite.normalized_absolute(value, "image artifact")
    for key in ("in_container_binary_sha256", "recipe_sha256"):
        suite.exact_hex(plan[key], 64, "image artifact digest")
    init_pid = suite.exact_int(
        document.get("State", {}).get("Pid"), "container init PID", 1, 1 << 31
    )
    root = os.open(
        f"/proc/{init_pid}/root", os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC
    )
    try:
        descriptor = suite._open_process_file(root, plan["in_container_recipe_path"])
        try:
            observed, payload = suite._hash_regular_fd(
                descriptor, "concurrency recipe", suite.MAX_PROGRAM_BYTES
            )
            require(observed == plan["recipe_sha256"], "image recipe hash differs")
            recipe = {
                key.decode(): value.decode()
                for key, value in suite._recipe_environment(payload).items()
            }
        finally:
            os.close(descriptor)
    finally:
        os.close(root)
    raw_env = document.get("Config", {}).get("Env")
    require(
        type(raw_env) is list and all(type(item) is str and "=" in item for item in raw_env),
        "container environment inventory is malformed",
    )
    container_env = {}
    for item in raw_env:
        key, value = item.split("=", 1)
        require(key not in container_env, "container environment repeats a key")
        container_env[key] = value
    return plan, recipe, container_env, _container_mounts(document)


def verify_runtime_bind(suite, runtime, mounts):
    """The in-container /results bind must be the exact suite runtime directory."""
    source = suite.normalized_absolute(mounts["/results"]["Source"], "results bind")
    require(source == runtime, "the /results bind source differs from the runtime")
    left = suite.open_directory_chain(source, "results bind source")
    try:
        right = suite.open_directory_chain(runtime, "concurrency runtime")
        try:
            first, second = os.fstat(left), os.fstat(right)
            require(
                (first.st_dev, first.st_ino) == (second.st_dev, second.st_ino),
                "the /results bind identity differs from the runtime",
            )
        finally:
            os.close(right)
    finally:
        os.close(left)


def request(args, method, route, body=None, *, timeout=REQUEST_TIMEOUT):
    parsed = urllib.parse.urlsplit(args.base_url)
    connection = http.client.HTTPConnection(
        parsed.hostname, parsed.port, timeout=timeout
    )
    try:
        payload = None if body is None else args.suite.canonical_bytes(body)
        connection.request(
            method,
            route,
            body=payload,
            headers={"Content-Type": "application/json", "Connection": "close"},
        )
        response = connection.getresponse()
        raw = response.read(MAX_RESPONSE + 1)
        if route == "/health" and response.status != 200:
            raise ConnectionError("server is not ready")
        require(
            len(raw) <= MAX_RESPONSE and response.status == 200,
            "endpoint status or response bound differs",
        )
        return raw
    finally:
        connection.close()


def find_pid(args, plan, model):
    """Locate the exec'd server: argv[0] is the release binary, not the shell."""
    raw = docker(["container", "top", args.container_id, "-eo", "pid,args"]).decode(
        "utf-8", "strict"
    )
    rows = []
    for line in raw.splitlines()[1:]:
        columns = line.strip().split(None, 1)
        if len(columns) != 2:
            continue
        tokens = columns[1].split()
        if tokens and tokens[0] == plan["in_container_binary_path"] and model in tokens:
            rows.append(int(columns[0]))
    require(len(rows) <= 1, "server process identity is ambiguous")
    return None if not rows else rows[0]


def claim_pid(args, pid, plan):
    """Bind cleanup to our exact container/executable before taking ownership."""
    descriptor = os.pidfd_open(pid)
    try:
        cgroup = Path(f"/proc/{pid}/cgroup").read_bytes()
        require(
            re.search(
                rb"(?<![0-9a-f])" + args.container_id.encode() + rb"(?![0-9a-f])",
                cgroup,
            )
            is not None,
            "server is outside the launch container",
        )
        executable = os.open(f"/proc/{pid}/exe", os.O_RDONLY | os.O_CLOEXEC)
        try:
            observed, _ = args.suite._hash_regular_fd(
                executable, "concurrency executable", 2 * 1024 * 1024 * 1024
            )
            require(
                observed == plan["in_container_binary_sha256"],
                "server executable hash differs",
            )
        finally:
            os.close(executable)
        require(
            not select.select([descriptor], [], [], 0)[0],
            "server exited before ownership",
        )
        return descriptor
    except BaseException:
        os.close(descriptor)
        raise


# --- provenance ------------------------------------------------------------


@dataclasses.dataclass
class Provenance:
    public: dict
    checkpoint_root: Path
    checkpoint_identities: dict
    checkpoint_manifest: Path
    checkpoint_manifest_identity: tuple
    source_receipt: Path
    source_receipt_identity: tuple
    source_closure: dict


def load_launch_manifest(args, suite):
    descriptor = suite.open_absolute_file(
        Path(args.launch_manifest), "release launch manifest"
    )
    try:
        payload = suite.read_fd(
            descriptor, "release launch manifest", 16 * 1024 * 1024, nlink=None
        )
    finally:
        os.close(descriptor)
    require(
        digest(payload) == args.launch_manifest_sha256,
        "release launch manifest hash differs",
    )
    manifest = suite.strict_json_loads(payload, "release launch manifest")
    require(type(manifest) is dict, "release launch manifest is not an object")
    provenance = suite.exact_object(
        manifest.get("provenance"), WRAPPER_PROVENANCE_KEYS, "release provenance"
    )
    require(
        provenance["release_version"] == manifest.get("release_version"),
        "release provenance version differs from the sealed launch manifest",
    )
    return provenance


def preflight_provenance(args, suite, probe, plan, mounts):
    """Verify the R15 source closure and checkpoint through the probe's helpers."""
    provenance = load_launch_manifest(args, suite)
    for key in (
        "source_bundle_manifest_sha256",
        "source_bundle_sha256",
        "build_receipt_sha256",
        "source_to_binary_receipt_sha256",
        "binary_sha256",
        "checkpoint_manifest_sha256",
        "recipe_sha256",
    ):
        probe.canonical_sha256(provenance[key], "release provenance." + key)
    for key in ("source_revision", "source_tree"):
        suite.exact_hex(provenance[key], 40, "release provenance." + key)
        require(set(provenance[key]) != {"0"}, "release provenance Git object is zero")
    require(
        provenance["binary_sha256"] == plan["in_container_binary_sha256"]
        and provenance["recipe_sha256"] == plan["recipe_sha256"],
        "release provenance binary or recipe differs from the image labels",
    )
    checkpoint_id = probe.public_checkpoint_id(
        provenance["checkpoint_id"], "release provenance.checkpoint_id"
    )
    revision = provenance["checkpoint_revision"]
    require(
        type(revision) is str
        and re.fullmatch(r"(?:[0-9a-f]{40}|[0-9a-f]{64})", revision) is not None
        and set(revision) != {"0"},
        "release provenance checkpoint revision is not immutable",
    )
    for key in WRAPPER_PROVENANCE_KEYS:
        if key.endswith("_path"):
            value = provenance[key]
            require(
                type(value) is str and Path(value).is_absolute(),
                f"release provenance.{key} must be an absolute path",
            )
    probe.validate_r15_source_closure(provenance)
    checkpoint_root = suite.normalized_absolute(
        provenance["checkpoint_path"], "release checkpoint path"
    )
    models_source = suite.normalized_absolute(
        mounts[CONTAINER_MODELS]["Source"], "checkpoint bind source"
    )
    require(models_source == checkpoint_root, "the /models bind differs from provenance")
    checkpoint_manifest = Path(provenance["checkpoint_manifest_path"])
    inventory, manifest_identity, identities = probe.validate_checkpoint_inventory(
        checkpoint_root,
        checkpoint_manifest,
        provenance["checkpoint_manifest_sha256"],
        checkpoint_id,
        revision,
        verify_bytes=True,
    )
    source_receipt = Path(provenance["source_to_binary_receipt_path"])
    public = {
        "release_version": provenance["release_version"],
        "source_revision": provenance["source_revision"],
        "source_tree": provenance["source_tree"],
        "source_bundle_manifest_name": Path(
            provenance["source_bundle_manifest_path"]
        ).name,
        "source_bundle_manifest_sha256": provenance["source_bundle_manifest_sha256"],
        "source_bundle_name": Path(provenance["source_bundle_path"]).name,
        "source_bundle_sha256": provenance["source_bundle_sha256"],
        "build_receipt_name": Path(provenance["build_receipt_path"]).name,
        "build_receipt_sha256": provenance["build_receipt_sha256"],
        "source_to_binary_receipt_name": source_receipt.name,
        "source_to_binary_receipt_sha256": provenance[
            "source_to_binary_receipt_sha256"
        ],
        "checkpoint_id": checkpoint_id,
        "checkpoint_revision": revision,
        "checkpoint_manifest_sha256": provenance["checkpoint_manifest_sha256"],
        "checkpoint_files_verified": len(inventory["files"]),
        "checkpoint_bytes_verified": inventory["total_bytes"],
        "binary_name": Path(plan["in_container_binary_path"]).name,
        "binary_sha256": provenance["binary_sha256"],
    }
    return Provenance(
        public,
        checkpoint_root.resolve(),
        identities,
        checkpoint_manifest,
        manifest_identity,
        source_receipt,
        probe.stable_identity(source_receipt, "source-to-binary receipt"),
        {key: provenance[key] for key in probe.PROVENANCE_KEYS},
    )


def recheck_provenance(probe, provenance):
    """The probe's own after-arm identity revalidation, on the container closure."""
    probe.validate_r15_source_closure(provenance.source_closure)
    require(
        probe.stable_identity(provenance.source_receipt, "source-to-binary receipt")
        == provenance.source_receipt_identity,
        "source-to-binary receipt changed during qualification",
    )
    require(
        probe.stable_identity(provenance.checkpoint_manifest, "checkpoint inventory")
        == provenance.checkpoint_manifest_identity,
        "checkpoint inventory changed during qualification",
    )
    for relative, expected in provenance.checkpoint_identities.items():
        observed = probe.stable_identity(
            provenance.checkpoint_root / relative, f"checkpoint file {relative}"
        )
        require(observed == expected, "checkpoint file changed during qualification")


# --- launch contract -------------------------------------------------------


def rust_log_emits_info(value):
    first = value.split(",", 1)[0].strip().lower()
    return first in ("info", "debug", "trace")


def arm_environment(probe, recipe, container_env, mode, profile):
    """Recipe plus arm selectors; the recipe must not pin a qualification key."""
    selectors = probe.SELECTOR_PROFILES[profile]
    reserved = set(selectors) | set(DIAGNOSTIC_ENVIRONMENT) | set(DIAGNOSTIC_LIMIT_KEYS)
    pinned = reserved & (set(recipe) | set(container_env))
    require(not pinned, "release recipe or image pins a qualification selector")
    require(
        rust_log_emits_info(recipe.get("RUST_LOG", "")),
        "release recipe RUST_LOG does not emit info-level qualification receipts",
    )
    overrides = {
        **recipe,
        **selectors,
        **DIAGNOSTIC_ENVIRONMENT,
        "ATLAS_DISABLE_SPECULATION": "1" if mode == "none" else "0",
    }
    expected_live = {
        **live_environment_subset(container_env),
        **live_environment_subset(overrides),
    }
    return overrides, expected_live


def arm_argv(plan, args, model, width, mode):
    argv = [
        plan["in_container_binary_path"],
        "serve",
        "--no-tui",
        "--model-from-path",
        CONTAINER_MODELS,
        "--model-name",
        model,
        "--bind",
        "0.0.0.0",
        "--port",
        str(args.container_port),
        "--qwen4-qsa",
        "--max-batch-size",
        str(width),
        "--max-num-seqs",
        str(width),
    ]
    for flag, value in FIXED_LAUNCH_FLAGS:
        argv += [flag, value]
    if mode == "native-mtp-k5":
        argv += ["--speculative", "--num-drafts", "4"]
    return argv


def launch_command(args, plan, overrides, argv, container_log):
    assignments = " ".join(
        shlex.quote(key + "=" + value) for key, value in sorted(overrides.items())
    )
    script = (
        "exec /usr/bin/env "
        + assignments
        + " "
        + " ".join(shlex.quote(item) for item in argv)
        + ' >>"$0" 2>&1'
    )
    return [
        "docker",
        "exec",
        "-w",
        args.container_cwd,
        args.container_id,
        "/bin/sh",
        "-c",
        script,
        container_log,
    ]


def bind_arm_process(probe, pid, manifest, host_log):
    """The probe's live-process checks, read through the host /proc view."""
    cmdline = Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0")
    if cmdline and cmdline[-1] == b"":
        cmdline.pop()
    require(
        [item.decode("utf-8", "strict") for item in cmdline] == manifest["argv"],
        "live /proc/PID/cmdline differs from the launch manifest argv",
    )
    require(
        os.readlink(f"/proc/{pid}/cwd") == manifest["cwd"],
        "live process cwd differs from the launch manifest cwd",
    )
    live = {}
    for entry in Path(f"/proc/{pid}/environ").read_bytes().split(b"\0"):
        if not entry or b"=" not in entry:
            continue
        key, value = entry.split(b"=", 1)
        key = key.decode("utf-8", "strict")
        if key.startswith(LIVE_ENVIRONMENT_PREFIXES) or key == "RUST_LOG":
            live[key] = value.decode("utf-8", "strict")
    require(
        live == manifest["environment"],
        "live ATLAS_/FLUX_/RUST_LOG environment differs from the launch manifest",
    )
    boot_id = Path("/proc/sys/kernel/random/boot_id").read_text("ascii").strip()
    require(
        re.fullmatch(
            r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", boot_id
        )
        is not None
        and not set(boot_id) <= {"0", "-"},
        "kernel boot id is malformed",
    )
    log_device_inode = probe.validate_log_binding(host_log, pid)
    return {
        "pid": pid,
        "boot_id": boot_id,
        "start_ticks": probe.process_start_ticks(pid),
        "log_device": log_device_inode[0],
        "log_inode": log_device_inode[1],
    }


def recheck_arm_process(args, probe, pid, process, host_log, plan):
    require(
        probe.process_start_ticks(pid) == process["start_ticks"],
        "server PID was reused during qualification",
    )
    require(
        Path("/proc/sys/kernel/random/boot_id").read_text("ascii").strip()
        == process["boot_id"],
        "host rebooted during qualification",
    )
    require(
        probe.validate_log_binding(host_log, pid)
        == (process["log_device"], process["log_inode"]),
        "server log binding changed during qualification",
    )
    executable = os.open(f"/proc/{pid}/exe", os.O_RDONLY | os.O_CLOEXEC)
    try:
        observed, _ = args.suite._hash_regular_fd(
            executable, "concurrency executable", 2 * 1024 * 1024 * 1024
        )
    finally:
        os.close(executable)
    require(
        observed == plan["in_container_binary_sha256"],
        "live executable changed during qualification",
    )


@dataclasses.dataclass
class LiveArm:
    mode: str
    profile: str
    width: int
    model: str
    pid: int
    pidfd: int
    proof: dict
    process: dict
    manifest: dict
    manifest_name: str
    manifest_sha256: str
    host_log: Path
    log_locator: str
    log_fd: int
    complete_log_sha256: str | None = None


def write_artifact(suite, runtime, locator, payload, mode=0o400):
    target = suite.create_beneath(runtime, locator, "concurrency artifact", mode)
    try:
        require(len(payload) <= suite.MAX_GATE_RECEIPT_BYTES, "artifact exceeds bound")
        suite.write_all(target, payload)
        os.fsync(target)
        suite.assert_path_identity(runtime, locator, target, "concurrency artifact")
    finally:
        os.close(target)
    return digest(payload)


def terminate_server(args, pidfd, process, plan, model):
    try:
        if pidfd is None:
            candidate = find_pid(args, plan, model)
            if candidate is not None:
                pidfd = claim_pid(args, candidate, plan)
        if pidfd is not None:
            if not select.select([pidfd], [], [], 0)[0]:
                signal.pidfd_send_signal(pidfd, signal.SIGTERM)
            if not select.select([pidfd], [], [], 10)[0]:
                signal.pidfd_send_signal(pidfd, signal.SIGKILL)
                require(
                    bool(select.select([pidfd], [], [], 5)[0]),
                    "server survived forced cleanup",
                )
                raise GateFailure("VOID", "server required forced cleanup")
        process.wait(timeout=10)
    finally:
        if process.poll() is None:
            process.kill()
            process.wait(timeout=5)
        if pidfd is not None:
            os.close(pidfd)


@contextmanager
def server(args, context, mode, profile, width, locator_stem):
    """Launch one fresh in-container arm process bound to its own log file."""
    suite, probe, plan = args.suite, context.probe, context.plan
    model = context.model
    overrides, expected_live = arm_environment(
        probe, context.recipe, context.container_env, mode, profile
    )
    argv = arm_argv(plan, args, model, width, mode)
    manifest = {
        "schema": probe.LAUNCH_SCHEMA,
        "argv": argv,
        "cwd": args.container_cwd,
        "base_url": args.base_url,
        "model": model,
        "environment": expected_live,
        "provenance": context.provenance.source_closure,
    }
    manifest_raw = suite.canonical_bytes(manifest)
    manifest_locator = locator_stem + ".manifest.json"
    manifest_sha256 = write_artifact(suite, context.runtime, manifest_locator, manifest_raw)
    log_locator = locator_stem + ".server.log"
    log_fd = suite.create_beneath(
        context.runtime, log_locator, "concurrency server log", 0o600
    )
    process = None
    pid = pidfd = None
    live = None
    try:
        host_log = context.runtime / log_locator
        container_log = args.container_results_path.rstrip("/") + "/" + log_locator
        command = launch_command(args, plan, overrides, argv, container_log)
        process = subprocess.Popen(command, stdin=subprocess.DEVNULL)
        deadline = time.monotonic() + READY_TIMEOUT
        while time.monotonic() < deadline:
            require(process.poll() is None, "server launcher exited before readiness")
            if pid is None:
                pid = find_pid(args, plan, model)
                if pid is not None:
                    pidfd = claim_pid(args, pid, plan)
            if pid is not None:
                try:
                    request(args, "GET", "/health", timeout=2)
                    request(args, "GET", "/health", timeout=2)
                    proof = suite.verify_live_server(
                        {
                            "schema": "flux-r15-live-process-request/1",
                            "mode": mode,
                            "host_pid": pid,
                        },
                        plan,
                        args.identities,
                    )
                    bound = bind_arm_process(probe, pid, manifest, host_log)
                    live = LiveArm(
                        mode,
                        profile,
                        width,
                        model,
                        pid,
                        pidfd,
                        proof,
                        bound,
                        manifest,
                        Path(manifest_locator).name,
                        manifest_sha256,
                        host_log,
                        log_locator,
                        log_fd,
                    )
                    break
                except (
                    ConnectionError,
                    TimeoutError,
                    OSError,
                    http.client.HTTPException,
                ):
                    pass
            time.sleep(0.1)
        require(live is not None, "fresh server readiness deadline expired")
        yield live
        final = suite.verify_live_server(
            {"schema": "flux-r15-live-process-request/1", "mode": mode, "host_pid": pid},
            plan,
            args.identities,
        )
        require(final == live.proof, "server identity changed during the arm")
        recheck_arm_process(args, probe, pid, live.process, host_log, plan)
    finally:
        try:
            if process is not None:
                terminate_server(args, pidfd, process, plan, model)
        finally:
            try:
                os.fchmod(log_fd, 0o400)
                complete_sha256 = publish_arm_log(args, suite, log_locator, log_fd)
                suite.assert_path_identity(
                    context.runtime, log_locator, log_fd, "complete concurrency server log"
                )
                if live is not None:
                    live.complete_log_sha256 = complete_sha256
            finally:
                os.close(log_fd)


# --- timing hook -----------------------------------------------------------


class TimingRegistry:
    """Per-request TTFT and decode timing captured around the probe's urlopen."""

    def __init__(self):
        self.lock = threading.Lock()
        self.records = []

    def drain(self):
        with self.lock:
            records, self.records = self.records, []
        return records


class TimedResponse:
    def __init__(self, response, record):
        self.response = response
        self.record = record

    def __enter__(self):
        self.response.__enter__()
        return self

    def __exit__(self, *exc):
        self.record["finished_unix"] = time.time()
        return self.response.__exit__(*exc)

    @property
    def status(self):
        return self.response.status

    def read(self, *arguments):
        return self.response.read(*arguments)

    def __iter__(self):
        for line in self.response:
            if self.record["first_content_unix"] is None and line.startswith(b"data:"):
                payload = line[5:].strip()
                if payload and payload != b"[DONE]" and b'"content"' in payload:
                    self.record["first_content_unix"] = time.time()
            yield line


def install_timing_hook(probe, registry):
    real_urlopen = urllib.request.urlopen

    def timed_urlopen(request_object, timeout=None):
        record = {
            "body_sha256": digest(request_object.data or b""),
            "started_unix": time.time(),
            "first_content_unix": None,
            "finished_unix": None,
        }
        with registry.lock:
            registry.records.append(record)
        return TimedResponse(real_urlopen(request_object, timeout=timeout), record)

    probe.urllib = types.SimpleNamespace(
        request=types.SimpleNamespace(
            Request=urllib.request.Request, urlopen=timed_urlopen
        ),
        error=urllib.error,
        parse=urllib.parse,
    )


def timing_rows(probe, registry, model, cases, max_tokens):
    labels = {}
    for case in cases:
        body = probe.json_canonical(probe.request_body(model, case, max_tokens))
        labels.setdefault(digest(body), case.label)
    rows = []
    for record in registry.drain():
        label = labels.get(record["body_sha256"])
        if label is None:
            continue
        first, finished = record["first_content_unix"], record["finished_unix"]
        decode = (
            None if first is None or finished is None or finished <= first
            else finished - first
        )
        rows.append(
            {
                "label": label,
                "ttft_s": None if first is None else first - record["started_unix"],
                "decode_s": decode,
                "tokens_per_second": None if decode is None else max_tokens / decode,
                "elapsed_s": (
                    None if finished is None else finished - record["started_unix"]
                ),
            }
        )
    return rows


# --- state contract --------------------------------------------------------


@contextmanager
def state_contract(probe, mode):
    """Native-K5 arms must carry engaged-native-mtp receipts; plain is untouched."""
    if mode == "none":
        yield
        return
    original_validate = probe.validate_state_receipt
    original_semantics = probe.baseline_semantics

    def k5_validate(scope, receipt, expected_output_tokens, expected_prompt_tokens):
        require(
            (receipt.mode, receipt.scheduler_path, receipt.proposer_loaded) == K5_STATE,
            f"{scope}: target-state receipt is not an engaged native-K5 receipt",
        )
        shadow = dataclasses.replace(
            receipt,
            mode=PLAIN_STATE[0],
            scheduler_path=PLAIN_STATE[1],
            proposer_loaded=PLAIN_STATE[2],
        )
        original_validate(scope, shadow, expected_output_tokens, expected_prompt_tokens)

    def k5_semantics(rows):
        rewritten = []
        for row in rows:
            state = row.get("target_state") if type(row) is dict else None
            require(
                type(state) is dict
                and (state.get("mode"), state.get("scheduler_path"), state.get("proposer_loaded"))
                == K5_STATE,
                "reference receipt baseline C1 row is not native-K5",
            )
            rewritten.append(
                {
                    **row,
                    "target_state": {
                        **state,
                        "mode": PLAIN_STATE[0],
                        "scheduler_path": PLAIN_STATE[1],
                        "proposer_loaded": PLAIN_STATE[2],
                    },
                }
            )
        return original_semantics(rewritten)

    probe.validate_state_receipt = k5_validate
    probe.baseline_semantics = k5_semantics
    try:
        yield
    finally:
        probe.validate_state_receipt = original_validate
        probe.baseline_semantics = original_semantics


# --- arm phases ------------------------------------------------------------


def frame_census(text):
    """Executed-width census that tolerates aliased sessions (same-prompt waves)."""
    counts = {"native": {}, "serial": {}}
    for route, rows in FRAME_CENSUS_RE.findall(text):
        table = counts[route.lower()]
        table[int(rows)] = table.get(int(rows), 0) + 1
    return {
        "native_frames_by_rows": {str(k): v for k, v in sorted(counts["native"].items())},
        "serial_frames_by_rows": {str(k): v for k, v in sorted(counts["serial"].items())},
        "native_width_executed": max(counts["native"], default=0),
        "serial_width_executed": max(counts["serial"], default=0),
    }


def require_executed_width(census, expected_route, width, phase):
    """Fail the phase when the claimed width was not what the engine executed."""
    if expected_route == "native":
        require(
            census["native_width_executed"] == width
            and not any(int(k) >= 2 for k in census["serial_frames_by_rows"]),
            f"{phase}: native width C{width} was not executed (collapse to serial)",
        )
    else:
        require(
            census["native_width_executed"] == 0,
            f"{phase}: serial control unexpectedly executed the native route",
        )


def token_divergence(observed, baseline):
    for index, (left, right) in enumerate(zip(observed, baseline)):
        if left != right:
            return index
    return None if len(observed) == len(baseline) else min(len(observed), len(baseline))


def divergence_rows(results, baseline_results):
    return [
        {
            "label": result.label,
            "first_divergence_index": token_divergence(
                result.token_ids, baseline_results[result.label].token_ids
            ),
        }
        for result in results
    ]


@dataclasses.dataclass
class ArmPlan:
    width: int
    expected_route: str
    wave_cases: list
    churn_replacement: object
    baseline_cases: list
    plan: dict


def arm_plan(args, probe, context, live):
    wave_cases = probe.make_cases(live.width)
    churn_replacement = probe.make_cases(live.width + 1)[-1] if live.width == 8 else None
    baseline_cases = wave_cases + ([churn_replacement] if churn_replacement else [])
    expected_route = "serial" if live.profile == "serial-control" else "native"
    plan = {
        "schema": probe.SCHEMA,
        "evidence_tier": "full",
        "selector_profile": live.profile,
        "width": live.width,
        "expected_route": expected_route,
        "model": live.model,
        "max_tokens": args.max_tokens,
        "minimum_full_frames": args.minimum_full_frames,
        "memory_floor_mib": args.memory_floor_mib,
        "probe_name": Path(args.probe_program).name,
        "probe_sha256": args.probe_sha256,
        "expected_binary_sha256": context.plan["in_container_binary_sha256"],
        "expected_manifest_sha256": live.manifest_sha256,
        "cases": [
            {
                "label": case.label,
                "ordinal": case.ordinal,
                "prompt_sha256": case.prompt_sha256,
            }
            for case in baseline_cases
        ],
    }
    plan["plan_sha256"] = digest(probe.json_canonical(plan))
    return ArmPlan(
        live.width, expected_route, wave_cases, churn_replacement, baseline_cases, plan
    )


def check_fresh_log(probe, cursor):
    initial = cursor.mark()
    preexisting = cursor.read_from(0, settle_seconds=0.0, end_offset=initial)
    probe.validate_evidence_line_syntax(preexisting)
    require(
        not any(
            pattern.search(preexisting)
            for pattern in (probe.ENGAGED_RE, probe.FRAME_RE, probe.LOGITS_RE, probe.STATE_RE)
        ),
        "server log contains inference receipts; use a fresh process",
    )


@dataclasses.dataclass
class Baseline:
    results: dict
    sessions: dict
    logits: dict
    states: dict
    receipts: list


def run_baseline(args, probe, context, live, plan, cursor):
    base = Baseline({}, {}, {}, {}, [])
    for case in plan.baseline_cases:
        offset = cursor.mark()
        result = probe.stream_request(
            args.base_url, live.model, case, args.max_tokens, args.timeout
        )
        base.results[case.label] = result
        parsed = probe.parse_log(cursor.read_from(offset))
        session = probe.sole_session(parsed, case.label)
        rows = probe.row_digest_map(parsed.rows_by_session[session])
        require(
            list(rows) == list(range(1, args.max_tokens)),
            f"{case.label}: C1 logits indices differ from 1..{args.max_tokens - 1}",
        )
        require(not parsed.frames, f"{case.label}: isolated C1 emitted batch frames")
        require(
            set(parsed.state_by_session) == {session},
            f"{case.label}: isolated C1 target-state session differs",
        )
        state = parsed.state_by_session[session]
        probe.validate_state_receipt(
            case.label, state, len(result.token_ids), result.usage["prompt_tokens"]
        )
        base.sessions[case.label] = session
        base.logits[case.label] = rows
        base.states[case.label] = state
        logits = probe.serialize_logit_rows(parsed.rows_by_session[session])
        base.receipts.append(
            {
                **probe.serialize_result(result),
                "session": session,
                "logits_rows": len(rows),
                "logits": logits,
                "logits_sha256_chain": digest(probe.json_canonical(logits)),
                "target_state": probe.state_signature(state),
                "log_sha256": parsed.text_sha256,
            }
        )
    require(
        len(set(base.sessions.values())) == len(base.sessions),
        "distinct C1 prompts collided on the session hash",
    )
    context.timing_rows[f"{live.mode}/{live.profile}-c{live.width}/baseline"] = (
        timing_rows(probe, context.timing, live.model, plan.baseline_cases, args.max_tokens)
    )
    return base


def validate_reference(args, probe, context, live, plan, base, reference):
    if live.profile == "native-reference":
        require(reference is None, "native-reference must not consume a reference")
        return None
    require(reference is not None, "optimized/serial arms require a reference arm")
    namespace = types.SimpleNamespace(
        reference_receipt=Path(reference["path"]),
        reference_receipt_sha256=reference["sha256"],
        width=live.width,
        model=live.model,
        max_tokens=args.max_tokens,
        memory_floor_mib=args.memory_floor_mib,
    )
    public = {**context.provenance.public, "selector_profile": live.profile}
    return probe.validate_reference_receipt(namespace, plan.plan, public, base.receipts)


def run_validated_wave(args, probe, context, live, plan, base, cursor, name, cases):
    offset = cursor.mark()
    results = probe.run_wave(args.base_url, live.model, cases, args.max_tokens, args.timeout)
    text = cursor.read_from(offset)
    key = f"{live.mode}/{live.profile}-c{live.width}/{name}"
    context.timing_rows[key] = timing_rows(
        probe, context.timing, live.model, cases, args.max_tokens
    )
    context.diagnostics[key] = {
        "divergence": divergence_rows(results, base.results),
        "census": frame_census(text),
    }
    wave = probe.validate_wave(
        name,
        plan.expected_route,
        live.width,
        cases,
        results,
        probe.parse_log(text),
        base.results,
        base.sessions,
        base.logits,
        base.states,
        args.minimum_full_frames,
    )
    require_executed_width(context.diagnostics[key]["census"], plan.expected_route, live.width, name)
    return wave, results


def run_c8_churn(args, probe, context, live, plan, base, cursor):
    churn_offset = cursor.mark()
    churn = probe.run_api_churn(
        args.base_url,
        live.model,
        plan.wave_cases,
        plan.churn_replacement,
        args.max_tokens,
        args.timeout,
        base.results,
    )
    churn_text = cursor.read_from(churn_offset)
    key = f"{live.mode}/{live.profile}-c8/churn"
    context.diagnostics[key] = {"census": frame_census(churn_text)}
    receipt = probe.validate_full_churn(
        plan.expected_route,
        live.width,
        plan.wave_cases,
        plan.churn_replacement,
        churn,
        probe.parse_log(churn_text),
        base.results,
        base.sessions,
        base.logits,
        base.states,
    )
    require_executed_width(context.diagnostics[key]["census"], plan.expected_route, 8, "churn")
    reuse_offset = cursor.mark()
    reuse_result = probe.stream_request(
        args.base_url, live.model, plan.churn_replacement, args.max_tokens, args.timeout
    )
    reuse = probe.validate_reuse_phase(
        probe.parse_log(cursor.read_from(reuse_offset)),
        plan.churn_replacement,
        reuse_result,
        base.results[plan.churn_replacement.label],
        base.sessions[plan.churn_replacement.label],
        base.logits[plan.churn_replacement.label],
        base.states[plan.churn_replacement.label],
    )
