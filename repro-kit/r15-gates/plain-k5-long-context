def supervise(argv, token):
    child = descriptor = None
    forced = False
    cleanup_errors = []

    def signal_owned_child(signum):
        if descriptor is not None:
            try:
                signal.pidfd_send_signal(descriptor, signum)
                return
            except ProcessLookupError:
                return
            except BaseException as error:
                cleanup_errors.append(error)
        # This single-threaded parent owns the direct child. Popen tracks any
        # successful reaping before its direct-child signal fallback.
        try:
            if signum == signal.SIGTERM:
                child.terminate()
            else:
                child.kill()
        except BaseException as error:
            cleanup_errors.append(error)

    try:
        # The host enables launch only after its output pump owns the log FD.
        if os.read(0, 1) != b"G":
            return 0
        child = subprocess.Popen(argv, stdin=subprocess.DEVNULL)
        # Do not poll/wait first: an unreaped direct child cannot reuse its PID.
        descriptor = os.pidfd_open(child.pid)
        while True:
            ready = select.select([0, descriptor], [], [], None)[0]
            if descriptor in ready or (0 in ready and not os.read(0, 65536)):
                break
    finally:
        if child is not None:
            try:
                try:
                    running = descriptor is None or not select.select(
                        [descriptor], [], [], 0
                    )[0]
                except BaseException as error:
                    cleanup_errors.append(error)
                    running = True
                if running:
                    signal_owned_child(signal.SIGTERM)
                try:
                    child.wait(timeout=10)
                except BaseException as error:
                    if not isinstance(error, subprocess.TimeoutExpired):
                        cleanup_errors.append(error)
                    forced = True
                    signal_owned_child(signal.SIGKILL)
                    child.wait(timeout=5)
            finally:
                if descriptor is not None:
                    os.close(descriptor)
        if cleanup_errors:
            raise cleanup_errors[0]
        print("R16_EXEC_CLEANUP token=" + token
              + " child_started=" + str(child is not None).lower()
              + " retired=true forced=" + str(forced).lower(), flush=True)
    return 1 if forced else 0

if __name__ == "__main__":
