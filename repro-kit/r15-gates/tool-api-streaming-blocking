class GateFailure(ValueError):
    """The live endpoint answered, but the sealed tool-call contract did not pass."""


def require(condition, message):
    if not condition:
        raise ValueError(message)


def digest(raw):
    return hashlib.sha256(raw).hexdigest()


def load_checked(path, expected, name):
    """Execute exactly the verified bytes, without pathname-based imports."""
    descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        before = os.fstat(descriptor)
        require(
            stat.S_ISREG(before.st_mode) and 0 < before.st_size <= 16 * 1024 * 1024,
            "helper is not a bounded regular file",
        )
        payload = os.pread(descriptor, before.st_size + 1, 0)
        after = os.fstat(descriptor)

        def identity(value):
            return (value.st_dev, value.st_ino, value.st_size, value.st_mtime_ns, value.st_ctime_ns)

        require(
            identity(before) == identity(after) and digest(payload) == expected,
            "source helper hash or identity differs",
        )
    finally:
        os.close(descriptor)
    module = types.ModuleType(name)
    module.__file__ = str(path)
    sys.modules[name] = module
    try:
        exec(compile(payload, str(path), "exec"), module.__dict__)
    except BaseException:
        sys.modules.pop(name, None)
        raise
    return module


def load_sealed_manifest(path, microgate):
    """The sealed tool case: exact tracked bytes, strict JSON, microgate manifest validation."""
    descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        info = os.fstat(descriptor)
        require(
            stat.S_ISREG(info.st_mode) and 0 < info.st_size <= MAX_MANIFEST_BYTES,
            "tool manifest is not a bounded regular file",
        )
        raw = os.pread(descriptor, info.st_size + 1, 0)
    finally:
        os.close(descriptor)
    require(digest(raw) == MANIFEST_SHA256, "sealed tool manifest hash differs")
    value = microgate.strict_json_loads(raw.decode("utf-8", "strict"), "tool manifest")
    return value, microgate.validate_manifest(value)


