# ==============================================================================
# Flux Engine Operating Recipe: flux-v9-w4096-interactive.env
# Mode Alias:  --mode interactive-w4096 (w4096 / 4,096-token prefill chunks)
# Pair With:   recipes/flux-serve-w4096.argv
# Bridge:      source scripts/flux_env_bridge.sh --mode interactive-w4096
# ==============================================================================
# Certified Performance (NVIDIA Grace Blackwell GB10 / sm_121a, Qwen3.8-Flash-Next NVFP4):
#   - 8K   (8,192 tok):   5,276.3 tok/s peak | 5,266.8 tok/s median (1,555.4 ms/8K)
#   - 16K  (16,384 tok):  5,176.9 tok/s peak | 5,164.5 tok/s median (1,586.2 ms/8K)
#   - 32K  (32,768 tok):  5,125.1 tok/s peak | 5,116.2 tok/s median (1,601.2 ms/8K)
#   - 64K  (65,536 tok):  5,026.5 tok/s peak | 5,016.1 tok/s median (1,633.1 ms/8K)
#   - 128K (131,072 tok): 4,899.8 tok/s peak | 4,891.7 tok/s median (1,674.7 ms/8K)
#   - Decode (K=5 MTP):   57.4 tok/s peak    | 56.3 tok/s median (LOSSLESS 10/10 = 2,560/2,560 exact)
#   - Memory Safety:      11,907 - 12,695 MiB MemAvailable floor (+4.2 GiB extra UMA headroom vs w16384)
#
# Architecture Notes:
#   Caps prefill chunk arena to 4,096 tokens via FLUX_QWEN4_PREFILL_WIDE=4096
#   while retaining > 5,000 tok/s prefill from 8K through 64K and 11,907+ MiB
#   free unified memory floor for co-resident host processes.
# ==============================================================================

# --- Flux Public Branded Selectors (translated by scripts/flux_env_bridge.sh) ---
FLUX_MODE=interactive-w4096
FLUX_QWEN4_PREFILL_WIDE=4096
FLUX_QWEN4_PREFILL_MOE_V28Q=2
FLUX_QWEN4_PREFILL_MHC_ROOF=t128
FLUX_QWEN4_PREFILL_QSA_FP8=qkpv
FLUX_QWEN4_PREFILL_QSA_PIPE=1
FLUX_QWEN4_PREFILL_GDN_CONV_V3=1
FLUX_QWEN4_PREFILL_GDN_NORM_FP8_V2=1
FLUX_PLE_READ_RINGS=4
FLUX_PLE_SECTOR_READ=1
FLUX_QWEN4_FAST_PROJ_FP8_WEIGHT_CACHE_RESERVE_GB=6

# --- Core Unified Prefill (w4096) + K=5 Speculative Decode Engine Selectors ---
ATLAS_BOUNDED_HOST_COPY=1
ATLAS_CUBLAS_TUNED=0
ATLAS_DFLASH_ASYNC=0
ATLAS_DFLASH_SPEC_CYCLE_V2=1
ATLAS_MOE_T_LANES=1
