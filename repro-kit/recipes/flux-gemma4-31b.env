# ==============================================================================
# Flux Engine Model Recipe: flux-gemma4-31b.env
# Target:     gemma-4-31b (nvidia/Gemma-4-31B-IT-NVFP4, dense, BF16 attention)
# Env:        ATLAS_ATTN_DENSE_CUBLASLT=1: BF16 attention projections in prefill use
#             cuBLASLt instead of the scalar dense_gemm_bf16 kernel (~55 tok/s prefill without it).
#             ATLAS_GEMMA_PREFILL_512_TC=1: the 10 full-attention (HDIM=512) layers use the
#             tensor-core inferspark_prefill_512tc instead of the scalar reference.
#             ATLAS_GEMMA4_FFN_TRANSPOSE=1: build transposed NVFP4 FFN copies (~11.7 GB) so dense
#             FFN prefill takes w4a16_gemm_t_m128 instead of the untransposed w4a16_gemm.
#             Otherwise the engine runs its MODEL.toml defaults. This file replaces the Qwen3.8-Flash-Next
#             mode environment, which is not applicable to Gemma.
# Launch:     flux-autodetect applies the launch knobs: BF16 KV always (FP8/NVFP4 KV corrupts
#             attention: norm weights reach 588, above the E4M3 limit of 448), --max-seq-len
#             36864 (~33.8 GiB of BF16 KV) with --max-prefill-tokens equal to it (one-call prefill
#             profile policy; flux-autodetect pins prefix_cache_supported=False), --gpu-memory-utilization 0.78,
#             --tool-call-parser gemma4, no speculation.
# ==============================================================================
ATLAS_ATTN_DENSE_CUBLASLT=1
FLUX_ATTN_DENSE_CUBLASLT=1
ATLAS_GEMMA_PREFILL_512_TC=1
FLUX_GEMMA_PREFILL_512_TC=1
ATLAS_GEMMA4_FFN_TRANSPOSE=1
FLUX_GEMMA4_FFN_TRANSPOSE=1
