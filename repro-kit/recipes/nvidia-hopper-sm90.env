# ==============================================================================
# Flux Engine Operating Recipe: nvidia-hopper-sm90.env
# Topology:    NVIDIA H100 / H200 / GH200 Hopper (SM90a, 80-141 GB HBM3/HBM3e)
# Status:      Experimental template — Hopper SM90 CUDA kernel backend is not yet implemented
#              in this release (see docs/SM120_SM103_BRINGUP.md). Do not use for production serving.
# ==============================================================================
FLUX_TOPOLOGY=generic-gpu
FLUX_ARCH_TARGET=sm_90a
FLUX_MODE=max-prefill
ATLAS_QWEN4_PREFILL_WIDE=8192
ATLAS_QWEN4_PREFILL_ATTN_FLASH=1
ATLAS_QWEN4_PREFILL_QSA=1
ATLAS_PLE_READ_RINGS=4
ATLAS_PLE_SECTOR_READ=1
ATLAS_BOUNDED_HOST_COPY=1
ATLAS_ALLOC_SEQ_ASYNC=1
ATLAS_QWEN4_K5_HYBRID=1
ATLAS_QWEN4_VERIFY_GRAPH=1
