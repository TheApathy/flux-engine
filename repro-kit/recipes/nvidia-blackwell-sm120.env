# ==============================================================================
# Flux Engine Operating Recipe: nvidia-blackwell-sm120.env
# Topology:    Discrete NVIDIA Blackwell SM120 (RTX 5090 / RTX PRO 5000 / 6000)
#              & Blackwell Ultra SM103 (B300 / GB300)
# Notes:       188-SM / 96 MiB L2 verified SM120 profile:
#              - Flash-Next prefill: V31_WS (auto, grid=188), mHC t128_w4 +
#                inject_2cta, shared/sort overlap, QSA FP8 qkpv + e4m3_2cta +
#                v8_shared (requires --kv-cache-dtype bf16), FlashInfer f16 GDN
#                nf8_strip (strip=4096, conv_v3 + conv_v4_strip), full 120/120
#                FP8 fast-proj weight cache, zero-syscall tmpfs PLE mmap.
#              - Flash-Next C=1..64 decode/verify: 192-CTA Split-V=4 GDN,
#                64-partition GQA-12 ragged decode, auto v28_m16 (<96 rows) /
#                V31_WS grid=188 (>=96 rows) MoE verify, C1 TC verify, batched
#                K5 with COHORT_ADAPTIVE_K=0 for full SM120 C=24..64 scaling.
#              - Qwen3.8-27B: single-launch BF16xBF16 MMA coalesced warp-split-K
#                (M=1..64, fused gate+up+silu + down/QKV/SSM/lm_head), WY17 lazy
#                SSM commit, 3-CTA/SM streaming multi-seq GDN, native CUDA 13.0
#                cuBLASLt NVFP4 dense FFN + merged gate/up + projections for prefill,
#                FlashInfer BF16 chunked GDN prefill, piecewise multi-seq CUDA
#                graphs (C=4..64), and CUDA-graphed DFlash2 drafting.
# ==============================================================================
FLUX_TOPOLOGY=generic-gpu
FLUX_ARCH_TARGET=sm_120a
FLUX_MODE=max-prefill
# Note: flux-autodetect sets ATLAS_QWEN4_PREFILL_WIDE dynamically to match
# --max-prefill-tokens (16384 for max-prefill; 2048 for C=64 high concurrency).
ATLAS_QWEN4_PREFILL_MOE_V28Q=2
ATLAS_QWEN4_PREFILL_MOE_V31_WS=auto
ATLAS_QWEN4_PREFILL_MOE_V31_MAX_GRID=188
ATLAS_QWEN4_PREFILL_MHC_ROOF=t128_w4
ATLAS_QWEN4_PREFILL_MHC_INJECT_2CTA=1
ATLAS_QWEN4_PREFILL_SHARED_SORT_OVERLAP=1
ATLAS_QWEN4_PREFILL_QSA_FP8=qkpv
ATLAS_QWEN4_PREFILL_QSA_PIPE=1
ATLAS_QWEN4_PREFILL_QSA_E4M3_2CTA=1
ATLAS_QWEN4_PREFILL_QSA_V8_SHARED=1
ATLAS_QWEN4_PREFILL_GDN_FI=2
ATLAS_QWEN4_PREFILL_GDN_NORM_FP8=3
ATLAS_QWEN4_PREFILL_GDN_NF8_STRIP=1
ATLAS_QWEN4_PREFILL_GDN_CONV_V3=1
ATLAS_QWEN4_PREFILL_GDN_CONV_V4_STRIP=1
ATLAS_QWEN4_PREFILL_GDN_FI_STRIP_ROWS=4096
ATLAS_QWEN4_PREFILL_FAST_PROJ_FP8_WEIGHT_CACHE=1
ATLAS_QWEN4_PREFILL_FAST_PROJ_FP8_WEIGHT_CACHE_RESERVE_GB=1
ATLAS_PLE_MMAP=1
ATLAS_PLE_READ_RINGS=4
ATLAS_PLE_SECTOR_READ=1
ATLAS_QWEN4_GDN_SPLIT_V=1
ATLAS_QWEN4_C1_TC_VERIFY=1
ATLAS_QWEN4_C1_DENSE_ATTN=1
ATLAS_QWEN4_SHARED_OVERLAP_THIN_SK=1
ATLAS_QWEN4_K5_HYBRID=1
ATLAS_QWEN4_K5_NATIVE_MOE=1
ATLAS_QWEN4_BATCHED_K5=1
ATLAS_QWEN4_BATCHED_ADAPTIVE_K=1
ATLAS_QWEN4_COHORT_ADAPTIVE_K=0
ATLAS_QWEN4_VERIFY_GRAPH=1
ATLAS_QWEN4_RELEASE_UNUSED=1
ATLAS_QWEN4_RELEASE_SPEC_UNUSED=1
ATLAS_CUBLASLT_NVFP4=1
ATLAS_CUBLASLT_NVFP4_MERGED_GATEUP=1
ATLAS_27B_PROJ_CUBLASLT_NVFP4=1
ATLAS_PREFILL_QKNORM_ROPE=1
ATLAS_GDN_PREFILL_FI=1
ATLAS_MULTISEQ_GRAPHS=1
ATLAS_SSM_PROJ_TC=1
ATLAS_GATEUP_N32=0
ATLAS_WY17_LAZY_COMMIT=1
ATLAS_DFLASH_NOISE_GRAPH=1
ATLAS_DFLASH_DRAFT_SPLITK=8
ATLAS_FFN_DOWN_SPLITK=8
ATLAS_SSM_OUT_SPLITK=8
ATLAS_SSM_QKVZ_SPLITK=2
ATLAS_ATTN_QKV_SPLITK=8
ATLAS_VERIFY_ARGMAX_ROWS=1
ATLAS_BOUNDED_HOST_COPY=1
ATLAS_ALLOC_SEQ_ASYNC=1
