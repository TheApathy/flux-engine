# ==============================================================================
# Flux Engine Operating Recipe: 3x-spark-pp3-disagg.env
# Topology:    3x NVIDIA DGX Spark (3x GB10 / sm_121a, 384 GB aggregate UMA)
# Interconnect: Switched / Daisy-Chained QSFP56 200GbE ConnectX-7 RoCEv2
# Modes Supported:
#   Mode A — 3x PP=3 Pipeline Ring (16 layers = 4 exact 3-GDN+1-QSA blocks/Spark,
#            ~27.2 GiB weights/Spark, 7M BF16 / 12M NVFP4 KV pool, respects kv_heads=2):
#     Node 0: FLUX_MODE=3x-spark FLUX_CONCURRENCY=16 FLUX_NODE_RANK=0 \
#               FLUX_MASTER_ADDR=<SPARK0_IP> flux serve
#     Node 1: FLUX_MODE=3x-spark FLUX_CONCURRENCY=16 FLUX_NODE_RANK=1 \
#               FLUX_MASTER_ADDR=<SPARK0_IP> flux serve
#     Node 2: FLUX_MODE=3x-spark FLUX_CONCURRENCY=16 FLUX_NODE_RANK=2 \
#               FLUX_MASTER_ADDR=<SPARK0_IP> flux serve
#   Mode B — 1P + 2D Disaggregated Serving + Sticky flux-router:
#     Node 0 (Prefill): spark serve <MODEL> --role prefill --port 8001 --qwen4-qsa
#     Node 1 (Decode0): spark serve <MODEL> --role decode --disagg-peer http://<SPARK0_IP>:8001 \
#                         --port 8000 --dflash --qwen4-qsa
#     Node 2 (Decode1): spark serve <MODEL> --role decode --disagg-peer http://<SPARK0_IP>:8001 \
#                         --port 8000 --dflash --qwen4-qsa
#     Router: flux-router --backends <SPARK1_IP>:8000,<SPARK2_IP>:8000
# ==============================================================================

FLUX_TOPOLOGY=3x-spark
FLUX_CLUSTER_WORLD_SIZE=3
FLUX_TENSOR_PARALLEL_SIZE=1
FLUX_EXPERT_PARALLEL_SIZE=1
FLUX_PIPELINE_PARALLEL_SIZE=3
FLUX_CPU_AFFINITY=5-9,15-19

# --- ConnectX-7 200GbE RoCEv2 Ring Transport ---
NCCL_IB_DISABLE=0
NCCL_IB_HCA=mlx5_0
NCCL_IB_GID_INDEX=3
NCCL_NET_GDR_LEVEL=5
NCCL_PROTO=LL128,Simple
NCCL_MIN_NCHANNELS=8

# --- Next-Gen PP=3 16-Layer Stage Ring + 7M-12M KV Stack ---
ATLAS_QWEN4_FP8_PAD128=1
ATLAS_CUBLASLT_CACHE=1
ATLAS_QWEN4_GDN_VERIFY_FUSED=1
ATLAS_QWEN4_QSA_FUSED_GATE=1
ATLAS_QWEN4_QSA_SELECT_V3=1
ATLAS_CUDA_PDL=1
ATLAS_CUDA_WFET_SYNC=1
ATLAS_QWEN4_PREFILL_WIDE=16384
ATLAS_QWEN4_PREFILL_MOE_V28Q=2
ATLAS_QWEN4_PREFILL_MHC_ROOF=t128
ATLAS_QWEN4_PREFILL_QSA_FP8=qkpv
ATLAS_QWEN4_PREFILL_QSA_PIPE=1
ATLAS_QWEN4_PREFILL_GDN_CONV_V3=1
ATLAS_QWEN4_PREFILL_GDN_NORM_FP8_V2=1
ATLAS_PLE_READ_RINGS=4
ATLAS_PLE_SECTOR_READ=1
ATLAS_QWEN4_K5_HYBRID=1
ATLAS_QWEN4_K5_NATIVE_MOE=1
ATLAS_UNIFIED_MOE_LAYOUT=1
ATLAS_FAST_LOAD_DIRECT_IO_TENSOR_CAP=20000
ATLAS_PLE_CACHE_MB=0
ATLAS_QWEN4_PLE_IO_QUEUE_DEPTH=256
ATLAS_QWEN4_PLE_IO_TIMEOUT_MS=30000
RUST_LOG=info
