# ==============================================================================
# Flux Engine Operating Recipe: 4x-spark-cluster.env
# Topology:    4x NVIDIA DGX Spark (4x GB10 / sm_121a, 512 GB aggregate UMA)
# Interconnect: Dual-port ConnectX-7 200GbE QSFP56 RoCEv2 / GPUDirect RDMA
# Modes Supported:
#   Mode A — 4x TP=4 + EP=4 Lockstep (DEFAULT: 6 Q + 1 replicated KV head,
#            128 local experts/Spark, ~24.7 GiB weights/Spark, compact MoE stack,
#            W=8 DFlash2 C=1..16, 5M BF16 / 10M NVFP4 KV pool):
#     Node 0..3: FLUX_MODE=4x-spark FLUX_CONCURRENCY=16 FLUX_NODE_RANK=<0..3> \
#                  FLUX_MASTER_ADDR=<SPARK0_IP> flux serve
#   Mode B — 4x PP=4 Pipeline Ring (12 layers = 3 exact 3-GDN+1-QSA blocks/Spark,
#            ~20.5 GiB weights/Spark, 10M BF16 / 16M NVFP4 KV pool, batched K=5 MTP):
#     Node 0..3: FLUX_MODE=4x-spark FLUX_PP_SIZE=4 FLUX_CONCURRENCY=16 \
#                  FLUX_NODE_RANK=<0..3> FLUX_MASTER_ADDR=<SPARK0_IP> flux serve
#   Mode C — 2x Independent (2x-spark TP=2+EP=2 + W=8 DFlash2) Replicas behind flux-router
#            (max throughput + W=8 DFlash2 + 6M-12M aggregate KV):
#     Cluster A (Spark 0+1): FLUX_MODE=2x-spark FLUX_CONCURRENCY=16 ...
#     Cluster B (Spark 2+3): FLUX_MODE=2x-spark FLUX_CONCURRENCY=16 ...
#     Router: flux-router --backends <CLUSTER_A>:8899,<CLUSTER_B>:8899
# ==============================================================================
FLUX_TOPOLOGY=4x-spark
FLUX_MODE=4x-spark
FLUX_CLUSTER_WORLD_SIZE=4
FLUX_TENSOR_PARALLEL_SIZE=4
FLUX_EXPERT_PARALLEL_SIZE=4
FLUX_PIPELINE_PARALLEL_SIZE=1
FLUX_CPU_AFFINITY=5-9,15-19

# --- ConnectX-7 RoCEv2 / NCCL Low-Latency Multi-Spark Transport (site-specific defaults; override for your NIC/HCA) ---
NCCL_IB_DISABLE=0
NCCL_IB_HCA=mlx5_0,mlx5_1
NCCL_IB_GID_INDEX=3
NCCL_CROSS_NIC=1
NCCL_NET_GDR_LEVEL=5
NCCL_PROTO=Simple,LL128
NCCL_ALGO=Ring,Tree
NCCL_MIN_NCHANNELS=8
NCCL_MAX_NCHANNELS=16
NCCL_BUFFSIZE=8388608

# --- Next-Gen TP=4 + EP=4 W=8 DFlash2 + Compact MoE + 5M-10M KV Stack ---
ATLAS_QWEN4_FP8_PAD128=1
ATLAS_CUBLASLT_CACHE=1
ATLAS_QWEN4_GDN_VERIFY_FUSED=1
ATLAS_QWEN4_QSA_FUSED_GATE=1
ATLAS_QWEN4_QSA_SELECT_V3=1
ATLAS_CUDA_PDL=1
ATLAS_CUDA_WFET_SYNC=1
ATLAS_QWEN4_BATCHED_K5=1
ATLAS_QWEN4_BATCHED_ADAPTIVE_K=1
ATLAS_QWEN4_PREFILL_WIDE=16384
ATLAS_QWEN4_PREFILL_MOE_V28Q=2
ATLAS_QWEN4_PREFILL_MHC_ROOF=t128
ATLAS_QWEN4_PREFILL_QSA_FP8=qkpv
ATLAS_QWEN4_PREFILL_QSA_PIPE=1
ATLAS_QWEN4_PREFILL_GDN_CONV_V3=1
ATLAS_QWEN4_PREFILL_GDN_NORM_FP8_V2=1
ATLAS_PLE_READ_RINGS=4
ATLAS_PLE_SECTOR_READ=1
ATLAS_PLE_READ_AFFINITY=big
ATLAS_ALLOC_SEQ_ASYNC=1
ATLAS_QWEN4_K5_HYBRID=1
ATLAS_QWEN4_K5_NATIVE_MOE=1
ATLAS_QWEN4_HYBRID_ALL_K=1
ATLAS_UNIFIED_MOE_LAYOUT=1
ATLAS_FAST_LOAD_DIRECT_IO_TENSOR_CAP=20000
ATLAS_PLE_CACHE_MB=0
ATLAS_QWEN4_PLE_IO_QUEUE_DEPTH=256
ATLAS_QWEN4_PLE_IO_TIMEOUT_MS=30000
RUST_LOG=info
