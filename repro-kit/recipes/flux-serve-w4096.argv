serve
--no-tui
--bind
127.0.0.1
--port
8899
--model-from-path
<MODELS_ROOT>/Qwen3.8-Flash-Next-NVFP4-Offload
--model-name
qwen38-native-mtp-frontier-v1
--kernel-target
qwen3.8-flash-next
--gpu-memory-utilization
0.85
--kv-cache-dtype
bf16
--block-size
16
--max-seq-len
135168
--max-prefill-tokens
4096
--max-batch-size
1
--max-num-seqs
1
--ssm-cache-slots
0
--qwen4-qsa
--oom-guard-mb
4096
--request-timeout
300
--disable-simhash-watchdog
--enable-prefix-caching
false
--speculative
--num-drafts
4
--mtp-vocab
0
--mtp-quantization
bf16
