# ==============================================================================
# Flux Engine Operating Recipe: flux-nextgen-c128-concurrency.env
# Target:      1x NVIDIA DGX Spark (GB10 / sm_121a, 128 GB LPDDR5X UMA)
# Concurrency: Up to C=128 native batching & C=2..128 2-frame speculative verify
# Recommended CLI (Speculative Adaptive-K C=2..128, up to 256 verify rows/cycle):
#   spark display-carveout --lock /tmp/atlas-carveout.lock -- \
#     spark serve /models/Qwen3.8-Flash-Next-NVFP4-QAD5500-Hybrid \
#     --max-batch-size 128 --max-num-seqs 128 --kv-pool-tokens 65536 \
#     --kv-cache-dtype bf16 --qwen4-qsa --speculative --num-drafts 4 \
#     --swap-space-gb 0 --decode-gap-target-ms 150
# ==============================================================================
# Architecture Notes:
#   - Exceeds peer C=64 / 128-row speculative ceilings: supports C=1..64 in a
#     single <=128-row verify frame and C=65..128 via two balanced <=128-row K=2
#     sub-frames (130..256 verify rows/cycle) + 1-pass 64-seq MTP propose_batch.
#   - Saves ~42.7 GiB UMA at C=128 via ATLAS_SSM_DECODE_RING=0 + compact lazy-H
#     SSM pool, and accelerates ragged paged decode via 12:1 GQA SK=32 + Warp-0
#     ragged tile partitioner (ATLAS_PAGED_DECODE_RAGGED_GQA=1).
# ==============================================================================

FLUX_MODE=c128-concurrency
FLUX_CONCURRENCY=128
FLUX_KV_CACHE_DTYPE=bf16
FLUX_KV_POOL_TOKENS=65536

ATLAS_QWEN4_BATCHED_K5=1
