# ==============================================================================
# Flux Engine Model Recipe: flux-qwen38-27b-dflash2.env
# Target:     qwen3.8-27b (Qwen3.8-27B NVFP4, ModelOpt mixed FP8+NVFP4) + z-lab DFlash2 drafter
# Source:     crates/spark-server/src/recipe/builtin/qwen3.8-27b-dflash2-v15-safe-local.yaml
#             `atlas.env`, exported verbatim with the optional FlashInfer library path set
#             to the container path /opt/flux/lib/ (override via ATLAS_FLASHINFER_SM121_LIB).
# Launch:     flux-autodetect applies the matching CLI defaults for this target
#             (--max-prefill-tokens 8192, --kv-cache-dtype nvfp4 --kv-high-precision-layers 8,
#             --dflash --dflash-gamma 7 --dflash-window-size 4096 --dflash-method flat,
#             --mtp-vocab 248320, --disable-confidence-early-stop).
# Library:    ATLAS_PREFILL_FFN_FLASHINFER=1 needs libatlas_fi_fp4_sm121.so (sha256 a007a825...)
#             at /opt/flux/lib. If it is absent, or the checkpoint is compressed-tensors, the
#             launcher sets ATLAS_PREFILL_FFN_FLASHINFER=0 and prints a warning.
# ==============================================================================
ATLAS_BOUNDED_HOST_COPY=1
ATLAS_H2D_LEGACY_DRAIN=0
ATLAS_DFLASH_ASYNC=0
ATLAS_DFLASH_METHOD=flat
ATLAS_DFLASH_CTX_WINDOW=4096
ATLAS_DFLASH_DRAFT_CAP=7
ATLAS_DFLASH_NOISE_ONLY=1
ATLAS_DFLASH_QUANT=nvfp4
ATLAS_DFLASH_SPEC_CYCLE_V2=1
ATLAS_DFLASH_SWA=1
ATLAS_DFLASH_HONOR_IS_CAUSAL=1
ATLAS_DFLASH_DRAFT_SPLITK=8
ATLAS_DFLASH_PREFILL_PIPE=1
ATLAS_DFLASH_CAPTURE_STRIDED=1
ATLAS_DFLASH_LM_HEAD_NVFP4=1
ATLAS_DFLASH_LM_HEAD_FP8=0
ATLAS_DFLASH_FFN_KGAMMA=1
ATLAS_DFLASH_ATTN_KGAMMA=1
ATLAS_DFLASH_FREE_SLOTS=0
ATLAS_DFLASH_FREE_SLOTS_TAIL=4
ATLAS_DFLASH_SAM=0
ATLAS_DFLASH_RETR_WIDE=31
ATLAS_DFLASH_KERNEL_PROFILE=0
ATLAS_DFLASH_TREE_COMMIT=0
ATLAS_DFLASH_ECHO=0
ATLAS_MTP_ACCEPT_LOG=1
ATLAS_FFN_TC=1
ATLAS_SSM_PROJ_TC=1
ATLAS_LM_HEAD_TC=1
ATLAS_DECODE_TC_PARITY=1
ATLAS_LM_HEAD_T=1
ATLAS_ACCEPT_FAST_ARGMAX=1
ATLAS_PREFILL_FFN_FLASHINFER=1
ATLAS_FLASHINFER_SM121_LIB=/opt/flux/lib/libatlas_fi_fp4_sm121.so
ATLAS_FLASHINFER_FFN_EXTRA_M=1
ATLAS_GDN_PREFILL_GATECACHE=1
# PACK is an experimental two-phase-only path. With the production
# 8192-token prefill arena, long requests use the ordinary chunk fallback.
ATLAS_SSM_PREFILL_PACK=0
ATLAS_GDN_C143_PREFILL=0
ATLAS_PREFILL_PROJ_FLASHINFER=0
ATLAS_PREFILL_SSM_FLASHINFER=0
ATLAS_PREFILL_FFN_FAST=0
ATLAS_PREFILL_PROJ_FAST=0
ATLAS_PREFILL_PROJ_PIPE=1
ATLAS_PREFILL_FFN_PIPE=1
ATLAS_SSM_GDN_SEQ_PERSISTENT=1
ATLAS_SSM_GDN_LAZY=1
ATLAS_ATTN_QKV_EXACT_STRIDED=1
ATLAS_ATTN_QKV_FUSED=1
ATLAS_ATTN_QKV_SPLITK=4
ATLAS_THINK_SPEC=1
ATLAS_FFN_FUSED_GATEUP=1
ATLAS_FFN_KGAMMA_M16=1
ATLAS_FFN_KGAMMA_M128=1
ATLAS_FFN_M16_TRANSPOSED=1
ATLAS_FFN_DOWN_SPLITK=4
ATLAS_NVFP4_GATE_UP_M128=1
ATLAS_NO_GEMV_SW=1
ATLAS_TC_NVFP4_M16=0
ATLAS_TC_NVFP4_M16_MS_ATTN=0
ATLAS_SSM_OUT_SPLITK=4
ATLAS_SSM_QKVZ_SPLITK=4
ATLAS_SSM_BA_BATCH=1
ATLAS_WY17_LAZY=1
ATLAS_WY17_LAZY_COMMIT=0
ATLAS_WY17_SPLIT=2
ATLAS_DISABLE_TREE_WY=1
ATLAS_DSPARK_ASYMMETRIC_ATTN=1
ATLAS_FLASH_ATTN_KGAMMA_SPLITK=1
ATLAS_FA2_KGAMMA=1
ATLAS_PAGED_DECODE_SPLITK=1
ATLAS_MULTISEQ_GRAPHS=0
# This target's transformed cache exceeds the currently provisioned local
# disk headroom. Keep the serving-safe profile read/write-cache-free; the
# checkpoint itself loads in about a minute from the warm filesystem.
ATLAS_WEIGHT_CACHE=0
ATLAS_ATTN_PROJ_CUBLASLT=1
ATLAS_SSM_PROJ_CUBLASLT=1
