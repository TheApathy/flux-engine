# ==============================================================================
# Flux Engine Operating Recipe: 2x-spark-tp2-disagg.env
# Topology:    2x NVIDIA DGX Spark (2x GB10 / sm_121a, 256 GB aggregate UMA)
# Interconnect: Direct-attached QSFP56 200GbE ConnectX-7 RoCEv2
# Modes Supported:
#   Mode A — 2x Sticky Session DP via flux-router (2x agg throughput & KV):
#     flux-router --backends spark0:8000,spark1:8000
#   Mode B — 2x TP=2 + EP=2 (PP=1) Lockstep with W=8 DFlash2 (C=1..16, 4M BF16 / 7M NVFP4 KV):
#     Node 0: FLUX_MODE=2x-spark FLUX_CONCURRENCY=16 FLUX_NODE_RANK=0 \
#               FLUX_MASTER_ADDR=<SPARK0_IP> flux serve
#     Node 1: FLUX_MODE=2x-spark FLUX_CONCURRENCY=16 FLUX_NODE_RANK=1 \
#               FLUX_MASTER_ADDR=<SPARK0_IP> flux serve
#   Mode C — 2x PP=2 Max-KV Ring (24 layers/Spark, 4.5M BF16 / 8M NVFP4 KV):
#     Node 0/1: FLUX_MODE=2x-spark FLUX_TP_SIZE=1 FLUX_EP_SIZE=1 FLUX_PP_SIZE=2 \
#               FLUX_NODE_RANK=<0|1> FLUX_MASTER_ADDR=<SPARK0_IP> flux serve
#   Mode D — 1P + 1D Prefill/Decode Disaggregation (zero decode interference):
#     Node 0 (Prefill): spark serve <MODEL> --role prefill --port 8001 --qwen4-qsa
#     Node 1 (Decode):  spark serve <MODEL> --role decode --disagg-peer http://<SPARK0_IP>:8001 \
#                         --port 8000 --dflash --qwen4-qsa
# ==============================================================================

FLUX_TOPOLOGY=2x-spark
FLUX_CLUSTER_WORLD_SIZE=2
FLUX_TENSOR_PARALLEL_SIZE=2
FLUX_EXPERT_PARALLEL_SIZE=2
FLUX_PIPELINE_PARALLEL_SIZE=1
FLUX_CPU_AFFINITY=5-9,15-19

# --- Direct-Attach ConnectX-7 200GbE RoCEv2 Transport ---
NCCL_IB_DISABLE=0
NCCL_IB_HCA=mlx5_0
NCCL_IB_GID_INDEX=3
NCCL_NET_GDR_LEVEL=5
NCCL_PROTO=LL128,Simple
NCCL_MIN_NCHANNELS=8

# --- Next-Gen TP=2 + EP=2 W=8 DFlash2 + Fast MoE + 4M-7M KV Stack ---
ATLAS_QWEN4_FP8_PAD128=1
ATLAS_CUBLASLT_CACHE=1
ATLAS_QWEN4_GDN_VERIFY_FUSED=1
ATLAS_QWEN4_QSA_FUSED_GATE=1
ATLAS_QWEN4_QSA_SELECT_V3=1
ATLAS_CUDA_PDL=1
ATLAS_CUDA_WFET_SYNC=1
ATLAS_QWEN4_BATCHED_K5=1
ATLAS_QWEN4_BATCHED_ADAPTIVE_K=1
ATLAS_QWEN4_PREFILL_WIDE=16384
ATLAS_QWEN4_PREFILL_MOE_V28Q=2
ATLAS_QWEN4_PREFILL_MHC_ROOF=t128
ATLAS_QWEN4_PREFILL_QSA_FP8=qkpv
ATLAS_QWEN4_PREFILL_QSA_PIPE=1
ATLAS_QWEN4_PREFILL_GDN_CONV_V3=1
ATLAS_QWEN4_PREFILL_GDN_NORM_FP8_V2=1
ATLAS_PLE_READ_RINGS=4
ATLAS_PLE_SECTOR_READ=1
ATLAS_QWEN4_K5_HYBRID=1
ATLAS_QWEN4_K5_NATIVE_MOE=1
ATLAS_QWEN4_HYBRID_ALL_K=1
ATLAS_UNIFIED_MOE_LAYOUT=1
ATLAS_FAST_LOAD_DIRECT_IO_TENSOR_CAP=20000
ATLAS_PLE_CACHE_MB=0
ATLAS_QWEN4_PLE_IO_QUEUE_DEPTH=256
ATLAS_QWEN4_PLE_IO_TIMEOUT_MS=30000
RUST_LOG=info
