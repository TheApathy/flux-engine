    "--adaptive-sampling", "--allow-special-tokens-in-content", "--check-kernels", "--ddtree-chain-seed", "--dflash",
    "--disable-confidence-early-stop", "--disable-loop-watchdog", "--disable-simhash-watchdog",
    "--disable-thinking", "--disable-thinking-loop-watchdog", "--enable-prefix-caching",
    "--experimental-dflash-probabilistic", "--high-speed-swap", "--ngram-speculative",
    "--no-fast-load", "--no-tui", "--profile", "--qwen4-qsa", "--require-auth",
    "--self-speculative", "--speculative",
})
_BOOL_LITERALS = frozenset({"true", "false"})


def _passthrough_arity(args, i):
    """Number of tokens a pass-through server flag at args[i] occupies (1 or 2)."""
    a = args[i]
    if "=" in a or i + 1 >= len(args):
        return 1
    nxt = args[i + 1]
    if a in SERVER_BOOL_FLAGS:
        return 2 if nxt.lower() in _BOOL_LITERALS else 1
    return 1 if nxt.startswith("--") else 2

