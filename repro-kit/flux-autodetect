        if not needs_wrapper and (not can_log or interactive_tty):
            if can_log and interactive_tty:
                os.environ.setdefault("ATLAS_TUI_LOG_FILE", log_file_env)
            os.execv(plan["command"][0], plan["command"])

        # Launch server subprocess and drain stdout in a background thread so pipes never block
        log_fh = open(log_file_env, "a", encoding="utf-8") if can_log else None
        proc = subprocess.Popen(
            plan["command"],
            stdout=subprocess.PIPE if log_fh else None,
            stderr=subprocess.STDOUT if log_fh else None,
            text=True,
            bufsize=1,
        )

        def _drain_stdout() -> None:
            if not proc.stdout:
                return
            try:
                for line in proc.stdout:
                    sys.stdout.write(line)
                    sys.stdout.flush()
                    if log_fh:
                        try:
                            log_fh.write(line)
                            log_fh.flush()
                        except Exception:
                            pass
            except Exception:
                pass

        drain_thread: Optional[threading.Thread] = None
        if log_fh and proc.stdout:
            drain_thread = threading.Thread(target=_drain_stdout, daemon=True)
            drain_thread.start()

        if needs_wrapper:
            port = plan["port"]
            ready = False
            start_t = time.time()
            while time.time() - start_t < 900:
                if proc.poll() is not None:
                    break
                try:
                    with urllib.request.urlopen(f"http://127.0.0.1:{port}/health", timeout=1.5) as r:
                        if r.status == 200:
                            ready = True
                            break
                except Exception:
                    time.sleep(0.5)

            if not ready:
                rc = proc.poll()
                if rc is None:
                    proc.terminate()
                    rc = 1
                if log_fh:
                    log_fh.close()
                _print_load_debug_tail()
                print(f"[flux] ERROR: Server failed to become ready on port {port} (exit={rc}).", file=sys.stderr)
                return rc or 1

            bench_rc = 0
            if with_bench:
                bench_rc = subprocess.call([
                    "/usr/local/bin/flux-bench",
                    "run",
                    "--endpoint",
                    f"http://127.0.0.1:{port}",
                    "--output",
                    "/results/results.json",
                ]) or bench_rc
            if with_lil:
                lil_args = shlex.split(with_lil)
                bench_rc = subprocess.call(["/usr/local/bin/lil-bench"] + lil_args + ["--port", str(port)]) or bench_rc
            if with_conc:
                bench_rc = subprocess.call(["/usr/local/bin/lil-bench", "concurrency", with_conc, "--port", str(port)]) or bench_rc
            if with_estonia:
                bench_rc = subprocess.call(["/usr/local/bin/lil-bench", "estonia", "--port", str(port)]) or bench_rc
            if with_card:
                generate_standalone_model_card(Path("/results/MODEL_CARD.md"), opts)
            proc.terminate()
            try:
                proc.wait(timeout=15)
            except Exception:
                proc.kill()
            if drain_thread:
                drain_thread.join(timeout=2.0)
            if log_fh:
                log_fh.close()
            return bench_rc

        rc = proc.wait()
        if drain_thread:
            drain_thread.join(timeout=2.0)
        if log_fh:
            log_fh.close()
        if rc != 0:
            _print_load_debug_tail()
            print(f"\n[flux] Server exited with code {rc}. Running automatic post-mortem diagnosis...", file=sys.stderr)
            diag = collect_diagnostics(opts)
            for w in diag.get("warnings", []):
                print(f"[flux-diagnose] ⚠️  {w}", file=sys.stderr)
        return rc

    # If subcommand is a shell/system executable (e.g. bash, sh, python3, nvidia-smi, curl), exec it directly
    if shutil.which(sub) and sub not in ("check-kernels",):
        os.execvp(sub, [sub] + rest)

    # Fallback: treat unknown subcommand as raw arguments to primary binary
    os.execv(BINARIES["primary"], [BINARIES["primary"], sub] + rest)
    return 0


if __name__ == "__main__":
    sys.exit(main())
