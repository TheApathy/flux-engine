def _parse_mib_value(raw: str) -> Optional[int]:
    """Parse an `nvidia-smi --format=csv,noheader,nounits` memory field (MiB)."""
    text = raw.strip()
    if not text:
        return None
    try:
        val = int(round(float(text)))
        return val if val > 0 else None
    except ValueError:
        return None


def recommended_container_image(hw: Dict[str, Any]) -> str:
    """Select the recommended OCI container image tag for the detected GPU architecture."""
    sm_family = str(hw.get("sm_family") or "").lower()
    cc = str(hw.get("compute_capability") or "").strip()
    if sm_family == "gb10-sm121a" or cc.startswith("12.1") or hw.get("unified_memory_architecture"):
        return "ghcr.io/theapathy/flux-engine:gb10"
    if sm_family in ("blackwell-sm120a", "blackwell-sm120") or cc.startswith("12.0"):
        return "ghcr.io/theapathy/flux-engine:sm120"
    if sm_family == "blackwell-sm103a" or cc.startswith("10.3"):
        return "ghcr.io/theapathy/flux-engine:sm103"
    return "ghcr.io/theapathy/flux-engine:latest"


def _discrete_vram_tier_label(per_gpu_vram_gib: float) -> str:
    """Map actual nvidia-smi GiB (e.g. 15.9, 31.8, 95.6, 269.0) to canonical tier label."""
    if per_gpu_vram_gib <= 0:
        return "unknown"
    if per_gpu_vram_gib <= 18.0:
        return "16gb"
    if per_gpu_vram_gib <= 26.0:
        return "24gb"
    if per_gpu_vram_gib <= 36.0:
        return "32gb"
    if per_gpu_vram_gib <= 54.0:
        return "48gb"
    if per_gpu_vram_gib <= 78.0:
        return "72gb"
    if per_gpu_vram_gib <= 104.0:
        return "96gb"
    if per_gpu_vram_gib >= 240.0:
        return "288gb"
    return f"{int(round(per_gpu_vram_gib))}gb"


def detect_hardware_topology() -> Dict[str, Any]:
    """
    Auto-detect GPU count, SM compute capability, and discrete VRAM vs Unified Memory (UMA)
    across GB10 (SM121a), discrete Blackwell SM120 (RTX 5060 Ti/5070/5080/5090, RTX PRO 5000/6000,
    1x/2x/4x single-host), Blackwell Ultra SM103 (B300/GB300 269-288 GB HBM3e), and Hopper/other GPUs.
    """
    mem_total_gib = 0.0
    mem_avail_gib = 0.0
    page_cache_gib = 0.0
    try:
        with open("/proc/meminfo", "r", encoding="utf-8") as f:
            for line in f:
                if line.startswith("MemTotal:"):
                    mem_total_gib = round(int(line.split(":")[1].strip().split()[0]) / (1024 * 1024), 1)
                elif line.startswith("MemAvailable:"):
                    mem_avail_gib = round(int(line.split(":")[1].strip().split()[0]) / (1024 * 1024), 1)
                elif line.startswith(("Buffers:", "Cached:")):
                    page_cache_gib += round(int(line.split(":")[1].strip().split()[0]) / (1024 * 1024), 1)
    except Exception:
        pass

    gpu_count = 0
    gpu_names: List[str] = []
    compute_caps: List[str] = []
    vram_mib_per_gpu: List[int] = []

    if shutil.which("nvidia-smi"):
        try:
            smi = subprocess.check_output(
                ["nvidia-smi", "--query-gpu=name,memory.total,compute_cap", "--format=csv,noheader,nounits"],
                text=True,
                stderr=subprocess.DEVNULL,
                timeout=4,
            ).strip()
            if smi:
                for row in smi.splitlines():
                    if not row.strip():
                        continue
                    parts = [p.strip() for p in row.split(",")]
                    gpu_count += 1
                    if len(parts) > 0:
                        gpu_names.append(parts[0])
                    if len(parts) > 1:
                        mib = _parse_mib_value(parts[1])
                        if mib is not None:
                            vram_mib_per_gpu.append(mib)
                    if len(parts) > 2 and parts[2]:
                        compute_caps.append(parts[2])
        except Exception:
            pass

    cc = compute_caps[0] if compute_caps else ("12.1" if gpu_count == 0 else "")
    name_first = (gpu_names[0] if gpu_names else "").lower()

    # Strictly distinguish GB10 (SM121a UMA), Blackwell Ultra (SM103a B300/GB300),
    # discrete Blackwell SM120 (RTX 50-series / RTX PRO 4000-6000), Blackwell SM100 (B200/GB200),
    # Hopper SM90, and generic CUDA GPUs.
    if cc.startswith("12.1") or "gb10" in name_first:
        sm_family = "gb10-sm121a"
        arch_target = "sm_121a"
        hw_recipe = "flux-nextgen-max-prefill-decode.env"
        is_uma = True
    elif cc.startswith("10.3") or "gb300" in name_first or "b300" in name_first:
        sm_family = "blackwell-sm103a"
        arch_target = "sm_103a"
        hw_recipe = "nvidia-blackwell-sm120.env"
        is_uma = False
    elif cc.startswith("12.0") or any(
        tok in name_first
        for tok in ("rtx 50", "rtx pro 6000", "rtx pro 5000", "rtx pro 4500", "rtx pro 4000")
    ):
        sm_family = "blackwell-sm120a"
        arch_target = "sm_120a"
        hw_recipe = "nvidia-blackwell-sm120.env"
        is_uma = False
    elif cc.startswith("10.0") or any(tok in name_first for tok in ("gb200", "b200", "b100", "blackwell")):
        sm_family = "blackwell-sm100a"
        arch_target = "sm_100a"
        hw_recipe = "nvidia-blackwell-sm120.env"
        is_uma = False
    elif cc.startswith("9.0") or "h100" in name_first or "h200" in name_first or "gh200" in name_first:
        sm_family = "hopper-sm90"
        arch_target = "sm_90a"
        hw_recipe = "nvidia-hopper-sm90.env"
        is_uma = False
    else:
        sm_family = f"cuda-sm{cc.replace('.', '')}" if cc else "cuda-unknown"
        arch_target = f"sm_{cc.replace('.', '')}" if cc else "sm_120"
        hw_recipe = "flux-nextgen-max-prefill-decode.env"
        is_uma = gpu_count == 0 and mem_total_gib >= 64

    vram_per_gpu_gib = [round(m / 1024.0, 1) for m in vram_mib_per_gpu]
    if is_uma:
        total_vram_gib = round(sum(vram_mib_per_gpu) / 1024.0, 1) if vram_mib_per_gpu else mem_total_gib
        effective_mem_gib = max(total_vram_gib, mem_total_gib)
        per_gpu_vram_gib = round(effective_mem_gib / max(1, gpu_count), 1)
    else:
        # Discrete GPUs NEVER fall back to host system RAM as GPU VRAM.
        total_vram_gib = round(sum(vram_mib_per_gpu) / 1024.0, 1) if vram_mib_per_gpu else 0.0
        per_gpu_vram_gib = round(min(vram_mib_per_gpu) / 1024.0, 1) if vram_mib_per_gpu else 0.0
        effective_mem_gib = total_vram_gib

    single_host_multi_gpu = (not is_uma) and (gpu_count >= 2)
    eff_gpu_count = max(1, gpu_count)

    if effective_mem_gib >= 180:
        hw_max_seq_len = 1048576  # 1M tokens (B300/GB300 269-288GB, 2x/4x 96GB, B200 192GB)
        hw_default_seq_len = 262144
    elif is_uma and effective_mem_gib >= 110:
        hw_max_seq_len = 1048576  # 128 GB GB10 UMA
        hw_default_seq_len = 131072
    elif effective_mem_gib >= 90:
        hw_max_seq_len = 1048576  # 1M tokens (1x 96 GB discrete with NVFP4 KV; discrete VRAM budget enforces fit)
        hw_default_seq_len = 262144 if effective_mem_gib >= 130 else 131072
    elif effective_mem_gib >= 60:
        hw_max_seq_len = 524288
        hw_default_seq_len = 131072
    elif effective_mem_gib >= 44:
        hw_max_seq_len = 262144
        hw_default_seq_len = 131072
    elif effective_mem_gib >= 28:
        hw_max_seq_len = 262144
        hw_default_seq_len = 65536
    elif not is_uma and effective_mem_gib > 0:
        hw_max_seq_len = 65536
        hw_default_seq_len = 32768
    else:
        hw_max_seq_len = 131072
        hw_default_seq_len = 65536

    if is_uma:
        gpu_tier = "gb10-uma-128gb"
    elif sm_family == "blackwell-sm103a":
        gpu_tier = f"{eff_gpu_count}x-sm103-{_discrete_vram_tier_label(per_gpu_vram_gib)}"
    elif sm_family == "blackwell-sm120a":
        gpu_tier = f"{eff_gpu_count}x-sm120-{_discrete_vram_tier_label(per_gpu_vram_gib)}"
    else:
        gpu_tier = f"{eff_gpu_count}x-{sm_family}"

    topo_info: Dict[str, Any] = {
        "gpu_count": eff_gpu_count,
        "gpu_detected": gpu_count > 0,
        "gpu_names": gpu_names,
        "compute_capability": cc,
        "sm_family": sm_family,
        "arch_target": arch_target,
        "gpu_tier": gpu_tier,
        "unified_memory_architecture": is_uma,
        "single_host_multi_gpu": single_host_multi_gpu,
        "vram_per_gpu_gib": vram_per_gpu_gib,
        "per_gpu_vram_gib": per_gpu_vram_gib,
        "total_vram_gib": total_vram_gib,
        "effective_memory_gib": effective_mem_gib,
        "mem_available_gib": mem_avail_gib,
        "uma_page_cache_gib": round(page_cache_gib, 1),
        "hardware_default_seq_len": hw_default_seq_len,
        "hardware_max_seq_len_fp8_kv": hw_max_seq_len,
        "recommended_tp_size": gpu_count if gpu_count in (2, 4, 8) else 1,
        "hardware_recipe": hw_recipe,
    }
    topo_info["container_image"] = recommended_container_image(topo_info)
    return topo_info


def detect_intranode_nccl_env(hw: Dict[str, Any]) -> Tuple[Dict[str, str], str]:
    """
    Auto-detect intra-node NCCL transport settings for single-host multi-GPU discrete machines.
    Returns `(nccl_env_defaults, transport_label)`.
    """
    nvlink = False
    if shutil.which("nvidia-smi"):
        try:
            topo_out = subprocess.check_output(
                ["nvidia-smi", "topo", "-m"],
                text=True,
                stderr=subprocess.DEVNULL,
                timeout=3,
            )
            if _re.search(r"\bNV\d+\b", topo_out):
                nvlink = True
        except Exception:
            pass
    # NCCL_P2P_LEVEL=SYS enables peer-to-peer DMA across NVLink, PCIe switches, and host bridges
    # while NCCL_IB_DISABLE=1 avoids probing absent InfiniBand HCAs on single-host workstations.
    nccl_env = {
        "NCCL_P2P_DISABLE": "0",
        "NCCL_P2P_LEVEL": "SYS",
        "NCCL_SHM_DISABLE": "0",
        "NCCL_IB_DISABLE": "1",
    }
    transport = "nvlink-p2p" if nvlink else "pcie-p2p-shm"
    return nccl_env, transport


def _quant_weight_scale(quant: str, default_quant: str) -> float:
    """Scale baseline weight GiB when checkpoint quantization differs from the profile's default."""
    q = (quant or default_quant or "NVFP4").upper()
    dq = (default_quant or "NVFP4").upper()
    if q == dq:
        return 1.0
    bpw = {
        "EXL3": 0.30,
        "NVFP4": 0.56,
        "INT4": 0.58,
        "AWQ": 0.58,
        "AWQ-4BIT": 0.58,
        "GPTQ": 0.58,
        "GPTQ-4BIT": 0.58,
        "FP8": 1.05,
        "INT8": 1.05,
        "BF16": 2.0,
        "FP16": 2.0,
    }
    base_b = bpw.get(dq, 0.56)
    cur_b = bpw.get(q)
    if cur_b is None:
        if "4" in q:
            cur_b = 0.58
        elif "8" in q:
            cur_b = 1.05
        elif "16" in q:
            cur_b = 2.0
        else:
            return 1.0
    return max(0.4, cur_b / base_b)


def estimate_model_vram_spec(model_info: Dict[str, Any]) -> Dict[str, Any]:
    """
    Resolve per-model VRAM weight, scratch, drafter, and KV byte-cost parameters.
    Uses calibrated profiles for known targets and an architecture-based estimator
    for generic/small/14B dense or auto-mapped checkpoints.
    """
    kt = str(model_info.get("kernel_target") or "").strip().lower()
    family = str(model_info.get("family") or "")
    quant = str(model_info.get("quantization") or model_info.get("quant") or "NVFP4").upper()
    num_experts = int(model_info.get("num_experts") or 0)
    hidden_size = int(model_info.get("hidden_size") or 0)
    num_layers = int(model_info.get("num_hidden_layers") or 0)
    vocab_size = int(model_info.get("vocab_size") or 151936)

    known = MODEL_VRAM_PROFILES.get(kt)
    # Auto-mapped dense checkpoints (e.g. 7B/8B/14B dense mapped to qwen3.6-35b-a3b fallback)
    # must be estimated from their true architecture shape rather than the 35B MoE fallback.
    use_arch_estimate = (
        known is None
        or family.startswith("Auto-Mapped")
        or (known.get("is_moe") and num_experts == 0 and hidden_size > 0 and num_layers > 0 and kt == "qwen3.6-35b-a3b")
    )
    if not use_arch_estimate and known is not None:
        spec = dict(known)
        scale = _quant_weight_scale(quant, str(spec.get("default_quant", "NVFP4")))
        if scale != 1.0:
            for wk in (
                "weights_gib_1x",
                "weights_gib_tp2_ep2",
                "weights_gib_tp4_ep4",
                "weights_gib_pp2",
                "weights_gib_pp3",
                "weights_gib_pp4",
            ):
                if wk in spec:
                    spec[wk] = round(float(spec[wk]) * scale, 2)
        return spec

    # Architecture-driven estimator for generic dense/MoE models (e.g. 4B, 8B, 14B NVFP4/FP8/BF16).
    if hidden_size > 0 and num_layers > 0:
        if num_experts > 0:
            layer_params = num_layers * (3.0 * (hidden_size ** 2) + num_experts * 1.5 * (hidden_size ** 2) * 0.25)
        else:
            layer_params = num_layers * 12.5 * (hidden_size ** 2)
        embed_params = 2.0 * vocab_size * hidden_size
        q_scale = _quant_weight_scale(quant, "NVFP4")
        # NVFP4 layer weights ~0.56 B/param; embeddings/lm_head ~1.0-2.0 B/param
        weights_bytes = layer_params * 0.56 * q_scale + embed_params * min(2.0, 1.0 * max(1.0, q_scale))
        weights_gib = round(max(0.5, weights_bytes / (1024.0 ** 3)), 2)
        kv_heads = 4 if hidden_size >= 4096 else 2
        head_dim = 128
        kv_bf16_kib = round((num_layers * 2 * kv_heads * head_dim * 2) / 1024.0, 2)
    else:
        weights_gib = 10.0
        kv_heads = 4
        kv_bf16_kib = 32.0

    scratch_gib = 1.5 if weights_gib <= 6.0 else (1.8 if weights_gib <= 12.0 else 2.5)
    return {
        "weights_gib_1x": weights_gib,
        "dflash_gib": 0.0,
        "scratch_gib": scratch_gib,
        "kv_kib_per_tok_bf16": max(8.0, kv_bf16_kib),
        "kv_kib_per_tok_nvfp4": max(4.0, round(kv_bf16_kib * 0.35, 2)),
        "kv_kib_per_tok_fp8": max(4.0, round(kv_bf16_kib * 0.55, 2)),
        "kv_heads": kv_heads,
        "is_moe": num_experts > 0,
        "default_quant": quant,
    }


def _shard_weights_per_gpu(spec: Dict[str, Any], tp_size: int, ep_size: int, pp_size: int) -> float:
    """Estimate resident model weight GiB on each GPU rank for a given TP/EP/PP split."""
    if pp_size == 4 and tp_size == 1 and ep_size == 1 and "weights_gib_pp4" in spec:
        return float(spec["weights_gib_pp4"])
    if pp_size == 3 and tp_size == 1 and ep_size == 1 and "weights_gib_pp3" in spec:
        return float(spec["weights_gib_pp3"])
    if pp_size == 2 and tp_size == 1 and ep_size == 1 and "weights_gib_pp2" in spec:
        return float(spec["weights_gib_pp2"])
    if tp_size == 4 and ep_size == 4 and pp_size == 1 and "weights_gib_tp4_ep4" in spec:
        return float(spec["weights_gib_tp4_ep4"])
    if tp_size == 2 and ep_size == 2 and pp_size == 1 and "weights_gib_tp2_ep2" in spec:
        return float(spec["weights_gib_tp2_ep2"])

    base = float(spec["weights_gib_1x"])
    if tp_size == 1 and ep_size == 1 and pp_size == 1:
        return base
    if pp_size > 1:
        per_stage = base / float(pp_size) + 1.0
        if tp_size > 1 or ep_size > 1:
            if spec.get("is_moe"):
                return round((per_stage * 0.85) / float(max(1, ep_size)) + (per_stage * 0.15) / float(max(1, tp_size)), 2)
            return round(per_stage / float(max(1, tp_size)) + 0.5, 2)
        return round(per_stage, 2)
    if spec.get("is_moe"):
        # ~85% routed expert weights scale with EP; ~15% attention/dense/embed scale with TP.
        return round((base * 0.85) / float(max(1, ep_size)) + (base * 0.15) / float(max(1, tp_size)) + 0.8, 2)
    return round(base / float(max(1, tp_size)) + 0.6, 2)


def _snap_kv_pool_tokens(max_kv_tokens: int) -> int:
    """Snap a discrete KV token budget to the largest clean standard milestone <= max_kv_tokens."""
    if max_kv_tokens <= 0:
        return 0
    best = 0
    for tier in _DISCRETE_KV_POOL_TIERS:
        if tier <= max_kv_tokens:
            best = tier
        else:
            break
    return best if best > 0 else (max_kv_tokens // 16) * 16


def _qwen4_kv_kib_per_tok(kv_cache_dtype: str, kv_high_precision_layers: str = "auto") -> float:
    """Exact Qwen3.8-Flash-Next KV + QSA side-cache KiB/token (12 attn layers, 2 KV heads, head_dim=256)."""
    qsa_side_kib = 1.61
    dt = (kv_cache_dtype or "bf16").strip().lower()
    if dt == "bf16":
        return 25.61
    hp_raw = str(kv_high_precision_layers or "auto").strip().lower()
    if hp_raw in ("max", "all"):
        bf16_layers = 12
    elif hp_raw == "auto":
        bf16_layers = 4
    else:
        try:
            bf16_layers = min(12, max(0, int(hp_raw)) * 2)
        except ValueError:
            bf16_layers = 4
    quant_layers = 12 - bf16_layers
    if dt == "nvfp4":
        if bf16_layers == 0:
            return 8.36
        if bf16_layers == 2:
            return 11.23
        if bf16_layers == 4:
            return 14.11
        return round(bf16_layers * 2.0 + quant_layers * 0.5625 + qsa_side_kib, 2)
    if dt == "fp8":
        return round(bf16_layers * 2.0 + quant_layers * 1.0 + qsa_side_kib, 2)
    return 25.61


def _qwen27b_kv_kib_per_tok(kv_cache_dtype: str, kv_high_precision_layers: str = "auto") -> float:
    """Exact Qwen3.8/3.6/3.5-27B KV KiB/token (16 full-attn layers, 4 KV heads, head_dim=256)."""
    dt = (kv_cache_dtype or "bf16").strip().lower()
    if dt == "bf16":
        return 64.0
    hp_raw = str(kv_high_precision_layers or "auto").strip().lower()
    if hp_raw in ("max", "all"):
        bf16_layers = 16
    elif hp_raw == "auto":
        bf16_layers = 4
    else:
        try:
            bf16_layers = min(16, max(0, int(hp_raw)) * 2)
        except ValueError:
            bf16_layers = 4
    quant_layers = 16 - bf16_layers
    if dt == "nvfp4":
        return round(bf16_layers * 4.0 + quant_layers * 1.125, 2)
    if dt == "fp8":
        return round(bf16_layers * 4.0 + quant_layers * 2.0, 2)
    return 64.0


def calculate_discrete_vram_budget(
    model_info: Dict[str, Any],
    hw: Dict[str, Any],
    *,
    tp_size: int = 1,
    ep_size: int = 1,
    pp_size: int = 1,
    gpu_mem_util: float = 0.90,
    kv_cache_dtype: str = "bf16",
    kv_high_precision_layers: str = "auto",
    speculative_enabled: bool = False,
    spec_mode: str = "none",
    max_prefill_tokens: int = 8192,
    ts4e_enabled: bool = False,
    release_unused_dflash: bool = False,
    concurrency: int = 1,
    max_seq_len: int = 262144,
    fast_proj_fp8_cache: bool = False,
    qsa_fp8_active: bool = False,
) -> Dict[str, Any]:
    """
    Calculate per-GPU discrete VRAM budget, KV pool capacity, and fit verdict
    for SM120 / SM103 / other discrete GPUs without ever mixing host RAM or GB10 UMA tiers.
    """
    per_gpu_vram_gib = float(hw.get("per_gpu_vram_gib") or 0.0)
    gpu_count = int(hw.get("gpu_count") or 1)
    if per_gpu_vram_gib <= 0.0:
        eff_total = float(hw.get("total_vram_gib") or hw.get("effective_memory_gib") or 0.0)
        if eff_total > 0.0:
            per_gpu_vram_gib = round(eff_total / max(1, gpu_count), 1)
    total_vram_gib = float(hw.get("total_vram_gib") or round(per_gpu_vram_gib * gpu_count, 1))
    sm_family = str(hw.get("sm_family") or "discrete-gpu")

    kt_l = str(model_info.get("kernel_target") or "").strip().lower()
    spec = estimate_model_vram_spec(model_info)
    world_size = max(1, (tp_size if tp_size == ep_size else tp_size * ep_size) * pp_size)
    weights_per_gpu = _shard_weights_per_gpu(spec, tp_size, ep_size, pp_size)
    if kt_l == "qwen3.8-flash-next":
        if ts4e_enabled:
            weights_per_gpu = max(
                0.0,
                weights_per_gpu - (3.37 / float(max(1, ep_size) * max(1, pp_size))),
            )
        if release_unused_dflash:
            if pp_size == 1:
                # Reclaimed unused target BF16 lm_head (1.18 GiB, guaranteed on every
                # checkpoint including hybrid checkpoints with mtp_tensors=0; checkpoints
                # with native mtp.* tensors reclaim an extra 1.52 GiB/ep as headroom).
                weights_per_gpu = max(0.0, weights_per_gpu - 1.18)
            else:
                weights_per_gpu = max(0.0, weights_per_gpu - (1.18 / float(max(1, pp_size))))
    drafter_gib = float(spec.get("dflash_gib", 0.0)) if (speculative_enabled and spec_mode == "dflash") else 0.0
    scratch_gib = float(
        spec.get("scratch_gib_multi_gpu", spec["scratch_gib"]) if world_size > 1 else spec["scratch_gib"]
    )
    if max_prefill_tokens > 8192 and spec.get("is_moe"):
        delta_per_8k = float(spec.get("scratch_gib_16k_delta", 1.8))
        scratch_gib += ((float(max_prefill_tokens) / 8192.0) - 1.0) * delta_per_8k
    if kt_l == "qwen3.8-flash-next":
        kv_heads_q4 = max(1, int(spec.get("kv_heads", 2)))
        kv_shard_div = float(min(max(1, tp_size), kv_heads_q4) * max(1, pp_size))
        ssm_shard_div = float(max(1, tp_size) * max(1, pp_size))
        if concurrency > 1:
            # Physical per-slot runtime reserves (matching preflight.rs):
            # - SSM pool: ~0.11 GiB/slot, sharded across TP * PP
            # - DFlash2 proposer ring + batched-K5 GDN retain: ~0.16 GiB/slot when speculative
            # - QSA side-cache reserve scales with concurrency * min(max_seq_len, 262144), sharded by KV heads * PP
            extra_slots = min(max(1, int(concurrency)), 64) - 1
            ssm_per_slot = 0.11 / ssm_shard_div
            spec_per_slot = (
                (0.18 / float(max(1, pp_size))) + (0.05 / ssm_shard_div)
                if speculative_enabled
                else 0.0
            )
            seq_factor = min(max(4096, int(max_seq_len)), 262144) / 262144.0
            qsa_per_slot = (0.16 * seq_factor) / kv_shard_div
            scratch_gib += float(extra_slots) * (ssm_per_slot + spec_per_slot + qsa_per_slot)
        if fast_proj_fp8_cache:
            # 120-weight FP8 fast-proj weight cache (~2.40 GiB / world_size).
            scratch_gib += 2.40 / float(max(1, world_size))
        if qsa_fp8_active and (kv_cache_dtype or "bf16").lower() == "bf16":
            # Lean Shared-V8 QSA E4M3 prefill shadows (~1.65 GiB / (min(tp, kv_heads) * pp)).
            scratch_gib += 1.65 / kv_shard_div
    elif kt_l in ("qwen3.8-27b", "qwen3.6-27b", "qwen3.5-27b"):
        ssm_shard_div = float(max(1, tp_size) * max(1, pp_size))
        if per_gpu_vram_gib >= 80.0:
            # On >=80 GiB discrete GPUs, 27B materializes dense FFN/SSM transposed
            # prefill/decode weights (~19.9 GiB) + BF16 lm_head/scales (~4.5 GiB).
            scratch_gib += 24.4 / ssm_shard_div
        if concurrency > 1:
            if speculative_enabled:
                # 48-layer SSM state + rollback snapshot + DFlash2 proposer rings (~2.4 GiB/slot)
                # plus shared batched DFlash2 proposer state (~1.6 GiB).
                scratch_gib += float(min(max(1, int(concurrency)), 64)) * (2.4 / ssm_shard_div)
                scratch_gib += 1.6 / float(max(1, pp_size))
            else:
                # Plain target-only C2..C64: 48-layer f32 SSM + conv state + per-slot decode buffers
                # plus ~3.5 GiB headroom for lazy cuBLASLt NVFP4 128x4 weight-scale caches on first prefill.
                scratch_gib += float(min(max(1, int(concurrency)), 128)) * (0.62 / ssm_shard_div)
        elif per_gpu_vram_gib >= 80.0:
            scratch_gib += 2.4 / ssm_shard_div

    # Mirror Step-5 runtime KV sizing (`build.rs`): subtract fixed CUDA context/graph
    # headroom directly from per-GPU VRAM, then apply a single clean allocator ratio
    # (`min(gpu_mem_util, 0.95)`) to the remaining free VRAM (never double-penalizing
    # static weights with `gpu_mem_util` and a second 10% token haircut).
    cuda_headroom_gib = min(1.5, per_gpu_vram_gib * 0.10) if per_gpu_vram_gib <= 24.0 else 1.5
    usable_per_gpu = max(0.0, per_gpu_vram_gib - cuda_headroom_gib)
    min_required_per_gpu = weights_per_gpu + drafter_gib + scratch_gib
    raw_free_gib = usable_per_gpu - min_required_per_gpu
    kv_alloc_ratio = min(max(0.0, float(gpu_mem_util)), 0.95)
    free_kv_gib = raw_free_gib * kv_alloc_ratio if raw_free_gib > 0.0 else raw_free_gib

    kv_dtype_l = (kv_cache_dtype or "bf16").lower()
    if kt_l == "qwen3.8-flash-next":
        base_kv_kib = _qwen4_kv_kib_per_tok(kv_dtype_l, kv_high_precision_layers)
    elif kt_l in ("qwen3.8-27b", "qwen3.6-27b", "qwen3.5-27b"):
        base_kv_kib = _qwen27b_kv_kib_per_tok(kv_dtype_l, kv_high_precision_layers)
    elif kv_dtype_l == "nvfp4":
        base_kv_kib = float(spec["kv_kib_per_tok_nvfp4"])
    elif kv_dtype_l == "fp8":
        base_kv_kib = float(spec["kv_kib_per_tok_fp8"])
    else:
        base_kv_kib = float(spec["kv_kib_per_tok_bf16"])

    kv_heads = max(1, int(spec.get("kv_heads", 2)))
    tp_kv_div = float(min(max(1, tp_size), kv_heads))
    pp_kv_div = float(max(1, pp_size))
    kv_kib_per_tok_gpu = max(1.0, base_kv_kib / (tp_kv_div * pp_kv_div))

    if free_kv_gib > 0.0:
        raw_tokens = int((free_kv_gib * 1024.0 * 1024.0) / kv_kib_per_tok_gpu)
        max_kv_tokens = (raw_tokens // 4096) * 4096 if raw_tokens >= 4096 else (raw_tokens // 16) * 16
    else:
        max_kv_tokens = 0

    rec_kv_tokens = _snap_kv_pool_tokens(max_kv_tokens)
    fits = (free_kv_gib >= 0.5) and (max_kv_tokens >= 4096)

    # Compute minimum GPUs of this per_gpu_vram_gib class needed to fit the model
    min_gpus = 1
    if per_gpu_vram_gib > 0.0:
        min_gpus = 8
        for cand_n in (1, 2, 4, 8):
            c_tp = cand_n if cand_n in (1, 2, 4, 8) else 1
            c_ep = c_tp if spec.get("is_moe") else 1
            c_scratch = float(spec.get("scratch_gib_multi_gpu", spec["scratch_gib"]) if cand_n > 1 else spec["scratch_gib"])
            c_w = _shard_weights_per_gpu(spec, c_tp, c_ep, 1)
            if (usable_per_gpu - (c_w + c_scratch)) >= 0.75:
                min_gpus = cand_n
                break

    kt = str(model_info.get("kernel_target") or "model")
    m_name = str(model_info.get("name") or kt)
    m_quant = str(model_info.get("quantization") or model_info.get("quant") or "NVFP4")

    if fits:
        fit_reason = (
            f"Fits {m_name} ({kt}, {m_quant}) on {gpu_count}x {per_gpu_vram_gib:.1f} GiB {sm_family}: "
            f"{weights_per_gpu:.1f} GiB weights/GPU + {drafter_gib + scratch_gib:.1f} GiB overhead -> "
            f"{free_kv_gib:.1f} GiB free VRAM/GPU (~{rec_kv_tokens:,} {kv_dtype_l.upper()} KV tokens)"
        )
    else:
        if min_gpus == 2 and gpu_count == 1:
            ep_hint = " + EP=2" if spec.get("is_moe") else ""
            if float(spec["weights_gib_1x"]) >= 45.0:
                action_hint = (
                    f"Requires 2x {int(round(per_gpu_vram_gib))} GB GPUs (TP=2{ep_hint}) "
                    "or a single >=96 GB GPU (RTX PRO 6000 Blackwell / B300)."
                )
            else:
                action_hint = (
                    f"Use a <=14B NVFP4 model on 16 GB, upgrade to >=32 GB VRAM (RTX 5090 / RTX PRO 5000), "
                    f"or run across 2x GPUs (TP=2{ep_hint})."
                )
        elif per_gpu_vram_gib <= 18.0:
            action_hint = (
                f"On a 16 GB discrete GPU, use a <=14B NVFP4 model (e.g. Holo-3.1-4B, Ornith-1.0-9B, or 14B-NVFP4), "
                f"upgrade to >=32 GB VRAM, or run across {min_gpus}x GPUs."
            )
        elif float(spec["weights_gib_1x"]) >= 45.0:
            action_hint = (
                f"Requires at least {min_gpus}x {int(round(per_gpu_vram_gib))} GB GPUs (TP={min_gpus}"
                f"{' + EP=' + str(min_gpus) if spec.get('is_moe') else ''}) or a single >=96 GB GPU (RTX PRO 6000 / B300)."
            )
        else:
            action_hint = f"Requires at least {min_gpus}x GPUs of this class or higher per-GPU VRAM."
        fit_reason = (
            f"Insufficient discrete VRAM for {m_name} ({kt}, {m_quant}) on {gpu_count}x {per_gpu_vram_gib:.1f} GiB {sm_family}: "
            f"requires ~{min_required_per_gpu:.1f} GiB/GPU ({weights_per_gpu:.1f} GiB weights + "
            f"{drafter_gib + scratch_gib:.1f} GiB overhead), exceeding {usable_per_gpu:.1f} GiB usable VRAM/GPU "
            f"({per_gpu_vram_gib:.1f} GiB x {gpu_mem_util:.2f}). {action_hint}"
        )

    return {
        "discrete": True,
        "sm_family": sm_family,
        "gpu_count": gpu_count,
        "per_gpu_vram_gib": round(per_gpu_vram_gib, 1),
        "total_vram_gib": round(total_vram_gib, 1),
        "gpu_memory_utilization": round(float(gpu_mem_util), 2),
        "usable_vram_per_gpu_gib": round(usable_per_gpu, 2),
        "model_weights_per_gpu_gib": round(weights_per_gpu, 2),
        "drafter_vram_gib": round(drafter_gib, 2),
        "scratch_overhead_gib": round(scratch_gib, 2),
        "required_min_vram_per_gpu_gib": round(min_required_per_gpu, 2),
        "free_vram_for_kv_per_gpu_gib": round(free_kv_gib, 2),
        "kv_kib_per_token_per_gpu": round(kv_kib_per_tok_gpu, 2),
        "max_kv_pool_tokens": max_kv_tokens,
        "recommended_kv_pool_tokens": rec_kv_tokens,
        "fits": fits,
        "min_gpus_recommended": min_gpus,
        "fit_reason": fit_reason,
    }


def recommend_models_for_hardware(hw: Dict[str, Any]) -> Dict[str, Any]:
    """Return hardware-tier model and topology recommendations for the detected GPU setup."""
    is_uma = bool(hw.get("unified_memory_architecture"))
    sm_family = str(hw.get("sm_family") or "gb10-sm121a")
    gpu_count = int(hw.get("gpu_count") or 1)
    per_gpu = float(hw.get("per_gpu_vram_gib") or hw.get("effective_memory_gib") or 0.0)
    total_vram = float(hw.get("total_vram_gib") or round(per_gpu * gpu_count, 1))
    image = recommended_container_image(hw)

    if is_uma:
        return {
            "tier": "gb10-uma-128gb",
            "container_image": image,
            "recommended_models": [
                "Qwen3.8-Flash-Next-NVFP4 (PLE offload, 262K native BF16 / 1M NVFP4)",
                "Qwen3.8-27B-NVFP4 (+ DFlash2)",
                "DeepSeek-V4.1",
                "GLM-5.3-Flash-EXL3",
                "Gemma-4-31B-NVFP4",
            ],
            "notes": ["128 GB unified memory (GB10 SM121a); use :gb10 container image."],
        }

    if sm_family == "blackwell-sm103a" or per_gpu >= 240.0:
        return {
            "tier": f"{gpu_count}x-sm103-hbm3e",
            "container_image": image,
            "recommended_models": [
                "Qwen3.8-Flash-Next-NVFP4 (1 GPU, massive multi-million-token BF16 KV pool)",
                "DeepSeek-V4.1 (1 GPU, >=1.5M BF16 KV pool)",
                "GLM-5.3-Flash-EXL3 (1 GPU, >=2M BF16 KV pool)",
                "Qwen3.8-27B-NVFP4",
            ],
            "notes": [
                f"{gpu_count}x {per_gpu:.0f} GB HBM3e discrete VRAM ({sm_family}); fits flagship 80B-320B models on 1 GPU with massive KV pool."
            ],
        }

    if gpu_count >= 2:
        tp = gpu_count if gpu_count in (2, 4, 8) else 2
        recs: List[str] = []
        notes = [f"Single-host multi-GPU {gpu_count}x {per_gpu:.0f} GB ({total_vram:.0f} GB aggregate): launch TP={tp} (EP={tp} for MoE) with 127.0.0.1:29500 and NCCL_P2P_LEVEL=SYS."]
        if per_gpu >= 90.0:
            recs.extend([
                f"Qwen3.8-Flash-Next-NVFP4 (TP={tp}+EP={tp} + DFlash2, multi-million-token BF16 KV)",
                f"Qwen3.5-122B-A10B-NVFP4 (TP={tp}+EP={tp})",
                f"DeepSeek-V4.1 (TP={tp}+EP={tp})",
                f"GLM-5.3-Flash-EXL3 (TP={tp}+EP={tp})",
            ])
        elif per_gpu >= 44.0:
            recs.extend([
                f"Qwen3.8-Flash-Next-NVFP4 (TP={tp}+EP={tp} across {gpu_count}x {per_gpu:.0f} GB GPUs)",
                f"Qwen3-Next-80B-A3B-NVFP4 (TP={tp}+EP={tp})",
                f"Qwen3.8-27B-NVFP4 (TP={tp}, massive KV pool)",
            ])
        elif per_gpu >= 28.0:
            recs.extend([
                f"Qwen3.8-27B-NVFP4 (TP={tp}, ~8.4 GB weights/GPU, large KV pool)",
                f"Qwen3-Next-80B-A3B-NVFP4 (TP={tp}+EP={tp}, ~24.5 GB weights/GPU)",
                f"Qwen3.6-35B-A3B-NVFP4 (TP={tp}+EP={tp})",
            ])
            if gpu_count >= 4:
                recs.insert(0, f"Qwen3.8-Flash-Next-NVFP4 (TP=4+EP=4, ~24.7 GB weights/GPU)")
            else:
                notes.append("Qwen3.8-Flash-Next (~74 GB) needs 4x 32 GB (TP=4+EP=4) or 2x >=48 GB GPUs.")
        else:
            recs.extend([
                f"Qwen3.8-27B-NVFP4 (TP={tp})",
                f"Qwen3.6-35B-A3B-NVFP4 (TP={tp}+EP={tp})",
            ])
        return {
            "tier": hw.get("gpu_tier", f"{gpu_count}x-{sm_family}"),
            "container_image": image,
            "recommended_models": recs,
            "notes": notes,
        }

    # Single discrete SM120 / discrete GPU tiers
    if per_gpu >= 90.0:
        return {
            "tier": "1x-sm120-96gb",
            "container_image": image,
            "recommended_models": [
                "Qwen3.8-Flash-Next-NVFP4 (~74 GB weights + DFlash2 + >=262K BF16 / 512K NVFP4 KV on 1 GPU)",
                "Qwen3.5-122B-A10B-NVFP4",
                "Qwen3-Next-80B-A3B-NVFP4",
                "Qwen3.8-27B-NVFP4 (massive KV pool)",
            ],
            "notes": ["RTX PRO 6000 Blackwell (96 GB GDDR7): fits Qwen3.8-Flash-Next + DFlash2 + healthy KV pool on 1 GPU."],
        }
    if per_gpu >= 44.0:
        recs = [
            "Qwen3.8-27B-NVFP4 (~15.5 GB weights, massive >=262K-1M KV pool)",
            "Qwen3.6-35B-A3B-NVFP4 (~20 GB weights)",
            "Gemma-4-31B-NVFP4 (~19 GB weights)",
        ]
        if per_gpu >= 68.0:
            recs.insert(1, "Qwen3-Next-80B-A3B-NVFP4 (~47 GB weights)")
        return {
            "tier": f"1x-sm120-{_discrete_vram_tier_label(per_gpu)}",
            "container_image": image,
            "recommended_models": recs,
            "notes": [
                f"RTX PRO 5000 ({per_gpu:.0f} GB GDDR7): ideal for Qwen3.8-27B-NVFP4 with >=262K KV pool; "
                "Qwen3.8-Flash-Next (~74 GB) requires 2x GPUs (TP=2 + EP=2)."
            ],
        }
    if per_gpu >= 28.0:
        return {
            "tier": "1x-sm120-32gb",
            "container_image": image,
            "recommended_models": [
                "Qwen3.8-27B-NVFP4 (~15.5 GB weights -> ~10+ GB free VRAM for large KV pool)",
                "Qwen3.6-35B-A3B-NVFP4 (~20 GB weights)",
                "Gemma-4-26B-A4B-NVFP4 (~16 GB weights)",
                "Gemma-4-31B-NVFP4 (~19 GB weights)",
            ],
            "notes": [
                "RTX 5090 (32 GB GDDR7): fits Qwen3.8-27B-NVFP4 with ~10+ GB free VRAM for a large KV pool; "
                "Qwen3.8-Flash-Next requires >=96 GB or 4x 32 GB."
            ],
        }
    return {
        "tier": f"1x-sm120-{_discrete_vram_tier_label(per_gpu)}",
        "container_image": image,
        "recommended_models": [
            "Holo-3.1-4B-NVFP4 (~2.8 GB weights)",
            "Ornith-1.0-9B-NVFP4 (~5.5 GB weights)",
            "14B-class NVFP4 quantized models (~8.5 GB weights)",
        ],
        "notes": [
            "16 GB discrete GPU (RTX 5060 Ti / 5070 Ti / 5080): best for <=14B NVFP4 models; "
            "27B (~15.5 GB + overhead) and 80B/Flash-Next exceed 16 GB VRAM and are refused cleanly."
        ],
    }


def build_single_host_multigpu_launch(
    base_cmd: List[str],
    hw: Dict[str, Any],
    *,
    world_size: int,
    tp_size: int,
    ep_size: int,
    pp_size: int,
    master_addr: str = "127.0.0.1",
    master_port: str = "29500",
    nccl_env: Optional[Dict[str, str]] = None,
    nccl_transport: str = "pcie-p2p-shm",
    port: int = 8899,
) -> Dict[str, Any]:
    """
    Generate per-rank commands and a ready-to-run single-host multi-GPU shell + Docker snippet
    spawning ranks 0..N-1 with --gpu-ordinal $r / FLUX_NODE_RANK=$r, --world-size N,
    --master-addr 127.0.0.1, --master-port 29500, and intra-node NCCL P2P transport.
    """
    import shlex

    eff_nccl = dict(nccl_env or {"NCCL_P2P_DISABLE": "0", "NCCL_P2P_LEVEL": "SYS", "NCCL_SHM_DISABLE": "0", "NCCL_IB_DISABLE": "1"})
    eff_addr = master_addr or "127.0.0.1"
    eff_port = master_port or "29500"
    image = recommended_container_image(hw)

    def _strip_rank_flags(argv: List[str]) -> List[str]:
        cleaned: List[str] = []
        skip_next = False
        rank_flags = {"--rank", "--gpu-ordinal", "--world-size", "--tp-size", "--ep-size", "--pp-size", "--master-addr", "--master-port"}
        for tok in argv:
            if skip_next:
                skip_next = False
                continue
            flag_key = tok.split("=", 1)[0]
            if flag_key in rank_flags:
                if "=" not in tok:
                    skip_next = True
                continue
            cleaned.append(tok)
        return cleaned

    common_argv = _strip_rank_flags(base_cmd)
    dist_tail = [
        "--world-size", str(world_size),
        "--tp-size", str(tp_size),
        "--ep-size", str(ep_size),
    ]
    if pp_size > 1:
        dist_tail.extend(["--pp-size", str(pp_size)])
    dist_tail.extend([
        "--master-addr", eff_addr,
        "--master-port", str(eff_port),
    ])

    rank_commands: List[List[str]] = []
    for r in range(world_size):
        rank_commands.append(common_argv + ["--rank", str(r), "--gpu-ordinal", str(r)] + dist_tail)

    quoted_common = " ".join(shlex.quote(tok) for tok in common_argv)
    quoted_tail = " ".join(shlex.quote(tok) for tok in dist_tail)
    env_exports = "\n".join(f"export {k}={shlex.quote(v)}" for k, v in sorted(eff_nccl.items()))
    shell_snippet = (
        f"# Single-host {world_size}x discrete GPU launch "
        f"(TP={tp_size}, EP={ep_size}, PP={pp_size}, transport={nccl_transport})\n"
        f"{env_exports}\n"
        f"trap 'kill 0' INT TERM EXIT\n"
        f"for r in $(seq 0 {world_size - 1}); do\n"
        f"  FLUX_NODE_RANK=$r {quoted_common} --rank \"$r\" --gpu-ordinal \"$r\" {quoted_tail} &\n"
        f"done\n"
        f"wait"
    )

    docker_env_flags = " ".join(f"-e {k}={v}" for k, v in sorted(eff_nccl.items()))
    pp_env = f" -e FLUX_PP_SIZE={pp_size}" if pp_size > 1 else ""
    docker_snippet = (
        f"docker run --rm --gpus all --ipc=host --shm-size=16g --network=host \\\n"
        f"  -v /path/to/models:/models:ro \\\n"
        f"  -e FLUX_PORT={port} -e FLUX_WORLD_SIZE={world_size} -e FLUX_TP_SIZE={tp_size} -e FLUX_EP_SIZE={ep_size}{pp_env} \\\n"
        f"  -e FLUX_MASTER_ADDR={eff_addr} -e FLUX_MASTER_PORT={eff_port} {docker_env_flags} \\\n"
        f"  {image}"
    )

    return {
        "mode": "single-host-multi-gpu",
        "world_size": world_size,
        "tp_size": tp_size,
        "ep_size": ep_size,
        "pp_size": pp_size,
        "master_addr": eff_addr,
        "master_port": str(eff_port),
        "nccl_env": eff_nccl,
        "nccl_transport": nccl_transport,
        "container_image": image,
        "rank_commands": rank_commands,
        "shell_snippet": shell_snippet,
        "docker_snippet": docker_snippet,
    }


def inspect_model(raw_model_dir: Path) -> Dict[str, Any]:
    model_dir, display_override = resolve_hf_or_model_dir(raw_model_dir)
    display_name = display_override or raw_model_dir.name
    cfg = _read_json(model_dir / "config.json")
    tcfg = cfg.get("text_config") if isinstance(cfg.get("text_config"), dict) else {}
    merged = {**tcfg, **cfg}

    model_type = str(merged.get("model_type", tcfg.get("model_type", "unknown")))
    text_model_type = str(tcfg.get("model_type", model_type))
    archs = merged.get("architectures") or ([merged["architecture"]] if merged.get("architecture") else [])
    arch_str = archs[0] if archs else "UnknownArchitecture"
    hidden_size = int(merged.get("hidden_size") or tcfg.get("hidden_size") or 0)
    num_layers = int(merged.get("num_hidden_layers") or tcfg.get("num_hidden_layers") or 0)
    num_experts = int(
        merged.get("num_local_experts")
        or merged.get("num_experts")
        or merged.get("n_routed_experts")
        or tcfg.get("num_local_experts")
        or tcfg.get("num_experts")
        or 0
    )
    num_experts_per_tok = int(
        merged.get("num_experts_per_tok")
        or tcfg.get("num_experts_per_tok")
        or (1 if num_experts == 0 else 8)
    )
    vocab_size = int(merged.get("vocab_size") or tcfg.get("vocab_size") or 0)
    max_pos = int(
        merged.get("max_position_embeddings")
        or tcfg.get("max_position_embeddings")
        or merged.get("seq_length")
        or 131072
    )
    rope_params = merged.get("rope_parameters") or tcfg.get("rope_parameters") or {}
    rope_scaling = merged.get("rope_scaling") or tcfg.get("rope_scaling") or (rope_params if "factor" in rope_params else None)
    rope_theta = float(
        merged.get("rope_theta")
        or tcfg.get("rope_theta")
        or (rope_params.get("rope_theta") if isinstance(rope_params, dict) else 0)
        or 1000000.0
    )
    mtp_layers = int(
        merged.get("mtp_num_hidden_layers")
        or merged.get("num_nextn_predict_layers")
        or tcfg.get("mtp_num_hidden_layers")
        or 0
    )
    quant = detect_quantization(model_dir, cfg, display_name)
    has_vision = bool("vision_config" in cfg or _safe_is_file(model_dir / "preprocessor_config.json"))
    ple_dir = None
    for cand in ("ple-offload", "ple", "ple_shards"):
        if _safe_is_dir(model_dir / cand):
            ple_dir = str(model_dir / cand)
            break

    safetensors = sorted(model_dir.glob("*.safetensors")) if _safe_is_dir(model_dir) else []
    valid_safetensors = [p for p in safetensors if _safe_exists(p)]
    broken_links = [
        str(p.name)
        for p in model_dir.iterdir()
        if p.is_symlink() and not _safe_exists(p)
    ] if _safe_is_dir(model_dir) else []

    drafter = is_drafter_dir(model_dir, cfg)
    identity_l = f"{display_name} {model_dir.name} {merged.get('_name_or_path', '')}".lower()
    mt_l = f"{model_type} {text_model_type}".lower()
    arch_l = arch_str.lower()

    # Check if this directory is a non-HuggingFace or non-causal-LLM checkpoint (e.g. TensorRT-LLM rank0, pure embedding/vision)
    is_trtllm = bool("mapping" in cfg or "trtllm" in identity_l or any(p.name.startswith("rank") for p in valid_safetensors))
    is_non_causal = (
        is_trtllm
        or any(k in mt_l or k in arch_l for k in ("siglip", "clip", "bert", "nomic", "embed", "diffusiongemma"))
        or ("forconditionalgeneration" not in arch_l and "forcausallm" not in arch_l and "LM" not in arch_str and not drafter)
    )

    # 100% Architecture-Driven Kernel Target & Binary Resolution across all 26 compiled targets
    kernel_target = os.environ.get("FLUX_KERNEL_TARGET", "").strip()
    binary_key = "primary"
    family = "unknown"
    requires_qwen4_qsa = False

    if not kernel_target:
        if drafter:
            kernel_target = "dflash-drafter"
            family = "Speculative Drafter / MTP Checkpoint"
        elif any(k in mt_l or k in arch_l for k in ("qwen4_exp", "qwen3_8_flash_next", "qwen4exp", "qwen3_8flashnext")) or (
            hidden_size == 2560 and num_layers == 48 and num_experts >= 256
        ):
            kernel_target = "qwen3.8-flash-next"
            family = "Qwen3.8-Flash-Next Hybrid DeltaNet-MoE (QSA / PLE)"
            binary_key = "primary"
            requires_qwen4_qsa = True
        elif "glm" in mt_l or "glm" in arch_l:
            kernel_target = "glm5.3-flash"
            family = "GLM-4.7 / GLM-5.3 MoE"
            binary_key = "primary"
        elif "deepseek_v41" in mt_l or "deepseekv41" in arch_l:
            # The kernel dir is kernels/gb10/deepseek-v4.1; "deepseek-v4-flash" matches no
            # compiled target, exact or substring, and the server refuses at load.
            kernel_target = "deepseek-v4.1"
            family = "DeepSeek-V4.1 Flash-Next (CB3 K124 MoE)"
            binary_key = "universal"
        elif "deepseek" in mt_l or "deepseek" in arch_l:
            kernel_target = "deepseek-v4-flash"
            family = "DeepSeek-V3.2 / V4 Flash MoE (MLA)"
            binary_key = "universal"
        elif "gemma4" in mt_l or "gemma4" in arch_l:
            if num_experts > 0:
                kernel_target = "gemma-4-26b-a4b"
                family = "Gemma-4 26B-A4B MoE / Multimodal"
            else:
                kernel_target = "gemma-4-31b"
                family = "Gemma-4 31B Dense / Multimodal"
            binary_key = "universal"
        elif "nemotron" in mt_l or "nemotron" in arch_l:
            if "puzzle" in identity_l or "75b" in identity_l:
                kernel_target = "nemotron-labs-3-puzzle-75b-a9b"
            elif hidden_size <= 3072 or "30b" in identity_l or "nano" in identity_l:
                kernel_target = "nemotron-3-nano-30b-a3b"
            else:
                kernel_target = "nemotron-super-120b-a12b"
            family = "NVIDIA Nemotron Hybrid Mamba-MoE"
            binary_key = "universal"
        elif "minimax" in mt_l or "minimax" in arch_l:
            kernel_target = "minimax-m2-229b"
            family = "MiniMax-M2 / M2.7 MoE"
            binary_key = "universal"
        elif "mistral" in mt_l or "mistral" in arch_l:
            kernel_target = "mistral-small-4"
            family = "Mistral Small 4"
            binary_key = "universal"
        elif "step" in mt_l or "step" in arch_l:
            kernel_target = "step3p7-flash"
            family = "Step-3.7-Flash MoE"
            binary_key = "universal"
        elif "laguna" in mt_l or "poolside" in mt_l or "laguna" in arch_l:
            kernel_target = "laguna-s-2.1"
            family = "Laguna Hybrid Attention"
            binary_key = "universal"
        elif "ornith" in mt_l or "ornith" in identity_l:
            kernel_target = "ornith-1.0-9b"
            family = "Ornith 1.0 9B"
            binary_key = "universal"
        elif "nllb" in mt_l or "m2m_100" in mt_l:
            kernel_target = "nllb-200-3.3b"
            family = "NLLB-200 3.3B"
            binary_key = "universal"
        elif num_experts > 0 and ("qwen" in mt_l or "qwen" in arch_l):
            if num_experts >= 512 and hidden_size == 2048:
                kernel_target = "qwen3-next-80b-a3b"
                family = "Qwen3-Next-80B-A3B Hybrid MoE"
                binary_key = "universal"
            elif num_experts == 128 and hidden_size == 2048:
                kernel_target = "qwen3-vl-30b-a3b"
                family = "Qwen3-VL-30B-A3B MoE"
                binary_key = "universal"
            elif hidden_size >= 4096 or "397b" in identity_l:
                kernel_target = "qwen3.5-397b-a17b"
                family = "Qwen3.5-397B-A17B MoE"
                binary_key = "universal"
            elif hidden_size >= 3072 or "122b" in identity_l:
                kernel_target = "qwen3.5-122b-a10b"
                family = "Qwen3.5-122B-A10B MoE"
                binary_key = "universal"
            elif "holo" in identity_l:
                kernel_target = "holo-3.1-35b-a3b"
                family = "Holo-3.1-35B-A3B Hybrid MoE"
                binary_key = "universal"
            elif "3.5" in identity_l:
                kernel_target = "qwen3.5-35b-a3b"
                family = "Qwen3.5-35B-A3B Hybrid DeltaNet-MoE"
                binary_key = "universal"
            else:
                kernel_target = "qwen3.6-35b-a3b"
                family = "Qwen3.6 / Qwen3.8 35B-A3B Hybrid DeltaNet-MoE"
                binary_key = "universal"
        elif hidden_size == 5120 and num_layers == 64:
            if "3.5" in identity_l:
                kernel_target = "qwen3.5-27b"
                family = "Qwen3.5-27B Dense Hybrid Gated-DeltaNet"
                binary_key = "universal"
            elif "3.6" in identity_l or "aeon" in identity_l or "qwopus" in identity_l:
                kernel_target = "qwen3.6-27b"
                family = "Qwen3.6-27B Dense Hybrid Gated-DeltaNet"
                binary_key = "universal" if _safe_is_file(Path(BINARIES["universal"])) else "qwen36_27b"
            else:
                kernel_target = "qwen3.8-27b"
                family = "Qwen3.8-27B Dense Hybrid Gated-DeltaNet"
                binary_key = "primary"
        elif "qwen3_5" in mt_l or "holo" in identity_l:
            if hidden_size <= 1536:
                kernel_target = "holo-3.1-0.8b"
                family = "Qwen3.5 / Holo-3.1 0.8B Dense Hybrid"
            else:
                kernel_target = "holo-3.1-4b"
                family = "Qwen3.5 / Holo-3.1 4B Dense Hybrid"
            binary_key = "universal"
        else:
            kernel_target = "qwen3.6-35b-a3b"
            family = f"Auto-Mapped ({arch_str})"
            binary_key = "universal" if _safe_is_file(Path(BINARIES["universal"])) else "primary"
    elif kernel_target == "qwen3.8-flash-next":
        requires_qwen4_qsa = True

    profile = MULTI_MODEL_PROFILES.get(kernel_target)
    binary_fallback: Optional[Dict[str, str]] = None
    selected_binary = os.environ.get("FLUX_SERVER_BIN", "").strip() or (
        _profile_binary(profile) if profile is not None else BINARIES.get(binary_key, BINARIES["primary"])
    )
    if not _safe_is_file(Path(selected_binary)):
        local_bin = Path(__file__).resolve().parent / "bin" / Path(selected_binary).name
        if _safe_is_file(local_bin):
            selected_binary = str(local_bin)
        else:
            if profile is not None:
                # Not silent: flux-server-real serves this target only if it was built
                # with it in ATLAS_TARGET_MODEL. build_launch_plan reports this.
                binary_fallback = {
                    "wanted": selected_binary,
                    "using": BINARIES["primary"],
                    "error": (
                        f"{selected_binary} is not installed, so {kernel_target} falls back to "
                        f"{BINARIES['primary']}. That binary serves {kernel_target} only if it was "
                        f"built with {kernel_target} in ATLAS_TARGET_MODEL; otherwise the server "
                        "stops at load with 'did not match any compiled kernel target'. "
                        "Install the binary or set FLUX_SERVER_BIN."
                    ),
                }
            selected_binary = BINARIES["primary"]

    # Determine status before speculative pairing
    status = "ready"
    if drafter:
        status = "drafter-checkpoint"
    elif broken_links and not valid_safetensors:
        status = "broken-symlinks"
    elif not valid_safetensors and not (list(model_dir.glob("*.bin")) if _safe_is_dir(model_dir) else []):
        status = "missing-weights"
    elif not cfg or hidden_size == 0:
        status = "invalid-config"
    elif is_non_causal:
        status = "non-causal-or-trtllm"

    # Architecture-validated speculative decoding / MTP detection
    env_draft_raw = (
        os.environ.get("FLUX_DRAFT_MODEL")
        or os.environ.get("FLUX_MTP_PATH")
        or os.environ.get("FLUX_DRAFTER_PATH")
        or ""
    ).strip().lower()
    spec_disabled_env = (
        env_draft_raw in ("none", "off", "0", "false")
        or os.environ.get("FLUX_SPEC_MODE", "").strip().lower() in ("none", "off", "0", "false")
        or os.environ.get("FLUX_DISABLE_SPECULATION", "").strip().lower() in ("1", "true", "yes")
        or os.environ.get("ATLAS_DISABLE_SPECULATION", "").strip().lower() in ("1", "true", "yes")
        or (profile is not None and profile["speculation"] == "none")
    )
    explicit_external_draft = bool(env_draft_raw and env_draft_raw not in ("none", "off", "0", "false"))
    requested_spec_mode = os.environ.get("FLUX_SPEC_MODE", "").strip().lower()
    prefer_dflash_mode = requested_spec_mode in ("dflash", "dflash2")
    conc_env_raw = os.environ.get("FLUX_CONCURRENCY", "1").strip()
    requested_concurrency = int(conc_env_raw) if conc_env_raw.isdigit() else 1
    launch_warnings: List[str] = []
    if profile is not None and profile["speculation"] == "none" and requested_spec_mode not in (
        "", "none", "off", "0", "false"
    ):
        # GLM-5.3 (DFlash2 is refused at load), DeepSeek-V4.1 and Gemma serve target-only:
        # no drafter search and no --dflash, whatever FLUX_SPEC_MODE asks for.
        launch_warnings.append(
            f"{profile['label']} serves target-only; FLUX_SPEC_MODE={requested_spec_mode} is ignored."
        )
    # The 27B profile speculates with DFlash2 by default; FLUX_SPEC_MODE=mtp selects the
    # in-checkpoint MTP head, which has no 27B measurement.
    dflash2_default = (
        profile is not None
        and profile["speculation"] == "dflash2"
        and requested_spec_mode in ("", "dflash", "dflash2")
    )
    if dflash2_default:
        prefer_dflash_mode = True
    # Qwen3.8-Flash-Next graduates incoai-dflash2-b8 (qualified=true, launcher_default=true):
    # when a qualified DFlash2 companion is mounted alongside the base model, FLUX_SPEC_MODE
    # is unset, and concurrency <= 16 on GB10 UMA (or <= 64 on discrete GPUs), auto-attach
    # DFlash2; otherwise seamlessly fall back to NextGen in-checkpoint Native-MTP.
    hw = detect_hardware_topology()
    is_discrete_auto_hw = (not bool(hw.get("unified_memory_architecture"))) and (
        float(hw.get("per_gpu_vram_gib") or hw.get("total_vram_gib") or 0.0) > 0.0
    )
    dflash2_auto_max_c = 64 if is_discrete_auto_hw else 16
    default_drafter_row = launcher_default_drafter_profile(kernel_target)
    flash_next_dflash2_auto = (
        kernel_target == "qwen3.8-flash-next"
        and default_drafter_row is not None
        and default_drafter_row.get("kind") == "dflash2"
        and requested_spec_mode == ""
        and requested_concurrency <= dflash2_auto_max_c
        and not explicit_external_draft
        and not spec_disabled_env
    )
    gamma_env_raw = os.environ.get("FLUX_GAMMA", "").strip()
    gamma_override = int(gamma_env_raw) if gamma_env_raw.isdigit() and int(gamma_env_raw) > 0 else None

    spec_info: Dict[str, Any] = {"mode": "none", "drafter_path": None, "gamma": 0, "native_mtp_k": 0}
    has_in_ckpt_mtp = (status == "ready" and not spec_disabled_env and has_in_checkpoint_mtp_weights(model_dir, mtp_layers))

    # When model_dir already contains in-checkpoint MTP experts (e.g. Qwen3.8-Flash-Next-NVFP4-QAD5500-Hybrid,
    # Qwen3.8-Flash-Next-NVFP4-Offload, CYBER-FROST-3.8-NVFP4-Offload), use the in-checkpoint native MTP head
    # directly (drafter_path = None) unless a qualified DFlash2 companion is auto-paired (C<=16) or the user
    # explicitly set FLUX_MTP_PATH / FLUX_DRAFT_MODEL / FLUX_SPEC_MODE=dflash.
    # Default to 6 drafts (K=7) where ATLAS_QWEN4_HYBRID_ALL_K=1 admits K=2..=9 at C=1
    # and batched adaptive-K admits K=2..=8 up to 128 rows/frame (16x7=112 <= 128) for C<=16;
    # ATLAS_QWEN4_MTP_CONF_CUM=0.4 trims high-entropy solo prose while letting high-confidence
    # spans reach K=7. build_launch_plan caps C>16, fixed-K5, and serial K5 to 4 drafts (K=5).
    default_mtp_drafts = 6
    if has_in_ckpt_mtp and not explicit_external_draft and not prefer_dflash_mode and not flash_next_dflash2_auto:
        num_drafts = gamma_override if gamma_override is not None else default_mtp_drafts
        spec_info = {
            "mode": "native-mtp",
            "drafter_path": None,
            "gamma": num_drafts,
            "num_drafts": num_drafts,
            "native_mtp_k": num_drafts + 1,
            "mtp_layers": max(1, mtp_layers),
        }
    else:
        companion = (
            find_companion_drafter(model_dir, kernel_target, hidden_size, num_layers)
            if (status == "ready" and not spec_disabled_env)
            else None
        )
        if (
            companion
            and flash_next_dflash2_auto
            and has_in_ckpt_mtp
            and not _is_qualified_flash_next_dflash2(_read_json(companion / "config.json"))
        ):
            # Only a qualified incoai-dflash2-b8 companion supersedes in-checkpoint Native-MTP
            # during zero-flag auto-discovery; unqualified drafters or external MTP sidecars
            # fall back cleanly to in-checkpoint Native-MTP.
            companion = None
        if (
            companion
            and dflash2_default
            and not explicit_external_draft
            and not _is_dflash2_drafter(_read_json(companion / "config.json"))
        ):
            launch_warnings.append(
                f"{companion.name} is not a DFlash2 drafter; {kernel_target} serves target-only. "
                "Set FLUX_DRAFT_MODEL to use it anyway."
            )
            companion = None
            has_in_ckpt_mtp = False
        elif companion is None and dflash2_default and status == "ready" and not spec_disabled_env:
            launch_warnings.append(
                f"no DFlash2 drafter found next to the model or in /models; {kernel_target} serves "
                "target-only. FLUX_SPEC_MODE=mtp selects the in-checkpoint MTP head (unmeasured)."
            )
            has_in_ckpt_mtp = False
        if companion and _safe_is_dir(companion):
            comp_st = [s for s in companion.glob("*.safetensors") if _safe_exists(s)]
            is_comp_mtp = bool(comp_st and all("mtp" in s.name.lower() for s in comp_st))
            if is_comp_mtp or "inferact-mtp" in companion.name.lower():
                num_drafts = gamma_override if gamma_override is not None else default_mtp_drafts
                spec_info = {
                    "mode": "native-mtp",
                    "drafter_path": str(companion),
                    "drafter_name": companion.name,
                    "gamma": num_drafts,
                    "num_drafts": num_drafts,
                    "native_mtp_k": num_drafts + 1,
                    "mtp_layers": max(1, mtp_layers),
                }
            else:
                d_cfg = _read_json(companion / "config.json")
                d_tcfg = d_cfg.get("text_config") if isinstance(d_cfg.get("text_config"), dict) else {}
                d_dflash = d_cfg.get("dflash_config") if isinstance(d_cfg.get("dflash_config"), dict) else {}
                block_size = int(
                    d_cfg.get("block_size")
                    or d_dflash.get("block_size")
                    or d_tcfg.get("block_size")
                    or d_cfg.get("draft_block_size")
                    or (8 if "incoai" in f"{companion.parent.name}/{companion.name}".lower() else 16)
                )
                gamma = gamma_override if gamma_override is not None else max(1, block_size - 1)
                spec_info = {
                    "mode": "dflash",
                    "drafter_path": str(companion),
                    "drafter_name": companion.name,
                    "block_size": block_size,
                    "gamma": gamma,
                    "ddtree_max_nodes": gamma + 1,
                }
        elif has_in_ckpt_mtp:
            num_drafts = gamma_override if gamma_override is not None else default_mtp_drafts
            spec_info = {
                "mode": "native-mtp",
                "drafter_path": None,
                "gamma": num_drafts,
                "num_drafts": num_drafts,
                "native_mtp_k": num_drafts + 1,
                "mtp_layers": max(1, mtp_layers),
            }

    if profile is not None:
        recommended_seq_len = int(profile["max_seq_len"])
    elif os.environ.get("FLUX_AUTO_SCALE_CONTEXT", "0") == "1":
        recommended_seq_len = min(max(max_pos, 262144), hw["hardware_max_seq_len_fp8_kv"])
    elif requires_qwen4_qsa and max_pos >= 262144 and hw["hardware_default_seq_len"] >= 131072:
        recommended_seq_len = 262144
    elif requires_qwen4_qsa and max_pos >= 135168 and hw["hardware_default_seq_len"] >= 131072:
        recommended_seq_len = 135168
    else:
        recommended_seq_len = min(max_pos, hw["hardware_default_seq_len"]) if max_pos > 0 else 131072
    max_rope_yarn_seq_len = max(max_pos * 4, 1048576) if max_pos > 0 else 1048576
    # Qwen3.8 Flash-Next (model_type=qwen4_exp) is trained on the native
    # Qwen3-Coder XML envelope, not Hermes JSON.  Selecting Hermes here makes
    # the launcher disagree with both the checkpoint Jinja template and the
    # server's parser registry, so valid calls are published as prose.
    qwen_xml_tools = (
        "nemotron" in kernel_target
        or "qwen3.8-flash-next" in kernel_target
        or model_type in ("qwen4_exp", "qwen3_8_flash_next")
        or text_model_type in ("qwen4_exp_text", "qwen3_8_flash_next_text")
    )
    tool_call_parser = "qwen3_coder" if qwen_xml_tools else "hermes"
    if profile is not None:
        tool_call_parser = profile["tool_call_parser"]

    info = {
        "name": display_name,
        "path": str(model_dir),
        "status": status,
        "is_drafter": drafter,
        "family": family,
        "architecture": arch_str,
        "model_type": model_type,
        "text_model_type": text_model_type,
        "quantization": quant,
        "quant": quant,
        "hidden_size": hidden_size,
        "num_hidden_layers": num_layers,
        "num_experts": num_experts,
        "num_experts_per_tok": num_experts_per_tok,
        "vocab_size": vocab_size,
        "max_position_embeddings": max_pos,
        "rope_theta": rope_theta,
        "rope_scaling": rope_scaling,
        "recommended_max_seq_len": recommended_seq_len,
        "max_rope_yarn_seq_len": max_rope_yarn_seq_len,
        "recommended_tool_call_parser": tool_call_parser,
        "requires_qwen4_qsa": requires_qwen4_qsa,
        "has_vision": has_vision,
        "ple_dir": ple_dir,
        "safetensors_count": len(valid_safetensors),
        "broken_symlinks": broken_links,
        "kernel_target": kernel_target,
        "selected_binary": selected_binary,
        "speculative": spec_info,
    }
    if profile is not None:
        info["launch_warnings"] = launch_warnings
        info["binary_fallback"] = binary_fallback
    return info


def scan_models_root(roots: Optional[List[Path]] = None) -> List[Dict[str, Any]]:
    if roots is None:
        roots = []
        env_m = os.environ.get("FLUX_MODEL", "").strip()
        if env_m:
            if _safe_exists(Path(env_m)):
                roots.append(Path(env_m))
            elif _safe_exists(Path("/models") / env_m):
                roots.append(Path("/models") / env_m)
        for r in (
            "/models",
            "/workspace/models",
            os.environ.get("HF_HUB_CACHE", ""),
            str(Path(os.environ.get("HF_HOME", "/root/.cache/huggingface")) / "hub"),
        ):
            if r:
                rp = Path(r)
                if _safe_is_dir(rp) and rp not in roots:
                    roots.append(rp)
    seen = set()
    models: List[Dict[str, Any]] = []

    def _add_candidate(cand: Path) -> None:
        try:
            eff_dir, _ = resolve_hf_or_model_dir(cand)
            key = str(eff_dir)
            if key not in seen and (_safe_exists(eff_dir / "config.json") or list(eff_dir.glob("*.safetensors"))):
                seen.add(key)
                models.append(inspect_model(cand))
        except Exception:
            pass

    for root in roots:
        if not _safe_exists(root):
            continue
        eff_root, _ = resolve_hf_or_model_dir(root)
        if _safe_is_file(eff_root / "config.json") or (list(eff_root.glob("*.safetensors")) if _safe_is_dir(eff_root) else []):
            _add_candidate(root)
            continue
        try:
            for child in sorted(root.iterdir()):
                try:
                    if not _safe_is_dir(child):
                        continue
                    eff_c, _ = resolve_hf_or_model_dir(child)
                    if _safe_exists(eff_c / "config.json") or list(eff_c.glob("*.safetensors")):
                        _add_candidate(child)
                    elif not child.name.startswith("."):
                        # Also support 2-level `<org>/<repo>/config.json` directory layouts
                        for subchild in sorted(child.iterdir()):
                            try:
                                if _safe_is_dir(subchild) and (_safe_exists(subchild / "config.json") or list(subchild.glob("*.safetensors"))):
                                    _add_candidate(subchild)
                            except Exception:
                                continue
                except Exception:
                    continue
        except Exception:
            pass
    return models


def select_best_model(models: List[Dict[str, Any]], query: Optional[str] = None) -> Optional[Dict[str, Any]]:
    ready = [m for m in models if m["status"] == "ready" and not m["is_drafter"]]
    if not ready:
        return models[0] if models else None

    # 2. Universal architecture-based ranking:
    #    Prioritize FLUX_TARGET (default qwen3.8-flash-next on GB10), PLE offload, NVFP4/FP8 quantization,
    #    speculative/MTP support, and canonical checkpoint names before parameter scale proxy.
    preferred_target = os.environ.get("FLUX_TARGET", "qwen3.8-flash-next").strip().lower()

    def _rank_key(m: Dict[str, Any]) -> Tuple[int, int, int, int, int, int, int]:
        target_match = 1 if m.get("kernel_target", "").lower() == preferred_target else 0
        ple_score = 1 if m.get("ple_dir") else 0
        q_str = str(m.get("quantization", "")).upper()
        quant_score = 3 if q_str == "NVFP4" else (2 if q_str in ("FP8", "MODELOPT") else 1)
        spec_score = 1 if m.get("speculative", {}).get("mode") != "none" else 0
        name_l = m.get("name", "").lower()
        canonical_score = (
            3
            if "qwen3.8-flash-next-nvfp4-qad5500-hybrid" in name_l
            else (
                2
                if "qwen3.8-flash-next-nvfp4-offload" in name_l
                else (1 if ("qwen3.8" in name_l or "qwen3.6" in name_l) else 0)
            )
        )
        is_hybrid_or_moe = 1 if (m.get("num_experts", 0) > 0 or m.get("hidden_size", 0) >= 2048) else 0
        arch_scale = int(m.get("num_hidden_layers", 0)) * int(m.get("hidden_size", 0))
        return (target_match, ple_score, quant_score, spec_score, canonical_score, is_hybrid_or_moe, arch_scale)

    # 1. If user specified FLUX_MODEL or CLI query (by path, HF org/repo, or substring), honor it first
    q = (query or os.environ.get("FLUX_MODEL", "")).strip().lower()
    if q:
        for pool in (ready, models):
            ranked_pool = sorted(pool, key=_rank_key, reverse=True)
            for m in ranked_pool:
                if q == m["name"].lower() or q == Path(m["path"]).name.lower() or q == m["path"].lower():
                    return m
            for m in ranked_pool:
                if q in m["name"].lower() or q in m["path"].lower() or q in m["kernel_target"].lower():
                    return m
        return None

    return sorted(ready, key=_rank_key, reverse=True)[0]


def resolve_model_query(explicit_model: Optional[str] = None, roots: Optional[List[Path]] = None) -> Optional[Dict[str, Any]]:
    q = (explicit_model or os.environ.get("FLUX_MODEL", "")).strip()
    if q:
        for cand in (Path(q), Path("/models") / q, Path("/workspace/models") / q):
            if _safe_exists(cand):
                eff_c, _ = resolve_hf_or_model_dir(cand)
                if _safe_exists(eff_c / "config.json") or (_safe_is_dir(eff_c) and list(eff_c.glob("*.safetensors"))):
                    return inspect_model(cand)
    models = scan_models_root(roots)
    return select_best_model(models, query=q if q else None)


def _find_recipe_path(recipe_filename: str) -> Optional[Path]:
    cand = Path(recipe_filename)
    if _safe_is_file(cand):
        return cand
    for base in (Path("/opt/flux/repro-kit/recipes"), Path("/opt/flux/recipes"), Path(__file__).resolve().parent / "recipes"):
        p = base / recipe_filename
        if _safe_is_file(p):
            return p
        if not recipe_filename.endswith(".env"):
            p_env = base / f"{recipe_filename}.env"
            if _safe_is_file(p_env):
                return p_env
    return None


def _load_recipe_env(recipe_filename: str) -> Dict[str, str]:
    out: Dict[str, str] = {}
    p = _find_recipe_path(recipe_filename)
    if p and _safe_is_file(p):
        try:
            for line in p.read_text(encoding="utf-8", errors="replace").splitlines():
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                if line.startswith("export "):
                    line = line[len("export "):].strip()
                if "=" not in line:
                    continue
                k, v = line.split("=", 1)
                v = v.strip()
                if (v.startswith('"') and v.endswith('"')) or (v.startswith("'") and v.endswith("'")):
                    v = v[1:-1]
                out[k.strip()] = v
        except Exception:
            pass
    return out


