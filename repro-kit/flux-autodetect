def _find_repacker_script() -> Optional[Path]:
    here = Path(__file__).resolve().parent
    for cand in (
        Path("/opt/flux/scripts/repack_qwen38_flash_next_ple_nvfp4.py"),
        Path("/usr/local/bin/repack-ple"),
        here / "scripts" / "repack_qwen38_flash_next_ple_nvfp4.py",
        here.parent / "scripts" / "repack_qwen38_flash_next_ple_nvfp4.py",
    ):
        if _safe_is_file(cand):
            return cand
    return None


def _find_lens_script() -> Optional[Path]:
    for candidate in (
        Path(__file__).resolve().with_name("flux_lens.py"),
        Path("/usr/local/bin/flux-lens"),
    ):
        if _safe_is_file(candidate):
            return candidate
    return None


def _plan_refusal(error: ValueError) -> int:
    """A plan-time refusal is one `[flux] ERROR:` line and exit 2; the traceback
    is kept only for FLUX_DEBUG=1 or FLUX_LOAD_DEBUG=always."""
    debug = (
        os.environ.get("FLUX_DEBUG", "").strip().lower() in ("1", "true", "on", "yes")
        or os.environ.get("FLUX_LOAD_DEBUG", "").strip().lower() == "always"
    )
    if debug:
        import traceback

        traceback.print_exception(type(error), error, error.__traceback__, file=sys.stderr)
    print(f"[flux] ERROR: {error}", file=sys.stderr, flush=True)
    return 2


