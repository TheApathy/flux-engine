def _moe_exact_rows_selected(env_vars: Dict[str, str]) -> bool:
    """Mirror spark_model::qwen4_batch_policy::moe_exact_rows_selected for Qwen4.

    Native batching needs the exact lane-parallel MoE rows route; without it
    the server serializes every C2+ frame, and refuses QSA rows outright.
    """
    def truthy(value: str) -> bool:
        return value == "1" or value.lower() == "true"

    unified = env_vars.get("ATLAS_UNIFIED_MOE_LAYOUT")
    hybrid = env_vars.get("ATLAS_HYBRID_MOE_LAYOUT")
    return (
        env_vars.get("ATLAS_MOE_T_LANES") == "1"
        and (unified is None or truthy(unified))
        and not (hybrid is not None and truthy(hybrid))
    )


