# ── Live server settings: `flux settings` / `flux set key=value ...` ───────────
# Talks to the RUNNING server's /v1/flux/settings (default 127.0.0.1:$FLUX_PORT),
# so it works inside the container via `docker exec <ctr> flux set ...`. Without
# a server API key a change needs the server's local admin token, which the
# server writes at every start to /run/flux/admin.<port>.token (mode 0600) and which
# `flux set` reads and sends as X-Flux-Admin-Token. With an API key, pass it via
# FLUX_API_KEY (or --api-key). Neither secret is ever printed.

SETTINGS_HELP = """flux settings [--json] [--url URL]
flux set key=value ... [--reset key] [--url URL] [--api-key KEY]

Show or change the RUNNING server's request defaults. New requests use a change,
requests already running keep theirs, and a field the request sets itself wins.

Keys (`flux settings` lists every key with its value and source):
  thinking.default                       true|false
  thinking.max_budget                    thinking ceiling for requested thinking
  thinking.answer_reserve                answer room kept when a request sets no budget
  thinking.effort_budget.<effort>        none|minimal|low|medium|high|xhigh|max
  sampling.<preset>.<field>              preset: thinking_text|non_thinking|tools
                                         field: temperature|top_p|top_k|min_p|
                                                presence_penalty|frequency_penalty|repetition_penalty
  max_tokens.default                     allowance for requests without max_tokens
  think_nudge.enabled|rate|min_tokens|max  (Flash-Next and Qwen3.8-27B only)
Values are JSON (true, 0.6, null); `null` or --reset restores the startup value.

Not adjustable at runtime: model, KV dtype, context length, concurrency,
speculation, watchdog thresholds, and the scheduler's SPONTANEOUS-thinking
budget (the cap on <think> the model opens by itself when the request did not
ask for thinking; it stays at --max-thinking-budget / MODEL.toml from launch).

Access: with a server API key, send it (FLUX_API_KEY). Without one, only this
container can change settings (it reads the local admin token): from the host
use `docker exec <container> flux set ...`.
"""

def _settings_url(rest: List[str]) -> str:
    """The settings endpoint. `--url` and FLUX_SETTINGS_URL both name the
    server base (e.g. http://127.0.0.1:8899); the path is appended unless the
    value already ends with it."""
    base = None
    for i, a in enumerate(rest):
        if a == "--url" and i + 1 < len(rest):
            base = rest[i + 1]
    base = base or os.environ.get("FLUX_SETTINGS_URL") or f"http://127.0.0.1:{os.environ.get('FLUX_PORT', '8899')}"
    base = base.rstrip("/")
    return base if base.endswith("/v1/flux/settings") else base + "/v1/flux/settings"


def _settings_api_key(rest: List[str]) -> Optional[str]:
    for i, a in enumerate(rest):
        if a == "--api-key" and i + 1 < len(rest):
            print("[flux] WARN: --api-key on the command line is visible in `ps` and shell history; "
                  "prefer FLUX_API_KEY", file=sys.stderr)
            return rest[i + 1]
    key = os.environ.get("FLUX_API_KEY")
    if key:
        return key
    token_file = os.environ.get("FLUX_AUTH_TOKENS_FILE")
    if token_file:
        try:
            for line in Path(token_file).read_text(encoding="utf-8").splitlines():
                line = line.strip()
                if line and not line.startswith("#"):
                    return line
        except OSError:
            return None
    return None


def parse_set_args(rest: List[str]) -> Dict[str, Any]:
    """`key=value ...` and `--reset key` into a PATCH body. Values are JSON
    (`true`, `0.6`, `null`); anything that is not JSON is sent as a string."""
    body: Dict[str, Any] = {}
    skip = False
    for i, a in enumerate(rest):
        if skip:
            skip = False
            continue
        if a in ("--url", "--api-key"):
            skip = True
            continue
        if a == "--reset":
            if i + 1 >= len(rest):
                raise ValueError("--reset needs a key")
            body[rest[i + 1]] = None
            skip = True
            continue
        if a == "--json":
            continue
        if "=" not in a:
            raise ValueError(f"expected key=value, got {a!r}")
        key, raw = a.split("=", 1)
        key = key.strip()
        if not key:
            raise ValueError(f"empty key in {a!r}")
        try:
            body[key] = json.loads(raw)
        except ValueError:
            body[key] = raw
    if not body:
        raise ValueError("nothing to set (usage: flux set key=value ... | --reset key)")
    return body


class SettingsClientError(Exception):
    """The server could not be reached or did not answer with JSON."""


_LOOPBACK_HOSTS = ("127.0.0.1", "localhost", "::1")


def _url_host_port(url: str) -> Tuple[str, int]:
    import urllib.parse
    parts = urllib.parse.urlsplit(url)
    host = (parts.hostname or "").lower()
    try:
        port = parts.port
    except ValueError:
        port = None
    if port is None:
        port = 443 if parts.scheme == "https" else 80
    return host, port


def _admin_token_paths(port: int) -> List[Path]:
    """Where the server on `port` writes its token (admin.<port>.token)."""
    explicit = os.environ.get("FLUX_ADMIN_TOKEN_FILE") or os.environ.get("ATLAS_ADMIN_TOKEN_FILE")
    if explicit and explicit.strip():
        return [Path(explicit.strip())]
    name = f"admin.{port}.token"
    paths = [Path("/run/flux") / name]
    runtime_dir = os.environ.get("XDG_RUNTIME_DIR")
    if runtime_dir:
        paths.append(Path(runtime_dir) / "flux" / name)
    return paths


def read_admin_token(url: str) -> Optional[str]:
    """The local admin token of the server at `url`, only when `url` is a
    loopback address (the token must never travel off this machine) and this
    user can read the file for that server's port."""
    host, port = _url_host_port(url)
    if host not in _LOOPBACK_HOSTS:
        return None
    for path in _admin_token_paths(port):
        try:
            token = path.read_text(encoding="utf-8").strip()
        except OSError:
            continue
        if token:
            return token
    return None


def settings_request(method: str, url: str, api_key: Optional[str], body: Optional[Dict[str, Any]] = None) -> Tuple[int, Dict[str, Any]]:
    """`(status, document)`; raises SettingsClientError when there is no JSON
    answer (connection refused, timeout, a proxy's HTML error page)."""
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method)
    req.add_header("Accept", "application/json")
    if data is not None:
        req.add_header("Content-Type", "application/json")
    if api_key:
        req.add_header("Authorization", f"Bearer {api_key}")
    if method != "GET":
        admin_token = read_admin_token(url)
        if admin_token:
            req.add_header("X-Flux-Admin-Token", admin_token)
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            status, raw = resp.status, resp.read()
    except urllib.error.HTTPError as e:
        status, raw = e.code, e.read()
    except (urllib.error.URLError, OSError) as e:
        reason = getattr(e, "reason", e)
        raise SettingsClientError(f"cannot reach {url}: {reason} (is the server running? set FLUX_PORT or --url)") from None
    try:
        doc = json.loads(raw or b"{}")
    except ValueError:
        raise SettingsClientError(f"{url} answered HTTP {status} without JSON (not a Flux server, or a proxy error page)") from None
    if not isinstance(doc, dict):
        raise SettingsClientError(f"{url} answered HTTP {status} with unexpected JSON")
    return status, doc


def format_settings(doc: Dict[str, Any]) -> str:
    rows = [f"Flux runtime settings ({doc.get('model', '?')})"]
    settings = doc.get("settings") or {}
    width = max((len(k) for k in settings), default=10)
    for key, entry in settings.items():
        value = json.dumps(entry.get("value"))
        rows.append(f"  {key:<{width}}  {value:<10}  [{entry.get('source')}]")
    if doc.get("persist_file"):
        rows.append(f"  (saved to {doc['persist_file']})")
    rows.append("  restart-only: " + ", ".join(doc.get("restart_only") or []))
    return "\n".join(rows)


def cmd_settings(rest: List[str]) -> int:
    if any(a in ("-h", "--help") for a in rest):
        print(SETTINGS_HELP)
        return 0
    try:
        status, doc = settings_request("GET", _settings_url(rest), _settings_api_key(rest))
    except SettingsClientError as e:
        print(f"[flux] ERROR: {e}", file=sys.stderr)
        return 1
    if status != 200:
        print(f"[flux] settings: HTTP {status}: {(doc.get('error') or {}).get('message', doc)}", file=sys.stderr)
        return 1
    print(json.dumps(doc, indent=2) if "--json" in rest else format_settings(doc))
    return 0


def cmd_set(rest: List[str]) -> int:
    if any(a in ("-h", "--help") for a in rest):
        print(SETTINGS_HELP)
        return 0
    try:
        body = parse_set_args(rest)
    except ValueError as e:
        print(f"[flux] set: {e}", file=sys.stderr)
        return 2
    try:
        status, doc = settings_request("PATCH", _settings_url(rest), _settings_api_key(rest), body)
    except SettingsClientError as e:
        print(f"[flux] ERROR: {e}", file=sys.stderr)
        return 1
    if status != 200:
        err = doc.get("error") or {}
        print(f"[flux] set refused (HTTP {status}, {err.get('code')}): {err.get('message', doc)}", file=sys.stderr)
        return 1
    for change in doc.get("changed") or []:
        print(f"{change['key']}: {json.dumps(change['old'])} -> {json.dumps(change['new'])}")
    if "--json" in rest:
        print(json.dumps(doc, indent=2))
    return 0


