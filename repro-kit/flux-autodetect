    "2x-spark-1m": "2x-spark-1m",
    "tp2-1m": "2x-spark-1m",
    "3x-spark": "3x-spark",
    "pp3": "3x-spark",
    "1p2d": "3x-spark",
    "4x-spark": "4x-spark",
    "tp4": "4x-spark",
    "pp4": "4x-spark",
}


def _safe_exists(path: Path) -> bool:
    try:
        return path.exists()
    except OSError:
        return False


def _safe_is_dir(path: Path) -> bool:
    try:
        return path.is_dir()
    except OSError:
        return False


def _safe_is_file(path: Path) -> bool:
    try:
        return path.is_file()
    except OSError:
        return False


def _find_real_driver_libs() -> List[str]:
    real_libs: List[str] = []
    for cand in (
        "/usr/lib/aarch64-linux-gnu/libcuda.so.1",
        "/lib/aarch64-linux-gnu/libcuda.so.1",
        "/usr/lib/x86_64-linux-gnu/libcuda.so.1",
        "/lib/x86_64-linux-gnu/libcuda.so.1",
        "/usr/lib64/libcuda.so.1",
    ):
        p = Path(cand)
        if _safe_is_file(p) and "compat" not in str(p):
            real_libs.append(cand)
    return real_libs


def _sanitize_cuda_ld_library_path() -> List[str]:
    """
    When `--gpus all` mounts the host's real libcuda.so.1 into the container,
    strip `/usr/local/cuda-*/compat` from LD_LIBRARY_PATH so child processes
    (ldd, flux-server-real) bind to the real NVIDIA driver instead of the stub.
    """
    real_libs = _find_real_driver_libs()
    if real_libs:
        ld_path = os.environ.get("LD_LIBRARY_PATH", "")
        if "compat" in ld_path:
            parts = [p for p in ld_path.split(":") if p and "compat" not in p]
            os.environ["LD_LIBRARY_PATH"] = ":".join(parts)
    return real_libs


def _parse_cpu_affinity(spec: str) -> List[int]:
    cpus = set()
    for part in spec.split(","):
        part = part.strip()
        if not part:
            continue
        if "-" in part:
            bounds = part.split("-", 1)
            if bounds[0].strip().isdigit() and bounds[1].strip().isdigit():
                start, end = int(bounds[0].strip()), int(bounds[1].strip())
                if start <= end:
                    cpus.update(range(start, end + 1))
        elif part.isdigit():
            cpus.add(int(part))
    return sorted(cpus)


def parse_opt_outs(argv: List[str]) -> Tuple[Dict[str, bool], List[str]]:
    # Privacy-First by Default: telemetry, host identifiers, and prompt logs are all opted-out/redacted by default
    env_raw = os.environ.get("FLUX_OPT_OUT", "all").lower()
    tokens = {t.strip() for t in env_raw.replace(";", ",").split(",") if t.strip()}
    none_out = ("none" in tokens) or ("0" in tokens) or ("false" in tokens)
    all_out = (not none_out) and (("all" in tokens) or ("1" in tokens) or ("true" in tokens) or not tokens)
    opts = {
        "telemetry": True,  # 100% offline/air-gapped by design
        "host": all_out or ("host" in tokens) or ("host-info" in tokens),
        "logs": all_out or ("logs" in tokens) or ("prompts" in tokens) or ("prompt-logs" in tokens),
    }
    if os.environ.get("FLUX_INCLUDE_HOST_INFO", "") == "1":
        opts["host"] = False
    if os.environ.get("FLUX_INCLUDE_PROMPT_LOGS", "") == "1":
        opts["logs"] = False
    cleaned: List[str] = []
    for a in argv:
        if a in ("--opt-out-telemetry", "--no-upload", "--offline"):
            opts["telemetry"] = True
        elif a == "--opt-out-host-info":
            opts["host"] = True
        elif a == "--opt-out-prompt-logs":
            opts["logs"] = True
        elif a in ("--opt-out-all", "--privacy-first"):
            opts["telemetry"] = True
            opts["host"] = True
            opts["logs"] = True
        elif a == "--include-host-info":
            opts["host"] = False
        elif a == "--include-prompt-logs":
            opts["logs"] = False
        else:
            cleaned.append(a)
    return opts, cleaned


def _read_json(path: Path) -> Dict[str, Any]:
    try:
        if _safe_is_file(path):
            return json.loads(path.read_text(encoding="utf-8", errors="replace"))
    except Exception:
        pass
    return {}


def resolve_hf_or_model_dir(path: Path) -> Tuple[Path, Optional[str]]:
    """
    Resolve either a standard model directory OR a HuggingFace Hub cache directory
    (`models--<org>--<repo>/snapshots/<commit_hash>`) without dereferencing symlinks
    inside `snapshots/<commit_hash>` (which point to `../../blobs/<sha256>`).
    Returns (resolved_model_dir, display_name_override).
    """
    if not _safe_exists(path):
        return path, None
    name = path.name
    if name.startswith("models--") and _safe_is_dir(path / "snapshots"):
        parts = name.split("--")
        display_name = "/".join(parts[1:]) if len(parts) >= 3 else name
        refs_main = path / "refs" / "main"
        if _safe_is_file(refs_main):
            try:
                rev = refs_main.read_text(encoding="utf-8").strip()
                snap = path / "snapshots" / rev
                if _safe_is_file(snap / "config.json"):
                    return snap, display_name
            except Exception:
                pass
        try:
            snaps = sorted(
                [d for d in (path / "snapshots").iterdir() if _safe_is_dir(d) and _safe_is_file(d / "config.json")],
                key=lambda p: p.stat().st_mtime,
                reverse=True,
            )
            if snaps:
                return snaps[0], display_name
        except Exception:
            pass
    # Check if path is itself inside `models--<org>--<repo>/snapshots/<rev>`
    if path.parent.name == "snapshots" and path.parent.parent.name.startswith("models--"):
        parts = path.parent.parent.name.split("--")
        display_name = "/".join(parts[1:]) if len(parts) >= 3 else path.name
        return path, display_name
    return path, None


def is_drafter_dir(path: Path, cfg: Optional[Dict[str, Any]] = None) -> bool:
    eff_path, disp = resolve_hf_or_model_dir(path)
    name_l = (disp or path.name).lower()
    if any(k in name_l for k in ("dflash", "drafter", "eagle", "medusa", "inferact-mtp")):
        return True
    cfg = cfg if cfg is not None else _read_json(eff_path / "config.json")
    tcfg = cfg.get("text_config") if isinstance(cfg.get("text_config"), dict) else {}
    merged = {**tcfg, **cfg}
    mt = str(merged.get("model_type", "")).lower()
    archs = " ".join(merged.get("architectures", []) or []).lower()
    if any(k in mt or k in archs for k in ("dflash", "drafter", "eagle")):
        return True
    if "dflash_config" in merged or ("block_size" in merged and int(merged.get("num_hidden_layers", 99)) <= 10):
        return True
    # Standalone MTP checkpoint check: all safetensors files in directory are MTP-only shards
    if _safe_is_dir(eff_path):
        try:
            st = list(eff_path.glob("*.safetensors"))
            if st and all("mtp" in s.name.lower() for s in st):
                return True
        except Exception:
            pass
    return False


def has_in_checkpoint_mtp_weights(model_dir: Path, mtp_layers: int) -> bool:
    if "nomtp" in model_dir.name.lower():
        return False
    idx_file = model_dir / "model.safetensors.index.json"
    if _safe_is_file(idx_file):
        try:
            idx_raw = idx_file.read_text(encoding="utf-8", errors="replace")
            if (
                "mtp.layers.0.mlp.experts.0.gate_proj.weight" in idx_raw
                or "mtp.layers.0.mlp.experts.gate_up_proj" in idx_raw
                or '"mtp.fc.weight"' in idx_raw
                or '"mtp.fc_embedding.weight"' in idx_raw
                or '"mtp.fc_hidden.weight"' in idx_raw
                or '"model.mtp.fc.weight"' in idx_raw
                or '"model.mtp.fc_embedding.weight"' in idx_raw
            ):
                return True
            return False
        except Exception:
            return False
    if mtp_layers <= 0:
        return False
    try:
        if any("mtp" in p.name.lower() for p in model_dir.glob("*.safetensors") if _safe_exists(p)):
            return True
    except Exception:
        pass
    # Single-shard model.safetensors without index file
    if _safe_exists(model_dir / "model.safetensors"):
        return True
    return False


def detect_quantization(model_dir: Path, cfg: Dict[str, Any], display_name: str = "") -> str:
    hf_q = _read_json(model_dir / "hf_quant_config.json")
    if hf_q:
        q_obj = hf_q.get("quantization") if isinstance(hf_q.get("quantization"), dict) else hf_q
        q_algo = str(q_obj.get("quant_algo", "")).upper()
        if q_algo == "MIXED_PRECISION":
            qlayers = q_obj.get("quantized_layers", {})
            if isinstance(qlayers, dict):
                algos = [
                    str(v.get("quant_algo", "")).upper()
                    for v in qlayers.values()
                    if isinstance(v, dict)
                ]
                if any("NVFP4" in a for a in algos):
                    return "NVFP4"
                if any("FP8" in a for a in algos):
                    return "FP8"
            return "MIXED_PRECISION"
        if q_algo:
            return "NVFP4" if "NVFP4" in q_algo else q_algo
    q_cfg = cfg.get("quantization_config") or (cfg.get("text_config", {}) or {}).get("quantization_config") or {}
    if isinstance(q_cfg, dict) and q_cfg:
        q_algo = str(q_cfg.get("quant_algo", "")).upper()
        qm = str(q_cfg.get("quant_method", "") or q_cfg.get("format", "") or q_algo).upper()
        bits = q_cfg.get("bits") or q_cfg.get("w_bit")
        # Check config_groups (compressed-tensors / modelopt NVFP4 format)
        cgroups = q_cfg.get("config_groups")
        if isinstance(cgroups, dict):
            for g_val in cgroups.values():
                w_cfg = g_val.get("weights", {}) if isinstance(g_val, dict) else {}
                if w_cfg.get("num_bits") == 4 and str(w_cfg.get("type", "")).lower() == "float":
                    return "NVFP4"
                if w_cfg.get("num_bits") == 8 and str(w_cfg.get("type", "")).lower() == "float":
                    return "FP8"
        if "NVFP4" in q_algo or "FP4" in q_algo or q_algo == "MIXED_PRECISION":
            return "NVFP4"
        if "FP8" in q_algo:
            return "FP8"
        if "NVFP4" in qm or "FP4" in qm or qm == "MIXED_PRECISION":
            return "NVFP4"
        if "FP8" in qm:
            return "FP8"
        if "EXL3" in qm:
            return "EXL3"
        if "AWQ" in qm:
            return f"AWQ-{bits}bit" if bits else "AWQ"
        if "GPTQ" in qm:
            return f"GPTQ-{bits}bit" if bits else "GPTQ"
    name_u = f"{display_name} {model_dir.name}".upper()
    for tag in ("NVFP4", "FP8", "BF16", "FP16", "EXL3", "AWQ", "GPTQ", "INT4", "INT8"):
        if tag in name_u:
            return tag
    dtype = str(
        cfg.get("torch_dtype")
        or cfg.get("dtype")
        or (cfg.get("text_config", {}) or {}).get("torch_dtype")
        or (cfg.get("text_config", {}) or {}).get("dtype")
        or "BF16"
    ).upper()
    return "BF16" if "BFLOAT16" in dtype else dtype


def _is_dflash2_drafter(cfg: Dict[str, Any]) -> bool:
    archs = " ".join(cfg.get("architectures", []) or []).lower()
    return "dflash2" in archs


def _is_qualified_flash_next_dflash2(cfg: Dict[str, Any]) -> bool:
    """Match the qualified Qwen3.8-Flash-Next incoai-dflash2-b8 DFlash2 geometry.

    Distinguishes the qualified 5L/B8/32Q:8KV incoai-dflash2-b8 checkpoint from
    unqualified native-v3 (DFlashDraftModel/B16), native-dflash2 (6L/B16), and
    pixelml-qwen3dspark (Qwen3DSparkModel/B7) drafters so zero-flag discovery
    never auto-attaches an experimental drafter the engine refuses by default.
    """
    tcfg = cfg.get("text_config") if isinstance(cfg.get("text_config"), dict) else {}
    merged = {**tcfg, **cfg}
    if not _is_dflash2_drafter(merged):
        return False
    dflash_cfg = merged.get("dflash_config") if isinstance(merged.get("dflash_config"), dict) else {}
    hidden_size = int(merged.get("hidden_size") or 0)
    if hidden_size != 2560:
        return False
    block_size = int(merged.get("block_size") or dflash_cfg.get("block_size") or 0)
    if block_size != 8:
        return False
    num_layers = merged.get("num_hidden_layers")
    if num_layers is not None and int(num_layers) != 5:
        return False
    t_layers = dflash_cfg.get("target_layer_ids")
    if t_layers is not None and list(t_layers) != [5, 15, 25, 35, 45]:
        return False
    if dflash_cfg.get("selector_vocab_size") is not None:
        return False
    return True


# [[dflash.profile]] rows from every kernels/<hw>/*/MODEL.toml, exported by
# scripts/drafter_profiles.py: the table the engine's drafter admission is
# compiled from. A kernel target with at least one row may get a companion.
DRAFTER_PROFILES_FILE = "drafter-profiles.json"
_DRAFTER_PROFILES: Optional[List[Dict[str, Any]]] = None


def load_drafter_profiles() -> List[Dict[str, Any]]:
    """Profile rows, or [] (no companion discovery) when the export is absent."""
    global _DRAFTER_PROFILES
    if _DRAFTER_PROFILES is None:
        rows: Any = None
        for base in (Path("/opt/flux/repro-kit/recipes"), Path("/opt/flux/recipes"), Path(__file__).resolve().parent / "recipes"):
            path = base / DRAFTER_PROFILES_FILE
            if _safe_is_file(path):
                document = _read_json(path)
                rows = document.get("profiles") if isinstance(document, dict) else None
                break
        if not isinstance(rows, list):
            print(
                f"[flux] WARN: {DRAFTER_PROFILES_FILE} missing or malformed; companion drafter discovery is off",
                file=sys.stderr,
                flush=True,
            )
            rows = []
        _DRAFTER_PROFILES = [row for row in rows if isinstance(row, dict) and row.get("target_model")]
    return _DRAFTER_PROFILES


def companion_drafter_targets() -> List[str]:
    """Kernel targets whose MODEL.toml declares a drafter pairing."""
    return sorted({str(row["target_model"]) for row in load_drafter_profiles()})


def launcher_default_drafter_profile(kernel_target: str) -> Optional[Dict[str, Any]]:
    """Return the qualified launcher_default [[dflash.profile]] row for kernel_target, if any."""
    for row in load_drafter_profiles():
        if (
            row.get("target_model") == kernel_target
            and row.get("qualified")
            and row.get("launcher_default")
        ):
            return row
    return None


def find_companion_drafter(
    model_dir: Path,
    kernel_target: str,
    target_hidden_size: int,
    target_num_layers: int,
) -> Optional[Path]:
    """
    Architecture-driven companion drafter / MTP discovery.
    Matches drafter checkpoints by verifying `config.json` structural compatibility
    (`hidden_size == target_hidden_size` and `max(target_layer_ids) < target_num_layers`)
    rather than assuming fixed directory names.
    """
    env_draft = (
        os.environ.get("FLUX_DRAFT_MODEL")
        or os.environ.get("FLUX_MTP_PATH")
        or os.environ.get("FLUX_DRAFTER_PATH")
        or ""
    ).strip()
    if env_draft:
        if env_draft.lower() in ("none", "off", "0", "false"):
            return None
        for cand_p in (
            Path(env_draft),
            Path("/models") / env_draft,
            model_dir.parent / env_draft,
            Path("/opt/flux/models") / env_draft,
            Path("/opt/flux/models") / Path(env_draft).name,
        ):
            if _safe_exists(cand_p):
                p, _ = resolve_hf_or_model_dir(cand_p)
                if _safe_is_dir(p):
                    return p

    # Only targets with a [[dflash.profile]] row (external DFlash or MTP) look for companion drafters
    if kernel_target not in companion_drafter_targets():
        return None

    search_roots = [model_dir.parent]
    if model_dir.parent.name == "snapshots" and _safe_is_dir(model_dir.parent.parent.parent):
        search_roots.append(model_dir.parent.parent.parent)
    for r in ("/models", "/workspace/models", "/opt/flux/models", "/root/.cache/huggingface/hub"):
        rp = Path(r)
        if _safe_is_dir(rp) and rp not in search_roots:
            search_roots.append(rp)

    compatible: List[Tuple[Tuple[int, int, str], Path]] = []
    req_spec = os.environ.get("FLUX_SPEC_MODE", "").strip().lower()
    req_conc_raw = os.environ.get("FLUX_CONCURRENCY", "1").strip()
    req_conc = int(req_conc_raw) if req_conc_raw.isdigit() else 1
    default_profile = launcher_default_drafter_profile(kernel_target)
    flash_next_default_dflash2 = (
        kernel_target == "qwen3.8-flash-next"
        and default_profile is not None
        and default_profile.get("kind") == "dflash2"
        and req_spec in ("", "dflash", "dflash2")
        and req_conc <= 16
    )
    prefer_dflash = req_spec in ("dflash", "dflash2") or flash_next_default_dflash2

    def _eval_candidate(cand: Path) -> None:
        if not _safe_is_dir(cand):
            return
        c_dir, c_disp = resolve_hf_or_model_dir(cand)
        if c_dir == model_dir:
            return
        c_name_l = f"{c_disp or ''} {cand.name} {c_dir.name}".lower()
        if not is_drafter_dir(c_dir) and "dflash" not in c_name_l and "drafter" not in c_name_l and "inferact-mtp" not in c_name_l:
            return
        # Must have existing weights
        st = [s for s in c_dir.glob("*.safetensors") if _safe_exists(s)]
        if not st:
            return
        d_cfg = _read_json(c_dir / "config.json")
        d_tcfg = d_cfg.get("text_config") if isinstance(d_cfg.get("text_config"), dict) else {}
        d_merged = {**d_tcfg, **d_cfg}
        d_hidden = int(d_merged.get("hidden_size") or 0)
        if target_hidden_size > 0 and d_hidden > 0 and d_hidden != target_hidden_size:
            return
        dflash_cfg = d_merged.get("dflash_config") or {}
        t_layers = dflash_cfg.get("target_layer_ids") or []
        if t_layers and target_num_layers > 0 and max(t_layers) >= target_num_layers:
            return
        c_id = f"{c_disp or ''} {cand.parent.name}/{cand.name} {c_dir.name} {d_merged.get('_name_or_path', '')}".lower()
        # Check family alignment
        if kernel_target == "glm5.3-flash" and "glm" not in c_id:
            return
        if kernel_target != "glm5.3-flash" and "glm" in c_id:
            return
        is_mtp_only = all("mtp" in s.name.lower() for s in st)
        if kernel_target == "qwen3.8-flash-next":
            is_qualified_dflash2 = (not is_mtp_only) and _is_qualified_flash_next_dflash2(d_merged)
            if req_spec in ("mtp", "native-mtp"):
                primary_rank = 0 if is_mtp_only else 2
                sub_rank = 0 if is_mtp_only else (0 if is_qualified_dflash2 else 1)
            elif prefer_dflash:
                if is_qualified_dflash2:
                    primary_rank = 0
                    sub_rank = -1
                elif not is_mtp_only:
                    # Unqualified external DFlash/DSpark only outranks MTP if the
                    # user explicitly requested FLUX_SPEC_MODE=dflash|dflash2.
                    primary_rank = 0 if req_spec in ("dflash", "dflash2") else 2
                    sub_rank = 1
                else:
                    primary_rank = 1
                    sub_rank = 0
            else:
                primary_rank = 0 if is_mtp_only else 1
                sub_rank = 0 if is_mtp_only else (0 if is_qualified_dflash2 else 1)
        else:
            if is_mtp_only:
                primary_rank = 10
                sub_rank = 10
            else:
                primary_rank = 0
                # Prefer Apathy v2 -> any v2 -> v3 -> z-lab / DFlash2 (block_size=16) -> incoai / block_size=8 -> other
                bs = int(
                    d_merged.get("block_size")
                    or (dflash_cfg.get("block_size") if isinstance(dflash_cfg, dict) else 0)
                    or (8 if "incoai" in c_id else 16)
                )
                if kernel_target == "qwen3.8-27b" and _is_dflash2_drafter(d_merged):
                    # The qualified 27B drafter is z-lab DFlash2 (block 8). Block-16 v1
                    # drafters fall to ~0.6x plain at 32K (drafter-bakeoff-20261014).
                    sub_rank = -1
                elif "apathy" in c_id and "v2" in c_id:
                    sub_rank = 0
                elif "v2" in c_id:
                    sub_rank = 1
                elif "v3" in c_id:
                    sub_rank = 2
                elif ("z-lab" in c_id or "dflash2" in c_id) and bs >= 16 and "incoai" not in c_id:
                    sub_rank = 3
                elif bs >= 16 and "incoai" not in c_id:
                    sub_rank = 4
                else:
                    sub_rank = 5
        compatible.append(((primary_rank, sub_rank, c_dir.name), c_dir))

    seen_dirs = set()
    for sroot in search_roots:
        try:
            for child in sorted(sroot.iterdir()):
                try:
                    if not _safe_is_dir(child) or child.name.startswith("."):
                        continue
                    eff_c, _ = resolve_hf_or_model_dir(child)
                    if _safe_exists(eff_c / "config.json") or list(eff_c.glob("*.safetensors")):
                        if str(eff_c) not in seen_dirs:
                            seen_dirs.add(str(eff_c))
                            _eval_candidate(child)
                    else:
                        # Also check 2-level `<org>/<repo>` directories (e.g. /models/z-lab/Qwen3.8-27B-DFlash2)
                        for subchild in sorted(child.iterdir()):
                            try:
                                if _safe_is_dir(subchild):
                                    eff_sub, _ = resolve_hf_or_model_dir(subchild)
                                    if str(eff_sub) not in seen_dirs and (_safe_exists(eff_sub / "config.json") or list(eff_sub.glob("*.safetensors"))):
                                        seen_dirs.add(str(eff_sub))
                                        _eval_candidate(subchild)
                            except Exception:
                                continue
                except Exception:
                    continue
        except Exception:
            pass

    if not compatible:
        return None
    compatible.sort(key=lambda item: item[0])
    return compatible[0][1]


