# FLUX_LOAD_DEBUG: the server keeps load-phase debug logs in memory and prints
# them only when the first load fails. The launcher validates the mode, points
# FLUX_LOAD_DEBUG_FILE at /results so a SIGKILL'd load (e.g. an OOM kill) still
# leaves a record, and prints that file's tail when the server could not.
LOAD_DEBUG_MODES = ("auto", "always", "off")
LOAD_DEBUG_DEFAULT_FILE = "/results/flux-load-debug.log"
LOAD_DEBUG_DUMPED_MARKER = "flux-load-debug: dumped to stderr"
LOAD_DEBUG_LOADED_MARKER = "flux-load-debug: load complete"
LOAD_DEBUG_TAIL_LINES = 200


def resolve_load_debug_env(environ: Dict[str, str], results_writable: bool) -> Dict[str, str]:
    """Return the FLUX_LOAD_DEBUG* settings to export; raise ValueError on a bad mode."""
    mode = environ.get("FLUX_LOAD_DEBUG", "").strip().lower() or "auto"
    if mode not in LOAD_DEBUG_MODES:
        raise ValueError(
            f"FLUX_LOAD_DEBUG={environ['FLUX_LOAD_DEBUG']!r} is not one of {'|'.join(LOAD_DEBUG_MODES)}"
        )
    out = {"FLUX_LOAD_DEBUG": mode}
    if mode != "off" and "FLUX_LOAD_DEBUG_FILE" not in environ and results_writable:
        out["FLUX_LOAD_DEBUG_FILE"] = LOAD_DEBUG_DEFAULT_FILE
    return out


DEBUG_LOG_ON = ("1", "true", "on", "yes")
DEBUG_LOG_OFF = ("", "0", "false", "off", "no")
DEBUG_LOG_DEFAULT_FILE = "/results/flux-debug.log"


def resolve_debug_log_env(environ: Dict[str, str], results_writable: bool) -> Dict[str, str]:
    """FLUX_DEBUG=1: full debug-level server logs to a capped file (console unchanged).

    Returns the settings to export; raises ValueError on a bad value.
    """
    raw = environ.get("FLUX_DEBUG", "").strip().lower()
    if raw not in DEBUG_LOG_ON + DEBUG_LOG_OFF:
        raise ValueError(f"FLUX_DEBUG={environ['FLUX_DEBUG']!r} is not one of 1|0 (true/false, on/off)")
    if raw in DEBUG_LOG_OFF:
        return {}
    cap = environ.get("FLUX_DEBUG_MAX_MB", "").strip()
    if cap and not (cap.isdigit() and int(cap) > 0):
        raise ValueError(f"FLUX_DEBUG_MAX_MB={cap!r} is not a positive integer")
    out = {"FLUX_DEBUG": "1"}
    if "FLUX_DEBUG_FILE" not in environ:
        if not results_writable:
            print(
                "[flux] WARN: FLUX_DEBUG=1 but /results is not writable and FLUX_DEBUG_FILE is unset; "
                "the debug log is off (mount -v <dir>:/results)",
                file=sys.stderr,
                flush=True,
            )
            return {"FLUX_DEBUG": "0"}
        out["FLUX_DEBUG_FILE"] = DEBUG_LOG_DEFAULT_FILE
    return out


_SECRET_FLAG_SEGMENTS = {"token", "key", "secret", "secrets", "password", "passwd", "auth", "apikey", "credential", "credentials"}


def _is_secret_flag(flag: str) -> bool:
    """`--auth-token`, `--hf-token`, `--api-key`, `--require-auth`… (whole name segments)."""
    name = flag.lstrip("-").split("=", 1)[0].lower()
    return flag.startswith("--") and any(seg in _SECRET_FLAG_SEGMENTS for seg in _re.split(r"[-_]", name))


def redact_argv(argv: List[str]) -> List[str]:
    """Redact the value of every secret-named flag, in the `=` and the space form.

    A value is only taken from the next argument when it is not itself a
    `--flag` (or a one-letter `-x` option), so boolean flags such as
    `--require-auth` redact nothing, while a secret starting with `-` is still
    caught.
    """
    out: List[str] = []
    redact_next = False
    for arg in argv:
        arg = str(arg)
        # A value may itself start with '-' (e.g. a token "-abc"); only a
        # following `--flag` or a bare "-" style option name ends the value.
        if redact_next and not (arg.startswith("--") or _re.fullmatch(r"-[A-Za-z]", arg)):
            out.append("<REDACTED>")
            redact_next = False
            continue
        redact_next = False
        if _is_secret_flag(arg):
            if "=" in arg:
                out.append(arg.split("=", 1)[0] + "=<REDACTED>")
                continue
            redact_next = True
        out.append(arg)
    return out


_OWNERSHIP_WARNED = False


def _adopt_dir_owner(fd: int, path: Path) -> None:
    """Give a private file the owner of its directory, so a root container
    leaves files the host user can read. Keep 0600 if that works; otherwise
    fall back to 0640 and warn once."""
    global _OWNERSHIP_WARNED
    try:
        st = os.stat(str(path.parent))
        os.fchown(fd, st.st_uid, st.st_gid)
        os.fchmod(fd, 0o600)
    except OSError as e:
        os.fchmod(fd, 0o640)
        if not _OWNERSHIP_WARNED:
            _OWNERSHIP_WARNED = True
            print(f"[flux] WARN: cannot give {path} the owner of {path.parent} ({e}); it is mode 0640",
                  file=sys.stderr, flush=True)


def _open_private(path: Path) -> int:
    """Create/truncate `path` (0600, owned like its directory); returns the fd."""
    fd = os.open(str(path), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    _adopt_dir_owner(fd, path)
    return fd


def _write_private(path: Path, text: str) -> None:
    """Write `text` to `path`, private and owned like its directory."""
    fd = _open_private(path)
    try:
        os.write(fd, text.encode("utf-8"))
    finally:
        os.close(fd)


def write_launch_record(results_dir: Path, plan: Dict[str, Any], model_info: Dict[str, Any]) -> None:
    """Record what the launcher actually started, for `flux bundle`. Best effort.

    Secret flag values and secret-named env values are redacted here, and the
    file is owner-only, so the record is safe on disk as well as in a bundle.
    """
    try:
        if not (_safe_is_dir(results_dir) and os.access(str(results_dir), os.W_OK)):
            return
        record = {
            "schema": "flux-launch-record-v1",
            "engine_version": engine_version(),
            "started_at_utc": dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
            "model": {k: model_info.get(k) for k in ("name", "family", "quantization", "kernel_target", "path")},
            "argv": redact_argv(list(plan.get("command", []))),
            "plan_env": _scrub_env_snapshot({k: str(v) for k, v in plan.get("env", {}).items()}, keep_all=True),
            "mode": plan.get("mode"),
            "launcher_argv": redact_argv(list(sys.argv)),
        }
        _write_private(results_dir / "flux-launch.json", json.dumps(record, indent=2) + "\n")
    except Exception:
        pass


def load_debug_tail(path: Optional[str], max_lines: int = LOAD_DEBUG_TAIL_LINES) -> Optional[str]:
    """The tail of a load-debug file the server did not get to print itself.

    None when there is no file, it is empty, the server already dumped it to
    stderr, or the load had completed (a later crash is not a load failure).
    """
    if not path or path.lower() == "none":
        return None
    try:
        lines = Path(path).read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return None
    if not lines or any(l in (LOAD_DEBUG_DUMPED_MARKER, LOAD_DEBUG_LOADED_MARKER) for l in lines[-2:]):
        return None
    tail = lines[-max_lines:]
    return (
        f"[flux] ===== server died during model load: load-phase debug log, last {len(tail)} of {len(lines)} lines =====\n"
        + "\n".join(tail)
        + f"\n[flux] ===== end of load-phase debug log (full log: {path}) ====="
    )


def _print_load_debug_tail() -> None:
    tail = load_debug_tail(os.environ.get("FLUX_LOAD_DEBUG_FILE"))
    if tail:
        print(tail, file=sys.stderr, flush=True)


