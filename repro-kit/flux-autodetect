def _note_native_262k_profile_once() -> None:
    """Print NATIVE_262K_PROFILE_NOTE once per process: `flux serve` builds the
    plan twice when /results is writable (main, then collect_diagnostics)."""
    global _NATIVE_262K_NOTE_PRINTED
    if not _NATIVE_262K_NOTE_PRINTED:
        _NATIVE_262K_NOTE_PRINTED = True
        print(f"[flux] INFO: {NATIVE_262K_PROFILE_NOTE}", file=sys.stderr, flush=True)


def _profile_binary(profile: Dict[str, Any]) -> str:
    key = profile["binary_key"]
    return GLM53_BINARY if key == "glm53" else BINARIES[key]


