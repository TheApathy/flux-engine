def _note_serial_qsa_concurrency_once(mode_key: str) -> None:
    """Print once per process, like _note_native_262k_profile_once."""
    global _SERIAL_QSA_NOTE_PRINTED
    if not _SERIAL_QSA_NOTE_PRINTED:
        _SERIAL_QSA_NOTE_PRINTED = True
        print(
            f"[flux] INFO: FLUX_MODE={mode_key} has no exact-rows MoE route (ATLAS_MOE_T_LANES=1 "
            "with the unified MoE layout), so native Qwen4 batching is unavailable: C2+ frames "
            "run the C1 kernels once per row (same numerics as C1). Use FLUX_MODE=max-prefill "
            "to batch natively.",
            file=sys.stderr,
            flush=True,
        )


def _synchronize_flux_atlas_env(env_vars: Dict[str, str]) -> Dict[str, str]:
    """
    Synchronize FLUX_<SUFFIX> <-> ATLAS_<SUFFIX> selectors (matching scripts/flux_env_bridge.sh)
    so user overrides using either FLUX_* or ATLAS_* syntax take effect seamlessly.
    """
    for k, v in list(env_vars.items()):
        if k.startswith("FLUX_") and k not in _FLUX_META_ENV_KEYS:
            suffix = k[len("FLUX_"):]
            if suffix == "QWEN4_FAST_PROJ_FP8_WEIGHT_CACHE_RESERVE_GB":
                env_vars["ATLAS_QWEN4_PREFILL_FAST_PROJ_FP8_WEIGHT_CACHE_RESERVE_GB"] = v
            elif suffix == "PREFILL_WIDE":
                env_vars["ATLAS_QWEN4_PREFILL_WIDE"] = v
            env_vars[f"ATLAS_{suffix}"] = v
    for k, v in list(env_vars.items()):
        if k.startswith("ATLAS_"):
            suffix = k[len("ATLAS_"):]
            flux_peer = f"FLUX_{suffix}"
            # The debug switches are FLUX-only: an unrelated ATLAS_DEBUG must
            # not become FLUX_DEBUG (and fail its validation).
            if flux_peer in _FLUX_ONLY_DEBUG_KEYS:
                continue
            if flux_peer not in env_vars:
                env_vars[flux_peer] = v
    return env_vars


def _resolve_27b_flashinfer(env_vars: Dict[str, str], model_info: Dict[str, Any], warnings: List[str]) -> None:
    """Keep the 27B FlashInfer dense-FFN route only when its library and checkpoint allow it."""
    if env_vars.get("ATLAS_PREFILL_FFN_FLASHINFER") != "1":
        return
    lib = env_vars.get("ATLAS_FLASHINFER_SM121_LIB", "")
    if lib and not _safe_is_file(Path(lib)):
        local_lib = Path(__file__).resolve().parent / "lib" / FLASHINFER_SM121_LIB_NAME
        if "ATLAS_FLASHINFER_SM121_LIB" not in os.environ and _safe_is_file(local_lib):
            env_vars["ATLAS_FLASHINFER_SM121_LIB"] = lib = str(local_lib)
    q_cfg = _read_json(Path(model_info["path"]) / "config.json").get("quantization_config") or {}
    reason = None
    if str(q_cfg.get("quant_method", "")).lower() == "compressed-tensors":
        reason = "this compressed-tensors checkpoint refuses the FlashInfer prefill routes"
    elif not lib or not _safe_is_file(Path(lib)):
        reason = f"{lib or 'ATLAS_FLASHINFER_SM121_LIB'} is not installed"
    if reason:
        env_vars["ATLAS_PREFILL_FFN_FLASHINFER"] = "0"
        if "ATLAS_CUBLASLT_NVFP4" not in os.environ and "ATLAS_CUBLASLT_NVFP4" not in env_vars:
            env_vars["ATLAS_CUBLASLT_NVFP4"] = "1"
            warnings.append(f"{reason}; ATLAS_PREFILL_FFN_FLASHINFER=0 (27B prefill takes the slower route)")
        elif str(env_vars.get("ATLAS_CUBLASLT_NVFP4", "")).strip() != "1":
            warnings.append(f"{reason}; ATLAS_PREFILL_FFN_FLASHINFER=0 (27B prefill takes the slower route)")


# FLUX_DFLASH_LOOKUP: reviewed opt-in for the DFlash context-lookup drafters
# (crates/spark-server/src/cli_dflash_lookup.rs). Default off: when unset the
# plan is unchanged. Each mode owns exactly these engine controls.
DFLASH_LOOKUP_MODES: Dict[str, Dict[str, str]] = {
    "off": {"DFLASH_SAM": "0", "DFLASH_RETRIEVAL": "0"},
    "sam": {"DFLASH_SAM": "1", "DFLASH_RETRIEVAL": "0"},
    "retrieval": {"DFLASH_SAM": "0", "DFLASH_RETRIEVAL": "1"},
}


def _apply_dflash_lookup(
    env_vars: Dict[str, str],
    dflash_engaged: bool,
    warnings: List[str],
    custom_env: Optional[Dict[str, str]] = None,
) -> Optional[str]:
    """Map FLUX_DFLASH_LOOKUP onto the engine controls; return the engaged mode."""
    # Resolve both aliases within each precedence layer before consulting the
    # synchronized recipe, where an inherited FLUX alias can mask --set ATLAS.
    mode = None
    for source in (custom_env or {}, os.environ, env_vars):
        if "FLUX_DFLASH_LOOKUP" in source:
            mode = source["FLUX_DFLASH_LOOKUP"]
            break
        if "ATLAS_DFLASH_LOOKUP" in source:
            mode = source["ATLAS_DFLASH_LOOKUP"]
            break
    if mode is None:
        return None
    if mode not in DFLASH_LOOKUP_MODES:
        raise ValueError(
            f"FLUX_DFLASH_LOOKUP={mode!r} is not a DFlash lookup mode (off, sam, retrieval)"
        )
    if mode != "off" and not dflash_engaged:
        warnings.append(
            f"FLUX_DFLASH_LOOKUP={mode} needs the DFlash drafter, which this launch does not "
            "run; lookup drafting stays off"
        )
        env_vars["ATLAS_DFLASH_LOOKUP"] = env_vars["FLUX_DFLASH_LOOKUP"] = "off"
        return None
    explicit = dict(os.environ)
    explicit.update(custom_env or {})
    for suffix, value in DFLASH_LOOKUP_MODES[mode].items():
        for name in (f"ATLAS_{suffix}", f"FLUX_{suffix}"):
            operator = explicit.get(name)
            admitted = (value,) if value == "1" else ("0",)
            if operator is not None and operator not in admitted:
                raise ValueError(
                    f"{name}={operator!r} conflicts with FLUX_DFLASH_LOOKUP={mode}; "
                    "unset it and select the lookup drafter with FLUX_DFLASH_LOOKUP only"
                )
            env_vars[name] = value
    env_vars["ATLAS_DFLASH_LOOKUP"] = env_vars["FLUX_DFLASH_LOOKUP"] = mode
    return None if mode == "off" else mode


def _cli_bool_flag_enabled(args: List[str], flag: str) -> bool:
    """Return True if a boolean CLI switch (bare, `flag true`, or `flag=true`) is enabled."""
    enabled = False
    i = 0
    while i < len(args):
        arg = args[i]
        if arg == flag:
            if i + 1 < len(args) and args[i + 1].lower() in _BOOL_LITERALS:
                enabled = args[i + 1].lower() == "true"
                i += 2
                continue
            enabled = True
        elif arg.startswith(flag + "="):
            enabled = arg.split("=", 1)[1].lower() in ("1", "true", "yes")
        i += 1
    return enabled


def build_launch_plan(
    model_info: Dict[str, Any],
    mode_raw: str,
    extra_args: List[str],
    custom_recipe: Optional[str] = None,
    custom_env: Optional[Dict[str, str]] = None,
    topology_override: Optional[str] = None,
    mode_explicit: Optional[bool] = None,
) -> Dict[str, Any]:
    import math

    # Load a user recipe before resolving the mode.  `--recipe FILE` is a
    # first-class way to select an operating profile, so its public FLUX_MODE
    # selector must affect the plan just like Docker `--env-file FILE` does.
    # A dedicated --mode flag, FLUX_MODE from the process environment, or a
    # caller-supplied --set FLUX_MODE remains authoritative.
    user_recipe = (custom_recipe or os.environ.get("FLUX_RECIPE_FILE", "")).strip()
    user_recipe_env = _load_recipe_env(user_recipe) if user_recipe else {}
    effective_mode = mode_raw
    if mode_explicit is None:
        normalized_mode = mode_raw.lower().strip()
        if custom_env and "FLUX_MODE" in custom_env:
            effective_mode = custom_env["FLUX_MODE"]
            mode_explicit = True
        elif "FLUX_MODE" in os.environ:
            effective_mode = os.environ["FLUX_MODE"]
            mode_explicit = True
        else:
            mode_explicit = bool(
                normalized_mode and normalized_mode not in ("auto", "default")
            )
    if not mode_explicit and user_recipe_env.get("FLUX_MODE", "").strip():
        effective_mode = user_recipe_env["FLUX_MODE"]
    mode_key = MODE_ALIASES.get(effective_mode.lower().strip(), "auto")
    recipe = MODES_CATALOG.get(mode_key, MODES_CATALOG["auto"])
    hw = detect_hardware_topology()
    kt = model_info["kernel_target"]
    bin_path = model_info["selected_binary"]
    bin_name = Path(bin_path).name
    profile = MULTI_MODEL_PROFILES.get(kt)
    launch_warnings: List[str] = list(model_info.get("launch_warnings") or [])
    if profile is not None and model_info.get("binary_fallback"):
        launch_warnings.append(model_info["binary_fallback"]["error"])

    env_vars: Dict[str, str] = {
        "CUDA_MODULE_LOADING": "LAZY",
        "NCCL_P2P_DISABLE": "0",
        "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True",
    }

    # 1. Load architecture-appropriate mode recipe
    recipe_file_loaded: Optional[str] = None
    if kt == "qwen3.8-flash-next":
        rec_name = recipe.get("recipe_file", "flux-nextgen-max-prefill-decode.env")
        if mode_key in ("2x-spark", "2x-spark-1m", "3x-spark", "4x-spark"):
            env_vars.update(_load_recipe_env("flux-nextgen-max-prefill-decode.env"))
        env_vars.update(_load_recipe_env(rec_name))
        recipe_file_loaded = rec_name
        # If this checkpoint does not use PLE offload, remove PLE reserve vars
        if not model_info.get("ple_dir"):
            for k in list(env_vars.keys()):
                if "_PLE_" in k or "WEIGHT_CACHE_RESERVE_GB" in k:
                    env_vars.pop(k, None)
    elif profile is not None:
        # The model's own recipe replaces the Flash-Next mode env.
        rec_name = profile["recipe_file"]
        if _find_recipe_path(rec_name) is None:
            raise ValueError(f"recipe {rec_name} for {kt} is not installed (repro-kit/recipes/)")
        env_vars.update(_load_recipe_env(rec_name))
        recipe_file_loaded = rec_name

    # 2. Apply hardware topology overlay if on multi-Spark or SM120/SM103/SM90 discrete GPUs
    topo = (topology_override or os.environ.get("FLUX_TOPOLOGY", "")).strip().lower()
    hw_recipe = hw.get("hardware_recipe", "flux-nextgen-max-prefill-decode.env")
    hw_sm_family = str(hw.get("sm_family") or "").lower()

    def _apply_hw_overlay(recipe_name: str) -> None:
        overlay = _load_recipe_env(recipe_name)
        if profile is not None:
            # Do not leak Qwen4/PLE-specific knobs from generic GPU recipes onto non-Flash-Next profile models.
            overlay = {
                k: v for k, v in overlay.items()
                if not k.startswith(("ATLAS_QWEN4_", "FLUX_QWEN4_", "ATLAS_PLE_", "FLUX_PLE_"))
                and k != "FLUX_MODE"
            }
        env_vars.update(overlay)

    if topo == "4x-spark":
        _apply_hw_overlay("4x-spark-cluster.env")
    elif topo == "3x-spark":
        _apply_hw_overlay("3x-spark-pp3-disagg.env")
    elif topo == "2x-spark":
        _apply_hw_overlay("2x-spark-cluster.env")
    elif topo in ("sm103", "sm103a", "blackwell-sm103", "blackwell-sm103a", "b300", "gb300"):
        _apply_hw_overlay("nvidia-blackwell-sm120.env")
        env_vars["FLUX_ARCH_TARGET"] = "sm_103a"
    elif topo in (
        "sm120", "sm120a", "blackwell-sm120", "blackwell-sm120a",
        "rtx5090", "rtx6000", "rtx-pro-6000", "rtx-pro-5000",
    ):
        _apply_hw_overlay("nvidia-blackwell-sm120.env")
    elif topo in ("sm90", "hopper-sm90"):
        _apply_hw_overlay("nvidia-hopper-sm90.env")
    elif hw_recipe not in ("flux-v9-max-prefill.env", "flux-nextgen-max-prefill-decode.env"):
        _apply_hw_overlay(hw_recipe)
        if hw_sm_family == "blackwell-sm103a":
            env_vars["FLUX_ARCH_TARGET"] = "sm_103a"

    # 3. Apply explicit user recipe file (--recipe / --env-file / FLUX_RECIPE_FILE) if supplied
    if user_recipe:
        env_vars.update(user_recipe_env)
        recipe_file_loaded = user_recipe

    # 4. Speculative drafter environment defaults
    spec = dict(model_info.get("speculative", {}))
    if spec.get("mode") == "dflash" and spec.get("drafter_path"):
        gamma = int(spec.get("gamma", 15))
        env_vars["ATLAS_DFLASH_DRAFT_CAP"] = str(gamma)
        env_vars["ATLAS_DDTREE_MAX_NODES"] = str(gamma + 1)
        if kt in ("qwen3.8-27b", "qwen3.6-27b", "qwen3.5-27b"):
            env_vars["ATLAS_DFLASH_27B_V2"] = "1"

    # 5. Apply caller-supplied environment overrides (os.environ FLUX_* / ATLAS_* and --set KEY=VAL)
    for k, v in os.environ.items():
        if (k.startswith("FLUX_") and k not in _FLUX_META_ENV_KEYS) or k.startswith("ATLAS_"):
            env_vars[k] = v
    if custom_env:
        for k, v in custom_env.items():
            env_vars[k] = v
    if profile is not None and profile.get("model_dir_env"):
        # The DSV41 Rust loader reads its checkpoint dir from this variable, not --model-from-path.
        env_vars.setdefault(profile["model_dir_env"], model_info["path"])
    if kt == "qwen3.8-27b":
        _resolve_27b_flashinfer(env_vars, model_info, launch_warnings)

    # 6. Synchronize FLUX_<SUFFIX> <-> ATLAS_<SUFFIX> selectors
    _synchronize_flux_atlas_env(env_vars)
    env_vars["FLUX_MODE"] = mode_key

    def public_selector(name: str, default: str = "") -> str:
        """Resolve public knobs as --set, process environment, then recipe."""
        if custom_env and name in custom_env:
            return str(custom_env[name])
        if name in os.environ:
            return os.environ[name]
        return str(env_vars.get(name, default))

    host = os.environ.get("FLUX_HOST", "0.0.0.0")
    port = os.environ.get("FLUX_PORT", "8899")
    concurrency = int(public_selector("FLUX_CONCURRENCY", "1"))
    if not 1 <= concurrency <= 128:
        raise ValueError(
            "FLUX_CONCURRENCY must be between 1 and the logical C128 admission ceiling; "
            "native batching remains model- and profile-specific"
        )
    env_vars["FLUX_CONCURRENCY"] = str(concurrency)
    if profile is not None and concurrency > int(profile.get("max_concurrency", 128)):
        raise ValueError(
            f"{profile['label']} serves one sequence at a time; set FLUX_CONCURRENCY=1"
        )

    is_uma_hw = bool(hw.get("unified_memory_architecture"))
    det_gpu_count = int(hw.get("gpu_count") or 1)
    single_host_multi_gpu = bool(hw.get("single_host_multi_gpu")) or (not is_uma_hw and det_gpu_count >= 2)
    per_gpu_vram_gib = float(hw.get("per_gpu_vram_gib") or 0.0)
    if per_gpu_vram_gib <= 0.0 and not is_uma_hw:
        eff_total_vram = float(hw.get("total_vram_gib") or hw.get("effective_memory_gib") or 0.0)
        if eff_total_vram > 0.0:
            per_gpu_vram_gib = round(eff_total_vram / max(1, det_gpu_count), 1)
    is_discrete_vram_known = (not is_uma_hw) and (per_gpu_vram_gib > 0.0)

    # Multi-GPU Tensor / Expert / Pipeline Parallel scaling (resolved before context & KV sizing)
    explicit_tp = (custom_env or {}).get("FLUX_TP_SIZE") or os.environ.get("FLUX_TP_SIZE")
    explicit_ep = (custom_env or {}).get("FLUX_EP_SIZE") or os.environ.get("FLUX_EP_SIZE")
    explicit_pp = (custom_env or {}).get("FLUX_PP_SIZE") or os.environ.get("FLUX_PP_SIZE")
    explicit_world = (custom_env or {}).get("FLUX_WORLD_SIZE") or os.environ.get("FLUX_WORLD_SIZE")
    tp_size = int(explicit_tp or env_vars.get("FLUX_TENSOR_PARALLEL_SIZE") or "1")
    ep_size = int(explicit_ep or env_vars.get("FLUX_EXPERT_PARALLEL_SIZE") or "1")
    pp_size = int(explicit_pp or env_vars.get("FLUX_PIPELINE_PARALLEL_SIZE") or "1")
    if explicit_pp and int(explicit_pp) > 1 and not explicit_tp and not explicit_ep:
        # Explicit FLUX_PP_SIZE>1 overrides TP/EP defaults from 2x/4x-spark recipes.
        tp_size = 1
        ep_size = 1
    if mode_key in ("2x-spark", "2x-spark-1m") and tp_size == 1 and ep_size == 1 and pp_size == 1:
        # 2x Spark defaults to TP=2, EP=2, PP=1: enables fused fast
        # MoE kernels (256 local experts/Spark), W=8 DFlash2 (C=1..16), and 3M-6M KV pool.
        tp_size = 2
        ep_size = 2
    elif mode_key == "3x-spark" and tp_size == 1 and ep_size == 1 and pp_size == 1:
        pp_size = 3
    elif mode_key == "4x-spark" and tp_size == 1 and ep_size == 1 and pp_size == 1:
        # 4x Spark defaults to TP=4, EP=4, PP=1: 6 Q + 1 replicated KV head,
        # 128 local experts/Spark (~22 GiB weights/Spark), fused MoE, W=8 DFlash2 C=1..16.
        tp_size = 4
        ep_size = 4
    elif (
        single_host_multi_gpu
        and not explicit_tp
        and not explicit_ep
        and not explicit_pp
        and not explicit_world
        and tp_size == 1
        and ep_size == 1
        and pp_size == 1
    ):
        # Single-host discrete multi-GPU (e.g. 2x RTX 5090, 2x RTX PRO 5000, 2x/4x RTX PRO 6000):
        # auto-select TP=2 / TP=4 (+ EP=TP for MoE models), capping Qwen4 QSA at world_size<=4.
        is_moe_model = bool(
            model_info.get("num_experts", 0) > 0
            or MODEL_VRAM_PROFILES.get(kt, {}).get("is_moe", False)
        )
        if det_gpu_count in (2, 4, 8):
            auto_tp = min(det_gpu_count, 4) if bool(model_info.get("requires_qwen4_qsa")) else det_gpu_count
            tp_size = auto_tp
            ep_size = auto_tp if is_moe_model else 1
        elif det_gpu_count == 3 and int(model_info.get("num_hidden_layers") or 0) % 3 == 0:
            pp_size = 3

    tp_ep_world = tp_size if tp_size == ep_size else tp_size * ep_size
    world_size = max(
        tp_ep_world * pp_size,
        int(explicit_world or env_vars.get("FLUX_CLUSTER_WORLD_SIZE") or "1"),
        2 if mode_key in ("2x-spark", "2x-spark-1m") else 1,
        3 if mode_key == "3x-spark" else 1,
        4 if mode_key == "4x-spark" else 1,
    )
    if world_size > 1:
        # Routed weight grouping is single-rank TP1/EP1 only (`weights.rs`).
        env_vars.pop("ATLAS_QWEN4_ROUTED_WEIGHT_GROUPS", None)
        env_vars.pop("ATLAS_QWEN4_ROUTED_WEIGHT_GROUPS_EAGER", None)
    node_rank = int(os.environ.get("FLUX_NODE_RANK") or env_vars.get("FLUX_NODE_RANK") or "0")
    master_addr = (os.environ.get("FLUX_MASTER_ADDR") or env_vars.get("FLUX_MASTER_ADDR") or "").strip()
    master_port = (os.environ.get("FLUX_MASTER_PORT") or env_vars.get("FLUX_MASTER_PORT") or "").strip()
    explicit_gpu_ordinal = (custom_env or {}).get("FLUX_GPU_ORDINAL") or os.environ.get("FLUX_GPU_ORDINAL")
    gpu_ordinal: Optional[int] = (
        int(explicit_gpu_ordinal)
        if (explicit_gpu_ordinal is not None and str(explicit_gpu_ordinal).strip().isdigit())
        else None
    )

    nccl_transport = "single-gpu"
    intranode_nccl_env: Dict[str, str] = {}
    if single_host_multi_gpu and world_size > 1:
        if not master_addr:
            master_addr = "127.0.0.1"
        if not master_port:
            master_port = "29500"
        if gpu_ordinal is None:
            gpu_ordinal = node_rank
        intranode_nccl_env, nccl_transport = detect_intranode_nccl_env(hw)
        for nk, nv in intranode_nccl_env.items():
            if nk not in os.environ and not (custom_env and nk in custom_env):
                env_vars[nk] = nv

    requires_qsa = bool(model_info.get("requires_qwen4_qsa"))
    native_max_pos = int(model_info.get("max_position_embeddings") or 131072)
    qsa_concurrency = requires_qsa and concurrency > 1

    # Resolve GPU memory utilization before discrete VRAM & KV-pool budgeting.
    # Non-QSA models on GB10 UMA default to 0.55 so pre-flight memory estimator leaves sufficient
    # UMA headroom alongside page-cached safetensors shards (GETTING_STARTED.md Gotcha 9).
    # Discrete SM120/SM103 GPUs have dedicated VRAM without host page cache, so default to 0.90.
    if is_discrete_vram_known:
        default_gpu_mem_util = "0.90"
    elif profile is not None:
        default_gpu_mem_util = profile["gpu_memory_utilization"]
    else:
        default_gpu_mem_util = "0.85" if (requires_qsa or not is_uma_hw) else "0.55"
    gpu_mem_util = public_selector("FLUX_GPU_MEMORY_UTILIZATION", default_gpu_mem_util)
    try:
        gpu_mem_util_f = float(gpu_mem_util)
    except ValueError:
        gpu_mem_util_f = 0.90 if is_discrete_vram_known else 0.85

    ple_ram_stage = _parse_ple_ram_stage_flag(
        (custom_env or {}).get("FLUX_PLE_RAM_STAGE")
        if (custom_env and "FLUX_PLE_RAM_STAGE" in custom_env)
        else os.environ.get("FLUX_PLE_RAM_STAGE")
    )
    ple_ram_plan: Optional[Dict[str, Any]] = None
    if ple_ram_stage:
        if not model_info.get("ple_dir"):
            raise ValueError(
                "FLUX_PLE_RAM_STAGE=1 / --ple-ram requires a PLE-offload checkpoint "
                "with ple-offload/manifest.json"
            )
        ram_base_dir = str(
            (custom_env or {}).get("FLUX_PLE_RAM_DIR")
            or os.environ.get("FLUX_PLE_RAM_DIR")
            or PLE_RAM_STAGE_DEFAULT_DIR
        ).strip()
        if not ram_base_dir:
            ram_base_dir = PLE_RAM_STAGE_DEFAULT_DIR
        ple_ram_plan = _plan_ple_ram_stage(Path(str(model_info["ple_dir"])), Path(ram_base_dir))
        env_vars["FLUX_PLE_RAM_STAGE"] = "1"
        env_vars["FLUX_PLE_RAM_DIR"] = ram_base_dir

    env_seq = public_selector("FLUX_MAX_SEQ_LEN").strip()
    explicit_seq = bool(env_seq and env_seq != str(DEFAULT_MAX_SEQ_LEN_SENTINEL))
    # The image default is a compatibility sentinel, not an explicit capacity
    # request.  It lets model detection and modes such as 256k raise the budget
    # while avoiding a memory-heavy allocation when concurrency scales up.
    if explicit_seq:
        max_seq_len = int(env_seq)
    elif profile is not None:
        max_seq_len = int(profile["max_seq_len"])
    elif ple_ram_stage and mode_key not in ("256k", "1m-nvfp4"):
        rec_seq = int(model_info.get("recommended_max_seq_len", 131072))
        max_seq_len = min(rec_seq, PLE_RAM_STAGE_DEFAULT_SEQ_LEN)
    elif qsa_concurrency and mode_key not in ("256k", "1m-nvfp4", "2x-spark-1m"):
        rec_seq = int(model_info.get("recommended_max_seq_len", 131072))
        if concurrency <= 16:
            max_seq_len = min(rec_seq, 262144)
        else:
            max_seq_len = max(8192, min(rec_seq, (524288 if world_size >= 2 else 262144) // concurrency))
    else:
        max_seq_len = int(model_info.get("recommended_max_seq_len", 131072))
        if recipe.get("min_seq_len") and max_seq_len < int(recipe["min_seq_len"]):
            max_seq_len = int(recipe["min_seq_len"])
    env_vars["FLUX_MAX_SEQ_LEN"] = str(max_seq_len)
    explicit_kv_dtype_raw = public_selector("FLUX_KV_CACHE_DTYPE").strip().lower()
    explicit_nvfp4_kv = explicit_kv_dtype_raw == "nvfp4"
    nvfp4_1m_mode = requires_qsa and (
        mode_key == "1m-nvfp4"
        or (
            world_size == 1
            and max_seq_len > native_max_pos
            and (explicit_nvfp4_kv or mode_key == "high-kv")
            and mode_key not in ("512k", "1m")
        )
    )
    multi_spark_1m_mode = requires_qsa and (
        mode_key == "2x-spark-1m"
        or (world_size >= 2 and max_seq_len > native_max_pos and mode_key not in ("512k", "1m"))
    )
    if (nvfp4_1m_mode or multi_spark_1m_mode) and max_seq_len > 1048576:
        raise ValueError(
            f"FLUX_MAX_SEQ_LEN={max_seq_len} exceeds the Qwen3.8-Flash-Next 1,048,576 (4.0x YaRN) ceiling"
        )
    if (
        requires_qsa
        and not nvfp4_1m_mode
        and not multi_spark_1m_mode
        and (mode_key in ("512k", "1m") or max_seq_len > native_max_pos)
    ):
        # Flash-Next past its native window requires FLUX_MODE=1m-nvfp4 on 1x Spark
        # or FLUX_MODE=2x-spark-1m (lossless BF16) on 2x Spark; legacy 512k/1m/auto stay refused.
        raise ValueError(
            f"FLUX_MODE={mode_key} / FLUX_MAX_SEQ_LEN={max_seq_len} for Qwen3.8-Flash-Next is not "
            f"supported in v{engine_version()} for this mode; max is {native_max_pos:,} via FLUX_MODE=256k "
            "(or 1,048,576 at C=1 via FLUX_MODE=1m-nvfp4 on 1x Spark / FLUX_MODE=2x-spark-1m on 2x Spark)"
        )

    def positive_selector(name: str) -> Optional[int]:
        raw = public_selector(name).strip()
        if not raw:
            return None
        if not raw.isdigit() or int(raw) <= 0:
            raise ValueError(f"{name} must be a positive integer, got {raw!r}")
        return int(raw)

    draft_off_for_pool = str(
        env_vars.get("FLUX_DRAFT_MODEL")
        or os.environ.get("FLUX_DRAFT_MODEL")
        or env_vars.get("FLUX_MTP_PATH")
        or os.environ.get("FLUX_MTP_PATH")
        or env_vars.get("FLUX_DRAFTER_PATH")
        or os.environ.get("FLUX_DRAFTER_PATH")
        or ""
    ).strip().lower() in ("none", "off", "0", "false")
    spec_off_for_pool = (
        bool(recipe.get("disable_speculation"))
        or str(env_vars.get("ATLAS_DISABLE_SPECULATION", "")).lower() in ("1", "true", "yes")
        or str(env_vars.get("FLUX_DISABLE_SPECULATION", "")).lower() in ("1", "true", "yes")
        or str(env_vars.get("FLUX_SPEC_MODE") or os.environ.get("FLUX_SPEC_MODE") or "").strip().lower() in ("none", "off", "0", "false")
        or draft_off_for_pool
        or (profile is not None and profile["speculation"] == "none")
    )
    dflash_topo_ok = (world_size == 1) or (
        tp_size in (2, 4) and ep_size in (1, tp_size) and pp_size == 1 and world_size == tp_size
    )
    dflash_active_for_pool = (
        spec.get("mode") == "dflash"
        and bool(spec.get("drafter_path"))
        and not spec_off_for_pool
        and concurrency <= (64 if is_discrete_vram_known else 16)
        and dflash_topo_ok
    )

    # Resolve --kv-high-precision-layers early so discrete VRAM budgeting matches
    # the exact mixed-precision layer mix emitted on the CLI.
    _cli_hp_layers: Optional[str] = None
    for _idx, _arg in enumerate(extra_args):
        if _arg.startswith("--kv-high-precision-layers="):
            _cli_hp_layers = _arg.split("=", 1)[1].strip()
            break
        if _arg == "--kv-high-precision-layers" and _idx + 1 < len(extra_args):
            _cli_hp_layers = extra_args[_idx + 1].strip()
            break
    default_hp_layers = profile.get("kv_high_precision_layers", "auto") if profile is not None else "auto"
    if (
        is_discrete_vram_known
        and kt == "qwen3.8-27b"
        and default_hp_layers == "8"
    ):
        # On GB10 UMA, hp=8 keeps all 16/16 attention layers in BF16 (64 KiB/tok).
        # On discrete GPUs, default to hp=auto (4/16 BF16 + 12/16 NVFP4 = 29.5 KiB/tok)
        # so NVFP4 KV actually saves VRAM unless the operator explicitly overrides it.
        default_hp_layers = "auto"
    kv_hp_layers_for_budget = (
        _cli_hp_layers
        or public_selector("FLUX_KV_HIGH_PRECISION_LAYERS", default_hp_layers).strip()
        or default_hp_layers
    )

    if requires_qsa:
        # Preserve lossless BF16 KV through native context on 1x Spark and all the way
        # through 1,048,576 tokens on 2x+ Spark (where KV heads / layers split across ranks).
        # Under opt-in --ple-ram / FLUX_PLE_RAM_STAGE=1 on GB10 UMA or FLUX_MODE=high-kv,
        # default to mixed NVFP4 KV (4/12 BF16 + 8/12 NVFP4 via --kv-high-precision-layers auto).
        # On discrete SM120/SM103 GPUs, --ple-ram is used for host-RAM PLE offload while
        # keeping BF16 KV so QSA_FP8 prefill, gqa12_ragged, and batched verify CUDA graphs engage.
        if mode_key == "high-kv" or (ple_ram_stage and world_size == 1 and not is_discrete_vram_known):
            default_kv_dtype = "nvfp4"
        else:
            default_kv_dtype = "bf16" if (max_seq_len <= native_max_pos or world_size >= 2) else "nvfp4"
        # On tight discrete multi-GPU tiers (e.g. 2x 48 GB running 80B Flash-Next) where
        # BF16 fits weights but cannot hold 131K tokens, default to mixed NVFP4 KV unless
        # the operator explicitly requested BF16.
        if is_discrete_vram_known and not explicit_kv_dtype_raw and default_kv_dtype == "bf16":
            provisional_bf16 = calculate_discrete_vram_budget(
                model_info,
                hw,
                tp_size=tp_size,
                ep_size=ep_size,
                pp_size=pp_size,
                gpu_mem_util=gpu_mem_util_f,
                kv_cache_dtype="bf16",
                kv_high_precision_layers=kv_hp_layers_for_budget,
                speculative_enabled=dflash_active_for_pool,
                spec_mode="dflash" if dflash_active_for_pool else str(spec.get("mode") or "none"),
                max_prefill_tokens=16384 if concurrency == 1 else 8192,
                ts4e_enabled=(per_gpu_vram_gib <= 100.0 and dflash_active_for_pool),
                release_unused_dflash=(dflash_active_for_pool or spec_off_for_pool),
                concurrency=concurrency,
                max_seq_len=max_seq_len,
                fast_proj_fp8_cache=(
                    str(env_vars.get("ATLAS_QWEN4_PREFILL_FAST_PROJ_FP8_WEIGHT_CACHE", "0")).strip() == "1"
                    and concurrency <= 16
                ),
                qsa_fp8_active=(
                    concurrency == 1
                    and str(env_vars.get("ATLAS_QWEN4_PREFILL_QSA_FP8", "0")).strip() not in ("", "0", "off", "false")
                ),
            )
            if not provisional_bf16["fits"] or provisional_bf16["max_kv_pool_tokens"] < 131072:
                default_kv_dtype = "nvfp4"
    elif profile is not None:
        default_kv_dtype = profile["kv_cache_dtype"]
    else:
        default_kv_dtype = "fp8" if (concurrency > 1 or max_seq_len >= 262144) else "bf16"
    kv_cache_dtype = public_selector("FLUX_KV_CACHE_DTYPE", default_kv_dtype)
    env_vars["FLUX_KV_CACHE_DTYPE"] = kv_cache_dtype
    if nvfp4_1m_mode and kv_cache_dtype != "nvfp4":
        raise ValueError(
            f"FLUX_MODE=1m-nvfp4 requires FLUX_KV_CACHE_DTYPE=nvfp4, got {kv_cache_dtype!r}"
        )
    if profile is not None and profile.get("kv_cache_dtype_required") and kv_cache_dtype != profile["kv_cache_dtype"]:
        raise ValueError(
            f"{profile['label']} needs {profile['kv_cache_dtype']} KV: its norm weights exceed the "
            f"E4M3 range, so {kv_cache_dtype} KV corrupts attention"
        )

    # On discrete >=90 GiB GPUs (e.g. 1x/2x/4x 96 GB RTX PRO 6000) in 1m-nvfp4 or high-kv
    # mode, default --gpu-memory-utilization to 0.92 (leaving GB10 UMA completely untouched).
    discrete_high_kv_96gb = (
        is_discrete_vram_known
        and per_gpu_vram_gib >= 90.0
        and (nvfp4_1m_mode or mode_key == "high-kv")
    )
    if discrete_high_kv_96gb and not any(
        k in os.environ or (custom_env and k in custom_env)
        for k in ("FLUX_GPU_MEMORY_UTILIZATION",)
    ):
        gpu_mem_util = "0.92"
        gpu_mem_util_f = 0.92

    # Resolve discrete lossless TS4E & Qwen4ReleaseMode::Dflash flags before VRAM budgeting
    # so `calculate_discrete_vram_budget()` reflects the exact weights resident on each GPU.
    explicit_ts4e = any(
        k in os.environ or (custom_env and k in custom_env)
        for k in ("ATLAS_MOE_SCALE_TS4E", "FLUX_MOE_SCALE_TS4E")
    )
    if explicit_ts4e:
        discrete_ts4e_enabled = public_selector("FLUX_MOE_SCALE_TS4E", public_selector("ATLAS_MOE_SCALE_TS4E", "0")).strip() == "1"
    else:
        discrete_ts4e_enabled = bool(
            is_discrete_vram_known
            and requires_qsa
            and env_vars.get("ATLAS_QWEN4_BOUNDED_TRANSPOSE_OWNERS") != "1"
            and (
                concurrency > 1
                or kv_cache_dtype == "nvfp4"
                or max_seq_len > 262144
                or (dflash_active_for_pool and per_gpu_vram_gib <= 100.0)
            )
        )
    release_unused_active = (
        env_vars.get("ATLAS_QWEN4_RELEASE_UNUSED", "1" if (requires_qsa and not user_recipe) else "0").strip() == "1"
    )
    discrete_release_unused_dflash = bool(
        is_discrete_vram_known
        and requires_qsa
        and release_unused_active
        and (dflash_active_for_pool or spec_off_for_pool)
    )

    # Discrete SM120 / SM103 VRAM fit check & KV-pool budgeting (never confused with host RAM or GB10 UMA).
    vram_budget: Optional[Dict[str, Any]] = None
    discrete_1x96_1m_prefill_8k = (
        is_discrete_vram_known
        and requires_qsa
        and (
            (world_size == 1 and per_gpu_vram_gib <= 100.0 and (nvfp4_1m_mode or mode_key == "high-kv"))
            or (per_gpu_vram_gib <= 48.0 and kv_cache_dtype != "bf16")
        )
        and not any(
            k in os.environ or (custom_env and k in custom_env)
            for k in (
                "FLUX_MAX_PREFILL_TOKENS",
                "FLUX_QWEN4_PREFILL_WIDE",
                "ATLAS_QWEN4_PREFILL_WIDE",
            )
        )
    )
    explicit_fast_proj_cache = any(
        k in os.environ or (custom_env and k in custom_env)
        for k in (
            "ATLAS_QWEN4_PREFILL_FAST_PROJ_FP8_WEIGHT_CACHE",
            "FLUX_QWEN4_PREFILL_FAST_PROJ_FP8_WEIGHT_CACHE",
        )
    )
    discrete_1x96_1m_disable_fast_proj = (
        is_discrete_vram_known
        and requires_qsa
        and not explicit_fast_proj_cache
        and (
            (world_size == 1 and per_gpu_vram_gib <= 100.0 and (nvfp4_1m_mode or mode_key == "high-kv"))
            or (per_gpu_vram_gib <= 48.0 and kv_cache_dtype != "bf16")
        )
    )
    if discrete_1x96_1m_disable_fast_proj:
        # On 1x 96 GB discrete GPUs in 1m-nvfp4 / high-kv mode (or <=48 GB tight multi-GPU
        # NVFP4 KV tiers), skip the ~2.40 GiB/world_size persistent FP8 fast-proj weight
        # cache so the full KV pool stays resident.
        env_vars["ATLAS_QWEN4_PREFILL_FAST_PROJ_FP8_WEIGHT_CACHE"] = "0"
        env_vars["FLUX_QWEN4_PREFILL_FAST_PROJ_FP8_WEIGHT_CACHE"] = "0"
    explicit_hp_layers = bool(
        _cli_hp_layers
        or any(
            k in os.environ or (custom_env and k in custom_env)
            for k in ("FLUX_KV_HIGH_PRECISION_LAYERS",)
        )
    )
    if (
        is_discrete_vram_known
        and requires_qsa
        and world_size == 1
        and per_gpu_vram_gib <= 100.0
        and nvfp4_1m_mode
        and concurrency > 4
        and not explicit_hp_layers
    ):
        # At C>4 on 1x 96 GB in 1m-nvfp4 mode, per-slot SSM/QSA runtime state reduces
        # free KV headroom (~13.2 GiB at C=16); auto-selecting all-NVFP4 (hp=0, 8.36 KiB/tok)
        # preserves a >=1.5M shared KV pool without requiring manual --kv-high-precision-layers 0.
        kv_hp_layers_for_budget = "0"
    if is_discrete_vram_known:
        raw_prefill_for_budget = public_selector("FLUX_MAX_PREFILL_TOKENS").strip()
        if raw_prefill_for_budget.isdigit():
            prefill_for_budget = int(raw_prefill_for_budget)
        elif discrete_1x96_1m_prefill_8k:
            prefill_for_budget = 8192
        elif qsa_concurrency:
            prefill_for_budget = 4096 if concurrency > 16 else min(max_seq_len, 8192)
        else:
            wide_raw = str(env_vars.get("ATLAS_QWEN4_PREFILL_WIDE") or "").strip()
            prefill_for_budget = int(wide_raw) if (requires_qsa and wide_raw.isdigit() and int(wide_raw) > 0) else 8192
        fast_proj_cache_for_budget = bool(
            requires_qsa
            and str(env_vars.get("ATLAS_QWEN4_PREFILL_FAST_PROJ_FP8_WEIGHT_CACHE", "0")).strip() == "1"
            and concurrency <= 16
            and not discrete_1x96_1m_disable_fast_proj
            and (ple_ram_plan is None or is_discrete_vram_known)
        )
        qsa_fp8_for_budget = bool(
            requires_qsa
            and kv_cache_dtype == "bf16"
            and concurrency == 1
            and not nvfp4_1m_mode
            and not multi_spark_1m_mode
            and str(env_vars.get("ATLAS_QWEN4_PREFILL_QSA_FP8", "0")).strip()
            not in ("", "0", "off", "false")
        )
        vram_budget = calculate_discrete_vram_budget(
            model_info,
            hw,
            tp_size=tp_size,
            ep_size=ep_size,
            pp_size=pp_size,
            gpu_mem_util=gpu_mem_util_f,
            kv_cache_dtype=kv_cache_dtype,
            kv_high_precision_layers=kv_hp_layers_for_budget,
            speculative_enabled=dflash_active_for_pool,
            spec_mode="dflash" if dflash_active_for_pool else str(spec.get("mode") or "none"),
            max_prefill_tokens=prefill_for_budget,
            ts4e_enabled=discrete_ts4e_enabled,
            release_unused_dflash=discrete_release_unused_dflash,
            concurrency=concurrency,
            max_seq_len=max_seq_len,
            fast_proj_fp8_cache=fast_proj_cache_for_budget,
            qsa_fp8_active=qsa_fp8_for_budget,
        )
        if not vram_budget["fits"]:
            raise ValueError(vram_budget["fit_reason"])
        if max_seq_len > vram_budget["max_kv_pool_tokens"]:
            if explicit_seq:
                raise ValueError(
                    f"Requested FLUX_MAX_SEQ_LEN={max_seq_len:,} exceeds discrete VRAM KV capacity "
                    f"(~{vram_budget['max_kv_pool_tokens']:,} {kv_cache_dtype.upper()} tokens in "
                    f"{vram_budget['free_vram_for_kv_per_gpu_gib']:.1f} GiB free VRAM/GPU on "
                    f"{det_gpu_count}x {per_gpu_vram_gib:.1f} GiB {hw_sm_family}). "
                    "Lower FLUX_MAX_SEQ_LEN or use compressed KV (FLUX_KV_CACHE_DTYPE=nvfp4)."
                )
            clamped_seq = max(4096, _snap_kv_pool_tokens(vram_budget["max_kv_pool_tokens"]))
            if clamped_seq < max_seq_len:
                launch_warnings.append(
                    f"Clamped max_seq_len from {max_seq_len:,} to {clamped_seq:,} to fit "
                    f"{vram_budget['free_vram_for_kv_per_gpu_gib']:.1f} GiB free discrete VRAM/GPU "
                    f"({kv_cache_dtype.upper()} KV)."
                )
                max_seq_len = clamped_seq
                env_vars["FLUX_MAX_SEQ_LEN"] = str(max_seq_len)

    # Shared KV pool (--kv-pool-tokens):
    #   - On discrete GPUs (SM120 / SM103): sized strictly from per-GPU discrete VRAM budget
    #     across both 1x and multi-GPU (2x/4x/8x TP/EP/PP) topologies.
    #   - On GB10 UMA: dynamically sized from available UMA, cluster topology (1x-4x Spark), and KV dtype.
    kv_pool_tokens = positive_selector("FLUX_KV_POOL_TOKENS")
    if (
        kv_pool_tokens is not None
        and vram_budget is not None
        and kv_pool_tokens > vram_budget["max_kv_pool_tokens"]
    ):
        raise ValueError(
            f"FLUX_KV_POOL_TOKENS ({kv_pool_tokens:,}) exceeds discrete VRAM KV capacity "
            f"(~{vram_budget['max_kv_pool_tokens']:,} {kv_cache_dtype.upper()} tokens in "
            f"{vram_budget['free_vram_for_kv_per_gpu_gib']:.1f} GiB free VRAM/GPU on "
            f"{det_gpu_count}x {per_gpu_vram_gib:.1f} GiB {hw_sm_family})."
        )
    mem_avail_gib = float(hw.get("mem_available_gib") or 0.0)
    high_uma = is_uma_hw and mem_avail_gib >= 112.0
    tight_uma = is_uma_hw and 0.0 < mem_avail_gib < 98.0
    if kv_pool_tokens is None and vram_budget is not None:
        rec_pool = min(vram_budget["recommended_kv_pool_tokens"], vram_budget["max_kv_pool_tokens"])
        should_auto_pool_discrete = mode_key != "256k" and (
            qsa_concurrency
            or (not requires_qsa and concurrency > 1)
            or nvfp4_1m_mode
            or multi_spark_1m_mode
            or mode_key == "high-kv"
            or (world_size >= 2 and rec_pool >= max_seq_len)
            or (kv_cache_dtype == "nvfp4" and rec_pool > max_seq_len)
        )
        if should_auto_pool_discrete and rec_pool >= max_seq_len:
            kv_pool_tokens = max(rec_pool, max_seq_len)
    elif (
        kv_pool_tokens is None
        and qsa_concurrency
        and not explicit_seq
        and mode_key != "256k"
    ):
        if world_size >= 2:
            # Multi-Spark (2x-4x GB10 UMA) live-calibrated KV pool sizing across
            # headless (>=112 GiB free), desktop (98-112 GiB), and tight (<98 GiB)
            # hosts. Sized against live rank-0 READY MemAvailable & budget_blocks
            # (with >=16 GiB UMA safety headroom; unlocks >4M pools under
            # --enable-prefix-caching, C>16, or >256K context).
            if pp_size >= 4:
                # 4x Spark PP=4 (~20.5 GiB weights/rank, 6 KiB/tok BF16 / ~3.2 KiB NVFP4;
                # live rank-0 budget_blocks=732K -> 11.18M BF16 max above 16 GiB floor).
                pool = (
                    (16777216 if high_uma else (8388608 if tight_uma else 12582912))
                    if kv_cache_dtype == "nvfp4"
                    else (10485760 if high_uma else (4194304 if tight_uma else 6291456))
                )
            elif ep_size >= 4:
                # 4x Spark TP=4 + EP=4 + W=8 DFlash2 (~24.7 GiB weights/rank,
                # 12 KiB/tok BF16 / ~6.3 KiB NVFP4; live 4M BF16 left 40.2 GiB free).
                pool = (
                    (10485760 if high_uma else (6291456 if tight_uma else 7340032))
                    if kv_cache_dtype == "nvfp4"
                    else (5242880 if high_uma else (3145728 if tight_uma else 4194304))
                )
            elif pp_size == 3:
                # 3x Spark PP=3 (~27.2 GiB weights/rank, 8 KiB/tok BF16 / ~4.2 KiB NVFP4;
                # live rank-0 budget_blocks=506K -> 7.72M BF16 max above 16 GiB floor).
                pool = (
                    (12582912 if high_uma else (6291456 if tight_uma else 8388608))
                    if kv_cache_dtype == "nvfp4"
                    else (7340032 if high_uma else (3145728 if tight_uma else 5242880))
                )
            elif pp_size == 2:
                # 2x Spark PP=2 (~38 GiB weights/rank, no DFlash2 drafter, 12 KiB/tok BF16).
                pool = (
                    (8388608 if high_uma else (4194304 if tight_uma else 6291456))
                    if kv_cache_dtype == "nvfp4"
                    else (4718592 if high_uma else (2097152 if tight_uma else 3145728))
                )
            elif ep_size >= 2:
                # 2x Spark TP=2 + EP=2 + W=8 DFlash2 (~39 GiB weights/rank,
                # 12 KiB/tok BF16 / ~6.3 KiB NVFP4; live 4M BF16 left 23.7 GiB free).
                pool = (
                    (7340032 if high_uma else (4194304 if tight_uma else 5242880))
                    if kv_cache_dtype == "nvfp4"
                    else (4194304 if high_uma else (2097152 if tight_uma else 2621440))
                )
            else:
                # 2x/4x Spark TP=2/4, EP=1 (full experts replicated, 12 KiB/tok BF16).
                pool = (
                    (3145728 if high_uma else (1572864 if tight_uma else 2097152))
                    if kv_cache_dtype == "nvfp4"
                    else (1572864 if high_uma else (786432 if tight_uma else 1048576))
                )
            kv_pool_tokens = max(pool, max_seq_len)
        elif ple_ram_stage and concurrency <= 16:
            # RAM-staged PLE keeps the 26.8 GiB PLE table in tmpfs; pair with a
            # 128K (131,056) mixed NVFP4 KV pool (~1.6 GiB) so C=1..16 runs with
            # zero MEM_FLOOR_BREACH on 128 GiB GB10 UMA.
            kv_pool_tokens = max_seq_len
        elif concurrency <= 16:
            # 1x GB10 UMA dynamic pool sizing:
            #   - Clean headless 128 GiB Spark (>=112 GiB free): 512K BF16 (12.0 GiB) or 1M NVFP4 (12.6 GiB)
            #   - Desktop Spark / default (98-112 GiB free):     384K BF16 (9.0 GiB)  or 768K NVFP4 (9.5 GiB)
            #   - Tight host (<98 GiB free):                     256K BF16 (6.0 GiB)  or 512K NVFP4 (6.3 GiB)
            if kv_cache_dtype == "nvfp4":
                pool = 1048576 if high_uma else (524288 if tight_uma else 786432)
            else:
                pool = 524288 if high_uma else (262144 if tight_uma else 393216)
            kv_pool_tokens = max(pool, max_seq_len)
        else:
            if high_uma:
                kv_pool_tokens = max(
                    524288 if kv_cache_dtype == "nvfp4" else 262144,
                    max_seq_len,
                )
            else:
                kv_pool_tokens = max(65536, max_seq_len)
    if kv_pool_tokens is not None:
        if kv_pool_tokens < max_seq_len:
            raise ValueError(
                f"FLUX_KV_POOL_TOKENS ({kv_pool_tokens}) must hold one "
                f"FLUX_MAX_SEQ_LEN ({max_seq_len}) sequence"
            )
        env_vars["FLUX_KV_POOL_TOKENS"] = str(kv_pool_tokens)
        # Under a shared KV pool (--kv-pool-tokens), depth-aware admission's
        # default watermark (`max_seq_len`, e.g. 262,144) reserves the full
        # max_tokens per request up front, collapsing a C=16 server to C=1..2
        # whenever requests send max_tokens=131072 or omit max_tokens. Reserve
        # 32,768 tokens per request on >=384K pools (unthrottling C=12..16 for
        # high-max_tokens reasoning workloads like GSM8K/MMLU-Pro/LAVD/GPQA),
        # 40,960 under --ple-ram, 65,536 on tight <=256K pools, or 2,048 at C>16.
        if not any(
            k in os.environ or (custom_env and k in custom_env)
            for k in ("ATLAS_KV_ADMIT_WATERMARK", "FLUX_KV_ADMIT_WATERMARK")
        ):
            if concurrency > 16:
                default_watermark = "4096" if kv_pool_tokens >= 524288 else "2048"
            elif kv_pool_tokens >= 393216:
                default_watermark = "32768"
            elif ple_ram_stage:
                default_watermark = "40960"
            elif dflash_active_for_pool and kv_pool_tokens <= 262144:
                default_watermark = "65536"
            else:
                default_watermark = "40960"
            env_vars.setdefault("ATLAS_KV_ADMIT_WATERMARK", default_watermark)
            env_vars.setdefault("FLUX_KV_ADMIT_WATERMARK", env_vars["ATLAS_KV_ADMIT_WATERMARK"])
    # Waiting-request bound (--max-queue-depth): unset keeps the default queue.
    queue_depth = positive_selector("FLUX_QUEUE_DEPTH")
    if queue_depth is not None:
        env_vars["FLUX_QUEUE_DEPTH"] = str(queue_depth)

    selected_prefill_tokens = public_selector("FLUX_MAX_PREFILL_TOKENS")
    explicit_wide = any(
        k in os.environ or (custom_env and k in custom_env)
        for k in ("FLUX_QWEN4_PREFILL_WIDE", "ATLAS_QWEN4_PREFILL_WIDE")
    )
    if selected_prefill_tokens:
        max_prefill_tokens = int(selected_prefill_tokens)
        if requires_qsa and not explicit_wide:
            env_vars["ATLAS_QWEN4_PREFILL_WIDE"] = str(max_prefill_tokens)
            env_vars["FLUX_QWEN4_PREFILL_WIDE"] = str(max_prefill_tokens)
    elif profile is not None:
        prefill_default = profile["max_prefill_tokens"]
        max_prefill_tokens = max_seq_len if prefill_default == "max_seq_len" else int(prefill_default)
    elif qsa_concurrency and not explicit_wide:
        if max_seq_len < 4096:
            max_prefill_tokens = min(max_seq_len, 2048)
            env_vars["ATLAS_QWEN4_PREFILL_WIDE"] = "0"
            env_vars["FLUX_QWEN4_PREFILL_WIDE"] = "0"
        elif concurrency <= 16 and mode_key not in ("interactive", "agent"):
            max_prefill_tokens = min(max_seq_len, 8192)
            env_vars["ATLAS_QWEN4_PREFILL_WIDE"] = str(max_prefill_tokens)
            env_vars["FLUX_QWEN4_PREFILL_WIDE"] = str(max_prefill_tokens)
        else:
            max_prefill_tokens = 4096
            env_vars["ATLAS_QWEN4_PREFILL_WIDE"] = "4096"
            env_vars["FLUX_QWEN4_PREFILL_WIDE"] = "4096"
    elif discrete_1x96_1m_prefill_8k:
        # On 1x 96 GB discrete GPUs in 1m-nvfp4 / high-kv mode, 8192 chunked
        # prefill reclaims 1.69 GiB of permanent BufferArena VRAM vs 16384 so
        # mixed-precision (hp=auto) NVFP4 cleanly achieves >=1.5M KV pool.
        max_prefill_tokens = 8192
        env_vars["ATLAS_QWEN4_PREFILL_WIDE"] = "8192"
        env_vars["FLUX_QWEN4_PREFILL_WIDE"] = "8192"
    elif mode_key in ("interactive", "agent", "decode"):
        default_wide = "8192" if mode_key == "decode" else "4096"
        max_prefill_tokens = int(env_vars.get("ATLAS_QWEN4_PREFILL_WIDE", default_wide))
        env_vars.setdefault("ATLAS_QWEN4_PREFILL_WIDE", str(max_prefill_tokens))
        env_vars.setdefault("FLUX_QWEN4_PREFILL_WIDE", str(max_prefill_tokens))
    elif explicit_wide:
        max_prefill_tokens = int(env_vars.get("ATLAS_QWEN4_PREFILL_WIDE", "16384"))
    elif "ATLAS_QWEN4_PREFILL_WIDE" in env_vars and env_vars["ATLAS_QWEN4_PREFILL_WIDE"].isdigit() and int(env_vars["ATLAS_QWEN4_PREFILL_WIDE"]) > 0:
        max_prefill_tokens = int(env_vars["ATLAS_QWEN4_PREFILL_WIDE"])
    else:
        max_prefill_tokens = 16384
    env_vars["FLUX_MAX_PREFILL_TOKENS"] = str(max_prefill_tokens)
    if profile is not None and profile["max_prefill_tokens"] == "max_seq_len" and max_prefill_tokens < max_seq_len:
        raise ValueError(
            f"{profile['label']} prefills a prompt in one call: FLUX_MAX_PREFILL_TOKENS "
            f"({max_prefill_tokens}) must be at least FLUX_MAX_SEQ_LEN ({max_seq_len})"
        )

    request_timeout = int(
        os.environ.get("FLUX_REQUEST_TIMEOUT", str(recipe.get("request_timeout", 1800)))
    )

    native_qsa_262k = (
        requires_qsa
        and mode_key == "256k"
        and native_max_pos == 262144
        and max_seq_len == native_max_pos
    )
    explicit_qsa_fp8_override = any(
        k in os.environ or (custom_env and k in custom_env)
        for k in ("ATLAS_QWEN4_PREFILL_QSA_FP8", "FLUX_QWEN4_PREFILL_QSA_FP8")
    )
    if nvfp4_1m_mode or multi_spark_1m_mode:
        env_vars.setdefault("ATLAS_QWEN4_QSA_SELECT_V3", "1")
        env_vars.setdefault("FLUX_QWEN4_QSA_SELECT_V3", env_vars["ATLAS_QWEN4_QSA_SELECT_V3"])
        if not explicit_qsa_fp8_override:
            env_vars["ATLAS_QWEN4_PREFILL_QSA_FP8"] = "0"
            env_vars["FLUX_QWEN4_PREFILL_QSA_FP8"] = "0"
    if requires_qsa and kv_cache_dtype != "bf16" and not explicit_qsa_fp8_override:
        # QSA E4M3 prefill shadows require all-BF16 KV; unconditionally clear
        # any BF16 hardware-recipe default (e.g. `nvidia-blackwell-sm120.env`
        # `=qkpv`) whenever NVFP4 / non-BF16 KV is selected.
        env_vars["ATLAS_QWEN4_PREFILL_QSA_FP8"] = "0"
        env_vars["FLUX_QWEN4_PREFILL_QSA_FP8"] = "0"
    if discrete_ts4e_enabled and not explicit_ts4e:
        # Lossless 0-ULP Atlas-TS4E-128 compressed MoE scales reclaim 3.37 GiB / ep_size
        # on discrete GPUs (1x and multi-GPU) for NVFP4 KV, >256K context, or <=100 GiB DFlash2.
        env_vars["ATLAS_MOE_SCALE_TS4E"] = "1"
        env_vars["FLUX_MOE_SCALE_TS4E"] = "1"
    if native_qsa_262k:
        _note_native_262k_profile_once()
        # The max-prefill recipe normally selects transient E4M3 Q/K/V shadows.
        # Native-262K is a correctness profile: keep those operands in BF16 as
        # well as the persistent KV cache.  Set both spellings after recipe and
        # user-environment synchronization so this mode cannot silently drift
        # away from the qualification recipe.
        env_vars["ATLAS_QWEN4_PREFILL_QSA_FP8"] = "0"
        env_vars["FLUX_QWEN4_PREFILL_QSA_FP8"] = "0"
        env_vars["ATLAS_QWEN4_QSA_VERIFY_ROWS"] = "0"
        env_vars["FLUX_QWEN4_QSA_VERIFY_ROWS"] = "0"
    elif requires_qsa and max_seq_len > 2048:
        env_vars.setdefault("ATLAS_QWEN4_QSA_VERIFY_ROWS", "1")
        env_vars.setdefault("FLUX_QWEN4_QSA_VERIFY_ROWS", env_vars["ATLAS_QWEN4_QSA_VERIFY_ROWS"])
        if qsa_concurrency and _moe_exact_rows_selected(env_vars):
            env_vars.setdefault("ATLAS_QWEN4_NATIVE_BATCH_QSA", "1")
            env_vars.setdefault("FLUX_QWEN4_NATIVE_BATCH_QSA", env_vars["ATLAS_QWEN4_NATIVE_BATCH_QSA"])
    if (
        qsa_concurrency
        and not _moe_exact_rows_selected(env_vars)
        and "ATLAS_QWEN4_NATIVE_BATCH_QSA" not in env_vars
    ):
        # Recipes without the exact-rows MoE route (FLUX_MODE=fast) cannot
        # batch natively, and the server treats an UNSET selector as QSA rows
        # on (spark_model::layers::qwen4_qsa::native_batch), which refuses to
        # start. Opt out explicitly so C2+ frames run the C1 kernels serially.
        env_vars["ATLAS_QWEN4_NATIVE_BATCH_QSA"] = "0"
        env_vars["FLUX_QWEN4_NATIVE_BATCH_QSA"] = "0"
        _note_serial_qsa_concurrency_once(mode_key)
    if requires_qsa and max_seq_len >= 143360:
        env_vars["ATLAS_CTX_OVERFLOW_TRUNCATE"] = "0"
        env_vars["FLUX_CTX_OVERFLOW_TRUNCATE"] = "0"
        if native_qsa_262k:
            reserve_key = "ATLAS_QWEN4_PREFILL_FAST_PROJ_FP8_WEIGHT_CACHE_RESERVE_GB"
            try:
                reserve_gb = max(10, int(env_vars.get(reserve_key, "0")))
            except ValueError:
                reserve_gb = 10
            env_vars[reserve_key] = str(reserve_gb)
            env_vars["FLUX_QWEN4_PREFILL_FAST_PROJ_FP8_WEIGHT_CACHE_RESERVE_GB"] = str(reserve_gb)
        elif concurrency == 1 and not any(
            k in os.environ or (custom_env and k in custom_env)
            for k in (
                "ATLAS_QWEN4_FP8_WEIGHT_CACHE_FLOOR_MARGIN_MIB",
                "FLUX_QWEN4_FP8_WEIGHT_CACHE_FLOOR_MARGIN_MIB",
            )
        ):
            # At C=1 262K with qkpv E4M3 shadows, post-load MemAvailable is ~11.2 GiB
            # and the full 120-weight FP8 cache is 2.55 GiB (leaving ~8.65 GiB free).
            # A 1024 MiB margin above the 6656 MiB floor (stop line 7680 MiB) lets
            # all 120/120 projection weights cache instead of staying 0/120 per-call.
            env_vars["ATLAS_QWEN4_FP8_WEIGHT_CACHE_FLOOR_MARGIN_MIB"] = "1024"
            env_vars["FLUX_QWEN4_FP8_WEIGHT_CACHE_FLOOR_MARGIN_MIB"] = "1024"
    if (
        requires_qsa
        and not user_recipe
    ):
        env_vars.setdefault("ATLAS_FAST_START", "0")
        env_vars.setdefault("FLUX_FAST_START", env_vars["ATLAS_FAST_START"])
        routed_groups_refused_spec = (
            _cli_bool_flag_enabled(extra_args, "--self-speculative")
            or _cli_bool_flag_enabled(extra_args, "--ngram-speculative")
            or world_size > 1
        )
        if routed_groups_refused_spec:
            if not any(
                k in os.environ or (custom_env and k in custom_env)
                for k in (
                    "ATLAS_FAST_LOAD_ROUTED_GROUPS",
                    "FLUX_FAST_LOAD_ROUTED_GROUPS",
                    "ATLAS_FAST_LOAD_ROUTED_GROUPS_EAGER",
                    "FLUX_FAST_LOAD_ROUTED_GROUPS_EAGER",
                )
            ):
                env_vars["ATLAS_FAST_LOAD_ROUTED_GROUPS"] = "0"
                env_vars["FLUX_FAST_LOAD_ROUTED_GROUPS"] = "0"
                env_vars["ATLAS_FAST_LOAD_ROUTED_GROUPS_EAGER"] = "0"
                env_vars["FLUX_FAST_LOAD_ROUTED_GROUPS_EAGER"] = "0"
        else:
            # Admitted for Plain, native MTP, and DFlash (serve_phases/weights.rs).
            env_vars.setdefault("ATLAS_FAST_LOAD_ROUTED_GROUPS", "1")
            env_vars.setdefault(
                "FLUX_FAST_LOAD_ROUTED_GROUPS",
                env_vars["ATLAS_FAST_LOAD_ROUTED_GROUPS"],
            )
            env_vars.setdefault("ATLAS_FAST_LOAD_ROUTED_GROUPS_EAGER", "1")
            env_vars.setdefault(
                "FLUX_FAST_LOAD_ROUTED_GROUPS_EAGER",
                env_vars["ATLAS_FAST_LOAD_ROUTED_GROUPS_EAGER"],
            )
        env_vars.setdefault("ATLAS_FAST_LOAD_DIRECT_IO_TENSOR_CAP", "20000")
        env_vars.setdefault(
            "FLUX_FAST_LOAD_DIRECT_IO_TENSOR_CAP",
            env_vars["ATLAS_FAST_LOAD_DIRECT_IO_TENSOR_CAP"],
        )
        env_vars.setdefault("ATLAS_QWEN4_QSA_VERIFY_STAGE_POOL_FUSED", "1")
        env_vars.setdefault(
            "FLUX_QWEN4_QSA_VERIFY_STAGE_POOL_FUSED",
            env_vars["ATLAS_QWEN4_QSA_VERIFY_STAGE_POOL_FUSED"],
        )
        # Leave ATLAS_MOE_T_LANES_WORKLIST_R8 unset so forward_k5.rs selects the
        # higher-occupancy r5 tier (3 CTAs/SM) automatically for rows <= 10 (C=2 K=5).
        env_vars.setdefault("ATLAS_SCHED_BURST_GATHER_MS", "3")
        env_vars.setdefault(
            "FLUX_SCHED_BURST_GATHER_MS",
            env_vars["ATLAS_SCHED_BURST_GATHER_MS"],
        )
        env_vars.setdefault("FLUX_MTP_VOCAB", "96000")
        if not any(
            k in os.environ or (custom_env and k in custom_env) or k in env_vars
            for k in ("ATLAS_QWEN4_MTP_CONF_CUM", "FLUX_QWEN4_MTP_CONF_CUM")
        ):
            env_vars["ATLAS_QWEN4_MTP_CONF_CUM"] = "0.4"
            env_vars["FLUX_QWEN4_MTP_CONF_CUM"] = "0.4"
        if mode_key in ("auto", "nextgen") and not any(
            k in os.environ or (custom_env and k in custom_env) or k in env_vars
            for k in ("ATLAS_QWEN4_HYBRID_ALL_K", "FLUX_QWEN4_HYBRID_ALL_K")
        ):
            env_vars["ATLAS_QWEN4_HYBRID_ALL_K"] = "1"
            env_vars["FLUX_QWEN4_HYBRID_ALL_K"] = "1"
        if not any(
            k in os.environ or (custom_env and k in custom_env)
            for k in (
                "ATLAS_MEMAVAILABLE_FLOOR_OVERRIDE",
                "FLUX_MEMAVAILABLE_FLOOR_OVERRIDE",
            )
        ):
            env_vars["ATLAS_MEMAVAILABLE_FLOOR_OVERRIDE"] = "1"
            env_vars["FLUX_MEMAVAILABLE_FLOOR_OVERRIDE"] = "1"
        if not any(
            k in os.environ or (custom_env and k in custom_env)
            for k in (
                "ATLAS_QWEN4_BOUNDED_TRANSPOSE_OWNERS",
                "FLUX_QWEN4_BOUNDED_TRANSPOSE_OWNERS",
                "ATLAS_QWEN4_BOUNDED_TRANSPOSE_OWNER_CAP_MIB",
                "FLUX_QWEN4_BOUNDED_TRANSPOSE_OWNER_CAP_MIB",
            )
        ):
            env_vars["ATLAS_QWEN4_BOUNDED_TRANSPOSE_OWNERS"] = "0"
            env_vars["FLUX_QWEN4_BOUNDED_TRANSPOSE_OWNERS"] = "0"
            env_vars.pop("ATLAS_QWEN4_BOUNDED_TRANSPOSE_OWNER_CAP_MIB", None)
            env_vars.pop("FLUX_QWEN4_BOUNDED_TRANSPOSE_OWNER_CAP_MIB", None)
            if "RUST_LOG" not in os.environ and not (custom_env and "RUST_LOG" in custom_env):
                env_vars["RUST_LOG"] = env_vars.get("RUST_LOG", "").replace(
                    ",atlas_bounded_transpose_allocation=debug", ""
                )
        if concurrency > 1:
            if not any(
                k in os.environ or (custom_env and k in custom_env)
                for k in ("ATLAS_QWEN4_PREFILL_QSA_FP8", "FLUX_QWEN4_PREFILL_QSA_FP8")
            ):
                env_vars["ATLAS_QWEN4_PREFILL_QSA_FP8"] = "0"
                env_vars["FLUX_QWEN4_PREFILL_QSA_FP8"] = "0"
            if concurrency > 16 and not any(
                k in os.environ or (custom_env and k in custom_env)
                for k in (
                    "ATLAS_QWEN4_PREFILL_FAST_PROJ_FP8_WEIGHT_CACHE",
                    "FLUX_QWEN4_PREFILL_FAST_PROJ_FP8_WEIGHT_CACHE",
                )
            ):
                env_vars["ATLAS_QWEN4_PREFILL_FAST_PROJ_FP8_WEIGHT_CACHE"] = "0"
                env_vars["FLUX_QWEN4_PREFILL_FAST_PROJ_FP8_WEIGHT_CACHE"] = "0"
            if concurrency > 16 and not is_discrete_vram_known and not any(
                k in os.environ or (custom_env and k in custom_env)
                for k in ("ATLAS_QWEN4_VERIFY_GRAPH", "FLUX_QWEN4_VERIFY_GRAPH")
            ):
                env_vars["ATLAS_QWEN4_VERIFY_GRAPH"] = "0"
                env_vars["FLUX_QWEN4_VERIFY_GRAPH"] = "0"
            elif not any(
                k in os.environ or (custom_env and k in custom_env)
                for k in ("ATLAS_QWEN4_VERIFY_GRAPH", "FLUX_QWEN4_VERIFY_GRAPH")
            ):
                # Keep single-sequence CUDA verify graphs enabled at C=2..16 so
                # live==1 requests on a multi-concurrency server avoid the ~16%
                # eager verify penalty (live>=2 uses decode_verify_qwen4_batched
                # and decode_a.rs disables per-slot PLE graphs at C>1).
                env_vars.setdefault("ATLAS_QWEN4_VERIFY_GRAPH", "1")
                env_vars.setdefault(
                    "FLUX_QWEN4_VERIFY_GRAPH",
                    env_vars["ATLAS_QWEN4_VERIFY_GRAPH"],
                )
            if (
                env_vars.get("ATLAS_QWEN4_BOUNDED_TRANSPOSE_OWNERS") != "1"
                and not any(
                    k in os.environ or (custom_env and k in custom_env)
                    for k in ("ATLAS_MOE_SCALE_TS4E", "FLUX_MOE_SCALE_TS4E")
                )
            ):
                # Reclaim ~3.35 GiB UMA at C>=2 via lossless 0-ULP Atlas-TS4E-128
                # inline compressed MoE scales.
                env_vars["ATLAS_MOE_SCALE_TS4E"] = "1"
                env_vars["FLUX_MOE_SCALE_TS4E"] = "1"
            elif (
                env_vars.get("ATLAS_QWEN4_BOUNDED_TRANSPOSE_OWNERS") == "1"
                and not any(
                    k in os.environ or (custom_env and k in custom_env)
                    for k in ("ATLAS_MOE_SCALE_TS4E", "FLUX_MOE_SCALE_TS4E")
                )
            ):
                env_vars.pop("ATLAS_MOE_SCALE_TS4E", None)
                env_vars.pop("FLUX_MOE_SCALE_TS4E", None)
            if not any(
                k in os.environ or (custom_env and k in custom_env)
                for k in ("ATLAS_SCHED_BURST_GATHER_MS", "FLUX_SCHED_BURST_GATHER_MS")
            ):
                env_vars["ATLAS_SCHED_BURST_GATHER_MS"] = "3"
                env_vars["FLUX_SCHED_BURST_GATHER_MS"] = "3"
        elif (
            mode_key in ("auto", "nextgen")
            and hw_recipe != "nvidia-hopper-sm90.env"
            and topo not in ("sm90", "hopper-sm90")
        ):
            # Lean Shared-V8 QSA FP8 shrinks qkpv shadows from 3,072 MiB to
            # 1,664 MiB (-1,408 MiB UMA), so C=1 auto/nextgen on Blackwell/GB10 keeps
            # Flat MoE (TS4E=0) alongside QSA_FP8=qkpv + QSA_PIPE=1 (DFlash2 separately
            # enables TS4E=1 below to reclaim 3.37 GiB UMA on 1x GB10).
            if (
                kv_cache_dtype == "bf16"
                and not nvfp4_1m_mode
                and not multi_spark_1m_mode
                and not native_qsa_262k
                and not any(
                    k in os.environ or (custom_env and k in custom_env)
                    for k in ("ATLAS_QWEN4_PREFILL_QSA_FP8", "FLUX_QWEN4_PREFILL_QSA_FP8")
                )
            ):
                env_vars["ATLAS_QWEN4_PREFILL_QSA_FP8"] = "qkpv"
                env_vars["FLUX_QWEN4_PREFILL_QSA_FP8"] = "qkpv"
            if not any(
                k in os.environ or (custom_env and k in custom_env)
                for k in ("ATLAS_QWEN4_PREFILL_QSA_PIPE", "FLUX_QWEN4_PREFILL_QSA_PIPE")
            ):
                env_vars["ATLAS_QWEN4_PREFILL_QSA_PIPE"] = "1"
                env_vars["FLUX_QWEN4_PREFILL_QSA_PIPE"] = "1"
    # Prefix caching & SSM/PLE state slots (enabled automatically at C1 in `agent` mode for ohmypi / Claude Code / Codex / Antigravity)
    enable_prefix_cache = (
        mode_key == "agent"
        or bool(recipe.get("prefix_cache"))
        or os.environ.get("FLUX_PREFIX_CACHE", "").lower() in ("1", "true", "yes")
    )
    if profile is not None:
        # None of these profiles was measured with prefix caching; FLUX_PREFIX_CACHE opts in.
        enable_prefix_cache = os.environ.get("FLUX_PREFIX_CACHE", "").lower() in ("1", "true", "yes")
        if not profile.get("prefix_cache_supported", True) and (
            enable_prefix_cache
        ):
            raise ValueError(
                f"{profile['label']} cannot serve with prefix caching under this one-call prefill "
                "launch profile. Unset FLUX_PREFIX_CACHE."
            )
    default_ssm_slots = str(recipe.get("ssm_cache_slots", 16)) if enable_prefix_cache else "0"
    ssm_cache_slots = int(os.environ.get("FLUX_SSM_CACHE_SLOTS", default_ssm_slots))
    if qsa_concurrency:
        # C2+ Qwen4 concurrency keeps per-slot physical QSA/PLE state isolated without prefix caching.
        if "FLUX_PREFIX_CACHE" not in os.environ:
            enable_prefix_cache = False
        if "FLUX_SSM_CACHE_SLOTS" not in os.environ:
            ssm_cache_slots = 0
    if os.environ.get("FLUX_PREFIX_CACHE_DIR", "").strip():
        env_vars["FLUX_PREFIX_CACHE_DIR"] = os.environ["FLUX_PREFIX_CACHE_DIR"].strip()
    tool_call_parser = os.environ.get(
        "FLUX_TOOL_CALL_PARSER",
        model_info.get("recommended_tool_call_parser", "hermes"),
    )
    tool_max_tokens = int(
        os.environ.get(
            "FLUX_TOOL_MAX_TOKENS",
            str(recipe.get("tool_max_tokens", max(65536, max_seq_len))),
        )
    )
    default_max_tokens_raw = public_selector("FLUX_DEFAULT_MAX_TOKENS").strip()
    if default_max_tokens_raw:
        if not default_max_tokens_raw.isdigit():
            raise ValueError("FLUX_DEFAULT_MAX_TOKENS must be a non-negative integer (0 keeps 4096)")
        default_max_tokens: Optional[int] = int(default_max_tokens_raw) or None
        default_max_tokens_source = "environment"
    else:
        profile_default = MODEL_PROFILE_DEFAULT_MAX_TOKENS.get(kt)
        default_max_tokens = min(profile_default, max_seq_len) if profile_default else None
        default_max_tokens_source = "model_profile" if default_max_tokens else "unspecified"

    # RoPE & YaRN scaling factor (explicit, recipe-defined, or auto-computed when max_seq_len > native max_position_embeddings)
    rope_yarn_factor: Optional[int] = None
    if os.environ.get("FLUX_ROPE_YARN_FACTOR"):
        rope_yarn_factor = int(float(os.environ["FLUX_ROPE_YARN_FACTOR"]))
    elif recipe.get("rope_yarn_factor") and profile is None:
        rope_yarn_factor = int(recipe["rope_yarn_factor"])
    elif max_seq_len > max(native_max_pos, 143360) and native_max_pos > 0:
        rope_yarn_factor = max(2, int(math.ceil(max_seq_len / float(native_max_pos))))
    rope_theta_override = os.environ.get("FLUX_ROPE_THETA", "").strip() or None

    draft_override = str(
        env_vars.get("FLUX_DRAFT_MODEL")
        or os.environ.get("FLUX_DRAFT_MODEL")
        or env_vars.get("FLUX_MTP_PATH")
        or os.environ.get("FLUX_MTP_PATH")
        or env_vars.get("FLUX_DRAFTER_PATH")
        or os.environ.get("FLUX_DRAFTER_PATH")
        or ""
    ).strip().lower()
    serial_concurrency_only = qsa_concurrency and (
        concurrency > QWEN4_NATIVE_MAX_ROWS
        or env_vars.get("ATLAS_QWEN4_NATIVE_BATCH") == "0"
    )
    # Fixed K5 batched native MTP admits C2-C32 (`qwen4_concurrency.rs`), and
    # adaptive-K (`ATLAS_QWEN4_BATCHED_ADAPTIVE_K=1`) admits single-frame <=128
    # verify rows through C64 (108.5 agg tok/s) and two-frame K2 through C128.
    # Above C64, 1-pass native target-only batching reaches 140.3 agg tok/s at
    # C128, so C65-C128 defaults to native target-only unless FLUX_SPEC_MODE=mtp
    # explicitly opts into two-frame adaptive-K speculation.
    adaptive_k_raw = str(
        env_vars.get("ATLAS_QWEN4_BATCHED_ADAPTIVE_K")
        or os.environ.get("ATLAS_QWEN4_BATCHED_ADAPTIVE_K")
        or ""
    ).strip()
    adaptive_k_effective = adaptive_k_raw == "1" or (
        adaptive_k_raw != "0"
        and (
            str(env_vars.get("ATLAS_QWEN4_HYBRID_ALL_K", "0")).strip() == "1"
            or str(env_vars.get("ATLAS_QWEN4_VERIFY_FAST_HOST", "0")).strip() == "1"
        )
    )
    explicit_mtp_spec = (
        str(env_vars.get("FLUX_SPEC_MODE") or os.environ.get("FLUX_SPEC_MODE") or "")
        .strip()
        .lower()
        in ("mtp", "native-mtp")
    )
    dflash_topology_supported = (world_size == 1) or (
        tp_size in (2, 4) and ep_size in (1, tp_size) and pp_size == 1 and world_size == tp_size
    )
    if spec.get("mode") == "dflash" and not dflash_topology_supported:
        # DFlash captures intermediate hidden states across layers and is
        # qualified for 1x Spark and lockstep TP=2/4 (EP=1 or EP=TP, PP=1).
        # Under PP>1 (3x/4x Spark), fall back cleanly to native K=5 MTP.
        model_info = dict(model_info)
        if requires_qsa and world_size <= 4:
            model_info["speculative"] = {
                "mode": "native-mtp",
                "drafter_path": None,
                "gamma": 4,
                "num_drafts": 4,
                "native_mtp_k": 5,
            }
        else:
            model_info["speculative"] = {"mode": "none", "drafter_path": None, "gamma": 0, "native_mtp_k": 0}
        spec = model_info["speculative"]
    dflash_qsa_mode = spec.get("mode") == "dflash"
    if dflash_qsa_mode:
        # Batched DFlash2 fits 16 x K8 = 128 rows on GB10 UMA, and up to
        # 256 rows on discrete Blackwell GPUs (32xK8=256, 48xK5=240, 64xK4=256).
        adaptive_rows_raw = str(
            env_vars.get("ATLAS_QWEN4_ADAPTIVE_MAX_ROWS")
            or os.environ.get("ATLAS_QWEN4_ADAPTIVE_MAX_ROWS")
            or ""
        ).strip()
        adaptive_rows_256 = adaptive_rows_raw.isdigit() and int(adaptive_rows_raw) >= 256
        spec_concurrency_ceiling = 64 if (is_discrete_vram_known or adaptive_rows_256) else 16
    else:
        spec_concurrency_ceiling = (
            (128 if explicit_mtp_spec else 64) if adaptive_k_effective else 32
        )
    wide_concurrency_target_only = qsa_concurrency and (
        concurrency > spec_concurrency_ceiling or world_size > 4
    )
    disable_spec = (
        bool(recipe.get("disable_speculation"))
        or str(env_vars.get("ATLAS_DISABLE_SPECULATION", "")).lower() in ("1", "true", "yes")
        or str(env_vars.get("FLUX_DISABLE_SPECULATION", "")).lower() in ("1", "true", "yes")
        or str(env_vars.get("FLUX_SPEC_MODE") or os.environ.get("FLUX_SPEC_MODE") or "").strip().lower() in ("none", "off", "0", "false")
        or draft_override in ("none", "off", "0", "false")
        or serial_concurrency_only
        or wide_concurrency_target_only
        or (profile is not None and profile["speculation"] == "none")
    )
    if not disable_spec and spec.get("mode") == "dflash":
        # `--dflash` cannot be combined with `--enable-prefix-caching`
        # (`serve_load.rs:963`); force prefix caching and SSM cache slots off.
        enable_prefix_cache = False
        ssm_cache_slots = 0

        def _dflash_explicit_override(*keys: str) -> bool:
            return any(
                k in os.environ
                or (custom_env and k in custom_env)
                or (user_recipe and k in user_recipe_env)
                for k in keys
            )

        def _set_dflash_default(
            suffix: str, value: str, *, force_over_base_recipe: bool = False
        ) -> None:
            atlas_k = f"ATLAS_{suffix}"
            flux_k = f"FLUX_{suffix}"
            if _dflash_explicit_override(atlas_k, flux_k):
                return
            if force_over_base_recipe or (atlas_k not in env_vars and flux_k not in env_vars):
                env_vars[atlas_k] = value
                env_vars[flux_k] = value

        _set_dflash_default("DFLASH_NOISE_GRAPH", "1")
        # DFlash2 defaults to exact GPU rejection sampling + calibrated draft
        # temperature scaling while native-mtp keeps `gumbel`. Respect explicit
        # user overrides (os.environ / custom_env / explicit --recipe).
        _set_dflash_default("SPEC_VERIFY", "rejection", force_over_base_recipe=True)
        _set_dflash_default("QWEN4_DFLASH_REJECT_TEMP_SCALE", "1.15")

        if kt == "qwen3.8-flash-next":
            # Certified Qwen3.8-Flash-Next DFlash2 (incoai-dflash2-b8) runtime
            # defaults at both C=1 and C=2..16; every lever yields to explicit
            # user env / --set / --recipe overrides.
            explicit_cli_dflash_quant = any(
                a == "--dflash-quantization" or a.startswith("--dflash-quantization=")
                for a in extra_args
            )
            if not explicit_cli_dflash_quant:
                _set_dflash_default("DFLASH_QUANTIZATION", "nvfp4")
            _set_dflash_default("DFLASH_NOISE_ONLY", "1")
            _set_dflash_default("DISABLE_TREE_WY", "1")
            _set_dflash_default("MEMLEAN_DRAFTER_BF16", "1")
            _set_dflash_default("THINK_SPEC", "1")
            _set_dflash_default("QWEN4_HYBRID_ALL_K", "1")
            if (
                env_vars.get("ATLAS_QWEN4_BOUNDED_TRANSPOSE_OWNERS") != "1"
                and (
                    (
                        world_size <= 2
                        and ep_size == 1
                        and pp_size == 1
                        and hw.get("unified_memory_architecture")
                    )
                    or (
                        is_discrete_vram_known
                        and (
                            kv_cache_dtype == "nvfp4"
                            or max_seq_len > 262144
                            or per_gpu_vram_gib <= 100.0
                        )
                    )
                )
            ):
                # Reclaim 3.37 GiB / ep_size via lossless Atlas-TS4E-128 on GB10 UMA
                # and discrete GPUs (1x and multi-GPU) alongside DFlash2.
                _set_dflash_default("MOE_SCALE_TS4E", "1", force_over_base_recipe=True)
            if concurrency >= 2:
                # Leave 2 GiB headroom above the 6,656 MiB UMA floor at C=2..4 and
                # 4.5 GiB at C>=8 for multi-stream DFlash capture/noise rings
                # (100 MiB/slot), batched verify CUDA graphs, and C=16 burst prefill
                # scratch, while C=1 keeps 1024 MiB so all 120/120 FP8 weights cache.
                fp8_margin = "4608" if concurrency >= 8 else "2048"
                _set_dflash_default(
                    "QWEN4_FP8_WEIGHT_CACHE_FLOOR_MARGIN_MIB",
                    fp8_margin,
                    force_over_base_recipe=True,
                )
                _set_dflash_default("SSM_DECODE_RING", "0", force_over_base_recipe=True)
                if is_discrete_vram_known and concurrency > 48:
                    # At C>48 under 256-row adaptive-K (K=4 / 3 drafts), disabling
                    # cumulative probability pruning avoids over-shortening already
                    # short K=4 frames (+168 tok/s at C=64 on 1x 96 GB SM120).
                    _set_dflash_default("QWEN4_DFLASH_PCUM_THRESH", "0", force_over_base_recipe=True)
            elif (
                concurrency == 1
                and not is_uma_hw
                and (
                    hw_sm_family == "blackwell-sm120a"
                    or topo in (
                        "sm120", "sm120a", "blackwell-sm120", "blackwell-sm120a",
                        "rtx5090", "rtx6000", "rtx-pro-6000", "rtx-pro-5000",
                    )
                )
            ):
                # On discrete SM120 at C=1, disabling cumulative probability pruning
                # eliminates Sync #3 and k<4 verify graph churn while keeping full
                # K=8 DFlash2 speculative width (GB10 UMA untouched).
                _set_dflash_default("QWEN4_DFLASH_PCUM_THRESH", "0", force_over_base_recipe=True)
        elif kt in ("qwen3.8-27b", "qwen3.6-27b", "qwen3.5-27b"):
            if concurrency >= 2:
                # Engage cross-sequence hoisted batched DFlash2 verify (`C=2..8`) automatically
                # unless the user explicitly overrides ATLAS_DFLASH_BATCHED_VERIFY / FLUX_DFLASH_BATCHED_VERIFY.
                _set_dflash_default("DFLASH_BATCHED_VERIFY", "1")
    if (
        not qsa_concurrency
        and requires_qsa
        and enable_prefix_cache
        and ssm_cache_slots > 0
        and "ATLAS_QWEN4_PREFILL_ATTN_CORE16" not in os.environ
        and "FLUX_QWEN4_PREFILL_ATTN_CORE16" not in os.environ
    ):
        # Route C1 Qwen4 prefix-cached prefill through `lookup_prefill_prefix`
        # instead of the uncached M16 fast-family bypass.
        for _attn_key in (
            "QWEN4_PREFILL_ATTN_CORE16",
            "QWEN4_PREFILL_ATTN_DEVICE16",
            "QWEN4_PREFILL_ATTN_HC16",
            "QWEN4_PREFILL_ATTN_CORE32",
        ):
            env_vars[f"ATLAS_{_attn_key}"] = "0"
            env_vars[f"FLUX_{_attn_key}"] = "0"
    if profile is not None and profile["speculation"] == "none" and draft_override not in ("", "none", "off", "0", "false"):
        raise ValueError(f"{profile['label']} serves target-only; unset FLUX_DRAFT_MODEL")
    if (
        profile is not None
        and not disable_spec
        and spec.get("mode", "none") != "none"
        and concurrency > int(profile.get("max_concurrency_speculative", 128))
    ):
        max_spec = int(profile.get("max_concurrency_speculative", 128))
        raise ValueError(
            f"{kt} speculation is qualified through C{max_spec}; set FLUX_CONCURRENCY<={max_spec}, "
            "or FLUX_SPEC_MODE=none for unqualified plain concurrency"
        )
    if qsa_concurrency:
        if not disable_spec and spec.get("mode") in ("native-mtp", "dflash"):
            env_vars.pop("FLUX_QWEN4_CONCURRENCY_TARGET_ONLY", None)
            env_vars.pop("ATLAS_QWEN4_CONCURRENCY_TARGET_ONLY", None)
            env_vars["ATLAS_QWEN4_BATCHED_K5"] = env_vars.get("ATLAS_QWEN4_BATCHED_K5", "1")
            env_vars["FLUX_QWEN4_BATCHED_K5"] = env_vars["ATLAS_QWEN4_BATCHED_K5"]
            env_vars["ATLAS_QWEN4_BATCHED_K5_GDN_MULTI"] = env_vars.get("ATLAS_QWEN4_BATCHED_K5_GDN_MULTI", "1")
            env_vars["FLUX_QWEN4_BATCHED_K5_GDN_MULTI"] = env_vars["ATLAS_QWEN4_BATCHED_K5_GDN_MULTI"]
            if spec.get("mode") == "dflash":
                env_vars["ATLAS_QWEN4_BATCHED_ADAPTIVE_K"] = env_vars.get("ATLAS_QWEN4_BATCHED_ADAPTIVE_K", "1")
                env_vars["FLUX_QWEN4_BATCHED_ADAPTIVE_K"] = env_vars["ATLAS_QWEN4_BATCHED_ADAPTIVE_K"]
                env_vars["ATLAS_QWEN4_HYBRID_ALL_K"] = env_vars.get("ATLAS_QWEN4_HYBRID_ALL_K", "1")
                env_vars["FLUX_QWEN4_HYBRID_ALL_K"] = env_vars["ATLAS_QWEN4_HYBRID_ALL_K"]
                env_vars["ATLAS_THINK_SPEC"] = env_vars.get("ATLAS_THINK_SPEC", "1")
                env_vars["FLUX_THINK_SPEC"] = env_vars["ATLAS_THINK_SPEC"]
            elif adaptive_k_effective or concurrency > 32:
                env_vars["ATLAS_QWEN4_BATCHED_ADAPTIVE_K"] = "1"
                env_vars["FLUX_QWEN4_BATCHED_ADAPTIVE_K"] = "1"
            env_vars["ATLAS_SCHED_BURST_GATHER_MS"] = env_vars.get("ATLAS_SCHED_BURST_GATHER_MS", "3")
            env_vars["FLUX_SCHED_BURST_GATHER_MS"] = env_vars["ATLAS_SCHED_BURST_GATHER_MS"]
            env_vars["ATLAS_QWEN4_QSA_VERIFY_STAGE_POOL_FUSED"] = env_vars.get("ATLAS_QWEN4_QSA_VERIFY_STAGE_POOL_FUSED", "1")
            env_vars["FLUX_QWEN4_QSA_VERIFY_STAGE_POOL_FUSED"] = env_vars["ATLAS_QWEN4_QSA_VERIFY_STAGE_POOL_FUSED"]
            # MTP_CONF, MTP_CONF_EARLY, MTP_CONF_CUM, MTP_ALLOW_ZERO, HISTORY_DRAFTS,
            # SPEC_CYCLE_V2, and SPEC_ADAPTIVE_DEPTH are gated per-cohort at runtime
            # (`b >= 2` in propose_chain_batch and `live_seqs == 1` in adaptive_depth.rs /
            # mtp_step.rs / verify_qwen4_batched_step.rs), so let solo c=1 paths keep full
            # parity on multi-concurrency servers while live>=2 cohorts stay protected.
            env_vars["ATLAS_QWEN4_MTP_VOCAB_PRUNE"] = "0"
            env_vars["FLUX_QWEN4_MTP_VOCAB_PRUNE"] = "0"
        else:
            if dflash_qsa_mode and concurrency > spec_concurrency_ceiling and wide_concurrency_target_only:
                print(
                    f"[flux] WARN: Batched DFlash2 supports C2-C{spec_concurrency_ceiling} only (FLUX_CONCURRENCY={concurrency}); "
                    "falling back to native target-only.",
                    file=sys.stderr,
                    flush=True,
                )
            env_vars["FLUX_QWEN4_CONCURRENCY_TARGET_ONLY"] = "1"
            for _k5_key in (
                "ATLAS_QWEN4_BATCHED_K5",
                "FLUX_QWEN4_BATCHED_K5",
                "ATLAS_QWEN4_BATCHED_K5_GDN_MULTI",
                "FLUX_QWEN4_BATCHED_K5_GDN_MULTI",
                "ATLAS_QWEN4_BATCHED_ADAPTIVE_K",
                "FLUX_QWEN4_BATCHED_ADAPTIVE_K",
                "ATLAS_QWEN4_HYBRID_ALL_K",
                "FLUX_QWEN4_HYBRID_ALL_K",
            ):
                env_vars.pop(_k5_key, None)

    if qsa_concurrency:
        # Same rule as qwen4_concurrency.rs: past native context only a shared
        # KV pool bounds the per-slot reservation.
        if max_seq_len > native_max_pos and kv_pool_tokens is None:
            raise ValueError(
                "Qwen4 concurrency is limited to the checkpoint's native context; "
                "extended YaRN remains C1 (set FLUX_KV_POOL_TOKENS for a shared pool)"
            )
        if kv_cache_dtype not in ("bf16", "nvfp4"):
            raise ValueError(
                "Qwen4 concurrency requires --kv-cache-dtype bf16 or nvfp4; "
                "remove FLUX_KV_CACHE_DTYPE or set it to bf16 or nvfp4"
            )
        if world_size > 4:
            raise ValueError(
                f"Qwen4 concurrency supports 1..=4 distributed ranks (got world_size={world_size}); "
                "use 2x Spark TP=2, 3x Spark PP=3, or 4x Spark PP=4"
            )
        # Native C2-C128 batching is the server default while
        # ATLAS_QWEN4_NATIVE_BATCH is unset; 0 is the explicit serial opt-out.
        # Same rule as spark_model::qwen4_batch_policy::admit_width.
        native_batch = env_vars.get("ATLAS_QWEN4_NATIVE_BATCH")
        if native_batch is not None and native_batch not in ("0", "1"):
            raise ValueError(
                "ATLAS_QWEN4_NATIVE_BATCH must be exactly 0 or 1, "
                "or unset for the native batching default"
            )
        if native_batch == "0" and env_vars.get("ATLAS_QWEN4_NATIVE_BATCH_QSA", "0") != "0":
            raise ValueError(
                "ATLAS_QWEN4_NATIVE_BATCH_QSA requires native batching; "
                "unset ATLAS_QWEN4_NATIVE_BATCH or ATLAS_QWEN4_NATIVE_BATCH_QSA"
            )
        if native_batch != "0" and concurrency > QWEN4_NATIVE_MAX_ROWS:
            raise ValueError(
                f"FLUX_CONCURRENCY={concurrency} exceeds the Qwen4 native batching ceiling "
                f"C{QWEN4_NATIVE_MAX_ROWS}; lower FLUX_CONCURRENCY or set ATLAS_QWEN4_NATIVE_BATCH=0"
            )
    # QSA rows keep their side index, which only --qwen4-qsa builds. Same rule
    # as spark_model::qwen4_batch_policy::resolve_plan (C2+; C1 never batches).
    if (
        concurrency > 1
        and env_vars.get("ATLAS_QWEN4_NATIVE_BATCH_QSA", "0") == "1"
        and not (requires_qsa or "--qwen4-qsa" in extra_args)
    ):
        raise ValueError(
            "ATLAS_QWEN4_NATIVE_BATCH_QSA=1 requires the QSA side index (--qwen4-qsa); "
            "this checkpoint does not enable it, so unset ATLAS_QWEN4_NATIVE_BATCH_QSA"
        )

    gamma_raw = str(env_vars.get("FLUX_GAMMA") or os.environ.get("FLUX_GAMMA") or "").strip()
    gamma_override = int(gamma_raw) if gamma_raw.isdigit() and int(gamma_raw) > 0 else None

    if disable_spec:
        model_info = dict(model_info)
        model_info["speculative"] = {"mode": "none", "drafter_path": None, "gamma": 0, "native_mtp_k": 0}
        spec = model_info["speculative"]
        for _k5_key in (
            "ATLAS_QWEN4_BATCHED_K5",
            "FLUX_QWEN4_BATCHED_K5",
            "ATLAS_QWEN4_BATCHED_K5_GDN_MULTI",
            "FLUX_QWEN4_BATCHED_K5_GDN_MULTI",
            "ATLAS_QWEN4_BATCHED_ADAPTIVE_K",
            "FLUX_QWEN4_BATCHED_ADAPTIVE_K",
            "ATLAS_QWEN4_HYBRID_ALL_K",
            "FLUX_QWEN4_HYBRID_ALL_K",
        ):
            env_vars.pop(_k5_key, None)

    thinking_raw = str(env_vars.get("FLUX_THINKING") or os.environ.get("FLUX_THINKING") or "").strip().lower()
    thinking_budget_raw = public_selector("FLUX_THINKING_BUDGET").strip()
    if not thinking_budget_raw and profile is not None and profile.get("thinking_budget"):
        thinking_budget_raw = str(profile["thinking_budget"])
    if thinking_budget_raw and not thinking_budget_raw.isdigit():
        raise ValueError("FLUX_THINKING_BUDGET must be a non-negative integer")
    cpu_affinity_raw = str(env_vars.get("FLUX_CPU_AFFINITY") or os.environ.get("FLUX_CPU_AFFINITY") or "").strip()
    cpu_affinity = _parse_cpu_affinity(cpu_affinity_raw) if cpu_affinity_raw else []

    if model_info.get("ple_dir"):
        try:
            import resource
            soft_ml, hard_ml = resource.getrlimit(resource.RLIMIT_MEMLOCK)
            if soft_ml != resource.RLIM_INFINITY and hard_ml == resource.RLIM_INFINITY:
                try:
                    resource.setrlimit(resource.RLIMIT_MEMLOCK, (resource.RLIM_INFINITY, resource.RLIM_INFINITY))
                    soft_ml = resource.RLIM_INFINITY
                except Exception:
                    pass
            if soft_ml != resource.RLIM_INFINITY and 0 <= soft_ml < 67108864:
                # After recipe/user synchronization: set both spellings (the server reads ATLAS_).
                env_vars["ATLAS_QWEN4_PLE_IO_QUEUE_DEPTH"] = "32"
                env_vars["FLUX_QWEN4_PLE_IO_QUEUE_DEPTH"] = "32"
        except Exception:
            pass
        env_vars["ATLAS_PLE_READ_RINGS"] = env_vars.get("ATLAS_PLE_READ_RINGS", "4")
        env_vars["FLUX_PLE_READ_RINGS"] = env_vars["ATLAS_PLE_READ_RINGS"]
        if ple_ram_plan is not None:
            stage_dir = str(ple_ram_plan["stage_dir"])
            env_vars["ATLAS_PLE_OFFLOAD_DIR"] = stage_dir
            env_vars["FLUX_PLE_OFFLOAD_DIR"] = stage_dir
            if not any(
                k in os.environ or (custom_env and k in custom_env)
                for k in ("ATLAS_PLE_PAGE_CACHE", "FLUX_PLE_PAGE_CACHE")
            ):
                env_vars["ATLAS_PLE_PAGE_CACHE"] = "1"
                env_vars["FLUX_PLE_PAGE_CACHE"] = "1"
            if not any(
                k in os.environ or (custom_env and k in custom_env)
                for k in ("ATLAS_PLE_PARKED_CACHE_MB", "FLUX_PLE_PARKED_CACHE_MB")
            ):
                env_vars["ATLAS_PLE_PARKED_CACHE_MB"] = "0"
                env_vars["FLUX_PLE_PARKED_CACHE_MB"] = "0"
            if not is_discrete_vram_known and not any(
                k in os.environ or (custom_env and k in custom_env)
                for k in (
                    "ATLAS_QWEN4_PREFILL_FAST_PROJ_FP8_WEIGHT_CACHE",
                    "FLUX_QWEN4_PREFILL_FAST_PROJ_FP8_WEIGHT_CACHE",
                )
            ):
                env_vars["ATLAS_QWEN4_PREFILL_FAST_PROJ_FP8_WEIGHT_CACHE"] = "0"
                env_vars["FLUX_QWEN4_PREFILL_FAST_PROJ_FP8_WEIGHT_CACHE"] = "0"
        # When running inside a managed container runtime that blocks io_uring
        # (e.g. Docker default seccomp / managed cloud GPU hosts / K8s) on a clean 128 GiB
        # host with ample UMA headroom, enable PageCache parallel planned pread
        # and a 2048 MiB (16.7M-slot) lock-free parked cache to absorb loopback
        # storage random-IOPS ceilings without risking OOM (clean OS page cache
        # stays reclaimable in MemAvailable).
        elif profile is None:
            io_uring_ok, _ = _check_io_uring_support()
            mem_avail_gib = float(hw.get("mem_available_gib") or 0.0)
            if not io_uring_ok and mem_avail_gib >= 104.0:
                if "ATLAS_PLE_PAGE_CACHE" not in env_vars and "FLUX_PLE_PAGE_CACHE" not in env_vars and "ATLAS_PLE_PAGE_CACHE" not in os.environ and "FLUX_PLE_PAGE_CACHE" not in os.environ:
                    env_vars["ATLAS_PLE_PAGE_CACHE"] = "1"
                    env_vars["FLUX_PLE_PAGE_CACHE"] = "1"
                if "ATLAS_PLE_PARKED_CACHE_MB" not in env_vars and "FLUX_PLE_PARKED_CACHE_MB" not in env_vars and "ATLAS_PLE_PARKED_CACHE_MB" not in os.environ and "FLUX_PLE_PARKED_CACHE_MB" not in os.environ:
                    env_vars["ATLAS_PLE_PARKED_CACHE_MB"] = "2048"
                    env_vars["FLUX_PLE_PARKED_CACHE_MB"] = "2048"

    # Binary-aware CLI flag emission (prevents passing flags unsupported by older/specialized binaries)
    supports_no_tui = bin_name in ("flux-server-real", "flux-server", "flux-server-universal")
    supports_simhash = bin_name in ("flux-server-real", "flux-server", "flux-server-qwen38-27b")
    supports_rope_flags = bin_name in ("flux-server-real", "flux-server")
    supports_mtp_from_path = bin_name in ("flux-server-real", "flux-server")
    if profile is not None and bin_name in RELEASE_CLI_BINARIES:
        supports_no_tui = supports_simhash = supports_rope_flags = supports_mtp_from_path = True

    cmd = [bin_path, "serve"]
    interactive_tui_allowed = (
        profile is None
        and sys.stdout.isatty()
        and sys.stdin.isatty()
        and os.environ.get("FLUX_NO_TUI", "0") != "1"
        and os.environ.get("ATLAS_NO_TUI", "0") != "1"
        and "--no-tui" not in extra_args
        and os.environ.get("TERM", "dumb") != "dumb"
    )
    if supports_no_tui and not interactive_tui_allowed:
        cmd.append("--no-tui")
    oom_guard_mb = (
        "1024"
        if (ple_ram_plan is not None or (is_discrete_vram_known and per_gpu_vram_gib <= 24.0))
        else ("2048" if (is_discrete_vram_known and per_gpu_vram_gib <= 48.0) else "4096")
    )
    cmd.extend([
        "--bind", str(host),
        "--port", str(port),
        "--model-from-path", model_info["path"],
        "--model-name", os.environ.get("FLUX_MODEL_NAME", model_info["name"]),
        "--kernel-target", kt,
        "--gpu-memory-utilization", str(gpu_mem_util),
        "--kv-cache-dtype", kv_cache_dtype,
        "--block-size", "16",
        "--max-seq-len", str(max_seq_len),
        "--max-prefill-tokens", str(max_prefill_tokens),
        "--max-batch-size", str(concurrency),
        "--max-num-seqs", str(concurrency),
        "--ssm-cache-slots", str(ssm_cache_slots),
        "--oom-guard-mb", oom_guard_mb,
        "--request-timeout", str(request_timeout),
    ])
    if (
        discrete_high_kv_96gb
        and "--speculative-cuda-headroom-mb" not in extra_args
        and not any(a.startswith("--speculative-cuda-headroom-mb=") for a in extra_args)
    ):
        cmd.extend(["--speculative-cuda-headroom-mb", "2048"])
    if qsa_concurrency:
        cmd.extend(["--swap-space-gb", "0"])
    if kv_pool_tokens is not None and "--kv-pool-tokens" not in extra_args:
        cmd.extend(["--kv-pool-tokens", str(kv_pool_tokens)])
    if queue_depth is not None and "--max-queue-depth" not in extra_args:
        cmd.extend(["--max-queue-depth", str(queue_depth)])
    if supports_simhash:
        cmd.append("--disable-simhash-watchdog")
    cmd.extend([
        "--enable-prefix-caching", "true" if enable_prefix_cache else "false",
        "--tool-call-parser", tool_call_parser,
        "--tool-max-tokens", str(tool_max_tokens),
    ])
    if default_max_tokens and "--default-max-tokens" not in extra_args:
        cmd.extend(["--default-max-tokens", str(default_max_tokens)])
    if (
        (kv_cache_dtype in ("fp8", "nvfp4") or (not requires_qsa and max_seq_len >= 262144))
        and "--kv-high-precision-layers" not in extra_args
    ):
        cmd.extend(["--kv-high-precision-layers", kv_hp_layers_for_budget])
    if supports_rope_flags and rope_yarn_factor and "--rope-yarn-factor" not in extra_args:
        cmd.extend(["--rope-yarn-factor", str(rope_yarn_factor)])
    if supports_rope_flags and rope_theta_override and "--rope-theta-override" not in extra_args:
        cmd.extend(["--rope-theta-override", str(rope_theta_override)])
    if supports_rope_flags:
        if thinking_raw in ("off", "0", "false", "no", "disable", "disabled"):
            if "--disable-thinking" not in extra_args:
                cmd.append("--disable-thinking")
            if "--default-chat-template-kwargs" not in extra_args:
                cmd.extend(["--default-chat-template-kwargs", '{"enable_thinking":false}'])
        elif thinking_raw in ("on", "1", "true", "yes", "enable", "enabled"):
            if "--default-chat-template-kwargs" not in extra_args:
                cmd.extend(["--default-chat-template-kwargs", '{"enable_thinking":true}'])
        if thinking_budget_raw and thinking_budget_raw.isdigit() and "--max-thinking-budget" not in extra_args:
            cmd.extend(["--max-thinking-budget", thinking_budget_raw])
    if world_size > 1 and "--world-size" not in extra_args:
        cmd.extend(["--world-size", str(world_size), "--tp-size", str(tp_size), "--ep-size", str(ep_size)])
        if pp_size > 1 and "--pp-size" not in extra_args:
            cmd.extend(["--pp-size", str(pp_size)])
        if "--rank" not in extra_args and (
            node_rank > 0
            or single_host_multi_gpu
            or "FLUX_NODE_RANK" in os.environ
            or "FLUX_NODE_RANK" in env_vars
        ):
            cmd.extend(["--rank", str(node_rank)])
        if gpu_ordinal is not None and "--gpu-ordinal" not in extra_args:
            cmd.extend(["--gpu-ordinal", str(gpu_ordinal)])
        if master_addr and "--master-addr" not in extra_args:
            cmd.extend(["--master-addr", master_addr])
        if master_port and "--master-port" not in extra_args:
            cmd.extend(["--master-port", master_port])
    elif gpu_ordinal is not None and "--gpu-ordinal" not in extra_args:
        cmd.extend(["--gpu-ordinal", str(gpu_ordinal)])
    if requires_qsa and "--qwen4-qsa" not in extra_args:
        cmd.append("--qwen4-qsa")
    if not disable_spec:
        if spec.get("mode") == "dflash" and spec.get("drafter_path"):
            eff_gamma = gamma_override if gamma_override is not None else int(spec.get("gamma", 15))
            if qsa_concurrency and gamma_override is None and eff_gamma > 7:
                eff_gamma = 7
            spec["gamma"] = eff_gamma
            spec["ddtree_max_nodes"] = eff_gamma + 1
            env_vars["ATLAS_DFLASH_DRAFT_CAP"] = str(eff_gamma)
            env_vars["ATLAS_DDTREE_MAX_NODES"] = str(eff_gamma + 1)
            cmd.extend([
                "--dflash",
                "--draft-model", str(spec["drafter_path"]),
                "--dflash-gamma", str(eff_gamma),
            ])
            if (
                qsa_concurrency
                and is_discrete_vram_known
                and per_gpu_vram_gib <= 112.0
                and concurrency > 16
                and "--dflash-window-size" not in extra_args
                and not _dflash_explicit_override("ATLAS_DFLASH_CTX_WINDOW", "FLUX_DFLASH_CTX_WINDOW")
            ):
                # Keep DFlash2 proposer KV + context ring inside discrete 96 GB VRAM headroom:
                # 4096 window costs 200 MiB/seq (12.8 GiB at C=64); 1024 costs 50 MiB/seq
                # (2.4 GiB at C=48), 256 costs 12.5 MiB/seq (0.8 GiB at C=64) — lossless verify.
                auto_dflash_win = 256 if concurrency > 48 else (1024 if concurrency > 32 else 2048)
                cmd.extend(["--dflash-window-size", str(auto_dflash_win)])
            if profile is not None:
                cmd.extend(profile.get("dflash_flags", []))
        elif spec.get("mode") == "native-mtp":
            if spec.get("drafter_path") and not supports_mtp_from_path:
                pass
            else:
                num_drafts = gamma_override if gamma_override is not None else int(spec.get("num_drafts", 6))
                if (
                    qsa_concurrency
                    and gamma_override is None
                    and (
                        str(env_vars.get("ATLAS_QWEN4_BATCHED_K5", "0")).strip() == "1"
                        or str(env_vars.get("ATLAS_QWEN4_K5_CMULTI", "0")).strip() == "1"
                    )
                ):
                    batched_adaptive_on = (
                        str(env_vars.get("ATLAS_QWEN4_BATCHED_ADAPTIVE_K", "0")).strip() == "1"
                    )
                    serial_k5_on = (
                        str(env_vars.get("ATLAS_QWEN4_K5_CMULTI", "0")).strip() == "1"
                    )
                    # Batched adaptive-K admits K=2..=8 (up to 128 rows/frame:
                    # 16x7=112 <= 128), so C<=16 keeps K=7 (--num-drafts 6) for
                    # solo c=1 parity and wider high-acceptance cohorts; C>16,
                    # fixed-K5 (adaptive-K off), and serial K5 cap to 4 (K=5).
                    max_default_drafts = (
                        6
                        if (batched_adaptive_on and not serial_k5_on and concurrency <= 16)
                        else 4
                    )
                    if num_drafts > max_default_drafts:
                        num_drafts = max_default_drafts
                spec["gamma"] = num_drafts
                spec["num_drafts"] = num_drafts
                spec["native_mtp_k"] = num_drafts + 1
                mtp_vocab_default = (
                    "96000"
                    if requires_qsa or str(env_vars.get("ATLAS_QWEN4_MTP_VOCAB_PRUNE", "0")) == "1"
                    else "0"
                )
                mtp_vocab_val = str(
                    env_vars.get("FLUX_MTP_VOCAB")
                    or os.environ.get("FLUX_MTP_VOCAB")
                    or mtp_vocab_default
                )
                cmd.extend([
                    "--speculative",
                    "--num-drafts", str(num_drafts),
                    "--mtp-vocab", mtp_vocab_val,
                    "--mtp-quantization", "bf16",
                ])
                if spec.get("drafter_path") and supports_mtp_from_path:
                    cmd.extend(["--mtp-from-path", str(spec["drafter_path"])])

    if profile is not None:
        cmd.extend(f for f in profile.get("flags", []) if f not in cmd)

    dflash_lookup = _apply_dflash_lookup(
        env_vars,
        not disable_spec and spec.get("mode") == "dflash" and bool(spec.get("drafter_path")),
        launch_warnings,
        custom_env,
    )

    # Merge extra_args so any user-supplied `--flag val` or `--flag=val` overrides defaults in `cmd`
    bool_flags = SERVER_BOOL_FLAGS
    ei = 0
    while ei < len(extra_args):
        arg = extra_args[ei]
        if arg.startswith("--"):
            if "=" in arg:
                flag_name, flag_val = arg.split("=", 1)
                if flag_name in cmd:
                    idx = cmd.index(flag_name)
                    if idx + 1 < len(cmd) and not cmd[idx + 1].startswith("-"):
                        cmd[idx + 1] = flag_val
                    else:
                        cmd[idx] = arg
                else:
                    cmd.append(arg)
                ei += 1
            elif _passthrough_arity(extra_args, ei) == 1:
                if arg in cmd:
                    idx = cmd.index(arg)
                    if (
                        arg in bool_flags
                        and idx + 1 < len(cmd)
                        and cmd[idx + 1].lower() in _BOOL_LITERALS
                    ):
                        cmd[idx + 1] = "true"
                else:
                    cmd.append(arg)
                ei += 1
            else:
                flag_val = extra_args[ei + 1]
                if arg in cmd:
                    idx = cmd.index(arg)
                    has_value_slot = idx + 1 < len(cmd) and not cmd[idx + 1].startswith("--")
                    if has_value_slot:
                        cmd[idx + 1] = flag_val
                    elif arg in bool_flags and flag_val.lower() in _BOOL_LITERALS:
                        # bare switch already emitted: `--flag false` removes it, `--flag true` keeps it
                        if flag_val.lower() == "false":
                            del cmd[idx]
                    else:
                        cmd.insert(idx + 1, flag_val)
                elif arg in bool_flags and flag_val.lower() in _BOOL_LITERALS:
                    if flag_val.lower() == "true" or arg == "--enable-prefix-caching":
                        cmd.extend([arg, flag_val] if arg == "--enable-prefix-caching" else [arg])
                else:
                    cmd.extend([arg, flag_val])
                ei += 2
        else:
            cmd.append(arg)
            ei += 1

    # Validate the merged argv so equals syntax and repeated overrides cannot
    # bypass the model's one-call-prefill requirement.
    if profile is not None and not profile.get("prefix_cache_supported", True):
        for i, arg in enumerate(cmd):
            if arg == "--enable-prefix-caching":
                value = cmd[i + 1] if i + 1 < len(cmd) and not cmd[i + 1].startswith("--") else "true"
            elif arg.startswith("--enable-prefix-caching="):
                value = arg.split("=", 1)[1]
            else:
                continue
            if value.lower() in ("1", "true", "yes"):
                raise ValueError(f"{profile['label']} cannot serve with prefix caching: nonzero-start prefill is unsupported")

    def explicit_cli_value(flag: str) -> Optional[str]:
        """Return the last explicit extra-argument value for a CLI flag."""
        value: Optional[str] = None
        i = 0
        while i < len(extra_args):
            arg = extra_args[i]
            if arg.startswith(flag + "="):
                value = arg.split("=", 1)[1]
                i += 1
            elif arg == flag and i + 1 < len(extra_args):
                value = extra_args[i + 1]
                i += 2
            else:
                i += 1
        return value

    explicit_cli_budget = explicit_cli_value("--max-thinking-budget")
    if explicit_cli_budget is not None:
        if not explicit_cli_budget.isdigit():
            raise ValueError("--max-thinking-budget must be a non-negative integer")
        effective_thinking_budget: Optional[int] = int(explicit_cli_budget)
        thinking_budget_source = "cli"
    elif thinking_budget_raw:
        effective_thinking_budget = int(thinking_budget_raw)
        thinking_budget_source = (
            "environment"
            if (custom_env and "FLUX_THINKING_BUDGET" in custom_env)
            or "FLUX_THINKING_BUDGET" in os.environ
            else "recipe"
        )
    else:
        profile_budget = model_info.get(
            "max_thinking_budget", MODEL_PROFILE_THINKING_BUDGETS.get(kt)
        )
        effective_thinking_budget = int(profile_budget) if profile_budget is not None else None
        thinking_budget_source = "model_profile" if profile_budget is not None else "unspecified"

    mode_summary = recipe["summary"]
    native_mtp_k = spec.get("native_mtp_k")
    if spec.get("mode") == "native-mtp" and isinstance(native_mtp_k, int) and native_mtp_k > 0:
        mode_summary = mode_summary.replace("K=5", f"K={native_mtp_k}")
    if profile is not None:
        # The FLUX_MODE catalog describes Flash-Next; a profile model runs its own recipe.
        mode_summary = profile_mode_summary(profile, not disable_spec and spec.get("mode", "none") != "none")

    multi_gpu_launch: Optional[Dict[str, Any]] = None
    if single_host_multi_gpu and world_size >= 2:
        multi_gpu_launch = build_single_host_multigpu_launch(
            cmd,
            hw,
            world_size=world_size,
            tp_size=tp_size,
            ep_size=ep_size,
            pp_size=pp_size,
            master_addr=master_addr or "127.0.0.1",
            master_port=master_port or "29500",
            nccl_env=intranode_nccl_env or None,
            nccl_transport=nccl_transport,
            port=int(port),
        )

    plan = {
        "mode": mode_key,
        "mode_summary": mode_summary,
        "recipe_file": recipe_file_loaded,
        "binary": bin_path,
        "kernel_target": kt,
        "hardware_topology": hw,
        "container_image": recommended_container_image(hw),
        "host": host,
        "port": int(port),
        "concurrency": concurrency,
        "max_seq_len": max_seq_len,
        "max_prefill_tokens": max_prefill_tokens,
        "request_timeout": request_timeout,
        "kv_cache_dtype": kv_cache_dtype,
        "gpu_memory_utilization": float(gpu_mem_util) if gpu_mem_util.replace(".", "", 1).isdigit() else gpu_mem_util,
        "speculative_enabled": not disable_spec and spec.get("mode", "none") != "none",
        "dflash_lookup": dflash_lookup,
        "ple_ram_stage": ple_ram_plan,
        "prefix_caching": enable_prefix_cache,
        "ssm_cache_slots": ssm_cache_slots,
        "tool_call_parser": tool_call_parser,
        "tool_max_tokens": tool_max_tokens,
        "default_max_tokens": default_max_tokens,
        "default_max_tokens_source": default_max_tokens_source,
        "thinking_budget": effective_thinking_budget,
        "thinking_budget_source": thinking_budget_source,
        "rope_yarn_factor": rope_yarn_factor,
        "rope_theta_override": rope_theta_override,
        "world_size": world_size,
        "tp_size": tp_size,
        "ep_size": ep_size,
        "pp_size": pp_size,
        "cpu_affinity": cpu_affinity,
        "env": env_vars,
        "command": cmd,
    }
    if gpu_ordinal is not None:
        plan["gpu_ordinal"] = gpu_ordinal
    if vram_budget is not None:
        plan["vram_budget"] = vram_budget
    if multi_gpu_launch is not None:
        plan["multi_gpu_launch"] = multi_gpu_launch
    if profile is not None:
        plan["launch_warnings"] = launch_warnings
        for warning in launch_warnings:
            print(f"[flux] WARN: {warning}", file=sys.stderr, flush=True)
    elif launch_warnings and ("ATLAS_DFLASH_LOOKUP" in env_vars or vram_budget is not None):
        if vram_budget is not None:
            plan["launch_warnings"] = launch_warnings
        # Flash-Next has no profile warning list; still say why the selector is inert.
        for warning in launch_warnings:
            print(f"[flux] WARN: {warning}", file=sys.stderr, flush=True)
    return plan


PLE_RAM_STAGE_DEFAULT_SEQ_LEN = 131056
PLE_RAM_STAGE_DEFAULT_DIR = "/dev/shm/flux-ple-offload"
_PLE_RAM_STAGE_ON = ("1", "true", "on", "yes")
_PLE_RAM_STAGE_OFF = ("", "0", "false", "off", "no")


def _parse_ple_ram_stage_flag(raw: Optional[str]) -> bool:
    val = (raw or "").strip().lower()
    if val in _PLE_RAM_STAGE_ON:
        return True
    if val in _PLE_RAM_STAGE_OFF:
        return False
    raise ValueError(
        f"FLUX_PLE_RAM_STAGE={raw!r} must be one of 0|1|false|true|off|on"
    )


def _ple_manifest_shard_files(source_dir: Path) -> List[Tuple[str, int]]:
    """Return sorted `(rel_path, size_bytes)` for all PLE shards referenced by manifest.json."""
    manifest_path = source_dir / "manifest.json"
    entries: List[str] = []
    if _safe_is_file(manifest_path):
        try:
            doc = json.loads(manifest_path.read_text(encoding="utf-8"))
            raw_entries = doc.get("entries") if isinstance(doc, dict) else None
            if isinstance(raw_entries, list):
                seen = set()
                for item in raw_entries:
                    if not isinstance(item, dict) or not item.get("file"):
                        continue
                    rel = str(item["file"]).strip()
                    rel_path = Path(rel)
                    if rel_path.is_absolute() or ".." in rel_path.parts:
                        raise ValueError(f"Unsafe shard path in PLE manifest: {rel!r}")
                    if rel not in seen:
                        seen.add(rel)
                        entries.append(rel)
        except ValueError:
            raise
        except Exception:
            entries = []
    if not entries and _safe_is_dir(source_dir):
        try:
            entries = sorted(
                p.name
                for p in source_dir.iterdir()
                if p.is_file() and p.name != "manifest.json" and not p.name.endswith(".tmp")
            )
        except OSError:
            entries = []
    files: List[Tuple[str, int]] = []
    for rel in entries:
        src = source_dir / rel
        size = src.stat().st_size if _safe_is_file(src) else 0
        files.append((rel, size))
    return files


def _plan_ple_ram_stage(source_dir: Path, base_dir: Path) -> Dict[str, Any]:
    import hashlib

    manifest_path = source_dir / "manifest.json"
    hasher = hashlib.sha256()
    if _safe_is_file(manifest_path):
        try:
            hasher.update(manifest_path.read_bytes())
        except OSError:
            hasher.update(str(source_dir).encode("utf-8"))
    else:
        hasher.update(str(source_dir).encode("utf-8"))
    key = hasher.hexdigest()[:16]
    stage_dir = base_dir / key
    shard_files = _ple_manifest_shard_files(source_dir)
    manifest_bytes = manifest_path.stat().st_size if _safe_is_file(manifest_path) else 0
    total_bytes = manifest_bytes + sum(size for _, size in shard_files)
    return {
        "enabled": True,
        "source_dir": str(source_dir),
        "stage_dir": str(stage_dir),
        "shard_count": len(shard_files),
        "source_bytes": total_bytes,
    }


def _stage_ple_to_ram(source_dir: Path, stage_dir: Path) -> Tuple[bool, int, int, float]:
    """Idempotently copy PLE offload shards + manifest.json into RAM-backed tmpfs.

    Returns `(reused, shard_count, total_bytes, elapsed_seconds)`.
    Never mutates `source_dir` (safe for read-only `/models:ro` mounts).
    """
    t0 = time.monotonic()
    manifest_src = source_dir / "manifest.json"
    if not _safe_is_file(manifest_src):
        raise ValueError(f"PLE manifest not found: {manifest_src}")
    manifest_bytes = manifest_src.read_bytes()
    shard_files = _ple_manifest_shard_files(source_dir)
    for rel, _ in shard_files:
        if not _safe_is_file(source_dir / rel):
            raise ValueError(f"PLE shard listed in manifest is missing: {source_dir / rel}")
    total_bytes = len(manifest_bytes) + sum(size for _, size in shard_files)

    try:
        if source_dir.resolve() == stage_dir.resolve():
            return True, len(shard_files), total_bytes, time.monotonic() - t0
    except OSError:
        pass

    manifest_dst = stage_dir / "manifest.json"
    all_match = (
        _safe_is_file(manifest_dst)
        and manifest_dst.read_bytes() == manifest_bytes
        and all(
            _safe_is_file(stage_dir / rel) and (stage_dir / rel).stat().st_size == size
            for rel, size in shard_files
        )
    )
    if all_match:
        return True, len(shard_files), total_bytes, time.monotonic() - t0

    stage_dir.mkdir(parents=True, exist_ok=True)
    missing_bytes = 0
    to_copy: List[Tuple[str, int]] = []
    for rel, size in shard_files:
        dst = stage_dir / rel
        if _safe_is_file(dst) and dst.stat().st_size == size:
            continue
        to_copy.append((rel, size))
        missing_bytes += size
    if not (_safe_is_file(manifest_dst) and manifest_dst.read_bytes() == manifest_bytes):
        missing_bytes += len(manifest_bytes)

    free_bytes = shutil.disk_usage(stage_dir).free
    headroom_bytes = 256 * 1024 * 1024
    if free_bytes < missing_bytes + headroom_bytes:
        need_gib = (missing_bytes + headroom_bytes) / (1024.0 ** 3)
        free_gib = free_bytes / (1024.0 ** 3)
        raise ValueError(
            f"Insufficient space in {stage_dir.parent} for --ple-ram: need {need_gib:.1f} GiB, "
            f"only {free_gib:.1f} GiB free. Pass '--shm-size=32g' to 'docker run' "
            "(or set FLUX_PLE_RAM_DIR to a larger tmpfs mount)."
        )

    copy_buf = 8 * 1024 * 1024
    for rel, _ in to_copy:
        src = source_dir / rel
        dst = stage_dir / rel
        dst.parent.mkdir(parents=True, exist_ok=True)
        tmp = dst.with_name(dst.name + ".tmp")
        try:
            with open(src, "rb") as rf, open(tmp, "wb") as wf:
                shutil.copyfileobj(rf, wf, length=copy_buf)
            os.replace(tmp, dst)
        except BaseException:
            try:
                tmp.unlink(missing_ok=True)
            except OSError:
                pass
            raise

    manifest_tmp = manifest_dst.with_name("manifest.json.tmp")
    try:
        manifest_tmp.write_bytes(manifest_bytes)
        os.replace(manifest_tmp, manifest_dst)
    except BaseException:
        try:
            manifest_tmp.unlink(missing_ok=True)
        except OSError:
            pass
        raise

    return False, len(shard_files), total_bytes, time.monotonic() - t0


def _check_io_uring_support() -> Tuple[bool, str]:
    try:
        import ctypes
        import errno

        libc = ctypes.CDLL(None, use_errno=True)
        libc.syscall.restype = ctypes.c_long
        params = (ctypes.c_ubyte * 120)()
        fd = libc.syscall(ctypes.c_long(425), ctypes.c_uint(1), ctypes.byref(params))
        if fd >= 0:
            try:
                os.close(int(fd))
            except OSError:
                pass
            return True, "ok"
        err = ctypes.get_errno()
        err_name = errno.errorcode.get(err, str(err))
        return False, f"{err_name} (os error {err})"
    except Exception as e:
        return True, f"unknown ({e})"


def collect_diagnostics(opts: Dict[str, bool], endpoint: Optional[str] = None) -> Dict[str, Any]:
    real_driver_libs = _sanitize_cuda_ld_library_path()
    # 1. Check libcuda.so.1 resolution via ldd on primary binary
    ldd_info: Dict[str, Any] = {
        "status": "unknown",
        "driver_ok": False,
        "libcuda_resolved": False,
        "using_compat_stub": False,
        "real_driver_libs": real_driver_libs,
    }
    try:
        out = subprocess.check_output(["ldd", BINARIES["primary"]], text=True, stderr=subprocess.STDOUT)
        for line in out.splitlines():
            if "libcuda.so.1" in line:
                ldd_info["libcuda_line"] = line.strip()
                ldd_info["libcuda_resolved"] = "not found" not in line
                ldd_info["using_compat_stub"] = "/compat/" in line
        ldd_info["status"] = "ok" if ldd_info["libcuda_resolved"] else "missing_libcuda"
        ldd_info["driver_ok"] = bool(ldd_info["libcuda_resolved"] and (not ldd_info["using_compat_stub"] or bool(real_driver_libs)))
    except Exception as e:
        ldd_info["status"] = f"error: {e}"

    # 2. Check GPU via nvidia-smi if available
    gpu_info: Dict[str, Any] = {"available": False, "gpus": []}
    if shutil.which("nvidia-smi"):
        try:
            smi = subprocess.check_output(
                ["nvidia-smi", "--query-gpu=name,memory.total,memory.free,driver_version", "--format=csv,noheader"],
                text=True,
                stderr=subprocess.DEVNULL,
                timeout=5,
            ).strip()
            if smi:
                gpu_info["available"] = True
                for row in smi.splitlines():
                    parts = [p.strip() for p in row.split(",")]
                    gpu_info["gpus"].append({
                        "name": "REDACTED-GPU" if opts.get("host") else (parts[0] if len(parts) > 0 else "GPU"),
                        "memory_total": parts[1] if len(parts) > 1 else "",
                        "memory_free": parts[2] if len(parts) > 2 else "",
                        "driver_version": "REDACTED" if opts.get("host") else (parts[3] if len(parts) > 3 else ""),
                    })
        except Exception:
            pass

    # 3. Check system memory, /dev/shm & io_uring availability
    mem_info: Dict[str, Any] = {}
    mem_total_mb = 0
    mem_avail_mb = 0
    try:
        with open("/proc/meminfo", "r", encoding="utf-8") as f:
            for line in f:
                if line.startswith(("MemTotal:", "MemAvailable:", "SwapTotal:")):
                    k, v = line.split(":", 1)
                    mem_info[k.strip()] = v.strip()
                    kb_str = v.strip().split()[0]
                    if kb_str.isdigit():
                        if k.strip() == "MemTotal":
                            mem_total_mb = int(kb_str) // 1024
                        elif k.strip() == "MemAvailable":
                            mem_avail_mb = int(kb_str) // 1024
    except Exception:
        pass
    mem_summary = {
        "mem_total_mb": mem_total_mb,
        "mem_available_mb": mem_avail_mb,
        **mem_info,
    }
    shm_stat = shutil.disk_usage("/dev/shm") if Path("/dev/shm").exists() else None
    shm_mb = int(shm_stat.total // (1024 * 1024)) if shm_stat else 0
    io_uring_ok, io_uring_status = _check_io_uring_support()

    # 4. Scan models & detect hardware topology
    hw_topo = detect_hardware_topology()
    hw_diag = dict(hw_topo)
    if opts.get("host") and "gpu_names" in hw_diag:
        hw_diag["gpu_names"] = ["REDACTED-GPU"] * len(hw_diag["gpu_names"])
    models = scan_models_root()
    selected = select_best_model(models)
    plan: Optional[Dict[str, Any]] = None
    plan_error: Optional[str] = None
    if selected:
        try:
            plan = build_launch_plan(selected, os.environ.get("FLUX_MODE", "auto"), [])
            if opts.get("host") and isinstance(plan.get("hardware_topology"), dict) and "gpu_names" in plan["hardware_topology"]:
                plan = dict(plan)
                plan_hw = dict(plan["hardware_topology"])
                plan_hw["gpu_names"] = ["REDACTED-GPU"] * len(plan_hw["gpu_names"])
                plan["hardware_topology"] = plan_hw
        except ValueError as err:
            plan_error = str(err)

    # 5. Live endpoint probe if requested or running locally
    probe_url = endpoint or f"http://127.0.0.1:{os.environ.get('FLUX_PORT', '8899')}"
    endpoint_status: Dict[str, Any] = {"url": probe_url, "reachable": False}
    try:
        with urllib.request.urlopen(f"{probe_url.rstrip('/')}/health", timeout=2.0) as resp:
            endpoint_status["reachable"] = resp.status == 200
            endpoint_status["health_http_status"] = resp.status
    except Exception:
        pass

    warnings: List[str] = []
    issues: List[str] = []
    if plan_error:
        warnings.append(plan_error)
        issues.append(f"launch_plan_refused: {plan_error}")
    if (ldd_info.get("using_compat_stub") or not ldd_info.get("driver_ok")) and not gpu_info["available"]:
        msg = (
            "Container is currently bound to the CUDA forward-compatibility stub (/usr/local/cuda-13.0/compat/libcuda.so.1) "
            "because `--gpus all` was not passed to `docker run`. CPU-only CLI/inspection commands work, but GPU model serving requires `--gpus all`."
        )
        warnings.append(msg)
        issues.append("missing_gpu_passthrough: pass `--gpus all` to `docker run`")
    if shm_mb and shm_mb < 1024:
        warnings.append(
            f"/dev/shm size is {shm_mb} MiB (< 1024 MiB). Recommend passing `--shm-size 16g` or `--ipc=host` to `docker run` for optimal zero-copy IPC."
        )
    if not io_uring_ok and any(m.get("ple_dir") for m in models):
        msg_uring = (
            f"Linux io_uring_setup is blocked ({io_uring_status}) by Docker's default seccomp profile. "
            "Pass `--security-opt seccomp=unconfined` to `docker run` when serving NVMe PLE-offload models (e.g. Qwen3.8-Flash-Next-NVFP4-Offload)."
        )
        warnings.append(msg_uring)
        if selected and selected.get("ple_dir"):
            issues.append("io_uring_blocked: pass `--security-opt seccomp=unconfined` for NVMe PLE offload")
    if not selected:
        issues.append("no_model_found: mount models directory via `-v /path/to/models:/models:ro`")
    elif selected.get("status") != "ready":
        issues.append(f"selected_model_not_ready: {selected.get('name')} has status '{selected.get('status')}'")
    for m in models:
        if m["broken_symlinks"]:
            warnings.append(
                f"Model `{m['name']}` has broken symlinks ({', '.join(m['broken_symlinks'][:3])}). Mount the parent HuggingFace cache directory if using symlinked snapshots."
            )

    return {
        "timestamp_utc": dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "engine_version": engine_version(),
        "privacy_opt_outs": opts,
        "system": {
            "arch": platform.machine(),
            "kernel": "REDACTED" if opts.get("host") else platform.release(),
            "hostname": "REDACTED" if opts.get("host") else socket.gethostname(),
            "shm_size_mib": shm_mb,
            "io_uring": {"available": io_uring_ok, "status": io_uring_status},
            "memory": mem_summary,
        },
        "memory": {
            "mem_total_mb": mem_total_mb,
            "mem_available_mb": mem_avail_mb,
        },
        "cuda_runtime": ldd_info,
        "gpu": gpu_info,
        "hardware_topology": hw_diag,
        "recommended_container_image": recommended_container_image(hw_topo),
        "hardware_recommendations": recommend_models_for_hardware(hw_topo),
        "binaries_installed": {k: Path(v).is_file() for k, v in BINARIES.items()},
        "models_detected_count": len(models),
        "models": models,
        "selected_model": selected,
        "launch_plan": plan,
        "live_endpoint": endpoint_status,
        "readiness": {
            "ready": len(issues) == 0,
            "issues": issues,
        },
        "warnings": warnings,
    }


def verify_endpoint(base_url: str, opts: Dict[str, bool]) -> Dict[str, Any]:
    base = base_url.rstrip("/")
    results: Dict[str, Any] = {"base_url": base, "timestamp_utc": dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"), "checks": {}}

    # 1. GET /health
    t0 = time.time()
    try:
        with urllib.request.urlopen(f"{base}/health", timeout=5.0) as r:
            results["checks"]["health"] = {"status": "PASS", "http_code": r.status, "latency_ms": round((time.time() - t0) * 1000, 2)}
    except Exception as e:
        results["checks"]["health"] = {"status": "FAIL", "error": str(e)}

    # 2. GET /v1/models
    model_id = os.environ.get("FLUX_MODEL_ID", "Qwen3.8-35B-A3B-NVFP4")
    t0 = time.time()
    try:
        with urllib.request.urlopen(f"{base}/v1/models", timeout=5.0) as r:
            body = json.loads(r.read().decode("utf-8", errors="replace"))
            data = body.get("data", [])
            if data and isinstance(data[0], dict) and data[0].get("id"):
                model_id = data[0]["id"]
            results["checks"]["v1_models"] = {"status": "PASS", "http_code": r.status, "model_id": model_id, "latency_ms": round((time.time() - t0) * 1000, 2)}
    except Exception as e:
        results["checks"]["v1_models"] = {"status": "FAIL", "error": str(e)}

    # 3. POST /v1/chat/completions
    t0 = time.time()
    try:
        payload = json.dumps({
            "model": model_id,
            "messages": [{"role": "user", "content": "Reply with the single word READY."}],
            "max_tokens": 16,
            "temperature": 0.0,
        }).encode("utf-8")
        req = urllib.request.Request(f"{base}/v1/chat/completions", data=payload, headers={"Content-Type": "application/json"}, method="POST")
        with urllib.request.urlopen(req, timeout=30.0) as r:
            resp = json.loads(r.read().decode("utf-8", errors="replace"))
            txt = resp.get("choices", [{}])[0].get("message", {}).get("content", "")
            usage = resp.get("usage", {})
            results["checks"]["v1_chat_completions"] = {
                "status": "PASS",
                "http_code": r.status,
                "latency_ms": round((time.time() - t0) * 1000, 2),
                "usage": usage,
                "response_preview": "[REDACTED]" if opts.get("logs") else txt[:160],
            }
    except Exception as e:
        results["checks"]["v1_chat_completions"] = {"status": "FAIL", "error": str(e)}

    all_pass = all(c.get("status") == "PASS" for c in results["checks"].values())
    results["overall_status"] = "PASS" if all_pass else "PARTIAL_OR_OFFLINE"
    return results


def adopt_results_owner(paths: List[Path], results_dir: Path) -> None:
    """chown files (and directory trees) the launcher wrote to the owner of
    `results_dir`, keeping their modes. A root container otherwise leaves
    root-owned files in the host's /results that the host user cannot remove.
    Symlinks are not followed. One WARN if the chown is refused."""
    global _OWNERSHIP_WARNED
    try:
        st = os.stat(str(results_dir))
    except OSError:
        return
    for top in paths:
        try:
            items = [top]
            if top.is_dir() and not top.is_symlink():
                items += sorted(top.rglob("*"))
            for item in items:
                if item.exists() or item.is_symlink():
                    os.chown(str(item), st.st_uid, st.st_gid, follow_symlinks=False)
        except OSError as e:
            if not _OWNERSHIP_WARNED:
                _OWNERSHIP_WARNED = True
                print(f"[flux] WARN: cannot give {top} the owner of {results_dir} ({e})", file=sys.stderr, flush=True)


def generate_standalone_model_card(out_path: Path, opts: Dict[str, bool]) -> Dict[str, Any]:
    diag = collect_diagnostics(opts)
    selected = diag.get("selected_model")
    plan = diag.get("launch_plan")

    # Also invoke lil-bench card if any JSON benchmark results exist in out_path.parent
    results_dir = out_path.parent
    results_dir.mkdir(parents=True, exist_ok=True)
    bench_jsons = [
        p for p in sorted(results_dir.glob("*.json"))
        if p.name not in ("environment.json", "flux-diagnostics.json", "CONTAINER_BUILD_RECEIPT.json")
    ]
    visual_cards = {}
    if bench_jsons and Path("/usr/local/bin/lil-bench").is_file():
        try:
            cmd = ["/usr/local/bin/lil-bench", "card", str(results_dir / "card")] + [str(p) for p in bench_jsons]
            if opts.get("host"):
                cmd.append("--opt-out-host-info")
            if opts.get("logs"):
                cmd.append("--opt-out-prompt-logs")
            out = subprocess.check_output(cmd, text=True)
            visual_cards = json.loads(out).get("cards", {})
        except Exception:
            pass

    # If lil-bench card did not already write a data-driven MODEL_CARD.md or if we want to enrich it:
    lines: List[str] = [
        f"# Flux Engine Model & Diagnostic Card",
        "",
        "## 1. Engine & Environment Summary",
        "",
        "| Field | Value |",
        "| :--- | :--- |",
        f"| **Engine Version** | `flux-engine v{engine_version()}` |",
        f"| **Timestamp (UTC)** | `{diag['timestamp_utc']}` |",
        f"| **Architecture / Kernel** | `{diag['system']['arch']}` / `{diag['system']['kernel']}` |",
        f"| **Hostname** | `{diag['system']['hostname']}` |",
        f"| **CUDA Runtime (`libcuda.so.1`)** | `{diag['cuda_runtime']['status']}` (`compat_stub={diag['cuda_runtime']['using_compat_stub']}`) |",
        f"| **Privacy Opt-Outs** | `telemetry={opts['telemetry']}, host_redacted={opts['host']}, prompt_logs_redacted={opts['logs']}` |",
        "",
    ]

    if selected:
        spec = selected.get("speculative", {})
        lines.extend([
            "## 2. Auto-Detected Primary Model Profile",
            "",
            "| Property | Value |",
            "| :--- | :--- |",
            f"| **Model Directory** | `{selected['name']}` (`{selected['path']}`) |",
            f"| **Model Family** | `{selected['family']}` |",
            f"| **HF Architecture / `model_type`** | `{selected['architecture']}` / `{selected['model_type']}` |",
            f"| **Quantization Format** | `{selected['quantization']}` |",
            f"| **Layers / Hidden Size** | `{selected['num_hidden_layers']}` layers / `d_model={selected['hidden_size']}` |",
            f"| **MoE Experts** | `{selected['num_experts']}` total (`top-{selected['num_experts_per_tok']}` active) |",
            f"| **Max Context (`max_position_embeddings`)** | `{selected['max_position_embeddings']:,}` tokens |",
            f"| **Auto-Selected `--kernel-target`** | `{selected['kernel_target']}` |",
            f"| **Auto-Selected Engine Binary** | `{selected['selected_binary']}` |",
            f"| **Speculative Decoding / MTP** | `{spec.get('mode')}` (`gamma={spec.get('gamma')}`, drafter=`{spec.get('drafter_path') or 'Native/None'}`) |",
            "",
        ])

    if plan:
        lines.extend([
            "## 3. Resolved Execution Plan (`FLUX_MODE`)",
            "",
            f"- **Mode**: `{plan['mode']}` — {plan['mode_summary']}",
            f"- **Concurrency (`--concurrency`)**: `{plan['concurrency']}`",
            f"- **Max Sequence Length (`--max-seq-len`)**: `{plan['max_seq_len']:,}`",
            f"- **Environment Overrides**: `{json.dumps(plan['env'])}`",
            "- **Launch Command**:",
            "```bash",
            " ".join(plan["command"]),
            "```",
            "",
        ])

    if bench_jsons and (results_dir / "summary.md").is_file():
        lines.extend([
            "## 4. Recorded Benchmark Results (`lil-bench`)",
            "",
            (results_dir / "summary.md").read_text(encoding="utf-8", errors="replace"),
            "",
        ])
    else:
        lines.extend([
            "## 4. Running Standard Benchmarks (`lil-bench`, Estonia 136.6K, Concurrency Sweeps)",
            "",
            "To populate this Model Card with live throughput matrices and dark-mode SVG/PNG cards:",
            "```bash",
            "# 1. All-context matrix (0, 8k, 16k, 32k, 64k, 128k) + visual card:",
            "lil-bench matrix",
            "",
            "# 2. Concurrency sweep (C=1,2,4,8 across 0, 8k, 32k):",
            "lil-bench concurrency 1,2,4,8",
            "",
            "# 3. Estonia 136.6K long-context needle benchmark:",
            "lil-bench estonia",
            "```",
            "",
        ])

    if diag.get("warnings"):
        lines.extend(["## 5. Diagnostic Warnings & Recommendations", ""])
        for w in diag["warnings"]:
            lines.append(f"- ⚠️ {w}")
        lines.append("")

    out_path.write_text("\n".join(lines) + "\n", encoding="utf-8")
    diag_path = results_dir / "flux-diagnostics.json"
    diag_path.write_text(json.dumps(diag, indent=2) + "\n", encoding="utf-8")
    adopt_results_owner([out_path, diag_path] + sorted(results_dir.glob("card*")), results_dir)
    return {
        "model_card_markdown": str(out_path),
        "diagnostics_json": str(diag_path),
        "visual_cards": visual_cards,
    }


def export_submission_bundle(results_dir: Path, opts: Dict[str, bool]) -> Dict[str, Any]:
    """
    Create a 100% privacy-scrubbed submission bundle in <results_dir>/submission-bundle/
    ready to attach to https://github.com/TheApathy/flux-engine/issues.
    Always enforces Privacy-First redaction (host=True, logs=True, telemetry=True).
    """
    import hashlib
    import re

    strict_opts = {"telemetry": True, "host": True, "logs": True}
    results_dir.mkdir(parents=True, exist_ok=True)
    generate_standalone_model_card(results_dir / "MODEL_CARD.md", strict_opts)

    bundle_dir = results_dir / "submission-bundle"
    bundle_dir.mkdir(parents=True, exist_ok=True)

    def _scrub_text(text: str) -> str:
        # Secrets, home paths, IPs, hostname and request content (see scrub_text).
        return scrub_text(text, include_prompts=False)

    copied_files: Dict[str, str] = {}
    candidate_names = [
        "MODEL_CARD.md",
        "summary.md",
        "flux-diagnostics.json",
        "card.svg",
        "card.png",
        "concurrency-card.svg",
        "concurrency-card.png",
        "repetition-1.json",
        "repetition-2.json",
        "repetition-3.json",
        "concurrency-sweep.json",
        "estonia-results.json",
        "coding-peak.json",
    ]
    for name in candidate_names:
        src = results_dir / name
        if not src.is_file():
            continue
        dst = bundle_dir / name
        if src.suffix in (".md", ".json", ".svg", ".txt", ".log"):
            raw = src.read_text(encoding="utf-8", errors="replace")
            if src.suffix == ".json":
                try:
                    obj = json.loads(raw)
                    if isinstance(obj, dict):
                        for k in ("raw_responses", "samples", "prompts", "completions"):
                            if k in obj:
                                obj[k] = "[REDACTED_PRIVACY_FIRST]"
                        if "estonia_profile" in obj and isinstance(obj["estonia_profile"], dict):
                            obj["estonia_profile"].pop("response_text", None)
                        if "hardware" in obj and isinstance(obj["hardware"], dict):
                            obj["hardware"]["hostname"] = "REDACTED"
                            obj["hardware"]["driver_version"] = "REDACTED"
                    raw = json.dumps(obj, indent=2) + "\n"
                except Exception:
                    pass
            scrubbed = _scrub_text(raw)
            dst.write_text(scrubbed, encoding="utf-8")
        else:
            shutil.copy2(src, dst)
        copied_files[name] = hashlib.sha256(dst.read_bytes()).hexdigest()

    # Also sanitize flux-server.log if present (keep only non-prompt operational lines)
    srv_log = results_dir / "flux-server.log"
    if srv_log.is_file():
        clean_lines = []
        # This bundle is uploaded publicly: drop any line that mentions a
        # prompt, content or credentials outright, then scrub what is left.
        for line in srv_log.read_text(encoding="utf-8", errors="replace").splitlines()[-500:]:
            if any(blocked_kw in line.lower() for blocked_kw in ("prompt", "content", "authorization", "bearer")):
                continue
            clean_lines.append(_scrub_text(line))
        dst_log = bundle_dir / "flux-server.sanitized.log"
        dst_log.write_text("\n".join(clean_lines) + "\n", encoding="utf-8")
        copied_files[dst_log.name] = hashlib.sha256(dst_log.read_bytes()).hexdigest()

    manifest = {
        "schema": "flux-diagnostics-bundle-v1",
        "engine_version": engine_version(),
        "created_at_utc": dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "privacy_first_verified": True,
        "redactions_applied": ["host_identifiers", "home_paths", "prompt_completion_logs", "auth_tokens"],
        "diagnostics_repository": "https://github.com/TheApathy/flux-engine/issues",
        "files_sha256": copied_files,
    }
    manifest_path = bundle_dir / "SUBMISSION_MANIFEST.json"
    manifest_path.write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")
    adopt_results_owner([bundle_dir], results_dir)
    return {
        "bundle_dir": str(bundle_dir),
        "manifest": str(manifest_path),
        "files_count": len(copied_files),
        "upload_repo": "https://github.com/TheApathy/flux-engine/issues",
    }


# ---------------------------------------------------------------------------
# Privacy scrubbing for anything that leaves the box (`flux bundle`).
#
# Secrets, home paths, IPs, emails and the hostname are ALWAYS redacted.
# Request content (prompt/completion text, tool arguments, token-id lists) is
# redacted unless the user opts in with FLUX_INCLUDE_PROMPT_LOGS=1 or
# --include-prompt-logs. The server logs request content in a few places:
# `Tool call: name(args)` (INFO), the dropped client system message (INFO),
# `raw pre-parse output` (INFO, atlas::tool_debug), `sample=` file paths
# (WARN) and token-id lists in DECODE / MTP drafts (DEBUG).
# ---------------------------------------------------------------------------
import re as _re

_SECRET_ENV_NAME_RE = _re.compile(
    r"(?:^|_)(?:TOKEN|KEY|SECRET|PASSWORD|PASSWD|PASS|CREDENTIALS?|AUTH)$", _re.I
)
_SECRET_RULES: List[Tuple[str, Any, str]] = [
    ("auth_token", _re.compile(r"(?i)\b(authorization\s*[:=]\s*\"?)(?:[A-Za-z]+\s+)?[^\s\",]+"), r"\1<REDACTED>"),
    ("auth_token", _re.compile(r"\b(?:Bearer|Basic)\s+(?!tokens?\b)[A-Za-z0-9._~+/=-]{6,}", _re.I), "<REDACTED_AUTH>"),
    ("url_credentials", _re.compile(r"(\b[A-Za-z][A-Za-z0-9+.-]*://)[^/\s:@]+:[^/\s@]*@"), r"\1<REDACTED>@"),
    (
        "secret_flag",
        _re.compile(
            r"(?i)(--(?:[a-z0-9]+[-_])*(?:token|key|secret|secrets|password|passwd|auth|apikey|credentials?)"
            r"(?:[-_][a-z0-9]+)*)(=|[ \t]+|\"[ \t]*,[ \t]*\")(?!--)([^\s\",]+)"
        ),
        r"\1\2<REDACTED>",
    ),
    ("api_key", _re.compile(r"\bhf_[A-Za-z0-9]{8,}"), "<REDACTED_KEY>"),
    ("api_key", _re.compile(r"\bsk-[A-Za-z0-9_-]{8,}"), "<REDACTED_KEY>"),
    ("api_key", _re.compile(r"\b(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{8,}"), "<REDACTED_KEY>"),
    ("api_key", _re.compile(r"\bgithub_pat_[A-Za-z0-9_]{8,}"), "<REDACTED_KEY>"),
    ("api_key", _re.compile(r"\bxox[abposr]-[A-Za-z0-9-]{8,}"), "<REDACTED_KEY>"),
    ("api_key", _re.compile(r"\bAKIA[0-9A-Z]{16}\b"), "<REDACTED_KEY>"),
    (
        "key_value",
        _re.compile(
            r"(?i)\b([A-Za-z0-9_.-]*(?:_token|_key|apikey|api-key|secret|password|passwd)|token|key|auth)"
            r"(\s*=\s*\"?|\"\s*:\s*\")([^\s\"',;&}\]]+)"
        ),
        r"\1\2<REDACTED>",
    ),
    (
        "key_value",
        _re.compile(r"(?i)\b((?:api[_-]?key|secret|password|passwd|access[_-]?token|auth[_-]?token)\s*:\s*)([^\s\"',;&}\]]+)"),
        r"\1<REDACTED>",
    ),
    ("home_path", _re.compile(r"/(?:home|Users)/[^/\s\"':]+"), "<HOME>"),
    ("home_path", _re.compile(r"(?<![\w.])/root(?=/|\b)"), "<HOME>"),
    ("email", _re.compile(r"\b[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,}\b"), "<EMAIL>"),
    (
        "ip_address",
        # Real dotted quads only (octets <= 255); loopback, 0.x (e.g. version
        # strings like 0.9.15.5) and 255.x masks are left alone.
        _re.compile(r"\b(?!127\.)(?!0\.)(?!255\.)(?:(?:25[0-5]|2[0-4]\d|1?\d?\d)\.){3}(?:25[0-5]|2[0-4]\d|1?\d?\d)\b"),
        "<IP>",
    ),
    ("ip_address", _re.compile(r"\b(?:f[cd][0-9a-f]{2}|fe80):[0-9a-f:]{2,}\b", _re.I), "<IP>"),
]
_PROMPT_RULES: List[Tuple[str, Any, str]] = [
    ("prompt_text", _re.compile(r"(Tool call: [^\s(]+)\(.*\)"), r"\1(<REDACTED_PROMPT>)"),
    ("prompt_text", _re.compile(r"(client system message.*\bdropped=).*$", _re.M), r"\1<REDACTED_PROMPT>"),
    ("prompt_text", _re.compile(r"(raw pre-parse output[^:]*: ).*$", _re.M), r"\1<REDACTED_PROMPT>"),
    ("prompt_text", _re.compile(r"\b(sample=)\[.*?\](?=\s|$)", _re.M), r"\1<REDACTED_PROMPT>"),
    (
        "prompt_text",
        _re.compile(
            r"(\"(?:content|prompt|text|completion|input|messages|arguments|query|instructions|system|output_text)\"\s*:\s*)"
            r"\"(?:[^\"\\]|\\.)*\""
        ),
        r'\1"<REDACTED_PROMPT>"',
    ),
    (
        "prompt_text",
        _re.compile(
            r"\b((?:content|prompt|text|completion|response|output_text|preview|query|arguments)=)"
            r"(?:\"(?:[^\"\\]|\\.)*\"|'(?:[^'\\]|\\.)*')"
        ),
        r"\1<REDACTED_PROMPT>",
    ),
    ("token_ids", _re.compile(r"=\[\s*\d+(?:\s*,\s*\d+){2,}\s*\]"), "=[<REDACTED_TOKEN_IDS>]"),
    # Single per-sequence token ids (census of server log fields: LOAD_DEBUG.md).
    (
        "token_ids",
        _re.compile(
            r"\b((?:last|last_tok|last_token|tok|token|token_id|next|next_token|new_draft|prev_draft|v0_verified|"
            r"argmax|raw_argmax|batch_argmax|serial_argmax|sampled|fork_tok|expected_after_fork|true_after_fork|"
            r"raw|clean|bonus|input|raw_top1_id|raw_top2_id|first_token|id)\s*=\s*)(?:Some\()?\d+\)?"
        ),
        r"\1<TOKEN_ID>",
    ),
    ("token_ids", _re.compile(r"\b(first token: )\d+"), r"\1<TOKEN_ID>"),
    (
        "token_ids",
        _re.compile(
            r"\b((?:tokens|token_ids|drafts|pending_drafts|tree_tokens|verify_input|verified|k1_verified|"
            r"shadow_verified|production_verified|output_tokens|accepted_ids|ids)(?:\[[^\]]*\])?\s*[=:]\s*)"
            r"(?:Some\()?\[[^\]]*\]\)?"
        ),
        r"\1[<REDACTED_TOKEN_IDS>]",
    ),
]


# Log records whose message carries request content are dropped whole (with
# their continuation lines) unless the user opts in: inline redaction cannot
# be trusted on multi-line or truncated previews.
_CONTENT_RECORD_RE = _re.compile(
    r"CONC_DIAG|SERIAL_POLICY_DECODE|SPEC_THINK_BOOTSTRAP|SPEC_RAW_BOOTSTRAP|DFLASH_SERIAL_ORACLE|BRANCH_AUDIT"
    r"|K2 REJECT|think mask:|first token: \d|"
    r"Tool call:|raw pre-parse output|client system message|\bF39\b|\bF49\b|sample_direct"
    r"|DECODE:|bootstrap.*drafts|drafts(?:\[[^\]]*\])?\s*=|tree_tokens|verify_input|k1_verified|shadow_verified"
    r"|raw_top1_id|\btokens\s*=\s*\[|\bcontent: \"|\\\"(?:content|prompt|text|arguments|messages)\\\""
    r"|\"(?:content|prompt|messages|arguments|text|completion)\"\s*:"
)
_RECORD_START_RE = _re.compile(r"^(?:\x1b\[[0-9;]*m)*(?:\d{4}-\d\d-\d\dT\S+|\[flux)")
_ANSI_RE = _re.compile(r"\x1b\[[0-9;]*m")


def drop_content_records(text: str, counts: Optional[Dict[str, int]] = None) -> str:
    """Replace each content-bearing log record (and its continuation lines) by a stub."""
    counts = counts if counts is not None else {}
    out: List[str] = []
    dropping = False
    for line in text.splitlines():
        plain = _ANSI_RE.sub("", line)
        if _RECORD_START_RE.match(line):
            dropping = bool(_CONTENT_RECORD_RE.search(plain))
            if dropping:
                stamp = plain.split()[0] if plain.split() else ""
                out.append(f"{stamp} <REDACTED_RECORD: request content>")
                counts["content_record"] = counts.get("content_record", 0) + 1
                continue
        elif dropping:
            continue
        elif _CONTENT_RECORD_RE.search(plain):
            out.append("<REDACTED_RECORD: request content>")
            counts["content_record"] = counts.get("content_record", 0) + 1
            continue
        out.append(line)
    return "\n".join(out) + ("\n" if text.endswith("\n") else "")


def scrub_log_text(text: str, include_prompts: bool = False, counts: Optional[Dict[str, int]] = None,
                   environ: Optional[Dict[str, str]] = None) -> str:
    """`scrub_text` for log files: also drops content-bearing records unless opted in."""
    counts = counts if counts is not None else {}
    if not include_prompts:
        text = drop_content_records(text, counts)
    return scrub_text(text, include_prompts=include_prompts, environ=environ, counts=counts)


def _secret_env_values(environ: Dict[str, str]) -> List[Tuple[str, str]]:
    """(name, value) for env vars whose name says they hold a secret."""
    out = []
    for name, value in environ.items():
        if value and len(value) >= 6 and (_SECRET_ENV_NAME_RE.search(name) or name in ("HF_TOKEN", "HUGGING_FACE_HUB_TOKEN")):
            out.append((name, value))
    return sorted(out, key=lambda kv: -len(kv[1]))


def scrub_text(
    text: str,
    include_prompts: bool = False,
    environ: Optional[Dict[str, str]] = None,
    counts: Optional[Dict[str, int]] = None,
) -> str:
    """Redact secrets, identifiers and (unless opted in) request content.

    `counts` (if given) is updated with the number of redactions per category.
    """
    counts = counts if counts is not None else {}
    env = dict(os.environ if environ is None else environ)
    for name, value in _secret_env_values(env):
        n = text.count(value)
        if n:
            text = text.replace(value, f"<REDACTED_ENV:{name}>")
            counts["env_secret"] = counts.get("env_secret", 0) + n
    host = socket.gethostname() if environ is None else env.get("HOSTNAME", "")
    # Words that are also log targets ("spark::...") are not redacted as hostnames.
    if host and len(host) >= 4 and host.lower() not in ("localhost", "spark", "flux", "atlas"):
        n = len(_re.findall(r"\b" + _re.escape(host) + r"\b", text))
        if n:
            text = _re.sub(r"\b" + _re.escape(host) + r"\b", "<HOSTNAME>", text)
            counts["hostname"] = counts.get("hostname", 0) + n
    rules = _SECRET_RULES + ([] if include_prompts else _PROMPT_RULES)
    for category, pattern, repl in rules:
        text, n = pattern.subn(repl, text)
        if n:
            counts[category] = counts.get(category, 0) + n
    # Last, so the e-mail and home-path rules see the original text.
    user = env.get("USER") or env.get("LOGNAME") or ""
    if len(user) >= 3 and user not in ("root", "flux", "spark", "atlas"):
        user_re = _re.compile(r"(?<![A-Za-z0-9])" + _re.escape(user) + r"(?![A-Za-z0-9])")
        text, n = user_re.subn("<USER>", text)
        if n:
            counts["username"] = counts.get("username", 0) + n
    return text


def _scrub_env_snapshot(environ: Dict[str, str], keep_all: bool = False) -> Dict[str, str]:
    """The engine-relevant env (names kept, secret values redacted)."""
    keep = ("FLUX_", "ATLAS_", "RUST_", "CUDA_", "NCCL_", "NVIDIA_", "HF_", "TRANSFORMERS_", "PYTORCH_")
    out = {}
    for name in sorted(environ):
        if not keep_all and not name.startswith(keep):
            continue
        value = environ[name]
        if _SECRET_ENV_NAME_RE.search(name) or name in ("HF_TOKEN", "HUGGING_FACE_HUB_TOKEN"):
            out[name] = "<REDACTED>" if value else ""
        else:
            out[name] = value
    return out


# Tail caps per collected log: a long FLUX_DEBUG run can reach 2x256 MiB.
BUNDLE_LOG_TAIL_BYTES = {
    "flux-server.log": 16 << 20,
    "flux-debug.log": 64 << 20,
    "flux-debug.log.1": 32 << 20,
    "flux-load-debug.log": 8 << 20,
}


def _read_tail(path: Path, max_bytes: int) -> Tuple[str, bool]:
    """The last `max_bytes` of a file (starting at a line boundary), and whether it was cut."""
    size = path.stat().st_size
    with path.open("rb") as fh:
        if size > max_bytes:
            fh.seek(size - max_bytes)
            data = fh.read()
            nl = data.find(b"\n")
            data = data[nl + 1:] if nl >= 0 else data
            return data.decode("utf-8", errors="replace"), True
        return fh.read().decode("utf-8", errors="replace"), False


def _load_failure_extract(server_log: str) -> Optional[str]:
    """The last load-failure block the server printed (dump + error chain)."""
    start = server_log.rfind("===== model load failed")
    if start < 0:
        start = server_log.rfind("===== panic during model load")
    if start < 0:
        return None
    start = server_log.rfind("\n", 0, start) + 1
    tail = server_log[start:]
    lines = tail.splitlines()
    # Keep the dump and the error chain that follows it (up to 80 lines).
    for i, line in enumerate(lines):
        if line.startswith("[flux] ===== end of load-phase debug log"):
            return "\n".join(lines[: i + 81]) + "\n"
    return "\n".join(lines[:1200]) + "\n"


IMAGE_LABELS_PATH = Path("/opt/flux/IMAGE_LABELS.json")
IMAGE_LABELS_MAX_BYTES = 256 * 1024


def _image_labels_record(path: Optional[Path] = None) -> Dict[str, Any]:
    """The image's OCI labels as written at build time, or why they are missing.

    Never raises: an older image has no file, and a bad file is reported, not
    trusted. Only a string->string map is accepted as labels.
    """
    path = IMAGE_LABELS_PATH if path is None else path
    rec: Dict[str, Any] = {"schema": "flux-bundle-image-labels-v1", "path": str(path)}
    if not _safe_is_file(path):
        rec.update(present=False, reason="not present in this image (built before IMAGE_LABELS.json was added); "
                   "run `docker inspect --format '{{json .Config.Labels}}' <image>` on the host")
        return rec
    rec["present"] = True
    try:
        with open(path, "rb") as fh:
            raw = fh.read(IMAGE_LABELS_MAX_BYTES + 1)
        if len(raw) > IMAGE_LABELS_MAX_BYTES:
            raise ValueError(f"larger than {IMAGE_LABELS_MAX_BYTES} bytes")
        data = json.loads(raw.decode("utf-8"))
        labels = data.get("labels") if isinstance(data, dict) else None
        if not isinstance(labels, dict) or not all(
            isinstance(k, str) and isinstance(v, str) for k, v in labels.items()
        ):
            raise ValueError("no string->string 'labels' object")
    except (OSError, ValueError) as e:
        rec.update(error=f"unreadable: {e}")
        return rec
    rec["file_schema"] = data.get("schema")
    rec["labels"] = dict(sorted(labels.items()))
    return rec


def _system_facts(opts: Dict[str, bool]) -> Dict[str, Any]:
    import hashlib

    facts: Dict[str, Any] = {
        "engine_version": engine_version(),
        "arch": platform.machine(),
        "cpu_count": os.cpu_count(),
        "kernel": "REDACTED" if opts.get("host") else platform.release(),
        "image_labels_note": "OCI labels are not visible inside the container; the build copies them to "
        f"{IMAGE_LABELS_PATH} (bundled as system/image-labels.json). Older images lack it: run "
        "`docker inspect --format '{{json .Config.Labels}}' <image>` on the host.",
    }
    for name in ("SOURCE_COMMIT", "SHA256SUMS"):
        p = Path("/opt/flux") / name
        if _safe_is_file(p):
            try:
                facts[name.lower()] = p.read_text(encoding="utf-8", errors="replace").strip()
            except OSError as e:
                facts[name.lower()] = f"unreadable: {e}"
    shas: Dict[str, str] = {}
    for p in sorted(glob.glob("/opt/flux/bin/flux-server*")):
        try:
            h = hashlib.sha256()
            with open(p, "rb") as fh:
                for chunk in iter(lambda: fh.read(1 << 20), b""):
                    h.update(chunk)
            shas[p] = h.hexdigest()
        except OSError as e:
            shas[p] = f"unreadable: {e}"
    facts["binaries_sha256"] = shas
    gpu: Dict[str, Any] = {"available": False}
    if shutil.which("nvidia-smi"):
        try:
            smi = subprocess.check_output(
                ["nvidia-smi", "--query-gpu=name,driver_version,memory.total,memory.used,memory.free",
                 "--format=csv,noheader"],
                text=True, stderr=subprocess.DEVNULL, timeout=10,
            ).strip()
            gpu = {"available": bool(smi), "query": smi.splitlines()}
        except Exception as e:  # noqa: BLE001 - facts are best effort
            gpu = {"available": False, "error": str(e)}
    facts["gpu"] = gpu
    mem: Dict[str, str] = {}
    try:
        for line in Path("/proc/meminfo").read_text(encoding="utf-8").splitlines():
            k, _, v = line.partition(":")
            if k in ("MemTotal", "MemAvailable", "MemFree", "SwapTotal", "SwapFree", "Cached"):
                mem[k] = v.strip()
    except OSError:
        pass
    facts["memory"] = mem
    return facts


def _probe_endpoint(port: str) -> Dict[str, Any]:
    out: Dict[str, Any] = {"url": f"http://127.0.0.1:{port}"}
    for route in ("/health", "/v1/models"):
        try:
            with urllib.request.urlopen(f"http://127.0.0.1:{port}{route}", timeout=3.0) as r:
                body = r.read(256 * 1024).decode("utf-8", errors="replace")
                try:
                    out[route] = {"status": r.status, "body": json.loads(body)}
                except ValueError:
                    out[route] = {"status": r.status, "body": body}
        except urllib.error.HTTPError as e:
            out[route] = {"status": e.code, "error": str(e)}
        except Exception as e:  # noqa: BLE001 - server down is a normal answer
            out[route] = {"status": None, "error": str(e)}
    return out


def export_debug_bundle(results_dir: Path, opts: Dict[str, bool], include_prompts: bool = False) -> Dict[str, Any]:
    """Write ONE scrubbed archive, <results_dir>/flux-debug-<version>-<UTC>.tar.gz.

    Collects the server log, the FLUX_DEBUG log, load-failure diagnostics,
    the launch record, image/binary/GPU/memory facts and a live endpoint
    probe, plus the existing submission bundle. Every text file is passed
    through `scrub_text`; MANIFEST.json lists each file and its redactions.
    """
    import hashlib
    import io
    import tarfile

    if not _safe_is_dir(results_dir) or not os.access(str(results_dir), os.W_OK):
        raise OSError(f"{results_dir} is not a writable directory (mount it with -v <dir>:/results)")
    stamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    version = _re.sub(r"[^A-Za-z0-9._-]", "_", engine_version())
    stem = f"flux-debug-{version}-{stamp}"
    members: Dict[str, bytes] = {}
    manifest_files: List[Dict[str, Any]] = []

    def add(name: str, text: str, source: str, truncated: bool = False, log: bool = False) -> None:
        counts: Dict[str, int] = {}
        scrub = scrub_log_text if log else scrub_text
        body = scrub(text, include_prompts=include_prompts, counts=counts)
        data = body.encode("utf-8")
        members[name] = data
        manifest_files.append({
            "file": name,
            "source": source,
            "bytes": len(data),
            "sha256": hashlib.sha256(data).hexdigest(),
            "truncated_to_tail": truncated,
            "redactions": counts,
        })

    root = os.path.realpath(str(results_dir))
    skipped: List[Dict[str, str]] = []

    def inside(name: str) -> Optional[Path]:
        """`results_dir/name` if it is a regular file that does not resolve outside results_dir."""
        src = results_dir / name
        if not _safe_is_file(src):
            return None
        real = os.path.realpath(str(src))
        if os.path.commonpath([root, real]) != root:
            skipped.append({"file": name, "reason": "symlink resolves outside the results directory"})
            return None
        return Path(real)

    server_log_text = ""
    for name, cap in BUNDLE_LOG_TAIL_BYTES.items():
        src = inside(name)
        if src is not None:
            text, cut = _read_tail(src, cap)
            if name == "flux-server.log":
                server_log_text = text
            add(f"logs/{name}", text, str(results_dir / name), truncated=cut, log=True)
    extract = _load_failure_extract(server_log_text) if server_log_text else None
    if extract:
        add("load-failure/from-flux-server-log.txt", extract, "flux-server.log (last load-failure block)", log=True)
    load_debug_src = inside("flux-load-debug.log")
    tail = load_debug_tail(str(load_debug_src), max_lines=10**9) if load_debug_src else None
    if tail:
        add("load-failure/killed-load-tail.txt", tail, "flux-load-debug.log (no dump/complete marker)", log=True)
    for name in ("flux-launch.json", "flux-diagnostics.json"):
        src = inside(name)
        if src is not None:
            add(f"launch/{name}", src.read_text(encoding="utf-8", errors="replace"), str(results_dir / name))
    add("launch/environment.json", json.dumps(_scrub_env_snapshot(dict(os.environ)), indent=2) + "\n",
        "process environment (FLUX_/ATLAS_/RUST_/CUDA_/NCCL_/NVIDIA_/HF_ names)")
    add("system/facts.json", json.dumps(_system_facts(opts), indent=2) + "\n", "image files, nvidia-smi, /proc/meminfo")
    add("system/image-labels.json", json.dumps(_image_labels_record(), indent=2) + "\n",
        str(IMAGE_LABELS_PATH))
    add("system/endpoint.json", json.dumps(_probe_endpoint(os.environ.get("FLUX_PORT", "8899")), indent=2) + "\n",
        "GET /health and /v1/models on 127.0.0.1")

    submission: Dict[str, Any]
    try:
        submission = export_submission_bundle(results_dir, opts)
        for p in sorted(Path(submission["bundle_dir"]).glob("*")):
            if p.is_file():
                if p.suffix in (".png",):
                    members[f"submission-bundle/{p.name}"] = p.read_bytes()
                    manifest_files.append({"file": f"submission-bundle/{p.name}", "source": str(p),
                                           "bytes": p.stat().st_size, "redactions": {}, "binary": True})
                else:
                    add(f"submission-bundle/{p.name}", p.read_text(encoding="utf-8", errors="replace"), str(p))
    except Exception as e:  # noqa: BLE001 - a stopped container has no models or GPU
        submission = {"error": f"submission bundle skipped: {e}"}

    manifest = {
        "schema": "flux-debug-bundle-v1",
        "engine_version": engine_version(),
        "created_at_utc": stamp,
        "prompt_content": "included (user opt-in)" if include_prompts else "redacted",
        "always_redacted": ["env_secret", "hostname", "username", "auth_token", "url_credentials", "secret_flag",
                            "api_key", "key_value", "home_path", "email", "ip_address"],
        "redacted_unless_opt_in": [] if include_prompts else ["content_record", "prompt_text", "token_ids"],
        "files": manifest_files,
        "skipped": skipped,
        "submission_bundle": {k: v for k, v in submission.items() if k != "bundle_dir"},
    }
    # Sources are paths; scrub them too (counts are not affected).
    members["MANIFEST.json"] = scrub_text(json.dumps(manifest, indent=2) + "\n", include_prompts=True).encode("utf-8")

    archive = results_dir / f"{stem}.tar.gz"
    tmp = results_dir / f".{stem}.tar.gz.partial"
    try:
        fd = _open_private(tmp)
        with os.fdopen(fd, "wb") as fh, tarfile.open(fileobj=fh, mode="w:gz") as tar:
            for name in ["MANIFEST.json"] + sorted(k for k in members if k != "MANIFEST.json"):
                info = tarfile.TarInfo(f"{stem}/{name}")
                info.size = len(members[name])
                info.mtime = int(time.time())
                info.mode = 0o600
                tar.addfile(info, io.BytesIO(members[name]))
        os.replace(tmp, archive)
    except BaseException:
        try:
            tmp.unlink()
        except OSError:
            pass
        raise
    return {
        "archive": str(archive),
        "files": sorted(members),
        "prompt_content": manifest["prompt_content"],
    }


