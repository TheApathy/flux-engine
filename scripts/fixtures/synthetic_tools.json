[
  {
    "name": "read_file",
    "description": "Read a UTF-8 text file from the workspace.",
    "input_schema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "Relative path to the file."
        },
        "start_line": {
          "type": "integer",
          "description": "Optional 1-based start line."
        },
        "end_line": {
          "type": "integer",
          "description": "Optional 1-based inclusive end line."
        }
      },
      "required": ["path"]
    }
  },
  {
    "name": "search_files",
    "description": "Search workspace files using a regular expression.",
    "input_schema": {
      "type": "object",
      "properties": {
        "pattern": {
          "type": "string",
          "description": "Regular expression pattern to match."
        },
        "glob": {
          "type": "string",
          "description": "Optional glob filter."
        }
      },
      "required": ["pattern"]
    }
  },
  {
    "name": "run_tests",
    "description": "Run a named test suite in the workspace.",
    "input_schema": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string",
          "description": "Crate or test module name."
        },
        "verbose": {
          "type": "boolean",
          "description": "Enable verbose test output."
        }
      },
      "required": ["target"]
    }
  }
]
