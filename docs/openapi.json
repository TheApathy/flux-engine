{
  "openapi": "3.1.0",
  "info": {
    "title": "Flux Engine Inference API",
    "version": "1.0.3",
    "summary": "OpenAI- and Anthropic-compatible HTTP API (+ Ollama discovery) for Flux Engine (Native Rust + Blackwell CUDA/PTX).",
    "description": "Verified HTTP endpoint specification for Flux Engine (`spark-server`). Supports streaming SSE completions, tool calling, structured outputs (`xgrammar`), reasoning streams, inline base64 vision inputs, runtime settings, disaggregated serving, and health/Prometheus telemetry.",
    "license": {
      "name": "AGPL-3.0-only",
      "url": "https://github.com/TheApathy/flux-engine/blob/main/LICENSE"
    },
    "contact": {
      "name": "Flux Engine Maintainers",
      "url": "https://github.com/TheApathy/flux-engine"
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8888",
      "description": "Local native `flux-server serve` default (loopback)"
    },
    {
      "url": "http://127.0.0.1:8899",
      "description": "Local container (`flux serve` / `flux-autodetect`) default (loopback)"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Required when `--api-key` / `--auth-tokens-file` / `--require-auth` is configured (OpenAI-compatible clients). Supports optional scope prefixes `read:`, `inference:`, `admin:` (insufficient scope returns 403)."
      },
      "AnthropicApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "Required when authentication is enabled (Anthropic SDK / Claude Code clients). Supports optional scope prefixes `read:`, `inference:`, `admin:`."
      }
    },
    "schemas": {
      "ChatMessage": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": { "type": "string", "enum": ["system", "developer", "user", "assistant", "tool"] },
          "content": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "object" } }] }
        }
      },
      "ChatCompletionRequest": {
        "type": "object",
        "required": ["model", "messages"],
        "properties": {
          "model": { "type": "string", "example": "Qwen3.8-Flash-Next-NVFP4" },
          "messages": { "type": "array", "items": { "$ref": "#/components/schemas/ChatMessage" } },
          "max_tokens": { "type": "integer", "minimum": 1, "example": 512 },
          "temperature": { "type": "number", "minimum": 0, "maximum": 2, "example": 0.7 },
          "top_p": { "type": "number", "minimum": 0, "maximum": 1, "example": 0.95 },
          "stream": { "type": "boolean", "default": false },
          "tools": { "type": "array", "items": { "type": "object" } },
          "response_format": { "type": "object", "description": "Optional JSON schema enforced via `xgrammar`." }
        }
      },
      "AnthropicMessageRequest": {
        "type": "object",
        "required": ["model", "max_tokens", "messages"],
        "properties": {
          "model": { "type": "string", "example": "Qwen3.8-Flash-Next-NVFP4" },
          "max_tokens": { "type": "integer", "minimum": 1, "example": 1024 },
          "system": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "object" } }] },
          "messages": { "type": "array", "items": { "type": "object" } },
          "stream": { "type": "boolean", "default": false },
          "tools": { "type": "array", "items": { "type": "object" } },
          "thinking": { "type": "object", "description": "Optional extended-thinking configuration." },
          "output_config": { "type": "object", "description": "Optional Anthropic structured output config (`format: { type: \"json_schema\", schema: ... }`) enforced via `xgrammar`." },
          "output_format": { "type": "object", "description": "Legacy structured output schema alias enforced via `xgrammar`." }
        }
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["ready", "loading", "draining", "memory_floor", "faulted"], "example": "ready" },
          "model": { "type": "string", "example": "Qwen3.8-Flash-Next-NVFP4" }
        }
      }
    }
  },
  "security": [{ "BearerAuth": [] }, { "AnthropicApiKey": [] }],
  "paths": {
    "/v1/chat/completions": {
      "post": {
        "tags": ["OpenAI"],
        "summary": "Create chat completion",
        "description": "OpenAI-compatible chat completions endpoint with SSE streaming, tool calls, reasoning streams, inline base64 vision inputs, and `xgrammar` structured outputs.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ChatCompletionRequest" } } }
        },
        "responses": {
          "200": { "description": "Chat completion JSON response or `text/event-stream` SSE stream." },
          "400": { "description": "Invalid request payload or context budget exceeded." },
          "401": { "description": "Missing or invalid API key." },
          "403": { "description": "Token lacks required `inference` scope." }
        }
      }
    },
    "/v1/chat/completions/{id}": {
      "get": {
        "tags": ["OpenAI"],
        "summary": "Retrieve stored chat completion",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Stored chat completion object." }, "404": { "description": "Completion ID not found." } }
      }
    },
    "/v1/completions": {
      "post": {
        "tags": ["OpenAI"],
        "summary": "Create raw text completion",
        "description": "OpenAI-compatible legacy text completions endpoint.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["model", "prompt"] } } }
        },
        "responses": { "200": { "description": "Completion JSON or SSE stream." } }
      }
    },
    "/v1/responses": {
      "post": {
        "tags": ["OpenAI"],
        "summary": "Create OpenAI Responses API response",
        "description": "Supports OpenAI Responses API input items, streaming events, reasoning, stateful `conversation` linkage, and tool calling.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["model", "input"] } } }
        },
        "responses": { "200": { "description": "Response object or SSE event stream." } }
      }
    },
    "/v1/responses/{id}": {
      "get": {
        "tags": ["OpenAI"],
        "summary": "Retrieve stored Response object",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Stored Response object." }, "404": { "description": "Response not found." } }
      },
      "delete": {
        "tags": ["OpenAI"],
        "summary": "Delete stored Response object",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Deletion confirmation." } }
      }
    },
    "/v1/responses/{id}/input_items": {
      "get": {
        "tags": ["OpenAI"],
        "summary": "List input items for a stored Response",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "List of input items." } }
      }
    },
    "/v1/responses/{id}/cancel": {
      "post": {
        "tags": ["OpenAI"],
        "summary": "Cancel Response (synchronous-only stub)",
        "description": "Returns `400 response_not_cancellable` because Flux completes responses synchronously and does not support `background: true`.",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "400": { "description": "`response_not_cancellable` error." } }
      }
    },
    "/v1/conversations": {
      "post": {
        "tags": ["OpenAI"],
        "summary": "Create a Responses conversation container",
        "responses": { "200": { "description": "Created conversation object." } }
      }
    },
    "/v1/conversations/{id}": {
      "get": {
        "tags": ["OpenAI"],
        "summary": "Retrieve conversation",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Conversation object." } }
      },
      "post": {
        "tags": ["OpenAI"],
        "summary": "Update conversation metadata",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Updated conversation object." } }
      },
      "delete": {
        "tags": ["OpenAI"],
        "summary": "Delete conversation",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Deletion confirmation." } }
      }
    },
    "/v1/conversations/{id}/items": {
      "get": {
        "tags": ["OpenAI"],
        "summary": "List conversation items",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Conversation item list." } }
      },
      "post": {
        "tags": ["OpenAI"],
        "summary": "Append conversation items",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Appended items." } }
      }
    },
    "/v1/conversations/{id}/items/{item_id}": {
      "get": {
        "tags": ["OpenAI"],
        "summary": "Retrieve single conversation item",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "item_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Conversation item." } }
      },
      "delete": {
        "tags": ["OpenAI"],
        "summary": "Delete single conversation item",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "item_id", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Deletion confirmation." } }
      }
    },
    "/v1/models": {
      "get": {
        "tags": ["OpenAI"],
        "summary": "List loaded models",
        "responses": { "200": { "description": "List of available model descriptors." } }
      }
    },
    "/v1/models/{model_id}": {
      "get": {
        "tags": ["OpenAI"],
        "summary": "Retrieve model descriptor by ID",
        "parameters": [{ "name": "model_id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Model descriptor." }, "404": { "description": "Model not found." } }
      }
    },
    "/v1/messages": {
      "post": {
        "tags": ["Anthropic"],
        "summary": "Create Anthropic message (Claude Code compatible)",
        "description": "Native Anthropic Messages API translator supporting SSE events, tool use, thinking blocks, `output_config`/`output_format` JSON schemas, and inline base64 / data-URI images (no remote HTTP image fetching).",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AnthropicMessageRequest" } } }
        },
        "responses": {
          "200": { "description": "Anthropic Message JSON or `text/event-stream` SSE stream." },
          "400": { "description": "Invalid Anthropic request payload." },
          "401": { "description": "Missing or invalid `x-api-key`." },
          "403": { "description": "Token lacks required `inference` scope." }
        }
      }
    },
    "/v1/messages/count_tokens": {
      "post": {
        "tags": ["Anthropic"],
        "summary": "Count prompt tokens for Anthropic Messages request",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "type": "object", "required": ["model", "messages"] } } }
        },
        "responses": { "200": { "description": "Exact input token count." } }
      }
    },
    "/api/tags": {
      "get": {
        "tags": ["Ollama Discovery"],
        "summary": "List local models (Ollama discovery)",
        "responses": { "200": { "description": "Ollama-compatible model list." } }
      }
    },
    "/api/show": {
      "post": {
        "tags": ["Ollama Discovery"],
        "summary": "Inspect model metadata (Ollama discovery)",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "model": { "type": "string", "description": "Model name (Ollama current field)." },
                  "name": { "type": "string", "description": "Model name (legacy Ollama field)." }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Ollama-compatible model metadata." } }
      }
    },
    "/tokenize": {
      "post": {
        "tags": ["Tokenizer & Debug"],
        "summary": "Encode text into token IDs",
        "responses": { "200": { "description": "Token ID array and count." } }
      }
    },
    "/detokenize": {
      "post": {
        "tags": ["Tokenizer & Debug"],
        "summary": "Decode token IDs back into text",
        "responses": { "200": { "description": "Decoded text string." } }
      }
    },
    "/v1/apply-template": {
      "post": {
        "tags": ["Tokenizer & Debug"],
        "summary": "Render chat messages through loaded Jinja chat template",
        "responses": { "200": { "description": "Rendered prompt text without running inference." } }
      }
    },
    "/v1/debug/prompt": {
      "post": {
        "tags": ["Tokenizer & Debug"],
        "summary": "Inspect rendered prompt tokens",
        "responses": { "200": { "description": "Rendered prompt and token IDs." } }
      }
    },
    "/v1/decisions": {
      "post": {
        "tags": ["Tokenizer & Debug"],
        "summary": "Inspect next-token logit decisions",
        "responses": { "200": { "description": "Top candidate token probabilities / logits." } }
      }
    },
    "/flux/modes": {
      "get": {
        "tags": ["Flux Studio & Runtime"],
        "summary": "Inspect active server state and built-in operating modes (open UI route)",
        "security": [],
        "responses": { "200": { "description": "Active server mode & recipe catalog." } }
      }
    },
    "/recipes": {
      "get": {
        "tags": ["Flux Studio & Runtime"],
        "summary": "Alias for `/flux/modes` (open UI route)",
        "security": [],
        "responses": { "200": { "description": "Built-in operating recipes." } }
      }
    },
    "/v1/flux/modes": {
      "get": {
        "tags": ["Flux Studio & Runtime"],
        "summary": "Inspect active server state and built-in operating modes (authenticated)",
        "responses": { "200": { "description": "Active server mode & recipe catalog." } }
      }
    },
    "/v1/flux/settings": {
      "get": {
        "tags": ["Flux Studio & Runtime"],
        "summary": "Read live runtime request defaults",
        "responses": { "200": { "description": "Current runtime defaults and sources." } }
      },
      "patch": {
        "tags": ["Flux Studio & Runtime"],
        "summary": "Update live runtime request defaults (`admin` scope)",
        "responses": { "200": { "description": "Updated runtime defaults." }, "403": { "description": "Requires `admin` scope." } }
      }
    },
    "/v1/memory": {
      "get": {
        "tags": ["Flux Studio & Runtime"],
        "summary": "Inspect live VRAM / UMA memory telemetry",
        "responses": { "200": { "description": "Memory usage and KV pool utilization." } }
      }
    },
    "/v1/experts/usage": {
      "get": {
        "tags": ["Flux Studio & Runtime"],
        "summary": "Inspect MoE expert routing histograms",
        "responses": { "200": { "description": "Per-layer MoE expert activation counts." } }
      }
    },
    "/v1/disagg/status": {
      "get": {
        "tags": ["Disaggregated Serving"],
        "summary": "Inspect disaggregated prefill/decode coordinator status",
        "responses": { "200": { "description": "Disaggregated worker topology and status." } }
      }
    },
    "/v1/disagg/prefill": {
      "post": {
        "tags": ["Disaggregated Serving"],
        "summary": "Run disaggregated prefill stage (`admin` scope)",
        "responses": { "200": { "description": "Prefill KV transfer metadata." }, "403": { "description": "Requires `admin` scope." } }
      }
    },
    "/v1/disagg/decode": {
      "post": {
        "tags": ["Disaggregated Serving"],
        "summary": "Run disaggregated decode stage (`admin` scope)",
        "responses": { "200": { "description": "Decode stream or completion." }, "403": { "description": "Requires `admin` scope." } }
      }
    },
    "/v1/disagg/generate": {
      "post": {
        "tags": ["Disaggregated Serving"],
        "summary": "Coordinated disaggregated prefill+decode generation (`admin` scope)",
        "responses": { "200": { "description": "Generated output." }, "403": { "description": "Requires `admin` scope." } }
      }
    },
    "/health": {
      "get": {
        "tags": ["Operations"],
        "summary": "Server readiness & health probe",
        "security": [],
        "responses": {
          "200": {
            "description": "Server is ready to accept inference requests (`{\"status\":\"ready\",\"model\":\"...\"}`).",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HealthResponse" } } }
          },
          "503": {
            "description": "Server is loading, draining, below memory floor, or faulted.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HealthResponse" } } }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": ["Operations"],
        "summary": "Readiness probe alias for `/health`",
        "security": [],
        "responses": {
          "200": { "description": "Server ready (`{\"status\":\"ready\",\"model\":\"...\"}`)." },
          "503": { "description": "Server not ready." }
        }
      }
    },
    "/health/live": {
      "get": {
        "tags": ["Operations"],
        "summary": "Process liveness probe (Kubernetes `livenessProbe`)",
        "security": [],
        "responses": {
          "200": { "description": "Plain-text `ok` while server process is alive." }
        }
      }
    },
    "/metrics": {
      "get": {
        "tags": ["Operations"],
        "summary": "Prometheus telemetry scrape endpoint",
        "security": [],
        "responses": { "200": { "description": "Prometheus text exposition format metrics (`vllm:*` and `atlas_*`)." } }
      }
    }
  }
}
