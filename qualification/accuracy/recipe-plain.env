# ==============================================================================
# Flux Engine Operating Recipe: flux-qwen4-native-262k-w4096-bf16-owner16.env
# Qualification: exact native 262,144-token C1/BF16/QSA correctness
# Pair With:   recipes/flux-serve.argv
# Bridge:      source scripts/flux_env_bridge.sh --mode max-prefill
# ==============================================================================
# Source-candidate correctness recipe, not a performance qualification receipt.
# Persistent KV and sparse-prefill Q/K/V use BF16. Copied max-prefill profile
# rates do not qualify this different operand policy or its native endpoint.
# Each key is assigned once so the sealed literal recipe parser can bind it.
# ==============================================================================

# --- Flux Public Branded Selectors (translated by scripts/flux_env_bridge.sh) ---
FLUX_QWEN4_PREFILL_WIDE=4096
FLUX_QWEN4_PREFILL_MOE_V28Q=2
FLUX_QWEN4_PREFILL_MHC_ROOF=t128
