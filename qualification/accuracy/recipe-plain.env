ATLAS_QWEN4_PREFILL_MOE_SLOT_MXFP8=1
ATLAS_QWEN4_PREFILL_LAST_LAYER_CROP=1

# --- Serve v5 Levers (04k-serve-v5-gate: QSA E4M3 qkpv, fused FP8 act amax, PLE pipeline, unified MTP T) ---
ATLAS_QWEN4_PREFILL_FP8_ACT_AMAX_FUSED=1
ATLAS_QWEN4_PLE_PREFILL_PIPELINE=1
ATLAS_QWEN4_MTP_UNIFIED_T=1
ATLAS_SSM_DUMMY_STATE_ONLY=1

# --- Serve v6 Levers (04o-serve-v6-gate: K8 coalesced KV zero, fused PLE join, GDN conv v2, warp top-k, QSA fused top-k) ---
ATLAS_PREFILL_KV_ZERO_COALESCE=1
ATLAS_QWEN4_PLE_PREFILL_FUSED=1
ATLAS_QWEN4_PREFILL_GDN_CONV_V2=1
ATLAS_QWEN4_PREFILL_MOE_TOPK_WARP=1
ATLAS_QWEN4_PREFILL_MOE_SLOT_BF16_FUSED=1
ATLAS_QWEN4_PREFILL_QSA_FUSED_TOPK=1

# --- Serve v7 Levers (04q-serve-v7-gate: K9 race-free MTP last-K deferral, mHC t128 roof, 4-ring sector PLE DMA) ---
ATLAS_MTP_LASTK_DEFER=1
ATLAS_QWEN4_PREFILL_MHC_ROOF=t128
ATLAS_PLE_FAST_PLAN=1
ATLAS_PLE_SECTOR_READ=1
ATLAS_PLE_READ_RINGS=4
ATLAS_QWEN4_PLE_EARLY_ISSUE=1

# --- Serve v8 / v8c Levers (04s/04t: K10 inter-expert MoE plan order, o_proj absmax epilogue fold, 7 GiB FP8 cache reserve) ---
ATLAS_QWEN4_PREFILL_MOE_PLAN_ORDER=inter
ATLAS_QWEN4_PREFILL_OPROJ_AMAX_FUSED=1
ATLAS_PLE_READ_AFFINITY=big
ATLAS_ALLOC_SEQ_ASYNC=1

# --- Serve v9 Levers (05e-serve-v9-gate: K11/K12 SM121a fusions on unified13) ---
ATLAS_QWEN4_PREFILL_QSA_PLAN_FUSED=1
ATLAS_QWEN4_PREFILL_QSA_PREP_FUSED=1
ATLAS_QWEN4_PREFILL_QSA_PIPE=1
ATLAS_QWEN4_PREFILL_HC_FUSED_PREP=1
ATLAS_QWEN4_PREFILL_SHARED_W4A8_PRETRANSCODE=1
ATLAS_QWEN4_PLE_PREFILL_ASYNC=1
ATLAS_QWEN4_PREFILL_MOE_V28Q=2
ATLAS_QWEN4_PREFILL_MHC_GATEPRE=1
ATLAS_QWEN4_PREFILL_ROUTER_GEMM_PIPE=1
ATLAS_QWEN4_PREFILL_ROUTER_PIPE=1
ATLAS_QWEN4_PREFILL_MOE_FUSED_SORT_PLAN=1
ATLAS_QWEN4_PREFILL_MOE_SORT_PLAN_FUSED=1
ATLAS_QWEN4_MTP_LASTK_SKIP_INTERMEDIATE=1
ATLAS_QWEN4_PREFILL_GDN_NORM_FP8_V2=1
ATLAS_QWEN4_PREFILL_GDN_CONV_V3=1
ATLAS_PREFILL_LEAN_FINALIZE=1
ATLAS_QWEN4_VERIFY_FAST_HOST=1
ATLAS_QWEN4_GDN_COMMIT_NO_MIRROR=1
ATLAS_QWEN4_MTP_KEEP_LAST_ROW=1
ATLAS_QWEN4_MTP_BATCH_REPLAY=1
ATLAS_QWEN4_HC_TAIL_ROWS=1
ATLAS_QWEN4_MTP_KV_ONLY_REPLAY=1
ATLAS_MOE_T_LANES_DOWN_T8=1

# --- Native 262K correctness contract ---
# Keep the complete fast-prefill selector family above. A partial
# MULTI_CHUNK/WIDE selection is invalid, while the ordinary path degenerates
# into token-serial forward calls and does not engage sparse QSA prefill.
FLUX_MODE=256k
FLUX_MAX_SEQ_LEN=262144
FLUX_MAX_PREFILL_TOKENS=4096
FLUX_CONCURRENCY=1
FLUX_KV_CACHE_DTYPE=bf16
FLUX_CTX_OVERFLOW_TRUNCATE=0
FLUX_QWEN4_QSA_VERIFY_ROWS=0
# The performance profile defaults sparse-prefill Q/K/V operands to E4M3.
# Disable that transient shadow route as well as keeping persistent KV BF16.
FLUX_QWEN4_PREFILL_QSA_FP8=0
FLUX_QWEN4_FAST_PROJ_FP8_WEIGHT_CACHE_RESERVE_GB=10

ATLAS_CTX_OVERFLOW_TRUNCATE=0
ATLAS_QWEN4_QSA_VERIFY_ROWS=0
ATLAS_QWEN4_PREFILL_QSA_FP8=0
ATLAS_QWEN4_PREFILL_FAST_PROJ_FP8_WEIGHT_CACHE_RESERVE_GB=10

# --- Native C2-C8 exact-attention launch reduction candidates ---
# These selectors are dormant in the C1 correctness candidate above. Enabling them
# for a native-concurrency release is not itself a promotion: promotion
# requires exact token and full-logit parity against isolated C1 at every width
# C2-C8, including row removal, replacement, slot reuse, and reverse ordering.
ATLAS_ATTN_QKV_EXACT_STRIDED=1
ATLAS_ATTN_QK_NORM_BATCHED=1
ATLAS_ATTN_GATE_BATCHED=1
ATLAS_ATTN_KV_WRITE_BATCHED=1

# Recurrent-state allocations stay fixed while a C2-C8 scheduler wave keeps
# the same rows and order. Reuse the already resident per-layer pointer table
# after an exact pointer-by-pointer match. Any row churn uploads a fresh table.
# Promotion still requires the same exact token, full-logit, row-removal,
# replacement, slot-reuse, and reverse-order parity gate described above.
ATLAS_QWEN4_NATIVE_SSM_PTR_CACHE=1

# --- W4096 / owner16 successor: distinct registration and image required ---
# Grouped source owners retain the 64 MiB cap, checked by the startup census.
# Destination owners use 16 MiB, with all 48 ordered target-layer receipts.
FLUX_FAST_LOAD_ROUTED_GROUPS=1
ATLAS_FAST_LOAD_ROUTED_GROUPS=1
FLUX_FAST_LOAD_ROUTED_GROUPS_EAGER=1
ATLAS_FAST_LOAD_ROUTED_GROUPS_EAGER=1
FLUX_QWEN4_BOUNDED_TRANSPOSE_OWNERS=1
ATLAS_QWEN4_BOUNDED_TRANSPOSE_OWNERS=1
FLUX_QWEN4_BOUNDED_TRANSPOSE_OWNER_CAP_MIB=16
ATLAS_QWEN4_BOUNDED_TRANSPOSE_OWNER_CAP_MIB=16
FLUX_QWEN4_MTP_CONF=0
FLUX_QWEN4_MTP_CONF_EARLY=0

ATLAS_QWEN4_MTP_VOCAB_PRUNE=0
FLUX_QWEN4_MTP_VOCAB_PRUNE=0
# --- Arm Speculation Selectors ---
ATLAS_DISABLE_SPECULATION=1
FLUX_DISABLE_SPECULATION=1
FLUX_SPEC_MODE=none
ATLAS_SCHED_BURST_GATHER_MS=20
ATLAS_MOE_T_LANES_WORKLIST_R8=1
ATLAS_FAST_LOAD_DIRECT_IO_TENSOR_CAP=20000
FLUX_FAST_LOAD_DIRECT_IO_TENSOR_CAP=20000
ATLAS_QWEN4_NATIVE_BATCH=1
ATLAS_QWEN4_NATIVE_BATCH_QSA=1
