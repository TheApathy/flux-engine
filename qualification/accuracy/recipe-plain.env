ATLAS_VERIFY_ARGMAX_ROWS=1
ATLAS_QWEN4_VERIFY_OPROJ_ROWS=1
ATLAS_QWEN4_HC_DUAL_ROWS=1
ATLAS_QWEN4_VERIFY_GNORM_ROWS=1
