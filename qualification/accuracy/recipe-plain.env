ATLAS_QWEN4_PLE_VERIFY_BATCH=1
ATLAS_QWEN4_K5_BATCH_CONV=1
ATLAS_QWEN4_MTP_CONF=0
ATLAS_QWEN4_MTP_CONF_EARLY=0
